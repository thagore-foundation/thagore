# List helpers backed by runtime string-array handles.
# Note: v0.9 list values are ptr-oriented for CLI/tooling workloads.

extern func thag_str_array_new() -> ptr
extern func thag_str_array_push(parts: ptr, value: ptr) -> i32
extern func thag_str_array_remove(parts: ptr, index: i64) -> i32
extern func thag_str_array_sort(parts: ptr) -> i32
extern func thag_str_array_len(parts: ptr) -> i64
extern func thag_str_array_get(parts: ptr, index: i64) -> ptr

pub func new():
  return thag_str_array_new()

pub func append(list: ptr, value: ptr):
  if (thag_str_array_push(list, value) == 0):
    return 0
  return list

pub func remove(list: ptr, index: i64):
  if (thag_str_array_remove(list, index) == 0):
    return 0
  return list

pub func get(list: ptr, index: i64):
  return thag_str_array_get(list, index)

pub func sort(list: ptr):
  if (thag_str_array_sort(list) == 0):
    return 0
  return list

pub func filter(list: ptr, predicate):
  let out = thag_str_array_new()
  let i = 0
  while (i < thag_str_array_len(list)):
    let item = thag_str_array_get(list, i)
    if (predicate(item)):
      thag_str_array_push(out, item)
    i = i + 1
  return out

pub func map(list: ptr, mapper):
  let out = thag_str_array_new()
  let i = 0
  while (i < thag_str_array_len(list)):
    let item = thag_str_array_get(list, i)
    let mapped = mapper(item)
    thag_str_array_push(out, mapped)
    i = i + 1
  return out

pub func reduce(list: ptr, init, reducer):
  let acc = init
  let i = 0
  while (i < thag_str_array_len(list)):
    let item = thag_str_array_get(list, i)
    acc = reducer(acc, item)
    i = i + 1
  return acc

pub func len(list: ptr):
  return thag_str_array_len(list)
