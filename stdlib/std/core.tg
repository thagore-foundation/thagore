# Core std helpers.
# Rc<T>: single-thread shared ownership.
# Arc<T>: cross-thread shared ownership (Send/Sync-safe when inner type is Send).

extern func thag_process_exit(code: i32) -> void

pub func ok(val: i32) -> i32:
  return val

pub func fail(msg: ptr) -> i32:
  print(msg)
  return 0

pub func assert(cond: bool, msg: ptr) -> i32:
  if (cond):
    return 1
  print(msg)
  thag_process_exit(1)
  return 0

pub func print_int(v: i64) -> i32:
  print(v)
  return 1

pub func print_float(v: f64) -> i32:
  print(v)
  return 1

pub func print_bool(v: bool) -> i32:
  print(v)
  return 1

pub func rc_new(val: i32) -> i32:
  return val

pub func arc_new(val: i32) -> i32:
  return val
