# Core std helpers.
# Rc<T>: single-thread shared ownership.
# Arc<T>: cross-thread shared ownership (Send/Sync-safe when inner type is Send).

extern func thag_process_exit(code: i32) -> void

pub func ok(val):
  return Ok(val)

pub func fail(msg):
  return Err(msg)

pub func assert(cond, msg):
  if (cond):
    return 1
  print(msg)
  thag_process_exit(1)
  return 0

pub func rc_new(val):
  return Rc(val)

pub func arc_new(val):
  return Arc(val)
