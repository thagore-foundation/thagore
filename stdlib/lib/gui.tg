# Minimal GUI/canvas helpers mapped to runtime hooks.

extern func thag_gui_create_canvas(width: i32, height: i32, title: ptr) -> ptr
extern func thag_gui_destroy_canvas(canvas: ptr) -> i32
extern func thag_gui_clear(canvas: ptr, rgba: i32) -> i32
extern func thag_gui_draw_point(canvas: ptr, x: i32, y: i32, rgba: i32) -> i32
extern func thag_gui_draw_line(canvas: ptr, x0: i32, y0: i32, x1: i32, y1: i32, rgba: i32) -> i32
extern func thag_gui_present(canvas: ptr) -> i32
extern func thag_gui_last_frame_path(canvas: ptr) -> ptr
extern func thag_gui_poll_event(canvas: ptr) -> i32
extern func thag_gui_should_close(canvas: ptr) -> i32
extern func thag_gui_request_close(canvas: ptr) -> i32
extern func thag_gui_set_target_fps(canvas: ptr, fps: i32) -> i32
extern func thag_gui_tick(canvas: ptr) -> i32

pub func canvas(width: i32, height: i32, title: ptr) -> ptr:
  return thag_gui_create_canvas(width, height, title)

pub func window(width: i32, height: i32, title: ptr) -> ptr:
  return thag_gui_create_canvas(width, height, title)

pub func destroy(canvas: ptr) -> i32:
  return thag_gui_destroy_canvas(canvas)

pub func clear(canvas: ptr, rgba: i32) -> i32:
  return thag_gui_clear(canvas, rgba)

pub func draw_point(canvas: ptr, x: i32, y: i32, rgba: i32) -> i32:
  return thag_gui_draw_point(canvas, x, y, rgba)

pub func draw_line(canvas: ptr, x0: i32, y0: i32, x1: i32, y1: i32, rgba: i32) -> i32:
  return thag_gui_draw_line(canvas, x0, y0, x1, y1, rgba)

pub func present(canvas: ptr) -> i32:
  return thag_gui_present(canvas)

pub func last_frame_path(canvas: ptr) -> ptr:
  return thag_gui_last_frame_path(canvas)

pub func poll_event(canvas: ptr) -> i32:
  return thag_gui_poll_event(canvas)

pub func should_close(canvas: ptr) -> i32:
  return thag_gui_should_close(canvas)

pub func request_close(canvas: ptr) -> i32:
  return thag_gui_request_close(canvas)

pub func set_target_fps(canvas: ptr, fps: i32) -> i32:
  return thag_gui_set_target_fps(canvas, fps)

pub func tick(canvas: ptr) -> i32:
  return thag_gui_tick(canvas)

pub func run_fixed_timestep(canvas: ptr, fps: i32, steps: i32) -> i32:
  if (fps <= 0):
    return 0
  if (steps <= 0):
    return 0
  thag_gui_set_target_fps(canvas, fps)
  let i = 0
  while (i < steps):
    if (thag_gui_should_close(canvas) != 0):
      return i
    thag_gui_tick(canvas)
    i = i + 1
  return i
