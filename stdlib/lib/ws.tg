# Minimal WebSocket client surface mapped to runtime hooks.

extern func thag_ws_connect(endpoint: ptr, timeout_ms: i32) -> i32
extern func thag_ws_connect_retry(endpoint: ptr, timeout_ms: i32, retries: i32, backoff_ms: i32) -> i32
extern func thag_ws_send(handle: i32, message: ptr) -> i32
extern func thag_ws_close(handle: i32) -> i32

pub func ws_ready() -> i32:
  return 1

pub func ws_connect(endpoint: ptr, timeout_ms: i32) -> i32:
  return thag_ws_connect(endpoint, timeout_ms)

pub func ws_connect_retry(endpoint: ptr, timeout_ms: i32, retries: i32, backoff_ms: i32) -> i32:
  return thag_ws_connect_retry(endpoint, timeout_ms, retries, backoff_ms)

pub func ws_send(handle: i32, message: ptr) -> i32:
  return thag_ws_send(handle, message)

pub func ws_close(handle: i32) -> i32:
  return thag_ws_close(handle)
