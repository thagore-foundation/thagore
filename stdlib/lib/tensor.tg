# Tensor and accelerator helpers mapped to runtime hooks.

extern func thag_cuda_available() -> i32
extern func thag_opencl_available() -> i32
extern func thag_tensor_new_i64(length: i64) -> ptr
extern func thag_tensor_len(handle: ptr) -> i64
extern func thag_tensor_fill_i64(handle: ptr, value: i64) -> i32
extern func thag_tensor_set_i64(handle: ptr, index: i64, value: i64) -> i32
extern func thag_tensor_get_i64(handle: ptr, index: i64) -> i64
extern func thag_tensor_sum_i64(handle: ptr) -> i64
extern func thag_tensor_axpy_i64(out_handle: ptr, x_handle: ptr, y_handle: ptr, alpha: i64) -> i32
extern func thag_pytorch_axpy_i64(out_handle: ptr, x_handle: ptr, y_handle: ptr, alpha: i64) -> i32
extern func thag_tensor_free(handle: ptr) -> void

pub func cuda_available() -> i32:
  return thag_cuda_available()

pub func opencl_available() -> i32:
  return thag_opencl_available()

pub func new_i64(length: i64) -> ptr:
  return thag_tensor_new_i64(length)

pub func len(handle: ptr) -> i64:
  return thag_tensor_len(handle)

pub func fill_i64(handle: ptr, value: i64) -> i32:
  return thag_tensor_fill_i64(handle, value)

pub func set_i64(handle: ptr, index: i64, value: i64) -> i32:
  return thag_tensor_set_i64(handle, index, value)

pub func get_i64(handle: ptr, index: i64) -> i64:
  return thag_tensor_get_i64(handle, index)

pub func sum_i64(handle: ptr) -> i64:
  return thag_tensor_sum_i64(handle)

pub func axpy_i64(out_handle: ptr, x_handle: ptr, y_handle: ptr, alpha: i64) -> i32:
  return thag_tensor_axpy_i64(out_handle, x_handle, y_handle, alpha)

pub func pytorch_axpy_i64(out_handle: ptr, x_handle: ptr, y_handle: ptr, alpha: i64) -> i32:
  return thag_pytorch_axpy_i64(out_handle, x_handle, y_handle, alpha)

pub func free(handle: ptr) -> void:
  thag_tensor_free(handle)
