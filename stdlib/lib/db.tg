# Minimal DB client surface mapped to runtime hooks.

extern func thag_db_connect(dsn: ptr) -> i32
extern func thag_db_query(handle: i32, query: ptr) -> i32
extern func thag_db_close(handle: i32) -> i32

pub func db_ready() -> i32:
  return 1

pub func db_connect(dsn: ptr) -> i32:
  return thag_db_connect(dsn)

pub func db_query(handle: i32, query: ptr) -> i32:
  return thag_db_query(handle, query)

pub func db_close(handle: i32) -> i32:
  return thag_db_close(handle)
