# HTTP client surface mapped to runtime hooks.
# Adds body-capturing helpers while keeping status-only APIs for quick checks.

extern func thag_http_get(url: ptr, timeout_ms: i32) -> i32
extern func thag_http_post(url: ptr, payload: ptr, timeout_ms: i32) -> i32
extern func thag_http_get_retry(url: ptr, timeout_ms: i32, retries: i32, backoff_ms: i32) -> i32
extern func thag_http_post_retry(url: ptr, payload: ptr, timeout_ms: i32, retries: i32, backoff_ms: i32) -> i32
extern func thag_http_get_result(url: ptr, timeout_ms: i32) -> ptr
extern func thag_http_post_result(url: ptr, payload: ptr, timeout_ms: i32) -> ptr
extern func thag_http_result_status(result: ptr) -> i32
extern func thag_http_result_body(result: ptr) -> ptr
extern func thag_http_result_body_len(result: ptr) -> i64
extern func thag_http_result_free(result: ptr) -> void
extern func thag_http_result_is_null(result: ptr) -> i32
extern func thag_map_is_null_ptr(ptr: ptr) -> i32
extern func thag_str_concat(a: ptr, b: ptr) -> ptr
extern func thag_str_free(s: ptr) -> void

pub func http_ready() -> i32:
  return 1

pub func http_get(url: ptr, timeout_ms: i32) -> i32:
  return thag_http_get(url, timeout_ms)

pub func http_post(url: ptr, payload: ptr, timeout_ms: i32) -> i32:
  return thag_http_post(url, payload, timeout_ms)

pub func http_get_retry(url: ptr, timeout_ms: i32, retries: i32, backoff_ms: i32) -> i32:
  return thag_http_get_retry(url, timeout_ms, retries, backoff_ms)

pub func http_post_retry(url: ptr, payload: ptr, timeout_ms: i32, retries: i32, backoff_ms: i32) -> i32:
  return thag_http_post_retry(url, payload, timeout_ms, retries, backoff_ms)

# Body-capturing helpers. Ownership of returned string belongs to caller; free with thag_str_free.

pub func http_get_body(url: ptr, timeout_ms: i32) -> (i32, ptr):
  let res: ptr = thag_http_get_result(url, timeout_ms)
  if (thag_http_result_is_null(res) == 1):
    return (0, null)
  let status: i32 = thag_http_result_status(res)
  let body_raw: ptr = thag_http_result_body(res)
  let body: ptr = thag_str_concat(body_raw, "")  # copy to caller-owned buffer
  thag_http_result_free(res)
  return (status, body)

pub func http_post_body(url: ptr, payload: ptr, timeout_ms: i32) -> (i32, ptr):
  let res: ptr = thag_http_post_result(url, payload, timeout_ms)
  if (thag_http_result_is_null(res) == 1):
    return (0, null)
  let status: i32 = thag_http_result_status(res)
  let body_raw: ptr = thag_http_result_body(res)
  let body: ptr = thag_str_concat(body_raw, "")
  thag_http_result_free(res)
  return (status, body)
