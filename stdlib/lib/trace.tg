# Distributed tracing hooks for request and task-level visibility.

extern func thag_task_trace_set_enabled(enabled: i32) -> void
extern func thag_task_trace_enabled() -> i32
extern func thag_trace_span_begin(name: ptr) -> i64
extern func thag_trace_span_end(span_id: i64) -> void
extern func thag_trace_event(message: ptr) -> void

pub func enable() -> void:
  thag_task_trace_set_enabled(1)

pub func disable() -> void:
  thag_task_trace_set_enabled(0)

pub func is_enabled() -> i32:
  return thag_task_trace_enabled()

pub func span_begin(name: ptr) -> i64:
  return thag_trace_span_begin(name)

pub func span_end(span_id: i64) -> void:
  thag_trace_span_end(span_id)

pub func event(message: ptr) -> void:
  thag_trace_event(message)
