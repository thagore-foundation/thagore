# JSON helpers mapped to runtime hooks.

extern func thag_json_parse(content: ptr) -> ptr
extern func thag_json_get_str(handle: ptr, key: ptr) -> ptr
extern func thag_json_get_int(handle: ptr, key: ptr) -> i64
extern func thag_json_set_str(handle: ptr, key: ptr, value: ptr) -> i32
extern func thag_json_set_int(handle: ptr, key: ptr, value: i64) -> i32
extern func thag_json_stringify(handle: ptr) -> ptr
extern func thag_json_free(handle: ptr) -> void

pub func parse(content: ptr) -> ptr:
  return thag_json_parse(content)

pub func get_str(handle: ptr, key: ptr) -> ptr:
  return thag_json_get_str(handle, key)

pub func get_int(handle: ptr, key: ptr) -> i64:
  return thag_json_get_int(handle, key)

pub func set_str(handle: ptr, key: ptr, value: ptr) -> i32:
  return thag_json_set_str(handle, key, value)

pub func set_int(handle: ptr, key: ptr, value: i64) -> i32:
  return thag_json_set_int(handle, key, value)

pub func stringify(handle: ptr) -> ptr:
  return thag_json_stringify(handle)

pub func free(handle: ptr) -> void:
  thag_json_free(handle)
