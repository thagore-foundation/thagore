# SQL builder + migration helpers mapped to runtime hooks.

extern func thag_sql_builder_new() -> i32
extern func thag_sql_builder_select(handle: i32, fields: ptr) -> i32
extern func thag_sql_builder_from(handle: i32, table: ptr) -> i32
extern func thag_sql_builder_where(handle: i32, predicate: ptr) -> i32
extern func thag_sql_builder_order_by(handle: i32, order_by: ptr) -> i32
extern func thag_sql_builder_limit(handle: i32, limit: i64) -> i32
extern func thag_sql_builder_build(handle: i32) -> ptr
extern func thag_sql_builder_reset(handle: i32) -> i32
extern func thag_sql_builder_free(handle: i32) -> i32
extern func thag_sql_migrate_apply(db_handle: i32, migration_name: ptr, sql: ptr) -> i32

pub func builder() -> i32:
  return thag_sql_builder_new()

pub func select(handle: i32, fields: ptr) -> i32:
  return thag_sql_builder_select(handle, fields)

pub func from(handle: i32, table: ptr) -> i32:
  return thag_sql_builder_from(handle, table)

pub func where(handle: i32, predicate: ptr) -> i32:
  return thag_sql_builder_where(handle, predicate)

pub func order_by(handle: i32, clause: ptr) -> i32:
  return thag_sql_builder_order_by(handle, clause)

pub func limit(handle: i32, n: i64) -> i32:
  return thag_sql_builder_limit(handle, n)

pub func build(handle: i32) -> ptr:
  return thag_sql_builder_build(handle)

pub func reset(handle: i32) -> i32:
  return thag_sql_builder_reset(handle)

pub func builder_free(handle: i32) -> i32:
  return thag_sql_builder_free(handle)

pub func migrate_apply(db_handle: i32, migration_name: ptr, sql: ptr) -> i32:
  return thag_sql_migrate_apply(db_handle, migration_name, sql)
