import "src/backend/llvm/emitter.tg" as em

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func main() -> i32:
    let fails = 0
    let src = "func main() -> i32:\n    let x = 1\n    return x\n"

    let ir1 = em.emit_program_from_source(src, "contract_mod")
    fails = fails + _expect_i32("emit from source has @main", _contains(ir1, "define i32 @main("), 1)
    fails = fails + _expect_i32("emit from source has ret i32", _contains(ir1, "ret i32"), 1)
    fails = fails + _expect_i32("emit from source no __NL__ marker", _contains(ir1, "__NL__"), 0)

    let ir2 = em.emit_program_typed(src, "contract_mod_typed")
    fails = fails + _expect_i32("emit typed has @main", _contains(ir2, "define i32 @main("), 1)
    fails = fails + _expect_i32("emit typed has ret i32", _contains(ir2, "ret i32"), 1)
    fails = fails + _expect_i32("emit typed no __NL__ marker", _contains(ir2, "__NL__"), 0)

    let src_if = "func main() -> i32:\n    let n = 3\n    if (n < 5):\n        return n\n    return 0\n"
    let ir_if = em.emit_program_from_source(src_if, "contract_if")
    fails = fails + _expect_i32("emit if has compare", _contains(ir_if, "icmp"), 1)
    fails = fails + _expect_i32("emit if has branch", _contains(ir_if, "br i1"), 1)
    let src_if_ne = "func main() -> i32:\n    let n = 3\n    if (n != 5):\n        return n\n    return 0\n"
    let ir_if_ne = em.emit_program_from_source(src_if_ne, "contract_if_ne")
    fails = fails + _expect_i32("emit if != uses icmp ne", _contains(ir_if_ne, "icmp ne"), 1)
    let src_if_and = "func main() -> i32:\n    let n = 3\n    if (n > 0 and n < 5):\n        return n\n    return 0\n"
    let ir_if_and = em.emit_program_from_source(src_if_and, "contract_if_and")
    fails = fails + _expect_i32("emit if and uses and i1", _contains(ir_if_and, " = and i1 "), 1)
    let src_if_or = "func main() -> i32:\n    let n = 3\n    if (n == 0 or n == 3):\n        return n\n    return 0\n"
    let ir_if_or = em.emit_program_from_source(src_if_or, "contract_if_or")
    fails = fails + _expect_i32("emit if or uses or i1", _contains(ir_if_or, " = or i1 "), 1)

    let src_while = "func main() -> i32:\n    let i = 0\n    while (i < 2):\n        return i\n    return 0\n"
    let ir_while = em.emit_program_from_source(src_while, "contract_while")
    fails = fails + _expect_i32("emit while has compare", _contains(ir_while, "icmp"), 1)
    fails = fails + _expect_i32("emit while has branch", _contains(ir_while, "br i1"), 1)
    let src_while_le = "func main() -> i32:\n    let i = 0\n    while (i <= 2):\n        return i\n    return 0\n"
    let ir_while_le = em.emit_program_from_source(src_while_le, "contract_while_le")
    fails = fails + _expect_i32("emit while <= uses icmp sle", _contains(ir_while_le, "icmp sle"), 1)
    let src_while_and = "func main() -> i32:\n    let i = 0\n    while (i >= 0 and i <= 2):\n        return i\n    return 0\n"
    let ir_while_and = em.emit_program_from_source(src_while_and, "contract_while_and")
    fails = fails + _expect_i32("emit while and uses and i1", _contains(ir_while_and, " = and i1 "), 1)

    if (fails == 0):
        print("PASS: codegen native contracts")
        return 0
    print("TOTAL FAILS:")
    print(fails)
    return 1
