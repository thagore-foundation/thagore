import "src/v0/ir/module.tg"
import "src/v0/ir/builder.tg"
import "src/v0/ir/verify.tg"

func main() -> i32:
    let m0 = v0_ir_module_new()
    let m1 = v0_ir_add_function(m0, "main", "i32")
    let m2 = v0_ir_add_block(m1, "main", "entry")
    let m3 = v0_ir_add_instr(m2, "main", "entry", "ret", "0", "", "i32")
    let mv = v0_ir_verify(m3)
    if (mv.error_count > 0):
        return 1
    return 0
