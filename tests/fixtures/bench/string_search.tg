func byte_at(i: i32) -> i32:
  return ((i * 131) + 17) % 26

func main() -> i32:
  let i: i32 = 0
  let count: i32 = 0
  while (i < 10000000):
    let a: i32 = byte_at(i)
    let b: i32 = byte_at(i + 1)
    let c: i32 = byte_at(i + 2)
    let d: i32 = byte_at(i + 3)
    if ((a == 19) and (b == 7) and (c == 0) and (d == 6)):
      count = count + 1
    i = i + 1
  return count % 251
