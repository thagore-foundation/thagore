# fixture: control/early_return
# expect: ok
# description: returns early from the middle of a function body
func classify(value: i32) -> i32:
  if (value < 0):
    return 1
  let adjusted: i32 = value + 1
  if (adjusted > 10):
    return 2
  return 0

func main() -> i32:
  if ((classify(-3) == 1) and (classify(10) == 2) and (classify(3) == 0)):
    return 0
  else:
    return 1
