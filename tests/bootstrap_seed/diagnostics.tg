import std.string as string

func append_issue(out: str, issue: str) -> str:
  if (string.len(out) == 0):
    return issue
  return string.concat(out, string.concat(" | ", issue))

func summary_field(summary: str, key: str) -> str:
  let marker = string.concat(key, "=")
  let start = string.find(summary, marker)
  if (start < 0):
    return ""
  let value_start = start + string.len(marker)
  let out = ""
  let index: i32 = value_start
  while (index < string.len(summary)):
    let ch = string.char_at(summary, index)
    if (string.str_eq(ch, ";")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

pub func analyze(summary: str, symbols: str) -> str:
  let issues = ""
  let func_name = summary_field(summary, "func")
  let return_ident = summary_field(summary, "return_ident")
  let local_binding = summary_field(summary, "first_local")
  let local_sep = string.find(local_binding, ":")
  let has_local = string.len(local_binding) > 0
  let missing_local_type = string.contains(local_binding, ":=")
  let missing_local_value = string.ends_with(local_binding, "=")

  if (string.len(func_name) == 0):
    issues = append_issue(issues, "missing func")

  if (string.len(return_ident) == 0):
    issues = append_issue(issues, "missing return")

  if (has_local and (local_sep < 0 or missing_local_type or missing_local_value)):
    issues = append_issue(issues, "malformed let")

  if (string.len(symbols) == 0):
    issues = append_issue(issues, "missing symbols")

  if (string.len(issues) == 0):
    return "ok"
  return issues

pub func analyze_with_imports(summary: str, symbols: str, imports: str) -> str:
  let issues = analyze(summary, symbols)
  let missing_imports = summary_field(imports, "missing")
  if (string.len(missing_imports) == 0):
    return issues
  if (string.str_eq(issues, "ok")):
    return "missing import"
  return append_issue(issues, "missing import")

func count_symbol_kind(symbols: str, target_kind: str, target_name: str) -> i32:
  let items = string.split(symbols, " | ")
  let count: i32 = 0
  for item in items:
    if (string.len(item) == 0):
      continue
    let name_sep = string.find(item, ":")
    if (name_sep < 0):
      continue
    let name = ""
    let index: i32 = 0
    while (index < name_sep):
      name = string.concat(name, string.char_at(item, index))
      index = index + 1
    let kind = ""
    index = name_sep + 1
    while (index < string.len(item)):
      kind = string.concat(kind, string.char_at(item, index))
      index = index + 1
    if (string.str_eq(name, target_name) and string.str_eq(kind, target_kind)):
      count = count + 1
  return count

pub func analyze_semantics(summary: str, symbols: str, imports: str) -> str:
  let issues = analyze_with_imports(summary, symbols, imports)
  let local_binding = summary_field(summary, "first_local")
  let local_sep = string.find(local_binding, ":")
  let local_name = ""
  let return_ident = summary_field(summary, "return_ident")

  if (local_sep > 0):
    let index: i32 = 0
    while (index < local_sep):
      local_name = string.concat(local_name, string.char_at(local_binding, index))
      index = index + 1

  if (string.len(return_ident) > 0 and string.len(local_name) > 0 and string.str_eq(return_ident, local_name) == false):
    if (string.str_eq(issues, "ok")):
      issues = "unknown return ident"
    else:
      issues = append_issue(issues, "unknown return ident")

  if (string.len(local_name) > 0 and count_symbol_kind(symbols, "local", local_name) > 1):
    if (string.str_eq(issues, "ok")):
      issues = "duplicate local"
    else:
      issues = append_issue(issues, "duplicate local")

  return issues
