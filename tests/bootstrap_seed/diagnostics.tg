from . import chars
import std.array as array
import std.fs as fs
import std.path as path
import std.string as string

func token_kind(token: str) -> str:
  let out = ""
  let index: i32 = 0
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    if (string.str_eq(ch, "(")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

func token_text(token: str) -> str:
  let start = string.find(token, "(")
  if (start < 0):
    return ""
  let out = ""
  let index: i32 = start + 1
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    let next = string.char_at(token, index + 1)
    if (string.str_eq(ch, ")") and string.str_eq(next, "@")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

func append_issue(out: str, issue: str) -> str:
  if (string.len(out) == 0):
    return issue
  return string.concat(out, string.concat(" | ", issue))

func summary_field(summary: str, key: str) -> str:
  let marker = string.concat(key, "=")
  let start = string.find(summary, marker)
  if (start < 0):
    return ""
  let value_start = start + string.len(marker)
  let out = ""
  let index: i32 = value_start
  while (index < string.len(summary)):
    let ch = string.char_at(summary, index)
    if (string.str_eq(ch, ";")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

pub func analyze(summary: str, symbols: str) -> str:
  let issues = ""
  let func_name = summary_field(summary, "func")
  let return_ident = summary_field(summary, "return_ident")
  let local_binding = summary_field(summary, "first_local")
  let local_sep = string.find(local_binding, ":")
  let has_local = local_sep > 0
  let missing_local_type = string.contains(local_binding, ":=")
  let missing_local_value = string.ends_with(local_binding, "=")

  if (string.len(func_name) == 0):
    issues = append_issue(issues, "missing func")

  if (string.len(return_ident) == 0):
    issues = append_issue(issues, "missing return")

  if (has_local and (local_sep < 0 or missing_local_type or missing_local_value)):
    issues = append_issue(issues, "malformed let")

  if (string.len(symbols) == 0):
    issues = append_issue(issues, "missing symbols")

  if (string.len(issues) == 0):
    return "ok"
  return issues

pub func analyze_with_imports(summary: str, symbols: str, imports: str) -> str:
  let issues = analyze(summary, symbols)
  let missing_imports = summary_field(imports, "missing")
  if (string.len(missing_imports) == 0):
    return issues
  if (string.str_eq(issues, "ok")):
    return "missing import"
  return append_issue(issues, "missing import")

func count_symbol_kind(symbols: str, target_kind: str, target_name: str) -> i32:
  let items = string.split(symbols, " | ")
  let count: i32 = 0
  for item in items:
    if (string.len(item) == 0):
      continue
    let name_sep = string.find(item, ":")
    if (name_sep < 0):
      continue
    let name = ""
    let index: i32 = 0
    while (index < name_sep):
      name = string.concat(name, string.char_at(item, index))
      index = index + 1
    let kind = ""
    index = name_sep + 1
    while (index < string.len(item)):
      kind = string.concat(kind, string.char_at(item, index))
      index = index + 1
    if (string.str_eq(name, target_name) and string.str_eq(kind, target_kind)):
      count = count + 1
  return count

func symbols_have_kind(symbols: str, target_kind: str, target_name: str) -> bool:
  return count_symbol_kind(symbols, target_kind, target_name) > 0

func any_local_shadows_import(symbols: str, source: str) -> bool:
  let items = string.split(symbols, " | ")
  let index: i32 = 0
  while (index < array.len(items)):
    let item = array.get(items, index)
    let name_sep = string.find(item, ":")
    if (name_sep < 0):
      index = index + 1
      continue
    let name = ""
    let cursor: i32 = 0
    while (cursor < name_sep):
      name = string.concat(name, string.char_at(item, cursor))
      cursor = cursor + 1
    let kind = ""
    let kind_cursor: i32 = name_sep + 1
    while (kind_cursor < string.len(item)):
      kind = string.concat(kind, string.char_at(item, kind_cursor))
      kind_cursor = kind_cursor + 1
    if (string.str_eq(kind, "local") and source_imports_name(source, name)):
      return true
    index = index + 1
  return false

func is_decimal_text(text: str) -> bool:
  if (string.len(text) == 0):
    return false
  let index: i32 = 0
  while (index < string.len(text)):
    if (chars.is_digit(string.char_at(text, index)) == false):
      return false
    index = index + 1
  return true

func is_bool_literal(text: str) -> bool:
  return string.str_eq(text, "true") or string.str_eq(text, "false")

func literal_type_name(text: str) -> str:
  if (is_decimal_text(text)):
    return "i32"
  if (is_bool_literal(text)):
    return "bool"
  return ""

func has_duplicate_items(items_text: str) -> bool:
  let items = string.split(items_text, " | ")
  let index: i32 = 0
  while (index < array.len(items)):
    let current = array.get(items, index)
    if (string.len(current) == 0):
      index = index + 1
      continue
    let seen: i32 = 0
    let inner: i32 = 0
    while (inner < array.len(items)):
      let candidate = array.get(items, inner)
      if (string.str_eq(current, candidate)):
        seen = seen + 1
      inner = inner + 1
    if (seen > 1):
      return true
    index = index + 1
  return false

func is_module_char(ch: str) -> bool:
  return chars.is_ident_continue(ch) or string.str_eq(ch, ".")

func matches_from_at(source: str, index: i32) -> bool:
  return string.str_eq(string.char_at(source, index), "f") and string.str_eq(string.char_at(source, index + 1), "r") and string.str_eq(string.char_at(source, index + 2), "o") and string.str_eq(string.char_at(source, index + 3), "m") and chars.is_space(string.char_at(source, index + 4))

func matches_import_at(source: str, index: i32) -> bool:
  return string.str_eq(string.char_at(source, index), "i") and string.str_eq(string.char_at(source, index + 1), "m") and string.str_eq(string.char_at(source, index + 2), "p") and string.str_eq(string.char_at(source, index + 3), "o") and string.str_eq(string.char_at(source, index + 4), "r") and string.str_eq(string.char_at(source, index + 5), "t") and chars.is_space(string.char_at(source, index + 6))

func read_module_name(source: str, index: i32) -> str:
  let name = ""
  while (is_module_char(string.char_at(source, index))):
    name = string.concat(name, string.char_at(source, index))
    index = index + 1
  return name

func module_to_path(module_name: str) -> str:
  let slashed = string.replace(module_name, ".", "/")
  return string.concat(slashed, ".tg")

func module_defines_func(module_source: str, func_name: str) -> bool:
  let pattern = string.concat("func ", string.concat(func_name, "("))
  return string.contains(module_source, pattern)

func source_imports_symbol(source: str, target_name: str) -> bool:
  let index: i32 = 0
  while (index < string.len(source)):
    if (matches_from_at(source, index) == false):
      index = index + 1
      continue

    index = index + 5
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let from_name = read_module_name(source, index)
    index = index + string.len(from_name)
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    if (matches_import_at(source, index) == false):
      continue

    index = index + 7
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let import_name = read_module_name(source, index)
    index = index + string.len(import_name)

    if (string.str_eq(import_name, target_name)):
      return true
  return false

func has_duplicate_from_import_symbols(source: str) -> bool:
  let names = ""
  let index: i32 = 0
  while (index < string.len(source)):
    if (matches_from_at(source, index) == false):
      index = index + 1
      continue

    index = index + 5
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let from_name = read_module_name(source, index)
    index = index + string.len(from_name)
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    if (matches_import_at(source, index) == false):
      continue

    index = index + 7
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let import_name = read_module_name(source, index)
    index = index + string.len(import_name)
    if (string.len(import_name) == 0):
      continue

    let count: i32 = 0
    let items = string.split(names, " | ")
    let inner: i32 = 0
    while (inner < array.len(items)):
      if (string.str_eq(array.get(items, inner), import_name)):
        count = count + 1
      inner = inner + 1
    if (count > 0):
      return true
    names = append_issue(names, import_name)
  return false

func source_imports_name(source: str, target_name: str) -> bool:
  let index: i32 = 0
  while (index < string.len(source)):
    if (matches_from_at(source, index) == false):
      index = index + 1
      continue

    index = index + 5
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let from_name = read_module_name(source, index)
    index = index + string.len(from_name)
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    if (matches_import_at(source, index) == false):
      continue

    index = index + 7
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let import_name = read_module_name(source, index)
    index = index + string.len(import_name)
    if (string.str_eq(import_name, target_name)):
      return true
  return false

func source_has_duplicate_import_aliases(source: str) -> bool:
  let aliases = ""
  let index: i32 = 0
  while (index < string.len(source)):
    if (matches_import_at(source, index) == false):
      index = index + 1
      continue

    index = index + 7
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let module_name = read_module_name(source, index)
    index = index + string.len(module_name)
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    if (string.str_eq(string.char_at(source, index), "a") == false or string.str_eq(string.char_at(source, index + 1), "s") == false or chars.is_space(string.char_at(source, index + 2)) == false):
      continue

    index = index + 3
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let alias_name = read_module_name(source, index)
    index = index + string.len(alias_name)
    if (string.len(alias_name) == 0):
      continue

    let count: i32 = 0
    let items = string.split(aliases, " | ")
    let inner: i32 = 0
    while (inner < array.len(items)):
      if (string.str_eq(array.get(items, inner), alias_name)):
        count = count + 1
      inner = inner + 1
    if (count > 0):
      return true
    aliases = append_issue(aliases, alias_name)
  return false

func source_has_local_shadowing_import_alias(symbols: str, source: str) -> bool:
  let items = string.split(symbols, " | ")
  let index: i32 = 0
  while (index < array.len(items)):
    let item = array.get(items, index)
    let name_sep = string.find(item, ":")
    if (name_sep < 0):
      index = index + 1
      continue
    let name = ""
    let cursor: i32 = 0
    while (cursor < name_sep):
      name = string.concat(name, string.char_at(item, cursor))
      cursor = cursor + 1
    let kind = ""
    let kind_cursor: i32 = name_sep + 1
    while (kind_cursor < string.len(item)):
      kind = string.concat(kind, string.char_at(item, kind_cursor))
      kind_cursor = kind_cursor + 1
    if (string.str_eq(kind, "local") and source_imports_alias(source, name)):
      return true
    index = index + 1
  return false

func source_imports_alias(source: str, target_name: str) -> bool:
  let index: i32 = 0
  while (index < string.len(source)):
    if (matches_import_at(source, index) == false):
      index = index + 1
      continue

    index = index + 7
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let module_name = read_module_name(source, index)
    index = index + string.len(module_name)
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    if (string.str_eq(string.char_at(source, index), "a") == false or string.str_eq(string.char_at(source, index + 1), "s") == false or chars.is_space(string.char_at(source, index + 2)) == false):
      continue

    index = index + 3
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let alias_name = read_module_name(source, index)
    index = index + string.len(alias_name)
    if (string.str_eq(alias_name, target_name)):
      return true
  return false

func source_has_func_shadowing_import_alias(source: str) -> bool:
  let index: i32 = 0
  while (index < string.len(source)):
    if (string.str_eq(string.char_at(source, index), "f") == false):
      index = index + 1
      continue

    if (string.str_eq(string.char_at(source, index + 1), "u") and string.str_eq(string.char_at(source, index + 2), "n") and string.str_eq(string.char_at(source, index + 3), "c") and chars.is_space(string.char_at(source, index + 4))):
      index = index + 5
      while (chars.is_space(string.char_at(source, index))):
        index = index + 1
      let func_name = read_module_name(source, index)
      index = index + string.len(func_name)
      if (string.len(func_name) > 0 and string.str_eq(func_name, "main") == false and source_imports_alias(source, func_name)):
        return true
      continue

    index = index + 1
  return false

func source_has_func_shadowing_import(source: str) -> bool:
  let index: i32 = 0
  while (index < string.len(source)):
    if (string.str_eq(string.char_at(source, index), "f") == false):
      index = index + 1
      continue

    if (string.str_eq(string.char_at(source, index + 1), "u") and string.str_eq(string.char_at(source, index + 2), "n") and string.str_eq(string.char_at(source, index + 3), "c") and chars.is_space(string.char_at(source, index + 4))):
      index = index + 5
      while (chars.is_space(string.char_at(source, index))):
        index = index + 1
      let func_name = read_module_name(source, index)
      index = index + string.len(func_name)
      if (string.len(func_name) > 0 and string.str_eq(func_name, "main") == false and source_imports_name(source, func_name)):
        return true
      continue

    index = index + 1
  return false

func analyze_imported_symbols(base_dir: str, source: str) -> str:
  let issues = ""
  let index: i32 = 0

  while (index < string.len(source)):
    if (matches_from_at(source, index) == false):
      index = index + 1
      continue

    index = index + 5
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let from_name = read_module_name(source, index)
    index = index + string.len(from_name)
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    if (matches_import_at(source, index) == false):
      continue

    index = index + 7
    while (chars.is_space(string.char_at(source, index))):
      index = index + 1

    let import_name = read_module_name(source, index)
    index = index + string.len(import_name)

    let combined = ""
    if (string.str_eq(from_name, ".")):
      combined = import_name
    else:
      if (string.len(from_name) > 0 and string.len(import_name) > 0):
        combined = string.concat(string.concat(from_name, "."), import_name)
      else:
        combined = import_name

    if (string.len(combined) == 0):
      continue

    let module_file = module_to_path(combined)
    let module_path = path.join(base_dir, module_file)
    if (fs.exists(module_path) == false):
      continue

    let module_source = fs.read(module_path)
    if (module_defines_func(module_source, import_name) == false):
      issues = append_issue(issues, "unknown imported symbol")

  if (string.len(issues) == 0):
    return "ok"
  return issues

func first_call_ident(report: str) -> str:
  let tokens = string.split(report, " | ")
  let index: i32 = 0

  while (index < array.len(tokens)):
    let current = array.get(tokens, index)
    let kind = token_kind(current)
    let text = token_text(current)

    if (string.str_eq(kind, "kw") and string.str_eq(text, "func")):
      index = index + 6
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "let")):
      if ((index + 5) < array.len(tokens)):
        index = index + 6
      else:
        index = index + 2
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "return")):
      index = index + 2
      continue

    if (string.str_eq(kind, "ident") and (index + 1) < array.len(tokens)):
      let next_text = token_text(array.get(tokens, index + 1))
      if (string.str_eq(next_text, "(")):
        return text

    index = index + 1

  return ""

func first_call_arg_count(report: str) -> i32:
  let tokens = string.split(report, " | ")
  let index: i32 = 0

  while (index < array.len(tokens)):
    let current = array.get(tokens, index)
    let kind = token_kind(current)
    let text = token_text(current)

    if (string.str_eq(kind, "kw") and string.str_eq(text, "func")):
      index = index + 6
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "let")):
      if ((index + 5) < array.len(tokens)):
        index = index + 6
      else:
        index = index + 2
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "return")):
      index = index + 2
      continue

    if (string.str_eq(kind, "ident") and (index + 2) < array.len(tokens)):
      let open = token_text(array.get(tokens, index + 1))
      if (string.str_eq(open, "(") == false):
        index = index + 1
        continue

      let next = token_text(array.get(tokens, index + 2))
      if (string.str_eq(next, ")")):
        return 0
      return 1

    index = index + 1

  return -1

func source_declares_func_name(source: str, target_name: str) -> bool:
  let index: i32 = 0
  while (index < string.len(source)):
    if (string.str_eq(string.char_at(source, index), "f") == false):
      index = index + 1
      continue

    if (string.str_eq(string.char_at(source, index + 1), "u") and string.str_eq(string.char_at(source, index + 2), "n") and string.str_eq(string.char_at(source, index + 3), "c") and chars.is_space(string.char_at(source, index + 4))):
      index = index + 5
      while (chars.is_space(string.char_at(source, index))):
        index = index + 1
      let func_name = read_module_name(source, index)
      index = index + string.len(func_name)
      if (string.str_eq(func_name, target_name)):
        return true
      continue

    index = index + 1
  return false

pub func analyze_semantics(summary: str, symbols: str, imports: str, base_dir: str, source: str, report: str) -> str:
  let issues = analyze_with_imports(summary, symbols, imports)
  let func_name = summary_field(summary, "func")
  let local_binding = summary_field(summary, "first_local")
  let local_sep = string.find(local_binding, ":")
  let local_eq = string.find(local_binding, "=")
  let local_name = ""
  let local_type_name = ""
  let local_value = ""
  let return_ident = summary_field(summary, "return_ident")
  let call_ident = first_call_ident(report)
  let call_arg_count = first_call_arg_count(report)
  let resolved_imports = summary_field(imports, "resolved")
  let missing_imports = summary_field(imports, "missing")

  if (local_sep > 0):
    let index: i32 = 0
    while (index < local_sep):
      local_name = string.concat(local_name, string.char_at(local_binding, index))
      index = index + 1
    index = local_sep + 1
    while (index < local_eq):
      local_type_name = string.concat(local_type_name, string.char_at(local_binding, index))
      index = index + 1
    index = local_eq + 1
    while (index < string.len(local_binding)):
      local_value = string.concat(local_value, string.char_at(local_binding, index))
      index = index + 1

  let return_type = summary_field(summary, "return")
  let return_literal_type = literal_type_name(return_ident)
  let local_literal_type = literal_type_name(local_value)

  if (string.len(local_literal_type) > 0 and string.len(local_type_name) > 0 and string.str_eq(local_literal_type, local_type_name) == false):
    if (string.str_eq(issues, "ok")):
      issues = "local type mismatch"
    else:
      issues = append_issue(issues, "local type mismatch")

  if (string.len(return_literal_type) > 0 and string.len(return_type) > 0 and string.str_eq(return_literal_type, return_type) == false):
    if (string.str_eq(issues, "ok")):
      issues = "return type mismatch"
    else:
      issues = append_issue(issues, "return type mismatch")

  if (string.len(return_ident) > 0 and string.len(return_literal_type) == 0 and symbols_have_kind(symbols, "local", return_ident) == false and symbols_have_kind(symbols, "func", return_ident) == false and source_imports_symbol(source, return_ident) == false):
    if (string.str_eq(issues, "ok")):
      issues = "unknown return ident"
    else:
      issues = append_issue(issues, "unknown return ident")

  if (string.len(local_name) > 0 and count_symbol_kind(symbols, "local", local_name) > 1):
    if (string.str_eq(issues, "ok")):
      issues = "duplicate local"
    else:
      issues = append_issue(issues, "duplicate local")

  if (string.len(func_name) > 0 and count_symbol_kind(symbols, "func", "main") == 0):
    if (string.str_eq(issues, "ok")):
      issues = "missing main"
    else:
      issues = append_issue(issues, "missing main")

  if (string.len(func_name) > 0 and count_symbol_kind(symbols, "func", func_name) > 1):
    if (string.str_eq(issues, "ok")):
      issues = "duplicate func"
    else:
      issues = append_issue(issues, "duplicate func")

  if (has_duplicate_items(resolved_imports) or has_duplicate_items(missing_imports)):
    if (string.str_eq(issues, "ok")):
      issues = "duplicate import"
    else:
      issues = append_issue(issues, "duplicate import")

  if (source_has_duplicate_import_aliases(source)):
    if (string.str_eq(issues, "ok")):
      issues = "duplicate import alias"
    else:
      issues = append_issue(issues, "duplicate import alias")

  if (has_duplicate_from_import_symbols(source)):
    if (string.str_eq(issues, "ok")):
      issues = "duplicate imported symbol"
    else:
      issues = append_issue(issues, "duplicate imported symbol")

  if (any_local_shadows_import(symbols, source)):
    if (string.str_eq(issues, "ok")):
      issues = "local shadows import"
    else:
      issues = append_issue(issues, "local shadows import")

  if (source_has_func_shadowing_import(source)):
    if (string.str_eq(issues, "ok")):
      issues = "func shadows import"
    else:
      issues = append_issue(issues, "func shadows import")

  if (source_has_local_shadowing_import_alias(symbols, source)):
    if (string.str_eq(issues, "ok")):
      issues = "local shadows import alias"
    else:
      issues = append_issue(issues, "local shadows import alias")

  if (source_has_func_shadowing_import_alias(source)):
    if (string.str_eq(issues, "ok")):
      issues = "func shadows import alias"
    else:
      issues = append_issue(issues, "func shadows import alias")

  if (string.len(call_ident) > 0 and count_symbol_kind(symbols, "func", call_ident) == 0 and source_imports_symbol(source, call_ident) == false):
    if (string.str_eq(issues, "ok")):
      issues = "unknown callee"
    else:
      issues = append_issue(issues, "unknown callee")

  if (string.len(call_ident) > 0 and call_arg_count > 0 and (source_declares_func_name(source, call_ident) or source_imports_name(source, call_ident))):
    if (string.str_eq(issues, "ok")):
      issues = "call arity mismatch"
    else:
      issues = append_issue(issues, "call arity mismatch")

  let import_issues = analyze_imported_symbols(base_dir, source)
  if (string.str_eq(import_issues, "ok")):
    return issues
  if (string.str_eq(issues, "ok")):
    return import_issues
  return append_issue(issues, import_issues)

  return issues
