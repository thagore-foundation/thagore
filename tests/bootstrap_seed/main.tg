from . import lexer
from . import parser
from . import symbols
from . import diagnostics
import std.fs as fs
import std.process as process
import std.string as string

func input_path() -> str:
  let arg = process.argv(1)
  if (string.len(arg) > 0):
    return arg
  return "tests/bootstrap_seed/sample.tg"

pub func main() -> i32:
  let path = input_path()
  let source = fs.read(path)
  if (string.len(source) == 0):
    return 1
  let normalized_crlf = string.replace(source, "\r\n", "\n")
  let normalized = string.replace(normalized_crlf, "\r", "\n")
  let report = lexer.scan(normalized)
  let summary = parser.summary(report)
  let table = symbols.collect(report)
  let left = string.concat("tokens=", report)
  let with_summary = string.concat(left, string.concat(" || summary=", summary))
  let with_symbols = string.concat(with_summary, string.concat(" || symbols=", table))
  let issues = diagnostics.analyze(summary, table)
  println(string.concat(with_symbols, string.concat(" || diagnostics=", issues)))
  return 0
