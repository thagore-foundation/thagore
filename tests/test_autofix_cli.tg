import "lib/fs.tg" as fs
import "src/cli/autofix.tg" as autofix

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __string_from_codepoint(cp: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func _expect_contains(label: String, text: String, needle: String) -> i32:
    if (_contains(text, needle) == 1):
        return 0
    print("FAIL: " + label)
    print("missing: " + needle)
    return 1

func _expect_not_contains(label: String, text: String, needle: String) -> i32:
    if (_contains(text, needle) == 0):
        return 0
    print("FAIL: " + label)
    print("unexpected: " + needle)
    return 1

func _expect_text_eq(label: String, got: String, want: String) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    return 1

func main() -> i32:
    let fails = 0
    let nl = __string_from_codepoint(10)
    let dq = __string_from_codepoint(34)

    fails = fails + _expect_i32("normalize off", _contains(autofix.normalize_mode("off"), "off"), 1)
    fails = fails + _expect_i32("normalize safe", _contains(autofix.normalize_mode("safe"), "safe"), 1)
    fails = fails + _expect_i32("normalize aggressive", _contains(autofix.normalize_mode("aggressive"), "aggressive"), 1)
    fails = fails + _expect_i32("normalize unknown -> off", _contains(autofix.normalize_mode("weird"), "off"), 1)

    let missing_path = "tests/__autofix_missing_case.tg"
    fails = fails + _expect_i32("dry-run missing file", autofix.run_fix_dry_run(missing_path, "safe", "", 0), 1)

    let sample_path = "tests/__autofix_tmp_case.tg"
    let src0 = "func main()" + nl + "    return 1" + nl
    fails = fails + _expect_i32("write sample", fs.write_text(sample_path, src0), 1)

    fails = fails + _expect_i32("apply safe", autofix.run_fix_apply(sample_path, "safe", "", 0), 0)
    let after_safe = fs.read_text(sample_path)
    fails = fails + _expect_contains("safe adds colon", after_safe, "func main():")
    fails = fails + _expect_not_contains("safe no return infer", after_safe, "-> i32:")
    let safe_session = autofix.latest_session_id()
    fails = fails + _expect_contains("safe session available", safe_session, "-a1")
    let safe_session_path = ".thagore/fix/sessions/" + safe_session + ".json"
    fails = fails + _expect_i32("safe session file exists", fs.exists(safe_session_path), 1)
    let safe_session_text = fs.read_text(safe_session_path)
    fails = fails + _expect_contains("safe session has summary", safe_session_text, dq + "summary" + dq)
    fails = fails + _expect_contains("safe session has file_patches", safe_session_text, dq + "file_patches" + dq)
    fails = fails + _expect_contains("safe session has failure object", safe_session_text, dq + "failure" + dq)
    fails = fails + _expect_contains("safe session has rebuild outcome", safe_session_text, dq + "rebuild_outcome" + dq)
    fails = fails + _expect_contains("safe session risk metadata", safe_session_text, dq + "aggressive_review_required" + dq + ":false")
    fails = fails + _expect_i32("rollback safe session", autofix.run_fix_rollback(safe_session), 0)
    let after_rollback = fs.read_text(sample_path)
    fails = fails + _expect_contains("rollback restores original", after_rollback, "func main()")
    fails = fails + _expect_not_contains("rollback removes colon", after_rollback, "func main():")

    let src1 = "func main():" + nl + "    return 1" + nl
    fails = fails + _expect_i32("rewrite sample for aggressive", fs.write_text(sample_path, src1), 1)
    fails = fails + _expect_i32("apply aggressive", autofix.run_fix_apply(sample_path, "aggressive", "", 0), 0)
    let after_aggressive = fs.read_text(sample_path)
    fails = fails + _expect_contains("aggressive infers return", after_aggressive, "func main() -> i32:")
    let last_applied_report = autofix.latest_applied_report_path()
    fails = fails + _expect_contains("latest applied report available", last_applied_report, ".json")
    fails = fails + _expect_contains("latest applied report path", last_applied_report, ".thagore/fix/reports/")
    let aggressive_report_text = fs.read_text(last_applied_report)
    fails = fails + _expect_contains("aggressive report metadata", aggressive_report_text, dq + "aggressive_review_required" + dq + ":true")

    let src_rules = "pub pub fn main()   " + nl + "    return 1    " + nl
    fails = fails + _expect_i32("rewrite sample for safe rule pack", fs.write_text(sample_path, src_rules), 1)
    fails = fails + _expect_i32("apply safe with new rules", autofix.run_fix_apply(sample_path, "safe", "", 0), 0)
    let after_rules = fs.read_text(sample_path)
    fails = fails + _expect_contains("safe normalizes fn keyword", after_rules, "func main():")
    fails = fails + _expect_not_contains("safe removes deprecated fn", after_rules, "fn main")
    fails = fails + _expect_not_contains("safe removes duplicate pub", after_rules, "pub pub")
    fails = fails + _expect_not_contains("safe trims trailing ws", after_rules, "return 1    ")
    fails = fails + _expect_contains("safe keeps single pub", after_rules, "pub func main():")

    fails = fails + _expect_i32("idempotent apply safe", autofix.run_fix_apply(sample_path, "safe", "", 0), 0)
    let after_rules_second = fs.read_text(sample_path)
    fails = fails + _expect_text_eq("idempotent source stable", after_rules_second, after_rules)
    let safe_rules_report = autofix.latest_applied_report_path()
    let safe_rules_report_text = fs.read_text(safe_rules_report)
    fails = fails + _expect_contains("report has diff_unified", safe_rules_report_text, dq + "diff_unified" + dq)
    fails = fails + _expect_contains("report has fix_id", safe_rules_report_text, dq + "fix_id" + dq + ":" + dq + "AFX-")

    let src_no_nl = "fn eof()"
    fails = fails + _expect_i32("rewrite sample no final newline", fs.write_text(sample_path, src_no_nl), 1)
    fails = fails + _expect_i32("apply safe final newline", autofix.run_fix_apply(sample_path, "safe", "", 0), 0)
    let after_no_nl = fs.read_text(sample_path)
    fails = fails + _expect_contains("safe final newline case normalized func", after_no_nl, "func eof():")
    fails = fails + _expect_not_contains("safe final newline removes deprecated fn", after_no_nl, "fn eof()")
    let final_nl_report = autofix.latest_applied_report_path()
    let final_nl_report_text = fs.read_text(final_nl_report)
    fails = fails + _expect_contains("report has final newline rule", final_nl_report_text, "canonical_newline_final_newline")

    let bad_lock_path = sample_path + "/lock.json"
    let src_bad_lock = "func main()" + nl + "    return 1" + nl
    fails = fails + _expect_i32("rewrite sample for lock-write-fail", fs.write_text(sample_path, src_bad_lock), 1)
    fails = fails + _expect_i32("apply fails when lock path invalid", autofix.run_fix_apply(sample_path, "safe", bad_lock_path, 0), 1)
    let after_bad_lock = fs.read_text(sample_path)
    fails = fails + _expect_contains("lock write fail restores source", after_bad_lock, "func main()")
    fails = fails + _expect_not_contains("lock write fail keeps no colon", after_bad_lock, "func main():")
    let bad_lock_report = autofix.latest_report_path()
    fails = fails + _expect_contains("lock write fail report path", bad_lock_report, ".json")
    let bad_lock_report_text = fs.read_text(bad_lock_report)
    fails = fails + _expect_contains("lock write fail diagnostic", bad_lock_report_text, "AUTOFIX_IO_LOCK_WRITE_FAILED")
    fails = fails + _expect_not_contains("lock write fail report marks unapplied", bad_lock_report_text, dq + "applied" + dq + ":true")

    let lock_path = "tests/__autofix_tmp.lock"
    let lock_json = "{\n  " + dq + "mode" + dq + ": " + dq + "safe" + dq + ",\n  " + dq + "allowed_rules_set" + dq + ": " + dq + ";canonical_whitespace_tabs_to_spaces;" + dq + ",\n  " + dq + "allowed_rules" + dq + ": [" + dq + "canonical_whitespace_tabs_to_spaces" + dq + "]\n}\n"
    fails = fails + _expect_i32("write lock", fs.write_text(lock_path, lock_json), 1)
    let src2 = "func main()" + nl + "    return 1" + nl
    fails = fails + _expect_i32("rewrite sample for lock test", fs.write_text(sample_path, src2), 1)
    fails = fails + _expect_i32("apply lock strict blocked", autofix.run_fix_apply(sample_path, "safe", lock_path, 1), 1)
    let after_lock = fs.read_text(sample_path)
    fails = fails + _expect_contains("lock strict keeps source", after_lock, "func main()")
    fails = fails + _expect_not_contains("lock strict blocks colon fix", after_lock, "func main():")

    fails = fails + _expect_i32("lock strict requires lock path", autofix.run_fix_apply(sample_path, "safe", "", 1), 1)
    fails = fails + _expect_i32("protected path denied", autofix.run_fix_dry_run(".github/workflows/ci.tg", "safe", "", 0), 1)

    if (fails == 0):
        print("PASS: autofix cli")
        return 0
    print("TOTAL FAILS:")
    print(fails)
    return 1
