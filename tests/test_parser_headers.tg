import "src/frontend/parser/headers.tg" as ph

func _expect_str(label: String, got: String, want: String) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print("  got : " + got)
    print("  want: " + want)
    return 1

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func main() -> i32:
    let fails = 0

    fails = fails + _expect_str("func name simple", ph.parse_func_name("func main() -> i32:"), "main")
    fails = fails + _expect_str("func name generic", ph.parse_func_name("func sum[T: Add, U](a: T, b: U) -> T:"), "sum")
    fails = fails + _expect_str("func generic clause", ph.parse_func_generic_clause("func sum[T: Add, U](a: T, b: U) -> T:"), "T:Add,U")
    fails = fails + _expect_str("trait name", ph.parse_trait_name("trait Add:"), "Add")
    fails = fails + _expect_str("impl pair", ph.parse_impl_pair("impl Add for Vec[i32]:"), "Add|Vec[i32]")
    fails = fails + _expect_i32("result sugar yes", ph.has_result_sugar("func read() -> Result[i32, String]?:"), 1)
    fails = fails + _expect_i32("result sugar no", ph.has_result_sugar("func read() -> Result[i32, String]:"), 0)
    fails = fails + _expect_str("enum name", ph.parse_enum_name("enum Option[T]:"), "Option")
    fails = fails + _expect_str("type alias", ph.parse_type_alias_name("type Bytes = Slice[u8]"), "Bytes")
    fails = fails + _expect_str("pub func", ph.parse_visibility_decl("pub func run() -> i32:"), "func")
    fails = fails + _expect_i32("match header", ph.is_match_header("match value:"), 1)
    fails = fails + _expect_i32("range loop", ph.is_range_loop_header("for i in 0..10:"), 1)
    fails = fails + _expect_i32("if stmt header", ph.is_if_stmt_header("if (ok):"), 1)
    fails = fails + _expect_i32("while stmt header", ph.is_while_stmt_header("while (i < 10):"), 1)
    fails = fails + _expect_i32("if expr", ph.has_if_expression("let x = if ok: 1 else: 0"), 1)
    fails = fails + _expect_i32("tuple destruct", ph.has_tuple_destructuring("let (a, b) = pair"), 1)
    fails = fails + _expect_i32("array literal", ph.has_array_literal("let xs = [1, 2, 3]"), 1)
    fails = fails + _expect_i32("slice expr", ph.has_slice_expr("let head = xs[0:2]"), 1)
    fails = fails + _expect_i32("raw string", ph.has_raw_string("let p = r#path"), 1)
    fails = fails + _expect_i32("closure", ph.has_closure("let f = |x| x + 1"), 1)
    fails = fails + _expect_i32("loop label", ph.has_loop_label("outer: while (i < 10):"), 1)
    fails = fails + _expect_i32("unsafe block", ph.is_unsafe_block_header("unsafe:"), 1)
    fails = fails + _expect_i32("extension impl", ph.is_extension_impl_header("impl Display for Vec[i32]:"), 1)
    fails = fails + _expect_str("intent func kind", ph.parse_intent_kind("intent func sum(xs: [i32]) -> i32:"), "func")
    fails = fails + _expect_str("intent loop kind", ph.parse_intent_kind("intent loop i in 0..n:"), "loop")
    fails = fails + _expect_str("intent calc kind", ph.parse_intent_kind("intent calc(x):"), "calc")
    fails = fails + _expect_str("intent block kind", ph.parse_intent_kind("intent block:"), "block")
    fails = fails + _expect_i32("intent header yes", ph.is_intent_header("intent block:"), 1)
    fails = fails + _expect_i32("intent header no", ph.is_intent_header("intent loop i in 0..n"), 0)
    fails = fails + _expect_i32("intent goal yes", ph.is_intent_goal_line("goal: reduce_sum"), 1)
    fails = fails + _expect_i32("intent goal no", ph.is_intent_goal_line("goal:"), 0)
    fails = fails + _expect_i32("intent constraints header", ph.is_intent_constraints_header("constraints:"), 1)
    fails = fails + _expect_i32("intent examples header", ph.is_intent_examples_header("examples:"), 1)

    if (fails == 0):
        print("PASS: parser header helpers")
        return 0

    print("TOTAL FAILS:")
    print(fails)
    return 1
