import "src/semantics/traits/traits.tg" as gt

func _expect_str(label: String, got: String, want: String) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print("  got : " + got)
    print("  want: " + want)
    return 1

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func main() -> i32:
    let fails = 0

    let sig = "func sum[T: Add, U](a: T, b: U) -> T:"
    let clause = gt.extract_generic_clause(sig)
    fails = fails + _expect_str("generic clause", clause, "T:Add,U")
    fails = fails + _expect_i32("param count", gt.generic_param_count(clause), 2)
    fails = fails + _expect_str("param0 name", gt.generic_param_name_at(clause, 0), "T")
    fails = fails + _expect_str("param0 bound", gt.generic_param_bound_at(clause, 0), "Add")
    fails = fails + _expect_str("param1 name", gt.generic_param_name_at(clause, 1), "U")
    fails = fails + _expect_str("param1 bound", gt.generic_param_bound_at(clause, 1), "")

    fails = fails + _expect_str("trait parse", gt.extract_trait_name("trait Add:"), "Add")
    fails = fails + _expect_str("impl parse", gt.extract_impl_pair("impl Add for Vec[i32]:"), "Add|Vec[i32]")

    fails = fails + _expect_str("mangle symbol", gt.mangle_symbol("sum", "i32, Vec[i32]"), "sum__i32__Vec_i32_")
    fails = fails + _expect_str("instance key", gt.make_instance_key("map", "String"), "map__String")

    if (fails == 0):
        print("PASS: language foundation helpers")
        return 0

    print("TOTAL FAILS:")
    print(fails)
    return 1
