import "src/semantics/intent/matcher.tg" as im

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func _expect_str(label: String, got: String, want: String) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print("  got : " + got)
    print("  want: " + want)
    return 1

func main() -> i32:
    let fails = 0
    let src = "intent loop i in 0..n:\n    goal: reduce_sum\n    constraints:\n        deterministic == true\n"

    fails = fails + _expect_i32("intent marker count", im.count_intent_markers(src), 1)
    fails = fails + _expect_str("goal parse", im.parse_goals(src), ";reduce_sum;")
    fails = fails + _expect_i32("goal supported", im.is_supported_goal("reduce_sum"), 1)
    fails = fails + _expect_i32("goal supported auto_plan", im.is_supported_goal("auto_plan"), 1)
    fails = fails + _expect_i32("goal supported polynomial_eval", im.is_supported_goal("polynomial_eval"), 1)
    fails = fails + _expect_i32("goal supported fibonacci_dp", im.is_supported_goal("fibonacci_dp"), 1)
    fails = fails + _expect_i32("goal supported tribonacci_dp", im.is_supported_goal("tribonacci_dp"), 1)
    fails = fails + _expect_i32("goal supported lower_bound_sorted", im.is_supported_goal("lower_bound_sorted"), 1)
    fails = fails + _expect_i32("goal supported interval_cover_greedy", im.is_supported_goal("interval_cover_greedy"), 1)
    fails = fails + _expect_i32("goal supported sort_ascending", im.is_supported_goal("sort_ascending"), 1)
    fails = fails + _expect_i32("goal supported search_element", im.is_supported_goal("search_element"), 1)
    fails = fails + _expect_i32("goal supported sqrt_bounded_loop", im.is_supported_goal("sqrt_bounded_loop"), 1)
    fails = fails + _expect_i32("goal unsupported", im.is_supported_goal("unknown_goal"), 0)
    fails = fails + _expect_str("first unsupported empty", im.first_unsupported_goal(src), "")
    fails = fails + _expect_str("first unsupported found", im.first_unsupported_goal("intent block:\n    goal: mystery_goal\n    constraints:\n        deterministic == true\n"), "mystery_goal")
    fails = fails + _expect_i32("validate goals ok", im.validate_goals(src), 1)
    fails = fails + _expect_i32("validate goals fail", im.validate_goals("intent block:\n    goal: mystery_goal\n    constraints:\n        deterministic == true\n"), 0)
    fails = fails + _expect_str("rule min", im.select_rule("reduce_sum", "min"), "rule.reduce_sum.scalar.v1")
    fails = fails + _expect_str("rule max", im.select_rule("reduce_sum", "max"), "rule.reduce_sum.simd.v2")
    fails = fails + _expect_str("rule polynomial min", im.select_rule("polynomial_eval", "min"), "rule.polynomial_eval.horner.v1")
    fails = fails + _expect_str("rule polynomial max", im.select_rule("polynomial_eval", "max"), "rule.polynomial_eval.simd.v2")
    fails = fails + _expect_str("rule fib min", im.select_rule("fibonacci_dp", "min"), "rule.fibonacci_dp.iterative.v1")
    fails = fails + _expect_str("rule fib max", im.select_rule("fibonacci_dp", "max"), "rule.fibonacci_dp.iterative.v2")
    fails = fails + _expect_str("rule trib max", im.select_rule("tribonacci_dp", "max"), "rule.dp.trib.iterative.v1")
    fails = fails + _expect_str("rule lower bound", im.select_rule("lower_bound_sorted", "max"), "rule.search.lower_bound.sorted.v1")
    fails = fails + _expect_str("rule interval cover", im.select_rule("interval_cover_greedy", "max"), "rule.greedy.interval_cover.v1")
    fails = fails + _expect_str("rule auto", im.select_rule("auto_plan", "max"), "rule.auto_plan.resolve.v1")
    fails = fails + _expect_str("rule sort min", im.select_rule("sort_ascending", "min"), "rule.sort_ascending.quicksort.v1")
    fails = fails + _expect_str("rule sort max", im.select_rule("sort_ascending", "max"), "rule.sort_ascending.introsort.v2")
    fails = fails + _expect_str("rule search min", im.select_rule("search_element", "min"), "rule.search_element.binary_classic.v1")
    fails = fails + _expect_str("rule search max", im.select_rule("search_element", "max"), "rule.search_element.binary_iter.v2")
    fails = fails + _expect_str("rule sqrt min", im.select_rule("sqrt_bounded_loop", "min"), "rule.sqrt_bounded_loop.div_guard.v1")
    fails = fails + _expect_str("rule sqrt max", im.select_rule("sqrt_bounded_loop", "max"), "rule.sqrt_bounded_loop.mul_guard.v2")

    if (fails == 0):
        print("PASS: intent matcher")
        return 0
    print("TOTAL FAILS:")
    print(fails)
    return 1
