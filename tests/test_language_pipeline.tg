import "src/lowering/transform/program.tg" as pipe

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _contains(hay: String, needle: String) -> i32:
    let n = strlen(hay)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(hay, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func _expect_str(label: String, got: String, want: String) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print("  got : " + got)
    print("  want: " + want)
    return 1

func _expect_str_contains(label: String, hay: String, needle: String) -> i32:
    if (_contains(hay, needle) == 1):
        return 0
    print("FAIL: " + label)
    print("  missing: " + needle)
    return 1

func main() -> i32:
    let fails = 0

    let src_trait = "impl Add for Vec:"
    let out_trait = pipe.preprocess(src_trait)
    fails = fails + _expect_str_contains("rewrite impl for", out_trait, "impl Vec:")

    let src_comp = "func main() -> i32:\n    let x = comptime(1 + 2)\n    return x\n"
    let out_comp = pipe.preprocess(src_comp)
    fails = fails + _expect_str_contains("strip comptime wrapper", out_comp, "let x = 3")

    let src_comp_fn = "comptime func add(a: i32, b: i32) -> i32:\n    return a + b\nfunc main() -> i32:\n    let y = comptime add(40, 2)\n    return y\n"
    let out_comp_fn = pipe.preprocess(src_comp_fn)
    fails = fails + _expect_str_contains("fold comptime func call", out_comp_fn, "let y = 42")
    fails = fails + _expect_i32("drop comptime func body", _contains(out_comp_fn, "comptime func add"), 0)

    let src_gen = "func id[T](x: T) -> T:\n    return x\n"
    let out_gen = pipe.preprocess(src_gen)
    fails = fails + _expect_str_contains("strip generic clause", out_gen, "func id(x: T) -> T:")

    let src_pub = "pub func main() -> i32:\n    return 0\n"
    let out_pub = pipe.preprocess(src_pub)
    fails = fails + _expect_str_contains("strip pub on decl", out_pub, "func main() -> i32:")

    let src_unsafe = "unsafe:"
    let out_unsafe = pipe.preprocess(src_unsafe)
    fails = fails + _expect_str_contains("rewrite unsafe block header", out_unsafe, "if 1:")

    fails = fails + _expect_i32("reject defer top-level", pipe.validate("defer print(x)\n"), 1)
    fails = fails + _expect_i32("accept defer in function", pipe.validate("func main() -> i32:\n    defer print(x)\n    return 0\n"), 0)
    fails = fails + _expect_i32("reject stray ?", pipe.validate("foo?"), 1)
    fails = fails + _expect_i32("accept ? in result-like header", pipe.validate("func run() -> Result[i32, String]?:\n    return 0\n"), 0)
    fails = fails + _expect_i32("accept match header", pipe.validate("match value:"), 0)
    fails = fails + _expect_i32("reject invalid match header", pipe.validate("match value\n"), 1)
    fails = fails + _expect_i32("accept range loop", pipe.validate("for i in 0..10:"), 0)
    fails = fails + _expect_i32("reject invalid range loop", pipe.validate("for i in xs:"), 1)
    fails = fails + _expect_i32("reject if stmt without parens", pipe.validate("func main() -> i32:\n    if x > 0:\n        return 1\n    return 0\n"), 1)
    fails = fails + _expect_i32("reject while stmt without parens", pipe.validate("func main() -> i32:\n    while x > 0:\n        return 1\n    return 0\n"), 1)
    fails = fails + _expect_str("suggest if header fix", pipe._suggest_parenthesized_stmt_header("if x > 0:", "if "), "if (x > 0):")
    fails = fails + _expect_str("suggest while header fix", pipe._suggest_parenthesized_stmt_header("while i < 3:", "while "), "while (i < 3):")
    fails = fails + _expect_i32("accept pub decl", pipe.validate("pub enum Option:"), 0)
    fails = fails + _expect_i32("reject invalid pub target", pipe.validate("pub let x = 1\n"), 1)
    fails = fails + _expect_i32("accept unsafe block header", pipe.validate("unsafe:"), 0)
    fails = fails + _expect_i32("reject invalid unsafe form", pipe.validate("unsafe value\n"), 1)
    fails = fails + _expect_i32("accept intent func", pipe.validate("intent func dedup(xs: [i32]) -> [i32]:\n    goal: deduplicate_sorted\n    constraints:\n        deterministic == true\n"), 0)
    fails = fails + _expect_i32("accept intent with examples", pipe.validate("intent block:\n    goal: reduce_sum\n    examples:\n        reduce_sum([1,2]) == 3\n    constraints:\n        deterministic == true\n"), 0)
    fails = fails + _expect_i32("accept intent calc polynomial", pipe.validate("intent calc(x):\n    goal: polynomial_eval\n    constraints:\n        deterministic == true\n        vectorize == true\n        max_error <= 1e-6\n"), 0)
    fails = fails + _expect_i32("reject intent missing goal", pipe.validate("intent block:\n    constraints:\n        deterministic == true\n"), 1)
    fails = fails + _expect_i32("reject intent missing constraints", pipe.validate("intent loop i in 0..n:\n    goal: reduce_sum\n"), 1)
    fails = fails + _expect_i32("reject intent empty examples", pipe.validate("intent block:\n    goal: reduce_sum\n    examples:\n    constraints:\n        deterministic == true\n"), 1)
    fails = fails + _expect_i32("reject intent invalid example assertion", pipe.validate("intent block:\n    goal: reduce_sum\n    examples:\n        reduce_sum([1,2])\n    constraints:\n        deterministic == true\n"), 1)
    fails = fails + _expect_i32("reject intent malformed header", pipe.validate("intent loop i in 0..n\n    goal: reduce_sum\n    constraints:\n        deterministic == true\n"), 1)
    fails = fails + _expect_i32("accept flow basic", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        undo cloud.delete_vm(vm.id)\n        retry 2 backoff exp(200ms, 2.0)\n        timeout 20s\n        idempotent\n    step pkg = artifact.upload(input.bundle)\n        undo artifact.delete(pkg.id)\n        timeout 30s\n"), 0)
    fails = fails + _expect_i32("accept flow on_error irreversible_reason", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        undo cloud.delete_vm(vm.id)\n        timeout 20s\n    step notify = queue.publish(input.bundle)\n        irreversible reason \"manual approval\"\n        on_error map.release_error(notify)\n        timeout 10s\n"), 0)
    fails = fails + _expect_i32("reject flow missing undo", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        timeout 20s\n"), 1)
    fails = fails + _expect_i32("reject flow retry without idempotent", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        undo cloud.delete_vm(vm.id)\n        retry 2 backoff exp(200ms, 2.0)\n        timeout 20s\n"), 1)
    fails = fails + _expect_i32("reject flow timeout format", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        undo cloud.delete_vm(vm.id)\n        timeout soon\n"), 1)
    fails = fails + _expect_i32("reject flow on_error format", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        undo cloud.delete_vm(vm.id)\n        timeout 20s\n        on_error\n"), 1)
    fails = fails + _expect_i32("reject flow duplicate on_error", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        undo cloud.delete_vm(vm.id)\n        timeout 20s\n        on_error map.first(vm)\n        on_error map.second(vm)\n"), 1)
    fails = fails + _expect_i32("accept flow parallel with barrier", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    parallel:\n        step vm = cloud.create_vm(input.spec)\n            undo cloud.delete_vm(vm.id)\n            timeout 20s\n        step pkg = artifact.upload(input.bundle)\n            undo artifact.delete(pkg.id)\n            timeout 30s\n    barrier\n"), 0)
    fails = fails + _expect_i32("reject flow parallel missing barrier", pipe.validate("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    parallel:\n        step vm = cloud.create_vm(input.spec)\n            undo cloud.delete_vm(vm.id)\n            timeout 20s\n    step pkg = artifact.upload(input.bundle)\n        undo artifact.delete(pkg.id)\n        timeout 30s\n"), 1)
    fails = fails + _expect_i32("strict flow accepts timeout+undo", pipe.check_flow_headers_strict("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        undo cloud.delete_vm(vm.id)\n        timeout 20s\n"), 0)
    fails = fails + _expect_i32("strict flow rejects irreversible", pipe.check_flow_headers_strict("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step vm = cloud.create_vm(input.spec)\n        irreversible reason \"manual\"\n        timeout 20s\n"), 1)
    fails = fails + _expect_i32("strict flow rejects unknown capability", pipe.check_flow_headers_strict("flow deploy_release(input: DeployInput) -> Result[DeployOut, DeployErr]:\n    step ext = mystery.do_job(input.spec)\n        undo mystery.undo(ext.id)\n        timeout 20s\n"), 1)

    if (fails == 0):
        print("PASS: language pipeline")
        return 0
    print("TOTAL FAILS:")
    print(fails)
    return 1
