import std.array as array
import std.string as string

pub func token_count(csv: str) -> i32:
  let parts = string.split(csv, ",")
  return array.len(parts)

pub func total_chars(csv: str) -> i32:
  let total: i32 = 0
  let parts = string.split(csv, ",")
  for part in parts:
    total = total + string.len(part)
  return total

pub func normalized(csv: str) -> str:
  let parts = string.split(csv, ",")
  let head = array.get(parts, 0)
  if (string.str_eq(head, "alpha") == false):
    return "invalid"
  return string.join(parts, "|")
