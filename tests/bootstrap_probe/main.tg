import std.string as string
import std.fs as fs
import std.time as time

pub func report(message: str) -> str:
  let now = time.now_ms()
  if (now >= 0):
    return string.concat("[time-ready] ", message)
  return message

pub func scan_dir(path: str) -> str:
  let entries = fs.read_dir(path)
  let out = ""
  for entry in entries:
    let line = string.concat("entry: ", entry)
    let touched_path = fs.path_join(fs.path_join(path, entry), ".bootstrap")
    let touched = ""
    if (fs.exists(touched_path)):
      touched = " (tracked)"
    out = string.concat(out, string.concat(line, touched))
    out = string.concat(out, "\n")
  return out

pub func main() -> i32:
  let root = fs.getcwd()
  let header = report(string.concat("bootstrap probe running in ", root))
  print(header)
  let listing = scan_dir(root)
  print(listing)
  let file = fs.path_join(root, "tests/bootstrap_probe/probe-result.txt")
  fs.write(file, listing)
  print(report("probe finished"))
  return 0
