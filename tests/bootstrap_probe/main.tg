from . import report
import std.fs as fs
import std.path as path
import std.process as process
import std.string as string
import std.time as time

pub func main() -> i32:
  let started = time.now_ms()
  let root = path.getcwd()
  if (path.is_dir(root) == false):
    return 1
  if (string.str_eq(process.env("THAGORE_BOOTSTRAP_PROBE"), "ok") == false):
    return 2
  let file = "tests/bootstrap_probe/probe-result.txt"
  let payload = report.build_report("alpha,beta,gamma")
  if (fs.write(file, payload) == false):
    return 3
  let size = fs.filesize(file)
  if (size <= 0):
    return 4
  let stored = fs.read(file)
  if (string.str_eq(stored, payload) == false):
    return 5
  let elapsed = time.now_ms() - started
  if (elapsed < 0):
    return 6
  println(stored)
  return 0
