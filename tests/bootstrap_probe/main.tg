import std.string as string
import std.fs as fs
import std.time as time

pub func report(message: string) -> string:
  let now = time.now_ms()
  let prefix = string.concat("[", string.from_int(now))
  let stamped = string.concat(prefix, "] ")
  return string.concat(stamped, message)

pub func scan_dir(path: string) -> string:
  let entries = fs.read_dir(path)
  let out = ""
  for entry in entries:
    let line = string.concat("entry: ", entry)
    let touched_path = fs.path_join(fs.path_join(path, entry), ".bootstrap")
    let touched = if fs.exists(touched_path): " (tracked)" else: ""
    out = string.concat(out, string.concat(line, touched))
    out = string.concat(out, "\n")
  return out

pub func main() -> i32:
  let root = fs.getcwd()
  let header = report(string.concat("bootstrap probe running in ", root))
  print(header)
  let listing = scan_dir(root)
  print(listing)
  let file = fs.path_join(root, "tests/bootstrap_probe/probe-result.txt")
  fs.write(file, listing)
  print(report("probe finished"))
  return 0
