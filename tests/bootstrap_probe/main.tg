import std.string as string
import std.fs as fs
import std.time as time

pub func report(message: str) -> str:
  let now = time.now_ms()
  if (now >= 0):
    return string.concat("[time-ready] ", message)
  return message

pub func main() -> i32:
  let root = fs.getcwd()
  let file = fs.path_join(root, "tests/bootstrap_probe/probe-result.txt")
  let payload = report(string.concat("bootstrap probe running in ", root))
  print(payload)
  if (!fs.write(file, payload)):
    return 1
  if (!fs.exists(file)):
    return 2
  let stored = fs.read(file)
  if (stored != payload):
    return 3
  if (fs.filesize(file) <= 0):
    return 4
  print(report("probe finished"))
  return 0
