import "src/frontend/native/lexer.tg" as lx
import "src/frontend/native/parser.tg" as parsernative
import "src/frontend/native/typechecker.tg" as tc

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func _expect_contains(label: String, text: String, needle: String) -> i32:
    if (_contains(text, needle) == 1):
        return 0
    print("FAIL: " + label)
    print("missing: " + needle)
    return 1

func main() -> i32:
    let fails = 0
    let src_enum = "enum Option[T]: Some(i32)"
    fails = fails + _expect_i32("parse enum payload", parsernative.parse_enum_payload_count(src_enum), 1)

    let src_type = "type Bytes = [i32]"
    fails = fails + _expect_contains("parse type_alias", parsernative.parse_aliases(src_type), "Bytes|[i32]")
    fails = fails + _expect_i32("parse array literal", parsernative.parse_array_literal_count(src_type), 1)

    fails = fails + _expect_i32("parse match", parsernative.parse_match_count("match x:"), 1)

    fails = fails + _expect_i32("parse range_loop", parsernative.parse_range_loop_count("for i in 0..10:"), 1)

    fails = fails + _expect_i32("parse unsafe", parsernative.parse_unsafe_count("unsafe:"), 1)

    fails = fails + _expect_i32("parse slice", parsernative.parse_slice_expr_count("let s = xs[0:2]"), 1)
    fails = fails + _expect_i32("parse result sugar", parsernative.parse_result_sugar_count("func run() -> Result[i32, String]?:"), 1)
    fails = fails + _expect_i32("parse defer scope", parsernative.parse_defer_scope_count("defer release()"), 1)
    fails = fails + _expect_i32("parse comptime", parsernative.parse_comptime_count("let x = comptime add(1, 2)"), 1)

    fails = fails + _expect_i32("typecheck native simple", tc.validate_source("func main() -> i32:\n    return 0\n"), 0)
    fails = fails + _expect_i32("typecheck intent simple", tc.validate_source("intent loop i in 0..10:\n    goal: reduce_sum\n    constraints:\n        deterministic == true\nfunc main() -> i32:\n    return 0\n"), 0)
    fails = fails + _expect_i32("typecheck intent calc polynomial", tc.validate_source("intent calc(x):\n    goal: polynomial_eval\n    constraints:\n        deterministic == true\n        vectorize == true\n        max_error <= 1e-6\nfunc main() -> i32:\n    return 0\n"), 0)
    fails = fails + _expect_i32("typecheck intent fibonacci", tc.validate_source("intent func fib(n: i32) -> i32:\n    goal: fibonacci_dp\n    constraints:\n        deterministic == true\nfunc fib(n: i32) -> i32:\n    return n\nfunc main() -> i32:\n    return 0\n"), 0)
    fails = fails + _expect_i32("typecheck intent auto_plan", tc.validate_source("intent func fib(n: i32) -> i32:\n    goal: auto_plan\n    constraints:\n        deterministic == true\nfunc fib(n: i32) -> i32:\n    return n\nfunc main() -> i32:\n    return 0\n"), 0)
    fails = fails + _expect_i32("typecheck intent invalid", tc.validate_source("intent block:\n    constraints:\n        deterministic == true\nfunc main() -> i32:\n    return 0\n"), 1)
    fails = fails + _expect_i32("typecheck intent unsupported goal", tc.validate_source("intent block:\n    goal: mystery_goal\n    constraints:\n        deterministic == true\nfunc main() -> i32:\n    return 0\n"), 1)

    if (fails == 0):
        print("PASS: native pipeline")
        return 0
    print("TOTAL FAILS:")
    print(fails)
    return 1
