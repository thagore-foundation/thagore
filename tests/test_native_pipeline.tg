import "src/frontend/native/lexer.tg" as lx
import "src/frontend/native/parser.tg" as parsernative
import "src/frontend/native/typechecker.tg" as tc

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _expect_i32(label: String, got: i32, want: i32) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print(got)
    return 1

func _expect_contains(label: String, text: String, needle: String) -> i32:
    if (_contains(text, needle) == 1):
        return 0
    print("FAIL: " + label)
    print("missing: " + needle)
    return 1

func main() -> i32:
    let fails = 0
    let src_enum = "enum Option[T]: Some(i32)"
    fails = fails + _expect_i32("parse enum payload", parsernative.parse_enum_payload_count(src_enum), 1)

    let src_type = "type Bytes = [i32]"
    fails = fails + _expect_contains("parse type_alias", parsernative.parse_aliases(src_type), "Bytes|[i32]")
    fails = fails + _expect_i32("parse array literal", parsernative.parse_array_literal_count(src_type), 1)

    fails = fails + _expect_i32("parse match", parsernative.parse_match_count("match x:"), 1)

    fails = fails + _expect_i32("parse range_loop", parsernative.parse_range_loop_count("for i in 0..10:"), 1)

    fails = fails + _expect_i32("parse unsafe", parsernative.parse_unsafe_count("unsafe:"), 1)

    fails = fails + _expect_i32("parse slice", parsernative.parse_slice_expr_count("let s = xs[0:2]"), 1)

    fails = fails + _expect_i32("typecheck native simple", tc.validate_source("func main() -> i32:\n    return 0\n"), 0)

    if (fails == 0):
        print("PASS: native pipeline")
        return 0
    print("TOTAL FAILS:")
    print(fails)
    return 1
