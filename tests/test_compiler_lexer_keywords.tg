import "src/frontend/lexer/lexer_keywords.tg" as lexer

func _expect_str(label: String, got: String, want: String) -> i32:
    if (got == want):
        return 0
    print("FAIL: " + label)
    print("  got : " + got)
    print("  want: " + want)
    return 1

func main() -> i32:
    let fails = 0

    fails = fails + _expect_str("kw trait", lexer.keyword_kind("trait"), "TRAIT")
    fails = fails + _expect_str("kw interface", lexer.keyword_kind("interface"), "INTERFACE")
    fails = fails + _expect_str("kw enum", lexer.keyword_kind("enum"), "ENUM")
    fails = fails + _expect_str("kw match", lexer.keyword_kind("match"), "MATCH")
    fails = fails + _expect_str("kw type", lexer.keyword_kind("type"), "TYPE")
    fails = fails + _expect_str("kw pub", lexer.keyword_kind("pub"), "PUB")
    fails = fails + _expect_str("kw unsafe", lexer.keyword_kind("unsafe"), "UNSAFE")
    fails = fails + _expect_str("kw for", lexer.keyword_kind("for"), "FOR")
    fails = fails + _expect_str("kw in", lexer.keyword_kind("in"), "IN")
    fails = fails + _expect_str("kw defer", lexer.keyword_kind("defer"), "DEFER")
    fails = fails + _expect_str("kw comptime", lexer.keyword_kind("comptime"), "COMPTIME")
    fails = fails + _expect_str("kw normal", lexer.keyword_kind("hello"), "IDENTIFIER")

    fails = fails + _expect_str("sym [", lexer.classify_symbol("["), "LBRACKET")
    fails = fails + _expect_str("sym ]", lexer.classify_symbol("]"), "RBRACKET")
    fails = fails + _expect_str("sym |", lexer.classify_symbol("|"), "PIPE")
    fails = fails + _expect_str("sym ->", lexer.classify_symbol("->"), "ARROW")
    fails = fails + _expect_str("sym =>", lexer.classify_symbol("=>"), "FAT_ARROW")
    fails = fails + _expect_str("sym ..", lexer.classify_symbol(".."), "RANGE")
    fails = fails + _expect_str("sym ..=", lexer.classify_symbol("..="), "RANGE_INCLUSIVE")
    fails = fails + _expect_str("sym ?", lexer.classify_symbol("?"), "QUESTION")
    fails = fails + _expect_str("sym other", lexer.classify_symbol("+"), "")

    if (fails == 0):
        print("PASS: frontend lexer keyword helpers")
        return 0

    print("TOTAL FAILS:")
    print(fails)
    return 1
