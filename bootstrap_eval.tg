import "src/syntax/parser.tg" as parser
import "src/compiler/eval.tg" as eval

func main() -> i32:
    let code = "10 + 20 * 3 - 5"
    print("Expression: " + code)

    let root = parser.parse_expr(code)
    let interpreter = eval.new()

    print("Calculating...")
    let result = interpreter.eval_expr(root)

    print("Result:")
    print(result)

    if (result == 65):
        print("SUCCESS: Interpreter works correctly.")
    else:
        print("FAILURE: Wrong calculation.")

    return 0
