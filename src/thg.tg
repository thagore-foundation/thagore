import env
import fs
import process
import "src/compiler/codegen_llvm.tg" as codegen_llvm
import "src/compiler/semantic_headers.tg" as semantic_headers
import "src/compiler/language_pipeline.tg" as lang_pipe

extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _basename_no_ext(path: String) -> String:
    let i = 0
    let last_sep = -1
    let last_dot = -1
    while (i < path.length()):
        let ch = _char_at(path, i)
        if (ch == "/"):
            last_sep = i
            last_dot = -1
        if (ch == "\\"):
            last_sep = i
            last_dot = -1
        if (ch == "."):
            last_dot = i
        i = i + 1
    let start = last_sep + 1
    if (last_dot < start):
        last_dot = path.length()
    return path.substr(start, last_dot - start)

func _emit_ir_from_source(source: String, module_name: String) -> String:
    return codegen_llvm.emit_program_from_source(source, module_name)

func _contains_space(text: String) -> i32:
    let i = 0
    while (i < text.length()):
        if (_char_at(text, i) == " "):
            return 1
        i = i + 1
    return 0

func _sanitize_name(text: String) -> String:
    let i = 0
    let out = ""
    while (i < text.length()):
        let ch = _char_at(text, i)
        if (ch == " "):
            out = out + "_"
        else:
            out = out + ch
        i = i + 1
    return out

func _probe_clang(path: String) -> i32:
    let cmd = path + " --version"
    return process.run(cmd)

func _detect_clang() -> String:
    if (_probe_clang("clang") == 0):
        return "clang"
    let clang_short = "C:\\Progra~1\\LLVM\\bin\\clang.exe"
    if (_probe_clang(clang_short) == 0):
        return clang_short
    let clang_win = "C:\\Program Files\\LLVM\\bin\\clang.exe"
    if (_probe_clang(clang_win) == 0):
        return clang_win
    let clang_local = "llvm/clang+llvm-21.1.8-x86_64-pc-windows-msvc/bin/clang.exe"
    if (_probe_clang(clang_local) == 0):
        return clang_local
    let clang_usr_bin = "/usr/bin/clang"
    if (_probe_clang(clang_usr_bin) == 0):
        return clang_usr_bin
    let clang_usr_local = "/usr/local/bin/clang"
    if (_probe_clang(clang_usr_local) == 0):
        return clang_usr_local
    return ""

func _is_windows() -> i32:
    if (process.run("cmd /c ver >nul 2>nul") == 0):
        return 1
    return 0

func _detect_runtime_lib() -> String:
    if (_is_windows() == 1):
        if (process.run("cmd /c if exist thag_runtime.lib (exit 0) else (exit 1)") == 0):
            return "thag_runtime.lib"
        if (process.run("cmd /c if exist legacy\\thag_runtime.lib (exit 0) else (exit 1)") == 0):
            return "legacy\\thag_runtime.lib"
        if (process.run("cmd /c if exist build\\Debug\\thag_runtime.lib (exit 0) else (exit 1)") == 0):
            return "build\\Debug\\thag_runtime.lib"
        if (process.run("cmd /c if exist legacy\\build\\Debug\\thag_runtime.lib (exit 0) else (exit 1)") == 0):
            return "legacy\\build\\Debug\\thag_runtime.lib"
        return ""
    if (process.run("sh -lc 'test -f thag_runtime.lib'") == 0):
        return "thag_runtime.lib"
    if (process.run("sh -lc 'test -f legacy/thag_runtime.lib'") == 0):
        return "legacy/thag_runtime.lib"
    if (process.run("sh -lc 'test -f build/Debug/thag_runtime.lib'") == 0):
        return "build/Debug/thag_runtime.lib"
    if (process.run("sh -lc 'test -f legacy/build/Debug/thag_runtime.lib'") == 0):
        return "legacy/build/Debug/thag_runtime.lib"
    return ""

func _compile_ir_to_exe(ir_path: String, exe_path: String) -> i32:
    let clang_bin = _detect_clang()
    if (clang_bin.length() == 0):
        print("CRITICAL: Clang not found via PATH or standard locations. Please install LLVM.")
        return 1
    if (_contains_space(clang_bin) == 1):
        print("Error: detected clang path contains spaces; put clang in PATH or use a path without spaces.")
        return 1
    if (_contains_space(ir_path) == 1):
        print("Error: IR path contains spaces, unsupported by current command runner.")
        return 1
    if (_contains_space(exe_path) == 1):
        print("Error: output path contains spaces, unsupported by current command runner.")
        return 1
    let runtime_lib = _detect_runtime_lib()
    if (runtime_lib.length() == 0):
        print("CRITICAL: thag_runtime.lib not found in standard locations.")
        return 1
    if (_contains_space(runtime_lib) == 1):
        print("Error: runtime lib path contains spaces, unsupported by current command runner.")
        return 1
    let cmd = clang_bin + " " + ir_path + " " + runtime_lib + " -o " + exe_path + " -Wno-override-module"
    return process.run(cmd)

func main() -> i32:
    print("--- Thagore Compiler Driver (Pure Modules) ---")
    if (env.count() < 2):
        print("Usage: thg.exe [build|run] <script.tg> [-o output.exe] [-b|--build|-c|--compile|--emit-llvm|-ll|-r|--run|--interpret|--strict-interpret]")
        return 0
    let build_mode = 0
    let llvm_mode = 0
    let script_index = 1
    let output_override = ""
    if (env.get(1) == "build"):
        build_mode = 1
        script_index = 2
    if (script_index >= env.count()):
        print("Usage: thg.exe [build|run] <script.tg> [-o output.exe] [-b|--build|-c|--compile|--emit-llvm|-ll|-r|--run|--interpret|--strict-interpret]")
        return 1
    let i = script_index + 1
    while (i < env.count()):
        let arg = env.get(i)
        if (arg == "-o"):
            if ((i + 1) >= env.count()):
                print("Error: missing output path after -o")
                return 1
            output_override = env.get(i + 1)
            i = i + 2
        else:
            if (arg == "-b"):
                build_mode = 1
            else:
                if (arg == "--build"):
                    build_mode = 1
                else:
                    if (arg == "--emit-llvm"):
                        llvm_mode = 1
                    else:
                        if (arg == "-ll"):
                            llvm_mode = 1
            i = i + 1
    if (build_mode == 1):
        llvm_mode = 0
    if (build_mode == 0):
        if (llvm_mode == 0):
            build_mode = 1
    print("Loading script...")
    let input_path = env.get(script_index)
    let source = fs.read_text(input_path)
    if (source.length() == 0):
        print("Error: Empty file or file not found.")
        return 0
    let preflight_code = semantic_headers.preflight(source)
    if (preflight_code != 0):
        print("Build aborted by semantic preflight.")
        return preflight_code
    let lang_check = lang_pipe.validate(source)
    if (lang_check != 0):
        print("Build aborted by language pipeline validation.")
        return lang_check
    source = lang_pipe.preprocess(source)
    let base = _basename_no_ext(input_path)
    base = _sanitize_name(base)
    let output_exe = output_override
    if (output_exe.length() > 0):
        if (_contains_space(output_exe) == 1):
            print("Error: -o path with spaces is not supported by current command runner.")
            return 1
    if (output_exe.length() == 0):
        output_exe = base + ".exe"
    let output_ll = base + ".ll"
    let core_ir = ""
    let user_ir = ""
    let merged_ir = ""
    if (build_mode == 1):
        print("Source loaded. Generating IR...")
        core_ir = codegen_llvm.system_decls()
        user_ir = _emit_ir_from_source(source, base)
        if (user_ir.length() == 0):
            print("Error: LLVM IR generation failed")
            return 1
        merged_ir = core_ir + user_ir
        print("Build mode active. Compiling to executable...")
        let ok_temp = fs.write_text(output_ll, merged_ir)
        if (ok_temp == 0):
            print("Error: cannot write LLVM IR file")
            return 1
        let build_code = _compile_ir_to_exe(output_ll, output_exe)
        if (build_code == 0):
            print("Build success.")
            print(output_exe)
            return 0
        print("Build failed. Ensure clang is installed and available in PATH.")
        return build_code
    if (llvm_mode == 1):
        print("Source loaded. Generating IR...")
        core_ir = codegen_llvm.system_decls()
        user_ir = _emit_ir_from_source(source, base)
        if (user_ir.length() == 0):
            print("Error: LLVM IR generation failed")
            return 1
        merged_ir = core_ir + user_ir
        print("LLVM mode active. Generating LLVM IR...")
        let ok_ll = fs.write_text(output_ll, merged_ir)
        if (ok_ll == 0):
            print("Error: cannot write LLVM IR file")
            return 1
        let clang_bin = _detect_clang()
        if (clang_bin.length() == 0):
            print("CRITICAL: Clang not found via PATH or standard locations. Please install LLVM.")
            return 1
        let runtime_lib = _detect_runtime_lib()
        if (runtime_lib.length() == 0):
            print("CRITICAL: thag_runtime.lib not found in standard locations.")
            return 1
        print("Generated LLVM IR successfully:")
        print(output_ll)
        print("Compile with: " + clang_bin + " " + output_ll + " " + runtime_lib + " -o " + output_exe + " -Wno-override-module")
        return 0
    return 0
