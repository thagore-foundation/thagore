import env
import fs
import process
import "src/syntax/parser.tg" as parser
import "src/compiler/eval.tg" as eval
import "src/compiler/codegen.tg" as codegen
import "src/compiler/codegen_llvm.tg" as codegen_llvm

func _basename_no_ext(path: String) -> String:
    let i = 0
    let last_sep = -1
    let last_dot = -1
    while (i < path.length()):
        let ch = path.substr(i, 1)
        if (ch == "/"):
            last_sep = i
            last_dot = -1
        if (ch == "\\"):
            last_sep = i
            last_dot = -1
        if (ch == "."):
            last_dot = i
        i = i + 1
    let start = last_sep + 1
    if (last_dot < start):
        last_dot = path.length()
    return path.substr(start, last_dot - start)

func _emit_ir_from_source(source: String, module_name: String) -> String:
    return codegen_llvm.emit_program_from_source(source, module_name)

func _probe_clang(path: String) -> i32:
    let cmd = path + " --version"
    return process.run(cmd)

func _detect_clang() -> String:
    if (_probe_clang("clang") == 0):
        return "clang"
    let clang_win = "C:\\Program Files\\LLVM\\bin\\clang.exe"
    if (_probe_clang(clang_win) == 0):
        return clang_win
    let clang_local = "llvm/clang+llvm-21.1.8-x86_64-pc-windows-msvc/bin/clang.exe"
    if (_probe_clang(clang_local) == 0):
        return clang_local
    let clang_usr_bin = "/usr/bin/clang"
    if (_probe_clang(clang_usr_bin) == 0):
        return clang_usr_bin
    let clang_usr_local = "/usr/local/bin/clang"
    if (_probe_clang(clang_usr_local) == 0):
        return clang_usr_local
    return ""

func main() -> i32:
    print("--- Thagore Compiler Driver (Pure Modules) ---")
    if (env.count() < 2):
        print("Usage: thg.exe [build] <script.tg> [-o output.exe] [-b|--build|-c|--compile|--emit-llvm|-ll]")
        return 0
    let build_mode = 0
    let compile_mode = 0
    let llvm_mode = 0
    let script_index = 1
    let output_override = ""
    if (env.get(1) == "build"):
        build_mode = 1
        script_index = 2
    if (script_index >= env.count()):
        print("Usage: thg.exe [build] <script.tg> [-o output.exe] [-b|--build|-c|--compile|--emit-llvm|-ll]")
        return 1
    let i = script_index + 1
    while (i < env.count()):
        let arg = env.get(i)
        if (arg == "-o"):
            if ((i + 1) >= env.count()):
                print("Error: missing output path after -o")
                return 1
            output_override = env.get(i + 1)
            i = i + 2
        else:
            if (arg == "-b"):
                build_mode = 1
            else:
                if (arg == "--build"):
                    build_mode = 1
                else:
                    if (arg == "-c"):
                        compile_mode = 1
                    else:
                        if (arg == "--compile"):
                            compile_mode = 1
                        else:
                            if (arg == "--emit-llvm"):
                                llvm_mode = 1
                            else:
                                if (arg == "-ll"):
                                        llvm_mode = 1
            i = i + 1
    if (build_mode == 1):
        llvm_mode = 0
        compile_mode = 0
    else:
        if (llvm_mode == 1):
            compile_mode = 0
    print("Loading script...")
    let input_path = env.get(script_index)
    let source = fs.read_text(input_path)
    if (source.length() == 0):
        print("Error: Empty file or file not found.")
        return 0
    let base = _basename_no_ext(input_path)
    let output_exe = output_override
    if (output_exe.length() == 0):
        output_exe = base + ".exe"
    let output_ll = base + ".ll"
    let core_ir = ""
    let user_ir = ""
    let merged_ir = ""
    if (build_mode == 1):
        print("Source loaded. Generating IR...")
        core_ir = codegen_llvm.system_decls()
        user_ir = _emit_ir_from_source(source, base)
        if (user_ir.length() == 0):
            print("Error: LLVM IR generation failed")
            return 1
        merged_ir = core_ir + user_ir
        print("Build mode active. Compiling to executable...")
        let ok_temp = fs.write_text(output_ll, merged_ir)
        if (ok_temp == 0):
            print("Error: cannot write LLVM IR file")
            return 1
        let clang_bin = _detect_clang()
        if (clang_bin.length() == 0):
            print("CRITICAL: Clang not found via PATH or standard locations. Please install LLVM.")
            return 1
        let cmd = clang_bin + " " + output_ll + " thag_runtime.lib -o " + output_exe + " -Wno-override-module"
        let build_code = process.run(cmd)
        if (build_code == 0):
            print("Build success.")
            print(output_exe)
            return 0
        print("Build failed. Ensure clang is installed and available in PATH.")
        print("Command executed:")
        print(cmd)
        return build_code
    if (llvm_mode == 1):
        print("Source loaded. Generating IR...")
        core_ir = codegen_llvm.system_decls()
        user_ir = _emit_ir_from_source(source, base)
        if (user_ir.length() == 0):
            print("Error: LLVM IR generation failed")
            return 1
        merged_ir = core_ir + user_ir
        print("LLVM mode active. Generating LLVM IR...")
        let ok_ll = fs.write_text(output_ll, merged_ir)
        if (ok_ll == 0):
            print("Error: cannot write LLVM IR file")
            return 1
        let clang_bin = _detect_clang()
        if (clang_bin.length() == 0):
            print("CRITICAL: Clang not found via PATH or standard locations. Please install LLVM.")
            return 1
        print("Generated LLVM IR successfully:")
        print(output_ll)
        print("Compile with: " + clang_bin + " " + output_ll + " thag_runtime.lib -o " + output_exe + " -Wno-override-module")
        return 0
    if (compile_mode == 1):
        let program_ast = parser.parse_program(source)
        print("Compile mode active. Generating C source...")
        let c_code = codegen.emit_program(program_ast)
        parser.free_tree(program_ast)
        let ok = fs.write_text("out.c", c_code)
        if (ok == 0):
            print("Error: cannot write out.c")
            return 1
        print("Generated out.c successfully.")
        print("Compile with: gcc out.c -o out")
        return 0
    print("Parsing complete. Executing...")
    print("----------------------------------------")
    let program_ast = parser.parse_program(source)
    let interpreter = eval.new()
    let exit_code = interpreter.exec_stmt(program_ast)
    eval.dispose(interpreter)
    parser.free_tree(program_ast)
    print("----------------------------------------")
    print("Execution finished with code:")
    print(exit_code)
    return exit_code
