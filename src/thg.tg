import env
import fs
import process
import "src/compiler/parser.tg" as parser
import "src/compiler/eval.tg" as eval
import "src/compiler/codegen.tg" as codegen
import "src/compiler/codegen_llvm.tg" as codegen_llvm

extern func __thg_path_to_exe(input_path: String) -> String
extern func __thg_build_temp_ll(output_path: String) -> i32

func main() -> i32:
    print("--- Thagore Dual-Mode Runtime v1.0 ---")

    if (env.count() < 2):
        print("Usage: thg.exe <script.tg> [-b|--build|-c|--compile|--emit-llvm|-ll]")
        return 0

    let build_mode = 0
    let compile_mode = 0
    let llvm_mode = 0
    let i = 2
    while (i < env.count()):
        let arg = env.get(i)
        if (arg == "-b"):
            build_mode = 1
        else:
            if (arg == "--build"):
                build_mode = 1
            else:
                if (arg == "-c"):
                    compile_mode = 1
                else:
                    if (arg == "--compile"):
                        compile_mode = 1
                    else:
                        if (arg == "--emit-llvm"):
                            llvm_mode = 1
                        else:
                            if (arg == "-ll"):
                                llvm_mode = 1
        i = i + 1

    if (build_mode == 1):
        llvm_mode = 0
        compile_mode = 0
    else:
        if (llvm_mode == 1):
            compile_mode = 0

    print("Loading script...")
    let source = fs.read_text(env.get(1))
    if (source.length() == 0):
        print("Error: Empty file or file not found.")
        return 0

    print("Source loaded. Parsing...")
    let program_ast = parser.parse_program(source)

    if (build_mode == 1):
        print("Build mode active. Generating LLVM IR...")
        let llvm_ir = codegen_llvm.emit_program(program_ast)
        let ok_temp = fs.write_text("temp.ll", llvm_ir)
        if (ok_temp == 0):
            print("Error: cannot write temp.ll")
            return 1
        let output_name = __thg_path_to_exe(env.get(1))
        let build_code = __thg_build_temp_ll(output_name)
        process.run("cmd /C del /Q temp.ll >nul 2>nul")
        if (build_code == 0):
            print("Build success.")
            print(output_name)
            return 0
        print("Build failed. Ensure clang is installed and available in PATH.")
        print("Command: clang temp.ll -o <output>.exe -Wno-override-module")
        return build_code

    if (llvm_mode == 1):
        print("LLVM mode active. Generating LLVM IR...")
        let llvm_ir = codegen_llvm.emit_program(program_ast)
        let ok_ll = fs.write_text("out.ll", llvm_ir)
        if (ok_ll == 0):
            print("Error: cannot write out.ll")
            return 1
        print("Generated out.ll successfully.")
        print("Compile with: clang out.ll -o out")
        return 0

    if (compile_mode == 1):
        print("Compile mode active. Generating C source...")
        let c_code = codegen.emit_program(program_ast)
        let ok = fs.write_text("out.c", c_code)
        if (ok == 0):
            print("Error: cannot write out.c")
            return 1
        print("Generated out.c successfully.")
        print("Compile with: gcc out.c -o out")
        return 0

    print("Parsing complete. Executing...")
    print("----------------------------------------")
    let interpreter = eval.new()
    let exit_code = interpreter.exec_stmt(program_ast)

    print("----------------------------------------")
    print("Execution finished with code:")
    print(exit_code)
    return exit_code
