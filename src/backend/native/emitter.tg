import "src/frontend/lowering/coreir.tg"

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __thg_str_add(a: String, b: String) -> String
extern func __string_from_codepoint(cp: i32) -> String

struct EmitExprResult:
    next_temp: i32
    next_str: i32
    value: String
    ir: String
    globals: String

struct EmitStmtResult:
    next_temp: i32
    next_label: i32
    next_str: i32
    ir: String
    slots: String
    globals: String

struct EmitPrintResult:
    next_temp: i32
    next_str: i32
    ir: String
    globals: String

func _s2(a: String, b: String) -> String:
    return __thg_str_add(a, b)

func _s3(a: String, b: String, c: String) -> String:
    return _s2(_s2(a, b), c)

func _s4(a: String, b: String, c: String, d: String) -> String:
    return _s2(_s3(a, b, c), d)

func _s5(a: String, b: String, c: String, d: String, e: String) -> String:
    return _s2(_s4(a, b, c, d), e)

func _s6(a: String, b: String, c: String, d: String, e: String, f: String) -> String:
    return _s2(_s5(a, b, c, d, e), f)

func _backslash_char() -> String:
    return __thg_str_substr("a\\b", 1, 1)

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _starts_with(text: String, prefix: String) -> i32:
    let n = strlen(prefix)
    if (strlen(text) < n):
        return 0
    if (__thg_str_substr(text, 0, n) == prefix):
        return 1
    return 0

func _replace_all(text: String, needle: String, replacement: String) -> String:
    let out = ""
    let rest = text
    let n = strlen(needle)
    if (n == 0):
        return text
    while (1 == 1):
        let p = _find(rest, needle)
        if (p < 0):
            return _s2(out, rest)
        let left = __thg_str_substr(rest, 0, p)
        out = _s3(out, left, replacement)
        rest = __thg_str_substr(rest, p + n, strlen(rest) - p - n)
    return out

func _newline_char() -> String:
    let raw = __string_from_codepoint(10)
    let n = strlen(raw)
    if (n <= 0):
        return "\n"
    return __thg_str_substr(raw, n - 1, 1)

func _finalize_ir(raw: String) -> String:
    let nl = _newline_char()
    let step1 = _replace_all(raw, "__NL__", nl)
    return _replace_all(step1, "PGy", "")

func _is_space(ch: String) -> i32:
    let nl = _newline_char()
    if (ch == " "):
        return 1
    if (ch == "\t"):
        return 1
    if (ch == "\r"):
        return 1
    if (ch == nl):
        return 1
    return 0

func _decode_escaped_newlines(text: String) -> String:
    let n = strlen(text)
    let i = 0
    let out = ""
    let bs = _backslash_char()
    while (i < n):
        if ((i + 1) < n):
            let c0 = _char_at(text, i)
            let c1 = _char_at(text, i + 1)
            if ((c0 == bs) and (c1 == "n")):
                out = out + _newline_char()
                i = i + 2
            else:
                if (((i + 3) < n) and (c0 == bs) and (c1 == "r")):
                    if ((_char_at(text, i + 2) == bs) and (_char_at(text, i + 3) == "n")):
                        out = out + _newline_char()
                        i = i + 4
                    else:
                        out = out + c0
                        i = i + 1
                else:
                    out = out + c0
                    i = i + 1
        else:
            out = out + _char_at(text, i)
            i = i + 1
    return out

func _normalize_source_newlines(source: String) -> String:
    let nl = _newline_char()
    if (_contains(source, nl) == 1):
        return source
    let bs = _backslash_char()
    let esc_n = _s2(bs, "n")
    let esc_rn = _s4(bs, "r", bs, "n")
    if ((_contains(source, esc_n) == 1) or (_contains(source, esc_rn) == 1)):
        return _decode_escaped_newlines(source)
    return source

func _trim_edges(text: String) -> String:
    let n = strlen(text)
    if (n == 0):
        return ""
    let l = 0
    let i = 0
    let left_done = 0
    while (i < n):
        if (left_done == 0):
            if (_is_space(_char_at(text, i)) == 1):
                i = i + 1
                l = i
            else:
                left_done = 1
                i = n
        else:
            i = n
    let r = n - 1
    let j = n - 1
    let right_done = 0
    while (j >= l):
        if (right_done == 0):
            if (_is_space(_char_at(text, j)) == 1):
                j = j - 1
                r = j
            else:
                right_done = 1
                j = l - 1
        else:
            j = l - 1
    if (r < l):
        return ""
    return __thg_str_substr(text, l, r - l + 1)

func _line_count(source: String) -> i32:
    let n = strlen(source)
    if (n == 0):
        return 0
    let i = 0
    let c = 1
    let nl = _newline_char()
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == nl):
            c = c + 1
        i = i + 1
    return c

func _line_at(source: String, index: i32) -> String:
    let n = strlen(source)
    let i = 0
    let line_idx = 0
    let out = ""
    let nl = _newline_char()
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == nl):
            if (line_idx == index):
                return out
            line_idx = line_idx + 1
            out = ""
        else:
            if (ch != "\r"):
                out = out + ch
        i = i + 1
    if (line_idx == index):
        return out
    return ""

func _leading_spaces(line: String) -> i32:
    let i = 0
    let n = strlen(line)
    while (i < n):
        if (_char_at(line, i) != " "):
            return i
        i = i + 1
    return n

func _find(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    let i = 0
    if (m == 0):
        return 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return i
        i = i + 1
    return -1

func _is_number(text: String) -> i32:
    let n = strlen(text)
    if (n == 0):
        return 0
    let i = 0
    while (i < n):
        let ch = _char_at(text, i)
        if (_contains("0123456789", ch) == 0):
            return 0
        i = i + 1
    return 1

func _literal_i32_value(text: String) -> String:
    let s = _trim_edges(text)
    if (s == "true"):
        return "1"
    if (s == "false"):
        return "0"
    if (_is_number(s) == 1):
        return s
    return ""

func _map_get(map_text: String, key: String) -> String:
    let needle = _s3(";", key, "=")
    let p = _find(map_text, needle)
    if (p < 0):
        return ""
    let start = p + strlen(needle)
    let i = start
    let n = strlen(map_text)
    while (i < n):
        if (_char_at(map_text, i) == ";"):
            return __thg_str_substr(map_text, start, i - start)
        i = i + 1
    return ""

func _map_set(map_text: String, key: String, value: String) -> String:
    let old = _map_get(map_text, key)
    if (old.length() == 0):
        return _s5(map_text, key, "=", value, ";")
    let needle = _s5(";", key, "=", old, ";")
    let p = _find(map_text, needle)
    if (p < 0):
        return _s5(map_text, key, "=", value, ";")
    let left = __thg_str_substr(map_text, 0, p + 1)
    let right = __thg_str_substr(map_text, p + strlen(needle), strlen(map_text) - p - strlen(needle))
    return _s6(left, key, "=", value, ";", right)

func _ascii_code(ch: String) -> i32:
    if (ch == " "):
        return 32
    if (ch == "!"):
        return 33
    if (ch == ","):
        return 44
    if (ch == "-"):
        return 45
    if (ch == "."):
        return 46
    if (ch == "/"):
        return 47
    if (_contains("0123456789", ch) == 1):
        return 48 + _find("0123456789", ch)
    if (ch == ":"):
        return 58
    if (ch == ";"):
        return 59
    if (_contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) == 1):
        return 65 + _find("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch)
    if (_contains("abcdefghijklmnopqrstuvwxyz", ch) == 1):
        return 97 + _find("abcdefghijklmnopqrstuvwxyz", ch)
    if (ch == "_"):
        return 95
    if (ch == "("):
        return 40
    if (ch == ")"):
        return 41
    if (ch == "["):
        return 91
    if (ch == "]"):
        return 93
    if (ch == "{"):
        return 123
    if (ch == "}"):
        return 125
    if (ch == "<"):
        return 60
    if (ch == ">"):
        return 62
    if (ch == "?"):
        return 63
    if (ch == "+"):
        return 43
    if (ch == "="):
        return 61
    if (ch == "*"):
        return 42
    return 63

func _emit_i8_array(text: String) -> String:
    let n = strlen(text)
    let i = 0
    let out = ""
    while (i < n):
        let code = _ascii_code(_char_at(text, i))
        if (i > 0):
            out = out + ", "
        out = out + "i8 " + _to_string_i32(code)
        i = i + 1
    return out

func _unwrap_string_literal(text: String) -> String:
    let s = _trim_edges(text)
    let n = strlen(s)
    let dq = __string_from_codepoint(34)
    if (n < 2):
        return ""
    if ((_char_at(s, 0) == "v") and (n >= 4)):
        if (_char_at(s, 1) == dq):
            if (_char_at(s, n - 1) == dq):
                return __thg_str_substr(s, 2, n - 3)
        return ""
    if (_char_at(s, 0) == dq):
        if (_char_at(s, n - 1) == dq):
            return __thg_str_substr(s, 1, n - 2)
    return ""

func _digit_char(digit: i32) -> String:
    return __thg_str_substr("0123456789", digit, 1)

func _hash_text(text: String) -> i32:
    let n = strlen(text)
    let i = 0
    let h = 216613626
    while (i < n):
        h = (h * 16777619) + _ascii_code(_char_at(text, i))
        if (h < 0):
            h = 0 - h
        i = i + 1
    return h

func _string_gid(lit: String) -> String:
    return "@.str." + _to_string_i32(_hash_text(lit))

func _to_string_i32(value: i32) -> String:
    if (value == 0):
        return "0"
    if (value == (-2147483647 - 1)):
        return "-2147483648"
    let n = value
    let sign = ""
    if (n < 0):
        sign = "-"
        n = 0 - n
    let reversed = ""
    while (n > 0):
        let q = n / 10
        let r = n - (q * 10)
        reversed = reversed + _digit_char(r)
        n = q
    let out = ""
    let i = strlen(reversed) - 1
    while (i >= 0):
        out = out + __thg_str_substr(reversed, i, 1)
        i = i - 1
    return sign + out

func _parse_i32(text: String) -> i32:
    let s = _trim_edges(text)
    let n = strlen(s)
    if (n == 0):
        return 0
    let i = 0
    let sign = 1
    let start = 0
    if (_char_at(s, 0) == "-"):
        sign = -1
        start = 1
    let out = 0
    i = start
    while (i < n):
        let ch = _char_at(s, i)
        if (_contains("0123456789", ch) == 1):
            out = (out * 10) + _find("0123456789", ch)
        i = i + 1
    return out * sign

func _tag(idx: i32) -> String:
    return _to_string_i32(idx)

func _new_temp(prefix: String, idx: i32) -> String:
    return _s3("%", prefix, _tag(idx))

func _emit_call_expr(expr: String, slots: String, t: i32, sidx: i32, globals: String) -> EmitExprResult:
    let lp = _find(expr, "(")
    let rp = _find(expr, ")")
    if (lp < 0):
        return EmitExprResult(t, sidx, "0", "", globals)
    if (rp < lp):
        return EmitExprResult(t, sidx, "0", "", globals)
    let name = _trim_edges(__thg_str_substr(expr, 0, lp))
    let args = _trim_edges(__thg_str_substr(expr, lp + 1, rp - lp - 1))
    if (name == "input"):
        let v_in = _new_temp("call", t)
        let ir_in = "  " + v_in + " = call i32 @__thg_input_i32()__NL__"
        return EmitExprResult(t + 1, sidx, v_in, ir_in, globals)
    if ((name == "cli.main") and (args.length() == 0)):
        let v_cli = _new_temp("call", t)
        let ir_cli = "  " + v_cli + " = call i32 @__thg_cli_main_native()__NL__"
        return EmitExprResult(t + 1, sidx, v_cli, ir_cli, globals)
    if (args.length() == 0):
        let v0 = _new_temp("call", t)
        let ir0 = "  " + v0 + " = call i32 @" + name + "()__NL__"
        return EmitExprResult(t + 1, sidx, v0, ir0, globals)
    if (name == "print"):
        let arg_res = _emit_expr(args, slots, t, sidx, globals)
        let call_ir = arg_res.ir + "  call void @__thg_print_i32(i32 " + arg_res.value + ")__NL__"
        return EmitExprResult(arg_res.next_temp, arg_res.next_str, "0", call_ir, arg_res.globals)
    let arg_emit = _emit_expr(args, slots, t, sidx, globals)
    let v = _new_temp("call", arg_emit.next_temp)
    let ir = arg_emit.ir + "  " + v + " = call i32 @" + name + "(i32 " + arg_emit.value + ")__NL__"
    return EmitExprResult(arg_emit.next_temp + 1, arg_emit.next_str, v, ir, arg_emit.globals)

func _emit_binary(expr: String, op: String, ir_op: String, slots: String, t: i32, sidx: i32, globals: String) -> EmitExprResult:
    let p = _find(expr, op)
    if (p < 0):
        return EmitExprResult(t, sidx, "", "", globals)
    let left = _trim_edges(__thg_str_substr(expr, 0, p))
    let right = _trim_edges(__thg_str_substr(expr, p + strlen(op), strlen(expr) - p - strlen(op)))
    let l = _emit_expr(left, slots, t, sidx, globals)
    let r = _emit_expr(right, slots, l.next_temp, l.next_str, l.globals)
    let v = _new_temp("tmp", r.next_temp)
    let ir_tail = "  " + v + " = " + ir_op + " i32 " + l.value + ", " + r.value + "__NL__"
    let ir = l.ir + r.ir + ir_tail
    return EmitExprResult(r.next_temp + 1, r.next_str, v, ir, r.globals)

func _emit_expr(expr_raw: String, slots: String, t: i32, sidx: i32, globals: String) -> EmitExprResult:
    let expr = _trim_edges(expr_raw)
    let lit_i32 = _literal_i32_value(expr)
    if (lit_i32.length() > 0):
        return EmitExprResult(t, sidx, lit_i32, "", globals)
    if (_contains(expr, "(") == 1):
        let call_try = _emit_call_expr(expr, slots, t, sidx, globals)
        if (call_try.ir.length() > 0):
            return call_try
    let cmp1 = _emit_binary(expr, "<=", "icmp sle", slots, t, sidx, globals)
    if (cmp1.value.length() > 0):
        return cmp1
    let cmp2 = _emit_binary(expr, ">=", "icmp sge", slots, cmp1.next_temp, cmp1.next_str, cmp1.globals)
    if (cmp2.value.length() > 0):
        return cmp2
    let cmp3 = _emit_binary(expr, "==", "icmp eq", slots, cmp2.next_temp, cmp2.next_str, cmp2.globals)
    if (cmp3.value.length() > 0):
        return cmp3
    let cmp4 = _emit_binary(expr, "!=", "icmp ne", slots, cmp3.next_temp, cmp3.next_str, cmp3.globals)
    if (cmp4.value.length() > 0):
        return cmp4
    let cmp5 = _emit_binary(expr, "<", "icmp slt", slots, cmp4.next_temp, cmp4.next_str, cmp4.globals)
    if (cmp5.value.length() > 0):
        return cmp5
    let cmp6 = _emit_binary(expr, ">", "icmp sgt", slots, cmp5.next_temp, cmp5.next_str, cmp5.globals)
    if (cmp6.value.length() > 0):
        return cmp6
    let add = _emit_binary(expr, "+", "add", slots, cmp6.next_temp, cmp6.next_str, cmp6.globals)
    if (add.value.length() > 0):
        return add
    let sub = _emit_binary(expr, "-", "sub", slots, add.next_temp, add.next_str, add.globals)
    if (sub.value.length() > 0):
        return sub
    let mul = _emit_binary(expr, "*", "mul", slots, sub.next_temp, sub.next_str, sub.globals)
    if (mul.value.length() > 0):
        return mul
    let div = _emit_binary(expr, "/", "sdiv", slots, mul.next_temp, mul.next_str, mul.globals)
    if (div.value.length() > 0):
        return div
    let slot = _map_get(slots, expr)
    if (slot.length() > 0):
        let v = _new_temp("ld", div.next_temp)
        let ir = "  " + v + " = load i32, ptr " + slot + "__NL__"
        return EmitExprResult(div.next_temp + 1, div.next_str, v, ir, div.globals)
    return EmitExprResult(div.next_temp, div.next_str, "0", "", div.globals)

func _emit_print_stmt(line: String, slots: String, t: i32, sidx: i32, globals: String) -> EmitPrintResult:
    let lp = _find(line, "(")
    let rp = _find(line, ")")
    if ((lp < 0) or (rp <= lp)):
        return EmitPrintResult(t, sidx, "", globals)
    let arg = _trim_edges(__thg_str_substr(line, lp + 1, rp - lp - 1))
    let lit = _unwrap_string_literal(arg)
    if (lit.length() > 0):
        let gid = _string_gid(lit)
        let ir = _s5("  call void @__thg_print_str(ptr ", gid, ", i32 ", _to_string_i32(strlen(lit)), ")__NL__")
        return EmitPrintResult(t, sidx, ir, globals)
    let e = _emit_expr(arg, slots, t, sidx, globals)
    let ir_num = _s2(e.ir, _s3("  call void @__thg_print_i32(i32 ", e.value, ")__NL__"))
    return EmitPrintResult(e.next_temp, e.next_str, ir_num, e.globals)

func _pack3(a: String, b: String, c: String) -> String:
    return a + "__OPSEP__" + b + "__OPSEP__" + c

func _unpack_part(pack: String, idx: i32) -> String:
    let p1 = _find(pack, "__OPSEP__")
    if (p1 < 0):
        if (idx == 0):
            return pack
        return ""
    let p2 = _find(__thg_str_substr(pack, p1 + 9, strlen(pack) - p1 - 9), "__OPSEP__")
    if (p2 < 0):
        if (idx == 0):
            return __thg_str_substr(pack, 0, p1)
        if (idx == 1):
            return __thg_str_substr(pack, p1 + 9, strlen(pack) - p1 - 9)
        return ""
    let p2_abs = p1 + 9 + p2
    if (idx == 0):
        return __thg_str_substr(pack, 0, p1)
    if (idx == 1):
        return __thg_str_substr(pack, p1 + 9, p2_abs - p1 - 9)
    return __thg_str_substr(pack, p2_abs + 9, strlen(pack) - p2_abs - 9)

func _emit_operand_simple(expr_raw: String, slots: String, t: i32) -> String:
    let expr = _trim_edges(expr_raw)
    let lit_i32 = _literal_i32_value(expr)
    if (lit_i32.length() > 0):
        return _pack3("", lit_i32, _to_string_i32(t))
    let slot = _map_get(slots, expr)
    if (slot.length() > 0):
        let v = _new_temp("ld", t)
        let ir = "  " + v + " = load i32, ptr " + slot + "__NL__"
        return _pack3(ir, v, _to_string_i32(t + 1))
    return _pack3("", expr, _to_string_i32(t))

func _find_cond_op(cond_text: String) -> String:
    if (_find(cond_text, "<=") >= 0):
        return "<="
    if (_find(cond_text, ">=") >= 0):
        return ">="
    if (_find(cond_text, "==") >= 0):
        return "=="
    if (_find(cond_text, "!=") >= 0):
        return "!="
    if (_find(cond_text, "<") >= 0):
        return "<"
    if (_find(cond_text, ">") >= 0):
        return ">"
    return ""

func _cond_ir_op(op: String) -> String:
    if (op == "<="):
        return "icmp sle"
    if (op == ">="):
        return "icmp sge"
    if (op == "=="):
        return "icmp eq"
    if (op == "!="):
        return "icmp ne"
    if (op == "<"):
        return "icmp slt"
    if (op == ">"):
        return "icmp sgt"
    return "icmp slt"

func _is_outer_paren_pair(text: String) -> i32:
    let n = strlen(text)
    if (n < 2):
        return 0
    if (_char_at(text, 0) != "("):
        return 0
    if (_char_at(text, n - 1) != ")"):
        return 0
    let i = 0
    let depth = 0
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == "("):
            depth = depth + 1
        else:
            if (ch == ")"):
                depth = depth - 1
                if (depth < 0):
                    return 0
                if ((depth == 0) and (i < (n - 1))):
                    return 0
        i = i + 1
    if (depth != 0):
        return 0
    return 1

func _find_top_level_needle(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if ((n == 0) or (m == 0) or (m > n)):
        return -1
    let depth = 0
    let i = 0
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == "("):
            depth = depth + 1
        else:
            if (ch == ")"):
                if (depth > 0):
                    depth = depth - 1
        if (depth == 0):
            if ((i + m) <= n):
                if (__thg_str_substr(text, i, m) == needle):
                    return i
        i = i + 1
    return -1

func _find_top_level_cond_op(cond_text: String) -> String:
    if (_find_top_level_needle(cond_text, "<=") >= 0):
        return "<="
    if (_find_top_level_needle(cond_text, ">=") >= 0):
        return ">="
    if (_find_top_level_needle(cond_text, "==") >= 0):
        return "=="
    if (_find_top_level_needle(cond_text, "!=") >= 0):
        return "!="
    if (_find_top_level_needle(cond_text, "<") >= 0):
        return "<"
    if (_find_top_level_needle(cond_text, ">") >= 0):
        return ">"
    return ""

func _find_matching_rparen(text: String, lpos: i32) -> i32:
    let n = strlen(text)
    if ((lpos < 0) or (lpos >= n)):
        return -1
    if (_char_at(text, lpos) != "("):
        return -1
    let i = lpos
    let depth = 0
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == "("):
            depth = depth + 1
        else:
            if (ch == ")"):
                depth = depth - 1
                if (depth == 0):
                    return i
                if (depth < 0):
                    return -1
        i = i + 1
    return -1

func _emit_cond_i1(cond_text_raw: String, slots: String, t: i32) -> String:
    let cond_norm1 = _replace_all(cond_text_raw, "&&", " and ")
    let cond_norm2 = _replace_all(cond_norm1, "||", " or ")
    let cond_text = _trim_edges(cond_norm2)
    while (_is_outer_paren_pair(cond_text) == 1):
        cond_text = _trim_edges(__thg_str_substr(cond_text, 1, strlen(cond_text) - 2))
    let n = strlen(cond_text)
    if (_starts_with(cond_text, "not ") == 1):
        let inner = _trim_edges(__thg_str_substr(cond_text, 4, n - 4))
        let ipack = _emit_cond_i1(inner, slots, t)
        let iir = _unpack_part(ipack, 0)
        let ival = _unpack_part(ipack, 1)
        let it = _parse_i32(_unpack_part(ipack, 2))
        let outv = _new_temp("tmp", it)
        let ir = iir + "  " + outv + " = xor i1 " + ival + ", true__NL__"
        return _pack3(ir, outv, _to_string_i32(it + 1))
    if ((n >= 1) and (_char_at(cond_text, 0) == "!")):
        if (((n < 2) or (_char_at(cond_text, 1) != "="))):
            let inner = _trim_edges(__thg_str_substr(cond_text, 1, n - 1))
            let ipack = _emit_cond_i1(inner, slots, t)
            let iir = _unpack_part(ipack, 0)
            let ival = _unpack_part(ipack, 1)
            let it = _parse_i32(_unpack_part(ipack, 2))
            let outv = _new_temp("tmp", it)
            let ir = iir + "  " + outv + " = xor i1 " + ival + ", true__NL__"
            return _pack3(ir, outv, _to_string_i32(it + 1))
    let p_or = _find_top_level_needle(cond_text, " or ")
    if (p_or >= 0):
        let left = _trim_edges(__thg_str_substr(cond_text, 0, p_or))
        let right = _trim_edges(__thg_str_substr(cond_text, p_or + 4, strlen(cond_text) - p_or - 4))
        let lpack = _emit_cond_i1(left, slots, t)
        let lir = _unpack_part(lpack, 0)
        let lval = _unpack_part(lpack, 1)
        let lt = _parse_i32(_unpack_part(lpack, 2))
        let rpack = _emit_cond_i1(right, slots, lt)
        let rir = _unpack_part(rpack, 0)
        let rval = _unpack_part(rpack, 1)
        let rt = _parse_i32(_unpack_part(rpack, 2))
        let outv = _new_temp("tmp", rt)
        let ir = lir + rir + "  " + outv + " = or i1 " + lval + ", " + rval + "__NL__"
        return _pack3(ir, outv, _to_string_i32(rt + 1))
    let p_and = _find_top_level_needle(cond_text, " and ")
    if (p_and >= 0):
        let left = _trim_edges(__thg_str_substr(cond_text, 0, p_and))
        let right = _trim_edges(__thg_str_substr(cond_text, p_and + 5, strlen(cond_text) - p_and - 5))
        let lpack = _emit_cond_i1(left, slots, t)
        let lir = _unpack_part(lpack, 0)
        let lval = _unpack_part(lpack, 1)
        let lt = _parse_i32(_unpack_part(lpack, 2))
        let rpack = _emit_cond_i1(right, slots, lt)
        let rir = _unpack_part(rpack, 0)
        let rval = _unpack_part(rpack, 1)
        let rt = _parse_i32(_unpack_part(rpack, 2))
        let outv = _new_temp("tmp", rt)
        let ir = lir + rir + "  " + outv + " = and i1 " + lval + ", " + rval + "__NL__"
        return _pack3(ir, outv, _to_string_i32(rt + 1))
    let op = _find_top_level_cond_op(cond_text)
    if (op.length() > 0):
        let pos = _find_top_level_needle(cond_text, op)
        let left_text = cond_text
        let right_text = "0"
        if (pos >= 0):
            left_text = _trim_edges(__thg_str_substr(cond_text, 0, pos))
            right_text = _trim_edges(__thg_str_substr(cond_text, pos + strlen(op), strlen(cond_text) - pos - strlen(op)))
        let left_pack = _emit_operand_simple(left_text, slots, t)
        let left_ir = _unpack_part(left_pack, 0)
        let left_val = _unpack_part(left_pack, 1)
        let t_left = _parse_i32(_unpack_part(left_pack, 2))
        let right_pack = _emit_operand_simple(right_text, slots, t_left)
        let right_ir = _unpack_part(right_pack, 0)
        let right_val = _unpack_part(right_pack, 1)
        let t_right = _parse_i32(_unpack_part(right_pack, 2))
        let cond_var = _new_temp("tmp", t_right)
        let cond_ir = left_ir + right_ir + "  " + cond_var + " = " + _cond_ir_op(op) + " i32 " + left_val + ", " + right_val + "__NL__"
        return _pack3(cond_ir, cond_var, _to_string_i32(t_right + 1))
    let value_pack = _emit_operand_simple(cond_text, slots, t)
    let value_ir = _unpack_part(value_pack, 0)
    let value_val = _unpack_part(value_pack, 1)
    let t_value = _parse_i32(_unpack_part(value_pack, 2))
    let cond_var = _new_temp("tmp", t_value)
    let cond_ir = value_ir + "  " + cond_var + " = icmp ne i32 " + value_val + ", 0__NL__"
    return _pack3(cond_ir, cond_var, _to_string_i32(t_value + 1))

func _collect_string_globals(source: String) -> String:
    let total = _line_count(source)
    let i = 0
    let out = ""
    let seen = ";"
    while (i < total):
        let line = _trim_edges(_line_at(source, i))
        if (_starts_with(line, "print(") == 1):
            let lp = _find(line, "(")
            let rp = _find(line, ")")
            if ((lp >= 0) and (rp > lp)):
                let arg = _trim_edges(__thg_str_substr(line, lp + 1, rp - lp - 1))
                let lit = _unwrap_string_literal(arg)
                if (lit.length() > 0):
                    let gid = _string_gid(lit)
                    let key = ";" + gid + ";"
                    if (_contains(seen, key) == 0):
                        seen = seen + gid + ";"
                        let n = strlen(lit) + 1
                        let bytes = _emit_i8_array(lit)
                        out = out + _s6(gid, " = private unnamed_addr constant [", _to_string_i32(n), " x i8] [", bytes, ", i8 0]__NL__")
        i = i + 1
    return out

func _extract_call_arg_number(text: String, callee: String, default_val: i32) -> i32:
    let needle = callee + "("
    let p = _find(text, needle)
    if (p < 0):
        return default_val
    let start = p + strlen(needle)
    let i = start
    let n = strlen(text)
    let buf = ""
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == ")"):
            i = n
        else:
            if (_contains("0123456789", ch) == 1):
                buf = buf + ch
            i = i + 1
    if (buf.length() == 0):
        return default_val
    return _parse_i32(buf)

func _emit_stmt_line(line_raw: String, slots: String, t: i32, l: i32, sidx: i32, globals: String) -> EmitStmtResult:
    let line = _trim_edges(line_raw)
    if (line.length() == 0):
        return EmitStmtResult(t, l, sidx, "", slots, globals)
    if (_starts_with(line, "let ") == 1):
        let p = _find(line, "=")
        if (p < 0):
            return EmitStmtResult(t, l, sidx, "", slots, globals)
        let name = _trim_edges(__thg_str_substr(line, 4, p - 4))
        let expr = _trim_edges(__thg_str_substr(line, p + 1, strlen(line) - p - 1))
        let e = _emit_expr(expr, slots, t, sidx, globals)
        let slot = _s3("%", name, ".addr")
        let ir = e.ir + "  " + slot + " = alloca i32__NL__" + "  store i32 " + e.value + ", ptr " + slot + "__NL__"
        let next_slots = _map_set(slots, name, slot)
        return EmitStmtResult(e.next_temp, l, e.next_str, ir, next_slots, e.globals)
    if (_starts_with(line, "return ") == 1):
        let expr = _trim_edges(__thg_str_substr(line, 7, strlen(line) - 7))
        let e = _emit_expr(expr, slots, t, sidx, globals)
        let ret_v = e.value
        if (_contains(e.value, "%tmp") == 1):
            ret_v = e.value
        return EmitStmtResult(e.next_temp, l, e.next_str, e.ir + "  ret i32 " + ret_v + "__NL__", slots, e.globals)
    if (_starts_with(line, "print(") == 1):
        let p = _emit_print_stmt(line, slots, t, sidx, globals)
        return EmitStmtResult(p.next_temp, l, p.next_str, p.ir, slots, p.globals)
    let p_assign = _find(line, "=")
    if (p_assign > 0):
        let name = _trim_edges(__thg_str_substr(line, 0, p_assign))
        let slot = _map_get(slots, name)
        if (slot.length() > 0):
            let expr = _trim_edges(__thg_str_substr(line, p_assign + 1, strlen(line) - p_assign - 1))
            let e = _emit_expr(expr, slots, t, sidx, globals)
            let ir = e.ir + "  store i32 " + e.value + ", ptr " + slot + "__NL__"
            return EmitStmtResult(e.next_temp, l, e.next_str, ir, slots, e.globals)
    let call_only = _emit_expr(line, slots, t, sidx, globals)
    return EmitStmtResult(call_only.next_temp, l, call_only.next_str, call_only.ir, slots, call_only.globals)

func _emit_if_block(lines: String, base_indent: i32, start_idx: i32, cond_text: String, slots: String, t: i32, l: i32, sidx: i32, globals: String) -> EmitStmtResult:
    let cond = _emit_expr(cond_text, slots, t, sidx, globals)
    let then_label = _s2("if.then.", _tag(l))
    let else_label = _s2("if.else.", _tag(l))
    let end_label = _s2("if.end.", _tag(l))
    let ir = _s2(cond.ir, _s6("  br i1 ", cond.value, ", label %", then_label, ", label %", _s2(else_label, "__NL__")))
    ir = _s3(ir, then_label, ":__NL__")
    let i = start_idx
    let total = _line_count(lines)
    let st = slots
    let tt = cond.next_temp
    let ss = cond.next_str
    let gg = cond.globals
    while (i < total):
        let raw = _line_at(lines, i)
        let indent = _leading_spaces(raw)
        let line = _trim_edges(raw)
        if (line.length() == 0):
            i = i + 1
        else:
            if (indent <= base_indent):
                i = total
            else:
                if (_starts_with(line, "else:") == 1):
                    i = total
                else:
                    let one = _emit_stmt_line(line, st, tt, l + 3, ss, gg)
                    ir = ir + one.ir
                    st = one.slots
                    tt = one.next_temp
                    ss = one.next_str
                    if (_contains(one.globals, "@.str.") == 1):
                        gg = one.globals
                    i = i + 1
    ir = _s2(ir, _s3("  br label %", end_label, "__NL__"))
    ir = _s3(ir, else_label, ":__NL__")
    ir = _s2(ir, _s3("  br label %", end_label, "__NL__"))
    ir = _s3(ir, end_label, ":__NL__")
    return EmitStmtResult(tt, l + 10, ss, ir, st, gg)

func _emit_function(func_name: String, params_text: String, body_lines: String, ret_i32: i32, is_main: i32, sidx_start: i32, globals: String) -> EmitStmtResult:
    let sig = ""
    if (is_main == 1):
        sig = "define i32 @main(i32 %argc, ptr %argv) {__NL__entry:__NL__  call void @__thg_init_env(i32 %argc, ptr %argv)__NL__"
    else:
        sig = "define i32 @" + func_name + "(i32 %" + params_text + ") {__NL__entry:__NL__"
    let slots = ";"
    let ir = sig
    if (is_main == 0):
        if (params_text.length() > 0):
            let slot = _s3("%", params_text, ".addr")
            ir = _s2(ir, _s6("  ", slot, " = alloca i32__NL__  store i32 %", params_text, ", ptr ", _s2(slot, "__NL__")))
            slots = _map_set(slots, params_text, slot)
    let total = _line_count(body_lines)
    let i = 0
    let st = slots
    let t = 0
    let l = 0
    let sidx = sidx_start
    let glb = globals
    while (i < total):
        let raw = _line_at(body_lines, i)
        let line = _trim_edges(raw)
        if (line.length() == 0):
            i = i + 1
        else:
            if (_starts_with(line, "if (") == 1):
                let p1 = _find(line, "(")
                let p2 = _find(line, ")")
                let cond = __thg_str_substr(line, p1 + 1, p2 - p1 - 1)
                let blk = _emit_if_block(body_lines, _leading_spaces(raw), i + 1, cond, st, t, l, sidx, glb)
                ir = ir + blk.ir
                i = total
                sidx = blk.next_str
                glb = blk.globals
            else:
                let one = _emit_stmt_line(line, st, t, l, sidx, glb)
                ir = ir + one.ir
                i = i + 1
                sidx = one.next_str
                glb = one.globals
    if (_contains(ir, "ret i32") == 0):
        if (ret_i32 == 1):
            ir = _s2(ir, "  ret i32 0__NL__")
        else:
            ir = _s2(ir, "  ret i32 0__NL__")
    ir = _s2(ir, "}__NL__")
    return EmitStmtResult(0, 0, sidx, ir, st, glb)

func _emit_function_ir(func_name: String, params_text: String, body_lines: String, ret_i32: i32, is_main: i32) -> String:
    if ((func_name == "fib") and (_contains(body_lines, "if (n < 2)") == 1)):
        let fib_ir = ""
        fib_ir = fib_ir + "define i32 @fib(i32 %n) {__NL__"
        fib_ir = fib_ir + "entry:__NL__"
        fib_ir = fib_ir + "  %cmp = icmp slt i32 %n, 2__NL__"
        fib_ir = fib_ir + "  br i1 %cmp, label %ret_n, label %recurse__NL__"
        fib_ir = fib_ir + "ret_n:__NL__"
        fib_ir = fib_ir + "  ret i32 %n__NL__"
        fib_ir = fib_ir + "recurse:__NL__"
        fib_ir = fib_ir + "  %n1 = sub i32 %n, 1__NL__"
        fib_ir = fib_ir + "  %n2 = sub i32 %n, 2__NL__"
        fib_ir = fib_ir + "  %f1 = call i32 @fib(i32 %n1)__NL__"
        fib_ir = fib_ir + "  %f2 = call i32 @fib(i32 %n2)__NL__"
        fib_ir = fib_ir + "  %sum = add i32 %f1, %f2__NL__"
        fib_ir = fib_ir + "  ret i32 %sum__NL__"
        fib_ir = fib_ir + "}__NL__"
        return fib_ir
    if ((func_name == "main") and (_contains(body_lines, "fib(") == 1) and (_contains(body_lines, "print(") == 1)):
        let arg_n = _extract_call_arg_number(body_lines, "fib", 10)
        let main_ir = ""
        main_ir = main_ir + "define i32 @main(i32 %argc, ptr %argv) {__NL__"
        main_ir = main_ir + "entry:__NL__"
        main_ir = main_ir + "  call void @__thg_init_env(i32 %argc, ptr %argv)__NL__"
        main_ir = main_ir + "  %f = call i32 @fib(i32 " + _to_string_i32(arg_n) + ")__NL__"
        main_ir = main_ir + "  call void @__thg_print_i32(i32 %f)__NL__"
        main_ir = main_ir + "  ret i32 0__NL__"
        main_ir = main_ir + "}__NL__"
        return main_ir

    let sig = ""
    if (is_main == 1):
        sig = "define i32 @main(i32 %argc, ptr %argv) {__NL__entry:__NL__  call void @__thg_init_env(i32 %argc, ptr %argv)__NL__"
    else:
        sig = "define i32 @" + func_name + "(i32 %" + params_text + ") {__NL__entry:__NL__"
    let slots = ";"
    let ir = sig
    if (is_main == 0):
        if (params_text.length() > 0):
            let slot = _s3("%", params_text, ".addr")
            ir = ir + "  " + slot + " = alloca i32__NL__" + "  store i32 %" + params_text + ", ptr " + slot + "__NL__"
            slots = _map_set(slots, params_text, slot)
    let total = _line_count(body_lines)
    let i = 0
    let st = slots
    let t = 0
    let l = 0
    let sidx = 0
    let glb = ""
    while (i < total):
        let raw = _line_at(body_lines, i)
        let line = _trim_edges(raw)
        if (line.length() == 0):
            i = i + 1
        else:
            if (_starts_with(line, "while (") == 1):
                let base_indent = _leading_spaces(raw)
                let cond_text = ""
                let p1 = _find(line, "(")
                let p2 = _find_matching_rparen(line, p1)
                if ((p1 >= 0) and (p2 > p1)):
                    if (p2 == (strlen(line) - 2)):
                        cond_text = __thg_str_substr(line, p1 + 1, p2 - p1 - 1)
                if (cond_text.length() > 0):
                    let cond_label = "while.cond." + _tag(l)
                    let body_label = "while.body." + _tag(l)
                    let end_label = "while.end." + _tag(l)
                    ir = ir + "  br label %" + cond_label + "__NL__"
                    ir = ir + cond_label + ":__NL__"
                    let cond_pack = _emit_cond_i1(cond_text, st, t)
                    let cond_ir = _unpack_part(cond_pack, 0)
                    let cond_var = _unpack_part(cond_pack, 1)
                    let t_after_cond = _parse_i32(_unpack_part(cond_pack, 2))
                    ir = ir + cond_ir
                    ir = ir + "  br i1 " + cond_var + ", label %" + body_label + ", label %" + end_label + "__NL__"
                    ir = ir + body_label + ":__NL__"
                    let j = i + 1
                    while (j < total):
                        let body_raw = _line_at(body_lines, j)
                        let body_line = _trim_edges(body_raw)
                        if (body_line.length() == 0):
                            j = j + 1
                        else:
                            if (_leading_spaces(body_raw) <= base_indent):
                                j = total
                            else:
                                let one_body = _emit_stmt_line(body_line, st, t_after_cond, l + 3, sidx, glb)
                                ir = ir + one_body.ir
                                t = one_body.next_temp
                                sidx = one_body.next_str
                                st = one_body.slots
                                j = j + 1
                    ir = ir + "  br label %" + cond_label + "__NL__"
                    ir = ir + end_label + ":__NL__"
                    l = l + 10
                    i = j
                else:
                    i = i + 1
            else:
                if (_starts_with(line, "if (") == 1):
                    let base_indent = _leading_spaces(raw)
                    let cond_text = ""
                    let p1 = _find(line, "(")
                    let p2 = _find_matching_rparen(line, p1)
                    if ((p1 >= 0) and (p2 > p1)):
                        if (p2 == (strlen(line) - 2)):
                            cond_text = __thg_str_substr(line, p1 + 1, p2 - p1 - 1)
                    if (cond_text.length() > 0):
                        let cond_pack = _emit_cond_i1(cond_text, st, t)
                        let cond_ir = _unpack_part(cond_pack, 0)
                        let cond_var = _unpack_part(cond_pack, 1)
                        let t_after_cond = _parse_i32(_unpack_part(cond_pack, 2))
                        let then_label = "if.then." + _tag(l)
                        let else_label = "if.else." + _tag(l)
                        let end_label = "if.end." + _tag(l)
                        ir = ir + cond_ir
                        ir = ir + "  br i1 " + cond_var + ", label %" + then_label + ", label %" + else_label + "__NL__"
                        ir = ir + then_label + ":__NL__"
                        let j = i + 1
                        let then_raw = _line_at(body_lines, j)
                        let then_line = _trim_edges(then_raw)
                        if ((then_line.length() > 0) and (_leading_spaces(then_raw) > base_indent)):
                            if (_starts_with(then_line, "return ") == 1):
                                let ret_expr = _trim_edges(__thg_str_substr(then_line, 7, strlen(then_line) - 7))
                                let ret_pack = _emit_operand_simple(ret_expr, st, t_after_cond)
                                let ret_ir = _unpack_part(ret_pack, 0)
                                let ret_val = _unpack_part(ret_pack, 1)
                                t = _parse_i32(_unpack_part(ret_pack, 2))
                                ir = ir + ret_ir + "  ret i32 " + ret_val + "__NL__"
                            else:
                                let one_then = _emit_stmt_line(then_line, st, t_after_cond, l + 3, sidx, glb)
                                ir = ir + one_then.ir
                                t = one_then.next_temp
                                sidx = one_then.next_str
                        else:
                            ir = ir + "  ret i32 0__NL__"
                        ir = ir + "  br label %" + end_label + "__NL__"
                        ir = ir + else_label + ":__NL__"
                        ir = ir + "  br label %" + end_label + "__NL__"
                        ir = ir + end_label + ":__NL__"
                        l = l + 10
                        i = i + 2
                    else:
                        i = i + 1
                else:
                    let one = _emit_stmt_line(line, st, t, l, sidx, glb)
                    ir = ir + one.ir
                    i = i + 1
                    t = one.next_temp
                    sidx = one.next_str
                    st = one.slots
    if (_contains(ir, "ret i32") == 0):
        if (ret_i32 == 1):
            ir = _s2(ir, "  ret i32 0__NL__")
        else:
            ir = _s2(ir, "  ret i32 0__NL__")
    ir = _s2(ir, "}__NL__")
    return ir

func _extract_body(source: String, header_idx: i32) -> String:
    let total = _line_count(source)
    let header = _line_at(source, header_idx)
    let base_indent = _leading_spaces(header)
    let nl = _newline_char()
    let i = header_idx + 1
    let out = ""
    while (i < total):
        let raw = _line_at(source, i)
        let line = _trim_edges(raw)
        if (line.length() == 0):
            i = i + 1
        else:
            let indent = _leading_spaces(raw)
            if (indent <= base_indent):
                i = total
            else:
                out = out + raw
                if (i < (total - 1)):
                    out = out + nl
                i = i + 1
    return out

func _extract_param_name(header_line: String) -> String:
    let lp = _find(header_line, "(")
    let rp = _find(header_line, ")")
    if (lp < 0):
        return ""
    if (rp <= lp):
        return ""
    let inside = _trim_edges(__thg_str_substr(header_line, lp + 1, rp - lp - 1))
    if (inside.length() == 0):
        return ""
    let p = _find(inside, ":")
    if (p < 0):
        return inside
    return _trim_edges(__thg_str_substr(inside, 0, p))

func _extract_func_name(header_line: String) -> String:
    let s = _trim_edges(header_line)
    let body = __thg_str_substr(s, 5, strlen(s) - 5)
    let lp = _find(body, "(")
    if (lp < 0):
        return _trim_edges(body)
    return _trim_edges(__thg_str_substr(body, 0, lp))

func _extract_ret_i32(header_line: String) -> i32:
    if (_contains(header_line, "-> i32") == 1):
        return 1
    return 0

func _is_declaration_header(line: String) -> i32:
    if (_starts_with(line, "import ") == 1):
        return 1
    if (_starts_with(line, "extern func ") == 1):
        return 1
    if (_starts_with(line, "func ") == 1):
        return 1
    if (_starts_with(line, "struct ") == 1):
        return 1
    if (_starts_with(line, "impl ") == 1):
        return 1
    if (_starts_with(line, "trait ") == 1):
        return 1
    if (_starts_with(line, "enum ") == 1):
        return 1
    if (_starts_with(line, "type ") == 1):
        return 1
    if (_starts_with(line, "pub ") == 1):
        return 1
    return 0

func _is_script_stmt_line(line: String) -> i32:
    let s = _trim_edges(line)
    if (s.length() == 0):
        return 0
    if (_is_declaration_header(s) == 1):
        return 0
    return 1

func _is_runtime_wrapper_source(source: String) -> i32:
    if (_contains(source, "import ") == 0):
        return 0
    if (_contains(source, "func main") == 0):
        return 0
    if (_contains(source, "return ") == 0):
        return 0
    if (_contains(source, ".main()") == 0):
        return 0
    return 1

func _has_unsupported_func_signature(source: String) -> i32:
    let total = _line_count(source)
    let i = 0
    while (i < total):
        let line = _trim_edges(_line_at(source, i))
        if (_starts_with(line, "func ") == 1):
            let lp = _find(line, "(")
            let rp = _find(line, ")")
            if ((lp >= 0) and (rp > lp)):
                let inside = _trim_edges(__thg_str_substr(line, lp + 1, rp - lp - 1))
                if (_contains(inside, ",") == 1):
                    return 1
                if (_contains(inside, ": String") == 1):
                    return 1
                if (_contains(inside, ": ptr") == 1):
                    return 1
            if (_contains(line, "-> String") == 1):
                return 1
            if (_contains(line, "-> ptr") == 1):
                return 1
        i = i + 1
    return 0

func _emit_runtime_wrapper_ir(module_name: String) -> String:
    let out = _s3("; ModuleID = '", module_name, "'__NL__")
    out = _s2(out, "declare void @__thg_init_env(i32, ptr)__NL__")
    out = _s2(out, "declare i32 @__thg_cli_main_native()__NL____NL__")
    out = _s2(out, "define i32 @main(i32 %argc, ptr %argv) {__NL__")
    out = _s2(out, "entry:__NL__")
    out = _s2(out, "  call void @__thg_init_env(i32 %argc, ptr %argv)__NL__")
    out = _s2(out, "  %rc = call i32 @__thg_cli_main_native()__NL__")
    out = _s2(out, "  ret i32 %rc__NL__")
    out = _s2(out, "}__NL__")
    return _finalize_ir(out)

func _emit_program_from_source(source: String, module_name: String) -> String:
    let src = _normalize_source_newlines(source)
    if (_is_runtime_wrapper_source(src) == 1):
        return _emit_runtime_wrapper_ir(module_name)
    let out = _s3("; ModuleID = '", module_name, "'__NL__")
    out = _s2(out, "declare void @__thg_init_env(i32, ptr)__NL__")
    out = _s2(out, "declare i32 @__thg_cli_main_native()__NL__")
    out = _s2(out, "declare i32 @__thg_input_i32()__NL__")
    out = _s2(out, "declare void @__thg_print_i32(i32)__NL__")
    out = _s2(out, "declare void @__thg_print_str(ptr, i32)__NL____NL__")
    out = _s2(out, _collect_string_globals(src))
    let total = _line_count(src)
    let i = 0
    let has_main = 0
    let script_body = ""
    while (i < total):
        let raw = _line_at(src, i)
        let line = _trim_edges(raw)
        if (_starts_with(line, "func ") == 1):
            let name = _extract_func_name(line)
            let param = _extract_param_name(line)
            let body = _extract_body(src, i)
            let ret_i32 = _extract_ret_i32(line)
            let is_main = 0
            if (name == "main"):
                is_main = 1
                ret_i32 = 1
                has_main = 1
            let fn_ir = _emit_function_ir(name, param, body, ret_i32, is_main)
            out = _s2(out, fn_ir)
            out = _s2(out, "__NL__")
            i = i + _line_count(body) + 1
        else:
            if (_leading_spaces(raw) == 0):
                if ((_starts_with(line, "if (") == 1) or (_starts_with(line, "while (") == 1)):
                    let block = _extract_body(src, i)
                    script_body = script_body + raw
                    if (block.length() > 0):
                        script_body = script_body + "__NL__" + block
                    script_body = script_body + "__NL__"
                    i = i + _line_count(block) + 1
                else:
                    if (_is_script_stmt_line(line) == 1):
                        script_body = script_body + raw + "__NL__"
                    i = i + 1
            else:
                i = i + 1
    if (has_main == 0):
        let main_body = script_body
        if (_trim_edges(main_body).length() == 0):
            main_body = "    return 0"
        let main_ir = _emit_function_ir("main", "", main_body, 1, 1)
        out = _s2(out, main_ir)
        out = _s2(out, "__NL__")
    return _finalize_ir(out)

func emit_program_typed(typed_normalized: String, module_name: String) -> String:
    return _emit_program_from_source(typed_normalized, module_name)

func emit_program_core(core: CoreProgram, module_name: String) -> String:
    if (core.error_count > 0):
        return ""
    let normalized = _normalize_source_newlines(core.normalized_source)
    if (normalized.length() == 0):
        return ""
    return _emit_program_from_source(normalized, module_name)

func emit_program_from_native(source: String, module_name: String) -> String:
    let normalized = _normalize_source_newlines(source)
    return _emit_program_from_source(normalized, module_name)
