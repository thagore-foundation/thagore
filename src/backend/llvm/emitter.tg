import "src/backend/native/emitter.tg" as native_codegen
extern func __thg_codegen_emit_llvm_from_source(source: String, module_name: String) -> String
extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _is_cli_wrapper_source(source: String) -> i32:
    if (_contains(source, "src/cli/thagore.tg") == 0):
        return 0
    if (_contains(source, "func main() -> i32:") == 0):
        return 0
    if (_contains(source, "return cli.main()") == 0):
        return 0
    return 1

func _is_runtime_wrapper_source(source: String) -> i32:
    if (_contains(source, "src/cli/thagore.tg") == 0):
        return 0
    if (_contains(source, "func main() -> i32:") == 0):
        return 0
    if (_contains(source, "return cli.main()") == 0):
        return 0
    return 1

func emit_program(root: ptr) -> String:
    root = root
    return ""

func emit_program_from_source(source: String, module_name: String) -> String:
    if (_is_cli_wrapper_source(source) == 1):
        let ir_wrap = native_codegen.emit_program_from_native(source, module_name)
        if (ir_wrap.length() > 0):
            return ir_wrap
    if (_is_runtime_wrapper_source(source) == 1):
        let ir_runtime = native_codegen.emit_program_from_native(source, module_name)
        if (ir_runtime.length() > 0):
            return ir_runtime
    if ((_contains(source, "import ") == 1) or (_contains(source, "use ") == 1)):
        let helper_ir = __thg_codegen_emit_llvm_from_source(source, module_name)
        if (helper_ir.length() > 0):
            return helper_ir
    let ir = native_codegen.emit_program_from_native(source, module_name)
    if (ir.length() > 0):
        return ir
    return __thg_codegen_emit_llvm_from_source(source, module_name)

func emit_program_typed(typed_normalized: String, module_name: String) -> String:
    if (_is_cli_wrapper_source(typed_normalized) == 1):
        let ir_wrap = native_codegen.emit_program_typed(typed_normalized, module_name)
        if (ir_wrap.length() > 0):
            return ir_wrap
    if (_is_runtime_wrapper_source(typed_normalized) == 1):
        let ir_runtime = native_codegen.emit_program_typed(typed_normalized, module_name)
        if (ir_runtime.length() > 0):
            return ir_runtime
    if ((_contains(typed_normalized, "import ") == 1) or (_contains(typed_normalized, "use ") == 1)):
        let helper_ir = __thg_codegen_emit_llvm_from_source(typed_normalized, module_name)
        if (helper_ir.length() > 0):
            return helper_ir
    let ir = native_codegen.emit_program_typed(typed_normalized, module_name)
    if (ir.length() > 0):
        return ir
    return __thg_codegen_emit_llvm_from_source(typed_normalized, module_name)

func system_decls() -> String:
    return ""
