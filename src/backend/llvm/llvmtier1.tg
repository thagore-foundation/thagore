struct LLVMModuleRef:
    raw: ptr

struct LLVMContextRef:
    raw: ptr

struct LLVMTypeRef:
    raw: ptr

struct LLVMValueRef:
    raw: ptr

struct LLVMBuilderRef:
    raw: ptr

struct LLVMBasicBlockRef:
    raw: ptr

struct LLVMTargetMachineRef:
    raw: ptr

extern func LLVMContextCreate() -> ptr
