extern func LLVMInt32TypeInContext(ctx: ptr) -> ptr
extern func LLVMVoidTypeInContext(ctx: ptr) -> ptr
extern func LLVMPointerType(ty: ptr, address_space: i32) -> ptr
extern func LLVMFunctionType(ret_ty: ptr, param_types: ptr, param_count: i32, is_var_arg: i32) -> ptr

extern func LLVMAddFunction(module_ref: ptr, name: String, fn_ty: ptr) -> ptr
extern func LLVMAppendBasicBlockInContext(ctx: ptr, fn_value: ptr, name: String) -> ptr
extern func LLVMCreateBuilderInContext(ctx: ptr) -> ptr
extern func LLVMDisposeBuilder(builder: ptr) -> void
