extern func LLVMBuildSDiv(builder: ptr, lhs: ptr, rhs: ptr, name: String) -> ptr
extern func LLVMBuildICmp(builder: ptr, pred: i32, lhs: ptr, rhs: ptr, name: String) -> ptr
extern func LLVMBuildBr(builder: ptr, dest: ptr) -> ptr
extern func LLVMBuildCondBr(builder: ptr, cond: ptr, then_block: ptr, else_block: ptr) -> ptr

extern func LLVMConstInt(ty: ptr, value: i32, sign_extend: i32) -> ptr

extern func LLVMVerifyModule(module_ref: ptr, action: i32, out_message: ptr) -> i32
extern func LLVMDisposeMessage(message: ptr) -> void

extern func LLVMInitializeNativeTarget() -> i32
extern func LLVMInitializeNativeAsmPrinter() -> i32
extern func LLVMGetDefaultTargetTriple() -> ptr
