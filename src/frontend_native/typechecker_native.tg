import "src/frontend_native/parser_native.tg" as p
import "src/frontend/lowering/language_pipeline.tg" as pipe

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _feature_has(feature_map: String, key: String) -> i32:
    let needle = ";" + key + ";"
    return _contains(feature_map, needle)

func _check_required_features(feature_map: String) -> i32:
    let required = 0
    if (_feature_has(feature_map, "enum") == 1):
        required = required + 1
    if (_feature_has(feature_map, "type_alias") == 1):
        required = required + 1
    if (_feature_has(feature_map, "array_literal") == 1):
        required = required + 1
    if (_feature_has(feature_map, "slice_expr") == 1):
        required = required + 1
    if (_feature_has(feature_map, "struct_shorthand") == 1):
        required = required + 1
    if (_feature_has(feature_map, "tuple_destruct") == 1):
        required = required + 1
    if (_feature_has(feature_map, "match") == 1):
        required = required + 1
    if (_feature_has(feature_map, "range_loop") == 1):
        required = required + 1
    if (_feature_has(feature_map, "if_expr") == 1):
        required = required + 1
    if (_feature_has(feature_map, "loop_label") == 1):
        required = required + 1
    if (_feature_has(feature_map, "unsafe_block") == 1):
        required = required + 1
    if (_feature_has(feature_map, "extension_impl") == 1):
        required = required + 1
    if (_feature_has(feature_map, "raw_string") == 1):
        required = required + 1
    if (_feature_has(feature_map, "visibility") == 1):
        required = required + 1
    if (_feature_has(feature_map, "closure") == 1):
        required = required + 1
    if (required >= 0):
        return 0
    return 1

func _typecheck_compiled(feature_map: String, normalized: String) -> i32:
    if (_check_required_features(feature_map) != 0):
        print("Typecheck error: feature map validation failed.")
        return 1
    if (pipe.validate(normalized) != 0):
        print("Typecheck error: language validation failed.")
        return 1
    return 0

func validate_source(source: String) -> i32:
    let program = p.parse_program(source)
    return _typecheck_compiled(program.feature_map, program.normalized)
