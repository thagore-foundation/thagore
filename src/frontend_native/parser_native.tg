import "src/frontend/parser/parser_headers.tg" as headers
import "src/frontend_native/lexer_native.tg" as lx

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _is_space(ch: String) -> i32:
    if (ch == " "):
        return 1
    if (ch == "\t"):
        return 1
    if (ch == "\r"):
        return 1
    if (ch == "\n"):
        return 1
    return 0

func _trim_edges(text: String) -> String:
    let n = strlen(text)
    if (n == 0):
        return ""
    let l = 0
    let i = 0
    let left_done = 0
    while (i < n):
        if (left_done == 0):
            let ch = _char_at(text, i)
            if (_is_space(ch) == 1):
                i = i + 1
                l = i
            else:
                left_done = 1
                i = n
        else:
            i = n
    let r = n - 1
    let j = n - 1
    let right_done = 0
    while (j >= l):
        if (right_done == 0):
            let ch = _char_at(text, j)
            if (_is_space(ch) == 1):
                j = j - 1
                r = j
            else:
                right_done = 1
                j = l - 1
        else:
            j = l - 1
    if (r < l):
        return ""
    return __thg_str_substr(text, l, r - l + 1)

func _line_count(source: String) -> i32:
    let n = strlen(source)
    if (n == 0):
        return 0
    let i = 0
    let count = 1
    while (i < n):
        if (_char_at(source, i) == "\n"):
            count = count + 1
        i = i + 1
    return count

func _line_at(source: String, index: i32) -> String:
    let n = strlen(source)
    let i = 0
    let line_idx = 0
    let out = ""
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == "\n"):
            if (line_idx == index):
                return out
            line_idx = line_idx + 1
            out = ""
        else:
            if (ch != "\r"):
                out = out + ch
        i = i + 1
    if (line_idx == index):
        return out
    return ""

func _find(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    let i = 0
    if (m == 0):
        return 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return i
        i = i + 1
    return -1

func _extract_func_name(header_line: String) -> String:
    let s = _trim_edges(header_line)
    let body = __thg_str_substr(s, 5, strlen(s) - 5)
    let lp = _find(body, "(")
    if (lp < 0):
        return _trim_edges(body)
    return _trim_edges(__thg_str_substr(body, 0, lp))

func _parse_count(source: String, target: String) -> i32:
    let clean = lx.strip_comments(source)
    let total = _line_count(clean)
    let i = 0
    let out = 0
    while (i < total):
        let line = _trim_edges(_line_at(clean, i))
        if (line.length() > 0):
            if (target == "enum_payload"):
                let enum_name = headers.parse_enum_name(line)
                if (enum_name.length() > 0):
                    let p = _find(line, ":")
                    if (p >= 0):
                        let variants = _trim_edges(__thg_str_substr(line, p + 1, strlen(line) - p - 1))
                        if (_contains(variants, "(") == 1):
                            out = out + 1
            if (target == "match"):
                if (headers.is_match_header(line) == 1):
                    out = out + 1
            if (target == "range_loop"):
                if (headers.is_range_loop_header(line) == 1):
                    out = out + 1
            if (target == "if_expr"):
                if (headers.has_if_expression(line) == 1):
                    out = out + 1
            if (target == "closure"):
                if (headers.has_closure(line) == 1):
                    out = out + 1
            if (target == "unsafe"):
                if (headers.is_unsafe_block_header(line) == 1):
                    out = out + 1
            if (target == "extension_impl"):
                if (headers.is_extension_impl_header(line) == 1):
                    out = out + 1
            if (target == "visibility"):
                if (headers.parse_visibility_decl(line).length() > 0):
                    out = out + 1
            if (target == "tuple_destruct"):
                if (headers.has_tuple_destructuring(line) == 1):
                    out = out + 1
            if (target == "array_literal"):
                if (headers.has_array_literal(line) == 1):
                    out = out + 1
            if (target == "slice_expr"):
                if (headers.has_slice_expr(line) == 1):
                    out = out + 1
            if (target == "loop_label"):
                if (headers.has_loop_label(line) == 1):
                    out = out + 1
            if (target == "raw_string"):
                if (headers.has_raw_string(line) == 1):
                    out = out + 1
        i = i + 1
    return out

func parse_normalized(source: String) -> String:
    return lx.strip_comments(source)

func parse_enums(source: String) -> String:
    let clean = lx.strip_comments(source)
    let total = _line_count(clean)
    let i = 0
    let out = ";"
    while (i < total):
        let line = _trim_edges(_line_at(clean, i))
        let enum_name = headers.parse_enum_name(line)
        if (enum_name.length() > 0):
            let p = _find(line, ":")
            let variants = ""
            if (p >= 0):
                variants = _trim_edges(__thg_str_substr(line, p + 1, strlen(line) - p - 1))
            out = out + enum_name + "|" + variants + ";"
        i = i + 1
    return out

func parse_aliases(source: String) -> String:
    let clean = lx.strip_comments(source)
    let total = _line_count(clean)
    let i = 0
    let out = ";"
    while (i < total):
        let line = _trim_edges(_line_at(clean, i))
        let alias_name = headers.parse_type_alias_name(line)
        if (alias_name.length() > 0):
            let eq = _find(line, "=")
            let target = ""
            if (eq >= 0):
                target = _trim_edges(__thg_str_substr(line, eq + 1, strlen(line) - eq - 1))
            out = out + alias_name + "|" + target + ";"
        i = i + 1
    return out

func parse_funcs(source: String) -> String:
    let clean = lx.strip_comments(source)
    let total = _line_count(clean)
    let i = 0
    let out = ";"
    while (i < total):
        let line = _trim_edges(_line_at(clean, i))
        if (_contains(line, "func ") == 1):
            if (_find(line, "func ") == 0):
                let name = _extract_func_name(line)
                if (name.length() > 0):
                    out = out + name + "|;"
        i = i + 1
    return out

func parse_enum_payload_count(source: String) -> i32:
    return _parse_count(source, "enum_payload")

func parse_match_count(source: String) -> i32:
    return _parse_count(source, "match")

func parse_range_loop_count(source: String) -> i32:
    return _parse_count(source, "range_loop")

func parse_if_expr_count(source: String) -> i32:
    return _parse_count(source, "if_expr")

func parse_closure_count(source: String) -> i32:
    return _parse_count(source, "closure")

func parse_unsafe_count(source: String) -> i32:
    return _parse_count(source, "unsafe")

func parse_extension_impl_count(source: String) -> i32:
    return _parse_count(source, "extension_impl")

func parse_visibility_count(source: String) -> i32:
    return _parse_count(source, "visibility")

func parse_tuple_destruct_count(source: String) -> i32:
    return _parse_count(source, "tuple_destruct")

func parse_array_literal_count(source: String) -> i32:
    return _parse_count(source, "array_literal")

func parse_slice_expr_count(source: String) -> i32:
    return _parse_count(source, "slice_expr")

func parse_loop_label_count(source: String) -> i32:
    return _parse_count(source, "loop_label")

func parse_raw_string_count(source: String) -> i32:
    return _parse_count(source, "raw_string")
