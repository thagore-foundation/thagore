import "src/semantics/typedir/nodes.tg"
import "src/lowering/coreir/nodes.tg"
import "src/lowering/transform/validate/flow.tg" as validationflow
import "src/lowering/transform/preprocess/text.tg"
import "src/lowering/transform/preprocess/value.tg"
import "src/lowering/transform/preprocess/parse.tg"


func preprocess(source: String) -> String:
    return validationflow.preprocess(source)

func check_result_try_sugar(source: String) -> i32:
    return validationflow.check_result_try_sugar(source)

func check_defer_scope(source: String) -> i32:
    return validationflow.check_defer_scope(source)

func check_new_syntax_headers(source: String) -> i32:
    return validationflow.check_new_syntax_headers(source)

func check_intent_headers(source: String) -> i32:
    return validationflow.check_intent_headers(source)

func validate(source: String) -> i32:
    return validationflow.validate(source)

func _build_lower_rows(typed: ProgramT) -> String:
    let rows = ";"
    if (typed.enum_payload_count > 0):
        rows = rows + "lower.enum_payload|dispatch_payload;"
    if (typed.match_count > 0):
        rows = rows + "lower.match|tag_dispatch;"
    if (typed.range_loop_count > 0):
        rows = rows + "lower.range_loop|init_cond_inc;"
    if (typed.if_expr_count > 0):
        rows = rows + "lower.if_expr|temp_merge;"
    if (typed.closure_count > 0):
        rows = rows + "lower.closure|env_lifted_fn;"
    if (typed.tuple_destruct_count > 0):
        rows = rows + "lower.tuple_destruct|bind_components;"
    if (typed.result_sugar_count > 0):
        rows = rows + "lower.result_sugar|question_propagation;"
    if (typed.defer_scope_count > 0):
        rows = rows + "lower.defer_scope|scope_cleanup;"
    if (typed.comptime_count > 0):
        rows = rows + "lower.comptime|folded_expr;"
    return rows

func lower_program(typed: ProgramT) -> CoreProgram:
    let source_norm = _normalize_validation_source(typed.normalized)
    let lowered_source = preprocess(source_norm)
    let core = core_new(typed, lowered_source, _build_lower_rows(typed))
    if (validate(lowered_source) != 0):
        return core_set_error(core, "E_LOWER_VALIDATE", "lowering validation failed")
    return core