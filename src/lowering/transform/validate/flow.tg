import "src/semantics/traits/traits.tg" as gt
import "src/syntax/parser/header.tg" as ph
import "src/semantics/typedir/nodes.tg"
import "src/lowering/coreir/nodes.tg"
import "src/lowering/transform/preprocess/text.tg"
import "src/lowering/transform/preprocess/value.tg"
import "src/lowering/transform/preprocess/parse.tg"
import "src/lowering/transform/comptime/eval.tg"
import "src/lowering/transform/comptime/rewrite.tg"
import "src/semantics/flow/capability_registry.tg" as fcr



func _suggest_parenthesized_stmt_header(line: String, prefix: String) -> String:
    let s = _trim_edges(line)
    if (_starts_with(s, prefix) == 0):
        return ""
    let tail = _trim_edges(__thg_str_substr(s, strlen(prefix), strlen(s) - strlen(prefix)))
    if (tail.length() == 0):
        return ""
    if (_char_at(tail, tail.length() - 1) == ":"):
        tail = _trim_edges(__thg_str_substr(tail, 0, tail.length() - 1))
    if (tail.length() == 0):
        return ""
    if ((_char_at(tail, 0) == "(") and (_char_at(tail, tail.length() - 1) == ")")):
        return prefix + tail + ":"
    return prefix + "(" + tail + "):"

func _is_if_header_candidate(line: String) -> i32:
    if (_starts_with(line, "if ") == 1):
        return 1
    if (_starts_with(line, "if(") == 1):
        return 1
    return 0

func _is_while_header_candidate(line: String) -> i32:
    if (_starts_with(line, "while ") == 1):
        return 1
    if (_starts_with(line, "while(") == 1):
        return 1
    return 0

func _has_invalid_cond_stmt_headers(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    while (i < total):
        let line = _trim_edges(_line_at_raw(source, i))
        if (_is_if_header_candidate(line) == 1):
            if (ph.is_if_stmt_header(line) == 0):
                return 1
        if (_is_while_header_candidate(line) == 1):
            if (ph.is_while_stmt_header(line) == 0):
                return 1
        i = i + 1
    return 0

func preprocess(source: String) -> String:
    if (_has_invalid_cond_stmt_headers(source) == 1):
        return source
    let catalog = _collect_comptime_catalog(source)
    let folded = _fold_all_comptime_calls(catalog.source_wo_comptime_funcs, catalog.params_map, catalog.body_map)
    let total = _line_count_raw(folded)
    let i = 0
    let out = ""
    while (i < total):
        let line = _line_at_raw(folded, i)
        let t = _trim_edges(line)
        let keep = 1
        if (_starts_with(t, "trait ") == 1):
            keep = 0
        if (keep == 1):
            line = _rewrite_trait_impl_header(line)
            line = _rewrite_visibility_header(line)
            line = _rewrite_unsafe_header(line)
            line = _strip_generic_clause(line)
            out = out + line
            if (i < (total - 1)):
                out = out + "\n"
        i = i + 1
    return out

func check_result_try_sugar(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    let in_result_func = 0
    while (i < total):
        let line = _trim_edges(_line_at_raw(source, i))
        if (_find_char(line, _dq()) >= 0):
            i = i + 1
        else:
            if (_starts_with(line, "func ") == 1):
                if (_find_char(line, "?") >= 0):
                    in_result_func = 1
                else:
                    in_result_func = 0
            if (_find_char(line, "?") >= 0):
                if (in_result_func == 0):
                    fail = 1
            i = i + 1
    if (fail == 1):
        print("Semantic error: '?' is only allowed inside function returning Result...?.")
        return 1
    return 0

func check_defer_scope(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    let current_func_indent = -1
    while (i < total):
        let raw = _line_at_raw(source, i)
        let line = _trim_edges(raw)
        let indent = _leading_spaces(raw)
        if (_starts_with(line, "func ") == 1):
            current_func_indent = indent
        if (_is_blank(raw) == 0):
            if (indent <= current_func_indent):
                if (_starts_with(line, "func ") == 0):
                    current_func_indent = -1
        if (_starts_with(line, "defer ") == 1):
            if (current_func_indent < 0):
                fail = 1
        i = i + 1
    if (fail == 1):
        print("Semantic error: defer is only allowed inside function body.")
        return 1
    return 0

func check_new_syntax_headers(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    while (i < total):
        let line = _trim_edges(_line_at_raw(source, i))
        if (_starts_with(line, "pub ") == 1):
            if (ph.parse_visibility_decl(line).length() == 0):
                print("Semantic error: pub can only be used with func/struct/enum/type/impl/trait.")
                fail = 1
        if (_starts_with(line, "match ") == 1):
            if (ph.is_match_header(line) == 0):
                print("Semantic error: match header must end with ':'.")
                fail = 1
        if (_starts_with(line, "for ") == 1):
            if (_find_char(line, ":") < 0):
                if (_contains(line, " in ") == 1):
                    print("Semantic error [E_SYNTAX_FOR_HEADER] line " + _to_string_i32(i + 1) + ": range loop header must end with ':' (expected `for i in a..b:`).")
                    fail = 1
            if (_find_char(line, ":") >= 0):
                if (ph.is_range_loop_header(line) == 0):
                    if (_contains(line, " in ") == 1):
                        print("Semantic error: range loop must use 'for i in a..b:'.")
                        fail = 1
        if (_contains(line, "= for ") == 1):
            if ((_contains(line, " in ") == 1) and (_contains(line, "..") == 1)):
                print("Semantic error [E_SYNTAX_FOR_HEADER] line " + _to_string_i32(i + 1) + ": `for ... in ...` is a statement header, not an expression.")
                fail = 1
        if (_is_if_header_candidate(line) == 1):
            if (ph.is_if_stmt_header(line) == 0):
                print("Semantic error [E_SYNTAX_IF_HEADER] line " + _to_string_i32(i + 1) + ": if header must be `if (condition):`.")
                let fix_if = _suggest_parenthesized_stmt_header(line, "if ")
                if (fix_if.length() > 0):
                    print("Hint: rewrite as `" + fix_if + "`.")
                fail = 1
        if (_is_while_header_candidate(line) == 1):
            if (ph.is_while_stmt_header(line) == 0):
                print("Semantic error [E_SYNTAX_WHILE_HEADER] line " + _to_string_i32(i + 1) + ": while header must be `while (condition):`.")
                let fix_while = _suggest_parenthesized_stmt_header(line, "while ")
                if (fix_while.length() > 0):
                    print("Hint: rewrite as `" + fix_while + "`.")
                fail = 1
        if (_contains(line, "= if ") == 1):
            if (_contains(line, " else:") == 0):
                print("Semantic error: if-expression must be `let x = if cond: a else: b`.")
                fail = 1
            if (_contains(line, ":") == 0):
                print("Semantic error: if-expression must be `let x = if cond: a else: b`.")
                fail = 1
        if (_contains(line, " = |") == 1):
            if (ph.has_closure(line) == 0):
                print("Semantic error: closure must be `let f = |args| expr`.")
                fail = 1
        if (_starts_with(line, "unsafe") == 1):
            if (ph.is_unsafe_block_header(line) == 0):
                print("Semantic error: use unsafe block as 'unsafe:'.")
                fail = 1
        if (_starts_with(line, "impl ") == 1):
            if (_contains(line, " for ") == 1):
                if (ph.is_extension_impl_header(line) == 0):
                    print("Semantic error: extension impl must be 'impl Trait for Type:'.")
                    fail = 1
        i = i + 1
    return fail

func check_intent_headers(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    while (i < total):
        let raw = _line_at_raw(source, i)
        let line = _trim_edges(raw)
        let indent = _leading_spaces(raw)
        if (_starts_with(line, "intent ") == 1):
            let intent_kind = ph.parse_intent_kind(line)
            if (intent_kind.length() == 0):
                print("Semantic error: invalid intent header. Use intent func/loop/calc/block with ':'.")
                fail = 1
            else:
                let has_goal = 0
                let has_constraints = 0
                let has_constraint_item = 0
                let has_examples = 0
                let has_example_item = 0
                let body_seen = 0
                let in_constraints = 0
                let in_examples = 0
                let constraints_indent = -1
                let examples_indent = -1
                let j = i + 1
                while (j < total):
                    let body_raw = _line_at_raw(source, j)
                    let body_line = _trim_edges(body_raw)
                    let body_indent = _leading_spaces(body_raw)
                    if (body_line.length() == 0):
                        j = j + 1
                    else:
                        if (body_indent <= indent):
                            j = total
                        else:
                            body_seen = 1
                            if (ph.is_intent_goal_line(body_line) == 1):
                                has_goal = 1
                                in_constraints = 0
                                in_examples = 0
                            else:
                                if (ph.is_intent_constraints_header(body_line) == 1):
                                    has_constraints = 1
                                    in_constraints = 1
                                    in_examples = 0
                                    constraints_indent = body_indent
                                else:
                                    if (ph.is_intent_examples_header(body_line) == 1):
                                        has_examples = 1
                                        in_constraints = 0
                                        in_examples = 1
                                        examples_indent = body_indent
                                    else:
                                        if (in_constraints == 1):
                                            if (body_indent > constraints_indent):
                                                has_constraint_item = 1
                                            else:
                                                in_constraints = 0
                                        if (in_examples == 1):
                                            if (body_indent > examples_indent):
                                                has_example_item = 1
                                                if (_contains(body_line, "==") == 0):
                                                    print("Semantic error: example assertion must use '=='.")
                                                    fail = 1
                                            else:
                                                in_examples = 0
                            j = j + 1
                if (body_seen == 0):
                    print("Semantic error: intent block must contain goal and constraints sections.")
                    fail = 1
                if (has_goal == 0):
                    print("Semantic error: intent requires 'goal: <name>'.")
                    fail = 1
                if (has_constraints == 0):
                    print("Semantic error: intent requires 'constraints:' section.")
                    fail = 1
                if (has_constraints == 1):
                    if (has_constraint_item == 0):
                        print("Semantic error: constraints section must include at least one constraint line.")
                        fail = 1
                if (has_examples == 1):
                    if (has_example_item == 0):
                        print("Semantic error: examples section must include at least one assertion line.")
                        fail = 1
        i = i + 1
    return fail

func _flow_set_contains(set_text: String, name: String) -> i32:
    if (strlen(name) == 0):
        return 0
    if (_contains(set_text, ";" + name + ";") == 1):
        return 1
    return 0

func _flow_set_add(set_text: String, name: String) -> String:
    if (strlen(name) == 0):
        return set_text
    if (_flow_set_contains(set_text, name) == 1):
        return set_text
    return set_text + name + ";"

func _is_digit_char(ch: String) -> i32:
    if (_find_char("0123456789", ch) >= 0):
        return 1
    return 0

func _parse_positive_i32(text: String) -> i32:
    let s = _trim_edges(text)
    if (strlen(s) == 0):
        return -1
    let i = 0
    let value = 0
    while (i < strlen(s)):
        let ch = _char_at(s, i)
        if (_is_digit_char(ch) == 0):
            return -1
        value = (value * 10) + _find_char("0123456789", ch)
        i = i + 1
    if (value <= 0):
        return -1
    return value

func _flow_retry_count(line: String) -> i32:
    if (ph.is_flow_retry_line(line) == 0):
        return 0
    let s = _trim_edges(line)
    let body = _trim_edges(__thg_str_substr(s, 6, strlen(s) - 6))
    if (strlen(body) == 0):
        return -1
    let i = 0
    let digits = ""
    while (i < strlen(body)):
        let ch = _char_at(body, i)
        if (_is_digit_char(ch) == 1):
            digits = digits + ch
            i = i + 1
        else:
            i = strlen(body)
    return _parse_positive_i32(digits)

func _flow_timeout_token(line: String) -> String:
    if (ph.is_flow_timeout_line(line) == 0):
        return ""
    let s = _trim_edges(line)
    return _trim_edges(__thg_str_substr(s, 8, strlen(s) - 8))

func _valid_flow_timeout(token: String) -> i32:
    let t = _trim_edges(token)
    let n = strlen(t)
    if (n < 2):
        return 0
    let unit = ""
    let digits = ""
    if ((n >= 3) and (_char_at(t, n - 2) == "m") and (_char_at(t, n - 1) == "s")):
        unit = "ms"
        digits = __thg_str_substr(t, 0, n - 2)
    else:
        let tail = _char_at(t, n - 1)
        if ((tail == "s") or (tail == "m")):
            unit = tail
            digits = __thg_str_substr(t, 0, n - 1)
    if (strlen(unit) == 0):
        return 0
    if (_parse_positive_i32(digits) <= 0):
        return 0
    return 1

func _flow_timeout_ms(token: String) -> i32:
    let t = _trim_edges(token)
    let n = strlen(t)
    if (n < 2):
        return -1
    let digits = ""
    let mul = 0
    if ((n >= 3) and (_char_at(t, n - 2) == "m") and (_char_at(t, n - 1) == "s")):
        digits = __thg_str_substr(t, 0, n - 2)
        mul = 1
    else:
        let tail = _char_at(t, n - 1)
        if (tail == "s"):
            digits = __thg_str_substr(t, 0, n - 1)
            mul = 1000
        else:
            if (tail == "m"):
                digits = __thg_str_substr(t, 0, n - 1)
                mul = 60000
    if (mul <= 0):
        return -1
    let base = _parse_positive_i32(digits)
    if (base <= 0):
        return -1
    return base * mul

func _flow_step_expr(step_line: String) -> String:
    let s = _trim_edges(step_line)
    if (_starts_with(s, "step ") == 0):
        return ""
    let body = _trim_edges(__thg_str_substr(s, 5, strlen(s) - 5))
    let eq = _find_char(body, "=")
    if (eq < 0):
        return ""
    return _trim_edges(__thg_str_substr(body, eq + 1, strlen(body) - eq - 1))

func _flow_step_capability(step_line: String) -> String:
    let expr = _flow_step_expr(step_line)
    if (strlen(expr) == 0):
        return ""
    let dot = _find_char(expr, ".")
    if (dot <= 0):
        return ""
    let p = _find_char(expr, "(")
    if ((p >= 0) and (p < dot)):
        return ""
    return _trim_edges(__thg_str_substr(expr, 0, dot))

func _is_known_flow_capability(registry: String, cap: String) -> i32:
    return fcr.registry_is_known(registry, _trim_edges(cap))

func _flow_capability_supports_undo(registry: String, cap: String) -> i32:
    return fcr.registry_supports_undo(registry, _trim_edges(cap))

func _flow_capability_allows_irreversible(registry: String, cap: String) -> i32:
    return fcr.registry_allows_irreversible(registry, _trim_edges(cap))

func _flow_step_timeout_budget_ms(retry_count: i32, timeout_token: String) -> i32:
    let timeout_ms = _flow_timeout_ms(timeout_token)
    if (timeout_ms <= 0):
        return 0
    let attempts = retry_count + 1
    if (attempts < 1):
        return timeout_ms
    return timeout_ms * attempts

func _flow_strict_max_steps() -> i32:
    return 64

func _flow_strict_max_parallel_groups() -> i32:
    return 16

func _flow_strict_max_retry_budget() -> i32:
    return 64

func _flow_strict_max_timeout_budget_ms() -> i32:
    return 900000

func _validate_flow_step_policy(registry: String, step_id: String, step_line: i32, capability: String, has_undo: i32, has_irreversible: i32, has_idempotent: i32, retry_count: i32, timeout_token: String, strict_mode: i32) -> i32:
    let fail = 0
    if ((has_undo == 1) and (_flow_capability_supports_undo(registry, capability) == 0)):
        print("Semantic error [E_FLOW_CAPABILITY_UNDO_UNSUPPORTED] line " + _to_string_i32(step_line) + ": capability '" + capability + "' does not guarantee undo semantics.")
        fail = 1
    if ((has_irreversible == 1) and (_flow_capability_allows_irreversible(registry, capability) == 0)):
        print("Semantic error [E_FLOW_CAPABILITY_IRREVERSIBLE_UNSUPPORTED] line " + _to_string_i32(step_line) + ": capability '" + capability + "' must provide reversible contract (irreversible not allowed).")
        fail = 1
    if ((has_undo == 0) and (has_irreversible == 0)):
        print("Semantic error [E_FLOW_UNDO_REQUIRED] line " + _to_string_i32(step_line) + ": step '" + step_id + "' requires undo or irreversible.")
        fail = 1
    if ((retry_count > 0) and (has_idempotent == 0)):
        print("Semantic error [E_FLOW_RETRY_IDEMPOTENT] line " + _to_string_i32(step_line) + ": retry requires idempotent step contract.")
        fail = 1
    if ((retry_count > 0) and (strlen(timeout_token) == 0)):
        print("Semantic error [E_FLOW_RETRY_TIMEOUT] line " + _to_string_i32(step_line) + ": retry requires explicit timeout.")
        fail = 1
    if (strlen(timeout_token) > 0):
        if (_valid_flow_timeout(timeout_token) == 0):
            print("Semantic error [E_FLOW_TIMEOUT_FORMAT] line " + _to_string_i32(step_line) + ": timeout must use positive value with unit ms/s/m.")
            fail = 1
    if (strict_mode == 1):
        if (has_irreversible == 1):
            print("Semantic error [E_FLOW_STRICT_IRREVERSIBLE] line " + _to_string_i32(step_line) + ": irreversible is not allowed in strict flow mode.")
            fail = 1
        if (strlen(timeout_token) == 0):
            print("Semantic error [E_FLOW_STRICT_TIMEOUT] line " + _to_string_i32(step_line) + ": strict flow mode requires timeout on every step.")
            fail = 1
        if (retry_count > 5):
            print("Semantic error [E_FLOW_STRICT_RETRY_BUDGET] line " + _to_string_i32(step_line) + ": retry budget exceeds strict limit (max 5).")
            fail = 1
        let timeout_ms = _flow_timeout_ms(timeout_token)
        if ((retry_count > 0) and (timeout_ms > 0)):
            let min_budget = retry_count * 50
            if (timeout_ms < min_budget):
                print("Semantic error [E_FLOW_STRICT_TIMEOUT_BUDGET] line " + _to_string_i32(step_line) + ": timeout is too low for declared retry budget.")
                fail = 1
    return fail

func _check_flow_headers_internal(source: String, strict_mode: i32) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    let capability_registry = fcr.load_registry()
    while (i < total):
        let raw = _line_at_raw(source, i)
        let line = _trim_edges(raw)
        let indent = _leading_spaces(raw)
        if (ph.is_flow_header(line) == 1):
            let flow_id = ph.parse_flow_name(line)
            let seen_steps = ";"
            let flow_has_step = 0
            let j = i + 1
            let step_open = 0
            let step_indent = -1
            let step_line = -1
            let step_id = ""
            let step_capability = ""
            let step_has_undo = 0
            let step_has_irreversible = 0
            let step_has_idempotent = 0
            let step_on_error_count = 0
            let step_retry = 0
            let step_timeout = ""
            let flow_step_count = 0
            let flow_parallel_groups = 0
            let flow_retry_budget = 0
            let flow_timeout_budget_ms = 0
            let in_parallel = 0
            let parallel_indent = -1
            let parallel_line = -1
            let parallel_has_step = 0
            let in_flow = 1
            while ((j < total) and (in_flow == 1)):
                let body_raw = _line_at_raw(source, j)
                let body_line = _trim_edges(body_raw)
                let body_indent = _leading_spaces(body_raw)
                if (body_line.length() == 0):
                    j = j + 1
                else:
                    if (body_indent <= indent):
                        if (step_open == 1):
                            flow_retry_budget = flow_retry_budget + step_retry
                            flow_timeout_budget_ms = flow_timeout_budget_ms + _flow_step_timeout_budget_ms(step_retry, step_timeout)
                            fail = fail + _validate_flow_step_policy(capability_registry, step_id, step_line, step_capability, step_has_undo, step_has_irreversible, step_has_idempotent, step_retry, step_timeout, strict_mode)
                            step_open = 0
                        if (in_parallel == 1):
                            if (parallel_has_step == 0):
                                print("Semantic error [E_FLOW_PARALLEL_EMPTY] line " + _to_string_i32(parallel_line) + ": parallel block must contain at least one step.")
                            print("Semantic error [E_FLOW_BARRIER_REQUIRED] line " + _to_string_i32(parallel_line) + ": parallel block requires barrier before leaving flow body.")
                            fail = 1
                            in_parallel = 0
                        in_flow = 0
                    else:
                        if (step_open == 1):
                            if (body_indent <= step_indent):
                                flow_retry_budget = flow_retry_budget + step_retry
                                flow_timeout_budget_ms = flow_timeout_budget_ms + _flow_step_timeout_budget_ms(step_retry, step_timeout)
                                fail = fail + _validate_flow_step_policy(capability_registry, step_id, step_line, step_capability, step_has_undo, step_has_irreversible, step_has_idempotent, step_retry, step_timeout, strict_mode)
                                step_open = 0
                            else:
                                if (ph.is_flow_undo_line(body_line) == 1):
                                    step_has_undo = 1
                                if (ph.is_flow_retry_line(body_line) == 1):
                                    let parsed_retry = _flow_retry_count(body_line)
                                    if (parsed_retry <= 0):
                                        print("Semantic error [E_FLOW_RETRY_FORMAT] line " + _to_string_i32(j + 1) + ": retry must use positive integer.")
                                        fail = 1
                                    else:
                                        step_retry = parsed_retry
                                if (ph.is_flow_timeout_line(body_line) == 1):
                                    step_timeout = _flow_timeout_token(body_line)
                                if (ph.is_flow_idempotent_line(body_line) == 1):
                                    step_has_idempotent = 1
                                if (ph.is_flow_irreversible_line(body_line) == 1):
                                    step_has_irreversible = 1
                                    if (_starts_with(body_line, "irreversible reason") == 1):
                                        if (strlen(ph.parse_flow_irreversible_reason(body_line)) == 0):
                                            print("Semantic error [E_FLOW_IRREVERSIBLE_REASON_FORMAT] line " + _to_string_i32(j + 1) + ": irreversible reason must be quoted text.")
                                            fail = 1
                                if (_starts_with(body_line, "on_error") == 1):
                                    if (ph.is_flow_on_error_line(body_line) == 0):
                                        print("Semantic error [E_FLOW_ON_ERROR_FORMAT] line " + _to_string_i32(j + 1) + ": on_error requires non-empty handler expression.")
                                        fail = 1
                                    else:
                                        step_on_error_count = step_on_error_count + 1
                                        if (step_on_error_count > 1):
                                            print("Semantic error [E_FLOW_ON_ERROR_DUP] line " + _to_string_i32(j + 1) + ": duplicate on_error handler in same step.")
                                            fail = 1
                                j = j + 1
                        else:
                            if (ph.is_flow_parallel_header(body_line) == 1):
                                if (in_parallel == 1):
                                    print("Semantic error [E_FLOW_PARALLEL_NESTED] line " + _to_string_i32(j + 1) + ": nested parallel blocks are not supported.")
                                    fail = 1
                                else:
                                    in_parallel = 1
                                    flow_parallel_groups = flow_parallel_groups + 1
                                    parallel_indent = body_indent
                                    parallel_line = j + 1
                                    parallel_has_step = 0
                                j = j + 1
                            else:
                                if (ph.is_flow_barrier_line(body_line) == 1):
                                    if (in_parallel == 0):
                                        print("Semantic error [E_FLOW_BARRIER_WITHOUT_PARALLEL] line " + _to_string_i32(j + 1) + ": barrier requires an open parallel block.")
                                        fail = 1
                                    else:
                                        if (body_indent != parallel_indent):
                                            print("Semantic error [E_FLOW_BARRIER_INDENT] line " + _to_string_i32(j + 1) + ": barrier must align with parallel header indentation.")
                                            fail = 1
                                        if (parallel_has_step == 0):
                                            print("Semantic error [E_FLOW_PARALLEL_EMPTY] line " + _to_string_i32(parallel_line) + ": parallel block must contain at least one step.")
                                            fail = 1
                                        in_parallel = 0
                                        parallel_indent = -1
                                        parallel_line = -1
                                        parallel_has_step = 0
                                    j = j + 1
                                else:
                            if (ph.is_flow_step_line(body_line) == 1):
                                if (strict_mode == 1):
                                    let cap = _flow_step_capability(body_line)
                                    if ((strlen(cap) > 0) and (_is_known_flow_capability(capability_registry, cap) == 0)):
                                        print("Semantic error [E_FLOW_CAPABILITY_UNKNOWN] line " + _to_string_i32(j + 1) + ": unknown external flow capability '" + cap + "'.")
                                        fail = 1
                                if (in_parallel == 1):
                                    if (body_indent <= parallel_indent):
                                        print("Semantic error [E_FLOW_BARRIER_REQUIRED] line " + _to_string_i32(parallel_line) + ": missing barrier before exiting parallel block.")
                                                fail = 1
                                                in_parallel = 0
                                                parallel_indent = -1
                                                parallel_line = -1
                                                parallel_has_step = 0
                                            else:
                                                parallel_has_step = 1
                                        step_open = 1
                                        step_indent = body_indent
                                        step_line = j + 1
                                        step_id = ph.parse_flow_step_id(body_line)
                                        if (_flow_set_contains(seen_steps, step_id) == 1):
                                            print("Semantic error [E_FLOW_DUP_STEP_ID] line " + _to_string_i32(j + 1) + ": duplicate step id '" + step_id + "' in flow '" + flow_id + "'.")
                                            fail = 1
                                        else:
                                            seen_steps = _flow_set_add(seen_steps, step_id)
                                        step_capability = _flow_step_capability(body_line)
                                        step_has_undo = 0
                                        step_has_irreversible = 0
                                        step_has_idempotent = 0
                                        step_on_error_count = 0
                                        step_retry = 0
                                        step_timeout = ""
                                        flow_has_step = 1
                                        flow_step_count = flow_step_count + 1
                                        j = j + 1
                                    else:
                                        if ((in_parallel == 1) and (body_indent <= parallel_indent)):
                                            print("Semantic error [E_FLOW_BARRIER_REQUIRED] line " + _to_string_i32(parallel_line) + ": missing barrier before exiting parallel block.")
                                            fail = 1
                                            in_parallel = 0
                                            parallel_indent = -1
                                            parallel_line = -1
                                            parallel_has_step = 0
                                        j = j + 1
            if (step_open == 1):
                flow_retry_budget = flow_retry_budget + step_retry
                flow_timeout_budget_ms = flow_timeout_budget_ms + _flow_step_timeout_budget_ms(step_retry, step_timeout)
                fail = fail + _validate_flow_step_policy(capability_registry, step_id, step_line, step_capability, step_has_undo, step_has_irreversible, step_has_idempotent, step_retry, step_timeout, strict_mode)
            if (in_parallel == 1):
                if (parallel_has_step == 0):
                    print("Semantic error [E_FLOW_PARALLEL_EMPTY] line " + _to_string_i32(parallel_line) + ": parallel block must contain at least one step.")
                print("Semantic error [E_FLOW_BARRIER_REQUIRED] line " + _to_string_i32(parallel_line) + ": parallel block requires barrier before flow end.")
                fail = 1
            if (flow_has_step == 0):
                print("Semantic error [E_FLOW_EMPTY] line " + _to_string_i32(i + 1) + ": flow '" + flow_id + "' must contain at least one step.")
                fail = 1
            if (strict_mode == 1):
                if (flow_step_count > _flow_strict_max_steps()):
                    print("Semantic error [E_FLOW_STRICT_COMPLEXITY_STEPS] line " + _to_string_i32(i + 1) + ": flow '" + flow_id + "' has too many steps (" + _to_string_i32(flow_step_count) + "), max " + _to_string_i32(_flow_strict_max_steps()) + ".")
                    fail = 1
                if (flow_parallel_groups > _flow_strict_max_parallel_groups()):
                    print("Semantic error [E_FLOW_STRICT_COMPLEXITY_PARALLEL] line " + _to_string_i32(i + 1) + ": flow '" + flow_id + "' has too many parallel groups (" + _to_string_i32(flow_parallel_groups) + "), max " + _to_string_i32(_flow_strict_max_parallel_groups()) + ".")
                    fail = 1
                if (flow_retry_budget > _flow_strict_max_retry_budget()):
                    print("Semantic error [E_FLOW_STRICT_RETRY_GLOBAL_BUDGET] line " + _to_string_i32(i + 1) + ": flow '" + flow_id + "' retry budget is too high (" + _to_string_i32(flow_retry_budget) + "), max " + _to_string_i32(_flow_strict_max_retry_budget()) + ".")
                    fail = 1
                if (flow_timeout_budget_ms > _flow_strict_max_timeout_budget_ms()):
                    print("Semantic error [E_FLOW_STRICT_TIMEOUT_GLOBAL_BUDGET] line " + _to_string_i32(i + 1) + ": flow '" + flow_id + "' timeout budget is too high (" + _to_string_i32(flow_timeout_budget_ms) + "ms), max " + _to_string_i32(_flow_strict_max_timeout_budget_ms()) + "ms.")
                    fail = 1
        i = i + 1
    return fail

func check_flow_headers(source: String) -> i32:
    return _check_flow_headers_internal(source, 0)

func check_flow_headers_strict(source: String) -> i32:
    return _check_flow_headers_internal(source, 1)

func validate(source: String) -> i32:
    let normalized = _normalize_validation_source(source)
    let analyzed = _mask_string_literals(normalized)
    if (check_result_try_sugar(analyzed) != 0):
        return 1
    if (check_defer_scope(analyzed) != 0):
        return 1
    if (check_new_syntax_headers(analyzed) != 0):
        return 1
    if (check_intent_headers(analyzed) != 0):
        return 1
    if (check_flow_headers(analyzed) != 0):
        return 1
    return 0
