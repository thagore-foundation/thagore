import "src/frontend/semantic/traits.tg" as gt
import "src/frontend/parser/headers.tg" as ph
import "src/frontend/native/typedir.tg" as tir
import "src/frontend/lowering/coreir.tg" as cir

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __string_from_codepoint(cp: i32) -> String

struct ComptimeCatalog:
    source_wo_comptime_funcs: String
    params_map: String
    body_map: String

struct EvalBlockResult:
    has_return: i32
    return_value: i32
    env: String
    next_idx: i32

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _dq() -> String:
    return __string_from_codepoint(34)

func _bs() -> String:
    return __string_from_codepoint(92)

func _nl() -> String:
    return __string_from_codepoint(10)

func _cr() -> String:
    return __string_from_codepoint(13)

func _tab() -> String:
    return __string_from_codepoint(9)

func _mask_string_literals(text: String) -> String:
    let n = strlen(text)
    let i = 0
    let out = ""
    let in_str = 0
    let esc = 0
    while (i < n):
        let ch = _char_at(text, i)
        if (in_str == 0):
            if (ch == _dq()):
                in_str = 1
                esc = 0
                out = out + _dq()
            else:
                out = out + ch
        else:
            if (esc == 1):
                esc = 0
                if (ch == _nl()):
                    out = out + _nl()
                else:
                    out = out + " "
            else:
                if (ch == _bs()):
                    esc = 1
                    out = out + " "
                else:
                    if (ch == _dq()):
                        in_str = 0
                        out = out + _dq()
                    else:
                        if (ch == _nl()):
                            out = out + _nl()
                        else:
                            out = out + " "
        i = i + 1
    return out

func _decode_escaped_newlines(text: String) -> String:
    let n = strlen(text)
    let i = 0
    let out = ""
    while (i < n):
        if ((i + 1) < n):
            let c0 = _char_at(text, i)
            let c1 = _char_at(text, i + 1)
            if ((c0 == _bs()) and (c1 == "n")):
                out = out + _nl()
                i = i + 2
            else:
                if (((i + 3) < n) and (c0 == _bs()) and (c1 == "r")):
                    if ((_char_at(text, i + 2) == _bs()) and (_char_at(text, i + 3) == "n")):
                        out = out + _nl()
                        i = i + 4
                    else:
                        out = out + c0
                        i = i + 1
                else:
                    out = out + c0
                    i = i + 1
        else:
            out = out + _char_at(text, i)
            i = i + 1
    return out

func _normalize_validation_source(source: String) -> String:
    return _decode_escaped_newlines(source)

func _starts_with(text: String, prefix: String) -> i32:
    let pn = strlen(prefix)
    if (strlen(text) < pn):
        return 0
    if (__thg_str_substr(text, 0, pn) == prefix):
        return 1
    return 0

func _find_char(text: String, ch: String) -> i32:
    let i = 0
    let n = strlen(text)
    while (i < n):
        if (_char_at(text, i) == ch):
            return i
        i = i + 1
    return -1

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _find(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    let i = 0
    if (m == 0):
        return 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return i
        i = i + 1
    return -1

func _line_count(source: String) -> i32:
    let n = strlen(source)
    if (n == 0):
        return 0
    let i = 0
    let count = 1
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == _nl()):
            count = count + 1
        else:
            if ((i + 1) < n):
                if (__thg_str_substr(source, i, 2) == "\n"):
                    count = count + 1
                    i = i + 1
        i = i + 1
    return count

func _line_at(source: String, index: i32) -> String:
    let n = strlen(source)
    let i = 0
    let line_idx = 0
    let line = ""
    while (i < n):
        let ch = _char_at(source, i)
        let escaped_newline = 0
        if ((i + 1) < n):
            if (__thg_str_substr(source, i, 2) == "\n"):
                escaped_newline = 1
        if (ch == _nl()):
            if (line_idx == index):
                return line
            line_idx = line_idx + 1
            line = ""
        else:
            if (escaped_newline == 1):
                if (line_idx == index):
                    return line
                line_idx = line_idx + 1
                line = ""
                i = i + 1
            else:
                if (ch != _cr()):
                    line = line + ch
        i = i + 1
    if (line_idx == index):
        return line
    return ""

func _line_count_raw(source: String) -> i32:
    let n = strlen(source)
    if (n == 0):
        return 0
    let i = 0
    let count = 1
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == _nl()):
            count = count + 1
        i = i + 1
    return count

func _line_at_raw(source: String, index: i32) -> String:
    let n = strlen(source)
    let i = 0
    let line_idx = 0
    let line = ""
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == _nl()):
            if (line_idx == index):
                return line
            line_idx = line_idx + 1
            line = ""
        else:
            if (ch != _cr()):
                line = line + ch
        i = i + 1
    if (line_idx == index):
        return line
    return ""

func _leading_spaces(line: String) -> i32:
    let i = 0
    let n = strlen(line)
    while (i < n):
        if (_char_at(line, i) != " "):
            return i
        i = i + 1
    return n

func _is_blank(line: String) -> i32:
    if (strlen(_trim_edges(line)) == 0):
        return 1
    return 0

func _is_ws(ch: String) -> i32:
    if (ch == " "):
        return 1
    if (ch == _tab()):
        return 1
    if (ch == _cr()):
        return 1
    if (ch == _nl()):
        return 1
    return 0

func _trim_edges(text: String) -> String:
    let n = strlen(text)
    if (n == 0):
        return ""
    let l = 0
    let i = 0
    let left_done = 0
    while (i < n):
        if (left_done == 0):
            if (_is_ws(_char_at(text, i)) == 1):
                i = i + 1
                l = i
            else:
                left_done = 1
                i = n
        else:
            i = n
    let r = n - 1
    let j = n - 1
    let right_done = 0
    while (j >= l):
        if (right_done == 0):
            if (_is_ws(_char_at(text, j)) == 1):
                j = j - 1
                r = j
            else:
                right_done = 1
                j = l - 1
        else:
            j = l - 1
    if (r < l):
        return ""
    return __thg_str_substr(text, l, r - l + 1)

func _is_ident_char(ch: String) -> i32:
    if (ch == "_"):
        return 1
    if (_find_char("abcdefghijklmnopqrstuvwxyz", ch) >= 0):
        return 1
    if (_find_char("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) >= 0):
        return 1
    if (_find_char("0123456789", ch) >= 0):
        return 1
    return 0

func _replace_ident(text: String, old_name: String, new_name: String) -> String:
    if (strlen(old_name) == 0):
        return text
    let out = ""
    let i = 0
    let n = strlen(text)
    let k = strlen(old_name)
    while (i < n):
        let matched = 0
        if ((i + k) <= n):
            if (__thg_str_substr(text, i, k) == old_name):
                let left_ok = 1
                let right_ok = 1
                if (i > 0):
                    if (_is_ident_char(_char_at(text, i - 1)) == 1):
                        left_ok = 0
                if ((i + k) < n):
                    if (_is_ident_char(_char_at(text, i + k)) == 1):
                        right_ok = 0
                if (left_ok == 1):
                    if (right_ok == 1):
                        matched = 1
        if (matched == 1):
            out = out + new_name
            i = i + k
        else:
            out = out + _char_at(text, i)
            i = i + 1
    return out

func _replace_all(text: String, old_frag: String, new_frag: String) -> String:
    if (strlen(old_frag) == 0):
        return text
    let out = ""
    let i = 0
    let n = strlen(text)
    let k = strlen(old_frag)
    while (i < n):
        if ((i + k) <= n):
            if (__thg_str_substr(text, i, k) == old_frag):
                out = out + new_frag
                i = i + k
            else:
                out = out + _char_at(text, i)
                i = i + 1
        else:
            out = out + _char_at(text, i)
            i = i + 1
    return out

func _map_get(map_text: String, key: String) -> String:
    let needle = ";" + key + "="
    let p = _find(map_text, needle)
    if (p < 0):
        return ""
    let start = p + strlen(needle)
    let i = start
    let n = strlen(map_text)
    while (i < n):
        if (_char_at(map_text, i) == ";"):
            return __thg_str_substr(map_text, start, i - start)
        i = i + 1
    return ""

func _map_set(map_text: String, key: String, value: String) -> String:
    let old = _map_get(map_text, key)
    if (old.length() == 0):
        return map_text + key + "=" + value + ";"
    let needle = ";" + key + "=" + old + ";"
    let p = _find(map_text, needle)
    if (p < 0):
        return map_text + key + "=" + value + ";"
    let left = __thg_str_substr(map_text, 0, p + 1)
    let right = __thg_str_substr(map_text, p + strlen(needle), strlen(map_text) - p - strlen(needle))
    return left + key + "=" + value + ";" + right

func _is_digit(ch: String) -> i32:
    if (_find_char("0123456789", ch) >= 0):
        return 1
    return 0

func _is_int_literal(text: String) -> i32:
    let s = _trim_edges(text)
    if (s.length() == 0):
        return 0
    let i = 0
    if (_char_at(s, 0) == "-"):
        if (s.length() == 1):
            return 0
        i = 1
    while (i < s.length()):
        if (_is_digit(_char_at(s, i)) == 0):
            return 0
        i = i + 1
    return 1

func _parse_i32(text: String) -> i32:
    let s = _trim_edges(text)
    let sign = 1
    let i = 0
    if (s.length() == 0):
        return 0
    if (_char_at(s, 0) == "-"):
        sign = -1
        i = 1
    let out = 0
    while (i < s.length()):
        let d = _find_char("0123456789", _char_at(s, i))
        if (d < 0):
            return 0
        out = out * 10 + d
        i = i + 1
    return out * sign

func _digit_char(digit: i32) -> String:
    return __thg_str_substr("0123456789", digit, 1)

func _to_string_i32(value: i32) -> String:
    if (value == 0):
        return "0"
    if (value == (-2147483647 - 1)):
        return "-2147483648"
    let n = value
    let sign = ""
    if (n < 0):
        sign = "-"
        n = 0 - n
    let reversed = ""
    while (n > 0):
        let q = n / 10
        let r = n - (q * 10)
        reversed = reversed + _digit_char(r)
        n = q
    let out = ""
    let i = strlen(reversed) - 1
    while (i >= 0):
        out = out + __thg_str_substr(reversed, i, 1)
        i = i - 1
    return sign + out

func _csv_count(text: String) -> i32:
    let s = _trim_edges(text)
    if (s.length() == 0):
        return 0
    let i = 0
    let depth = 0
    let count = 1
    while (i < s.length()):
        let ch = _char_at(s, i)
        if (ch == "("):
            depth = depth + 1
        else:
            if (ch == ")"):
                depth = depth - 1
            else:
                if ((ch == ",") and (depth == 0)):
                    count = count + 1
        i = i + 1
    return count

func _csv_item(text: String, at: i32) -> String:
    let s = _trim_edges(text)
    if (s.length() == 0):
        return ""
    let i = 0
    let depth = 0
    let part = ""
    let idx = 0
    while (i < s.length()):
        let ch = _char_at(s, i)
        if (ch == "("):
            depth = depth + 1
            part = part + ch
        else:
            if (ch == ")"):
                depth = depth - 1
                part = part + ch
            else:
                if ((ch == ",") and (depth == 0)):
                    if (idx == at):
                        return _trim_edges(part)
                    idx = idx + 1
                    part = ""
                else:
                    part = part + ch
        i = i + 1
    if (idx == at):
        return _trim_edges(part)
    return ""

func _parse_param_names(header_line: String) -> String:
    let lp = _find_char(header_line, "(")
    let rp = _find_char(header_line, ")")
    if (lp < 0):
        return ""
    if (rp <= lp):
        return ""
    let inside = _trim_edges(__thg_str_substr(header_line, lp + 1, rp - lp - 1))
    let total = _csv_count(inside)
    let i = 0
    let out = ""
    while (i < total):
        let token = _csv_item(inside, i)
        let p = _find_char(token, ":")
        let name = token
        if (p >= 0):
            name = _trim_edges(__thg_str_substr(token, 0, p))
        if (name.length() > 0):
            if (out.length() == 0):
                out = name
            else:
                out = out + "," + name
        i = i + 1
    return out

func _parse_comptime_func_name(line: String) -> String:
    let t = _trim_edges(line)
    if (_starts_with(t, "comptime func ") == 0):
        return ""
    let body = __thg_str_substr(t, 13, strlen(t) - 13)
    let lp = _find_char(body, "(")
    if (lp < 0):
        return _trim_edges(body)
    return _trim_edges(__thg_str_substr(body, 0, lp))

func _extract_indented_block(source: String, header_idx: i32) -> String:
    let total = _line_count(source)
    let header = _line_at(source, header_idx)
    let base_indent = _leading_spaces(header)
    let i = header_idx + 1
    let out = ""
    while (i < total):
        let raw = _line_at(source, i)
        let line = _trim_edges(raw)
        if (line.length() == 0):
            if (i < (total - 1)):
                out = out + "\n"
            i = i + 1
        else:
            let indent = _leading_spaces(raw)
            if (indent <= base_indent):
                i = total
            else:
                out = out + raw
                if (i < (total - 1)):
                    out = out + "\n"
                i = i + 1
    return out

func _find_top_op(expr: String, op: String) -> i32:
    let n = strlen(expr)
    let m = strlen(op)
    let i = n - m
    let depth = 0
    while (i >= 0):
        let ch = _char_at(expr, i)
        if (ch == ")"):
            depth = depth + 1
        else:
            if (ch == "("):
                depth = depth - 1
        if (depth == 0):
            if (__thg_str_substr(expr, i, m) == op):
                if ((op == "-") or (op == "+")):
                    if (i == 0):
                        i = i - 1
                    else:
                        let prev = _char_at(expr, i - 1)
                        if ((prev == "(") or (prev == "+") or (prev == "-") or (prev == "*") or (prev == "/")):
                            i = i - 1
                        else:
                            return i
                else:
                    return i
        i = i - 1
    return -1

func _matching_rparen(text: String, lp: i32) -> i32:
    let i = lp
    let depth = 0
    while (i < strlen(text)):
        let ch = _char_at(text, i)
        if (ch == "("):
            depth = depth + 1
        else:
            if (ch == ")"):
                depth = depth - 1
                if (depth == 0):
                    return i
        i = i + 1
    return -1

func _header_expr(line: String, prefix: String) -> String:
    if (_starts_with(line, prefix) == 0):
        return ""
    let s = _trim_edges(__thg_str_substr(line, strlen(prefix), strlen(line) - strlen(prefix)))
    if (s.length() == 0):
        return ""
    if (_char_at(s, s.length() - 1) == ":"):
        return _trim_edges(__thg_str_substr(s, 0, s.length() - 1))
    return s

func _skip_block_end(lines: String, start_idx: i32, base_indent: i32) -> i32:
    let total = _line_count(lines)
    let i = start_idx
    while (i < total):
        let raw = _line_at(lines, i)
        let t = _trim_edges(raw)
        if (t.length() == 0):
            i = i + 1
        else:
            if (_leading_spaces(raw) <= base_indent):
                return i
            i = i + 1
    return total

func _eval_expr_int(expr: String, env: String, params_map: String, body_map: String, depth: i32) -> i32:
    let s = _trim_edges(expr)
    if (s.length() == 0):
        return 0
    if (depth > 32):
        return 0
    if (s == "true"):
        return 1
    if (s == "false"):
        return 0
    if ((_char_at(s, 0) == "(") and (_char_at(s, strlen(s) - 1) == ")")):
        return _eval_expr_int(__thg_str_substr(s, 1, strlen(s) - 2), env, params_map, body_map, depth + 1)
    if (_is_int_literal(s) == 1):
        return _parse_i32(s)
    let bound = _map_get(env, s)
    if (bound.length() > 0):
        return _parse_i32(bound)
    let call_lp = _find_char(s, "(")
    if (call_lp > 0):
        let call_rp = _matching_rparen(s, call_lp)
        if (call_rp == (strlen(s) - 1)):
            let name = _trim_edges(__thg_str_substr(s, 0, call_lp))
            let param_spec = _map_get(params_map, name)
            let body = _map_get(body_map, name)
            if (body.length() > 0):
                let args_csv = __thg_str_substr(s, call_lp + 1, strlen(s) - call_lp - 2)
                let total = _csv_count(param_spec)
                let local_env = ";"
                let i = 0
                while (i < total):
                    let pname = _csv_item(param_spec, i)
                    let aexpr = _csv_item(args_csv, i)
                    let aval = _eval_expr_int(aexpr, env, params_map, body_map, depth + 1)
                    local_env = _map_set(local_env, pname, _to_string_i32(aval))
                    i = i + 1
                let exec = _eval_block(body, 0, -1, local_env, params_map, body_map, depth + 1)
                if (exec.has_return == 1):
                    return exec.return_value
                return 0
    let p_eq = _find_top_op(s, "==")
    if (p_eq >= 0):
        let a = _eval_expr_int(__thg_str_substr(s, 0, p_eq), env, params_map, body_map, depth + 1)
        let b = _eval_expr_int(__thg_str_substr(s, p_eq + 2, strlen(s) - p_eq - 2), env, params_map, body_map, depth + 1)
        if (a == b):
            return 1
        return 0
    let p_ne = _find_top_op(s, "!=")
    if (p_ne >= 0):
        let a = _eval_expr_int(__thg_str_substr(s, 0, p_ne), env, params_map, body_map, depth + 1)
        let b = _eval_expr_int(__thg_str_substr(s, p_ne + 2, strlen(s) - p_ne - 2), env, params_map, body_map, depth + 1)
        if (a != b):
            return 1
        return 0
    let p_le = _find_top_op(s, "<=")
    if (p_le >= 0):
        let a = _eval_expr_int(__thg_str_substr(s, 0, p_le), env, params_map, body_map, depth + 1)
        let b = _eval_expr_int(__thg_str_substr(s, p_le + 2, strlen(s) - p_le - 2), env, params_map, body_map, depth + 1)
        if (a <= b):
            return 1
        return 0
    let p_ge = _find_top_op(s, ">=")
    if (p_ge >= 0):
        let a = _eval_expr_int(__thg_str_substr(s, 0, p_ge), env, params_map, body_map, depth + 1)
        let b = _eval_expr_int(__thg_str_substr(s, p_ge + 2, strlen(s) - p_ge - 2), env, params_map, body_map, depth + 1)
        if (a >= b):
            return 1
        return 0
    let p_lt = _find_top_op(s, "<")
    if (p_lt >= 0):
        let a = _eval_expr_int(__thg_str_substr(s, 0, p_lt), env, params_map, body_map, depth + 1)
        let b = _eval_expr_int(__thg_str_substr(s, p_lt + 1, strlen(s) - p_lt - 1), env, params_map, body_map, depth + 1)
        if (a < b):
            return 1
        return 0
    let p_gt = _find_top_op(s, ">")
    if (p_gt >= 0):
        let a = _eval_expr_int(__thg_str_substr(s, 0, p_gt), env, params_map, body_map, depth + 1)
        let b = _eval_expr_int(__thg_str_substr(s, p_gt + 1, strlen(s) - p_gt - 1), env, params_map, body_map, depth + 1)
        if (a > b):
            return 1
        return 0
    let p_add = _find_top_op(s, "+")
    if (p_add >= 0):
        return _eval_expr_int(__thg_str_substr(s, 0, p_add), env, params_map, body_map, depth + 1) + _eval_expr_int(__thg_str_substr(s, p_add + 1, strlen(s) - p_add - 1), env, params_map, body_map, depth + 1)
    let p_sub = _find_top_op(s, "-")
    if (p_sub >= 0):
        return _eval_expr_int(__thg_str_substr(s, 0, p_sub), env, params_map, body_map, depth + 1) - _eval_expr_int(__thg_str_substr(s, p_sub + 1, strlen(s) - p_sub - 1), env, params_map, body_map, depth + 1)
    let p_mul = _find_top_op(s, "*")
    if (p_mul >= 0):
        return _eval_expr_int(__thg_str_substr(s, 0, p_mul), env, params_map, body_map, depth + 1) * _eval_expr_int(__thg_str_substr(s, p_mul + 1, strlen(s) - p_mul - 1), env, params_map, body_map, depth + 1)
    let p_div = _find_top_op(s, "/")
    if (p_div >= 0):
        let rhs = _eval_expr_int(__thg_str_substr(s, p_div + 1, strlen(s) - p_div - 1), env, params_map, body_map, depth + 1)
        if (rhs == 0):
            return 0
        return _eval_expr_int(__thg_str_substr(s, 0, p_div), env, params_map, body_map, depth + 1) / rhs
    return 0

func _eval_block(lines: String, start_idx: i32, base_indent: i32, env_in: String, params_map: String, body_map: String, depth: i32) -> EvalBlockResult:
    let total = _line_count(lines)
    let i = start_idx
    let env = env_in
    while (i < total):
        let raw = _line_at(lines, i)
        let line = _trim_edges(raw)
        if (line.length() == 0):
            i = i + 1
        else:
            let indent = _leading_spaces(raw)
            if (indent <= base_indent):
                return EvalBlockResult(0, 0, env, i)
            if (_starts_with(line, "let ") == 1):
                let p = _find(line, "=")
                if (p > 0):
                    let name = _trim_edges(__thg_str_substr(line, 4, p - 4))
                    let rhs = _trim_edges(__thg_str_substr(line, p + 1, strlen(line) - p - 1))
                    let value = _eval_expr_int(rhs, env, params_map, body_map, depth + 1)
                    env = _map_set(env, name, _to_string_i32(value))
                i = i + 1
            else:
                if (_starts_with(line, "return ") == 1):
                    let expr = _trim_edges(__thg_str_substr(line, 7, strlen(line) - 7))
                    let value = _eval_expr_int(expr, env, params_map, body_map, depth + 1)
                    return EvalBlockResult(1, value, env, i + 1)
                else:
                    if (ph.is_if_stmt_header(line) == 1):
                        let cond_expr = _header_expr(line, "if ")
                        let cond_value = _eval_expr_int(cond_expr, env, params_map, body_map, depth + 1)
                        let then_start = i + 1
                        let then_end = _skip_block_end(lines, then_start, indent)
                        let else_exists = 0
                        let else_start = then_end
                        let else_end = then_end
                        if (then_end < total):
                            let else_line = _trim_edges(_line_at(lines, then_end))
                            let else_indent = _leading_spaces(_line_at(lines, then_end))
                            if ((else_indent == indent) and (else_line == "else:")):
                                else_exists = 1
                                else_start = then_end + 1
                                else_end = _skip_block_end(lines, else_start, indent)
                        if (cond_value != 0):
                            let then_result = _eval_block(lines, then_start, indent, env, params_map, body_map, depth + 1)
                            env = then_result.env
                            if (then_result.has_return == 1):
                                return then_result
                        else:
                            if (else_exists == 1):
                                let else_result = _eval_block(lines, else_start, indent, env, params_map, body_map, depth + 1)
                                env = else_result.env
                                if (else_result.has_return == 1):
                                    return else_result
                        if (else_exists == 1):
                            i = else_end
                        else:
                            i = then_end
                    else:
                        if (ph.is_while_stmt_header(line) == 1):
                            let cond_expr = _header_expr(line, "while ")
                            let body_start = i + 1
                            let loop_end = _skip_block_end(lines, body_start, indent)
                            let guard = 0
                            while (guard < 2048):
                                let cond_value = _eval_expr_int(cond_expr, env, params_map, body_map, depth + 1)
                                if (cond_value == 0):
                                    guard = 2048
                                else:
                                    let loop_result = _eval_block(lines, body_start, indent, env, params_map, body_map, depth + 1)
                                    env = loop_result.env
                                    if (loop_result.has_return == 1):
                                        return loop_result
                                    guard = guard + 1
                            i = loop_end
                        else:
                            let p_assign = _find(line, "=")
                            if (p_assign > 0):
                                let lhs = _trim_edges(__thg_str_substr(line, 0, p_assign))
                                let rhs = _trim_edges(__thg_str_substr(line, p_assign + 1, strlen(line) - p_assign - 1))
                                if (_map_get(env, lhs).length() > 0):
                                    let vv = _eval_expr_int(rhs, env, params_map, body_map, depth + 1)
                                    env = _map_set(env, lhs, _to_string_i32(vv))
                            i = i + 1
    return EvalBlockResult(0, 0, env, i)

func _eval_simple_int(expr: String, params_map: String, body_map: String) -> String:
    let v = _eval_expr_int(expr, ";", params_map, body_map, 0)
    return _to_string_i32(v)

func _rewrite_comptime_line(line: String, params_map: String, body_map: String) -> String:
    let marker = "comptime("
    let out = line
    let n = strlen(out)
    let m = strlen(marker)
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(out, i, m) == marker):
            let j = i + m
            while (j < n):
                if (_char_at(out, j) == ")"):
                    let inner = __thg_str_substr(out, i + m, j - i - m)
                    let folded = _eval_simple_int(inner, params_map, body_map)
                    let left = __thg_str_substr(out, 0, i)
                    let right = __thg_str_substr(out, j + 1, n - j - 1)
                    return left + folded + right
                j = j + 1
            return out
        i = i + 1
    let k = _find(out, "comptime ")
    if (k >= 0):
        let start = k + 9
        let tail = __thg_str_substr(out, start, strlen(out) - start)
        let nl = _find(tail, "\n")
        let expr_len = strlen(tail)
        if (nl >= 0):
            expr_len = nl
        let expr_text = _trim_edges(__thg_str_substr(tail, 0, expr_len))
        if (expr_text.length() > 0):
            let folded = _eval_simple_int(expr_text, params_map, body_map)
            let left = __thg_str_substr(out, 0, k)
            let right = __thg_str_substr(out, start + expr_len, strlen(out) - start - expr_len)
            return left + folded + right
    return out

func _collect_comptime_catalog(source: String) -> ComptimeCatalog:
    let total = _line_count(source)
    let i = 0
    let out = ""
    let params_map = ";"
    let body_map = ";"
    while (i < total):
        let raw = _line_at(source, i)
        let t = _trim_edges(raw)
        if (_starts_with(t, "comptime func ") == 1):
            let fn_name = _parse_comptime_func_name(t)
            if (fn_name.length() > 0):
                let header_idx = i
                let params = _parse_param_names(t)
                let body = _extract_indented_block(source, header_idx)
                params_map = _map_set(params_map, fn_name, params)
                body_map = _map_set(body_map, fn_name, body)
                i = _skip_block_end(source, header_idx + 1, _leading_spaces(raw))
            else:
                i = i + 1
        else:
            out = out + raw
            if (i < (total - 1)):
                out = out + "\n"
            i = i + 1
    return ComptimeCatalog(out, params_map, body_map)

func _rewrite_trait_impl_header(line: String) -> String:
    let t = _trim_edges(line)
    if (_starts_with(t, "impl") == 0):
        return line
    let p_for = _find_char(t, "f")
    if (p_for < 0):
        return line
    if ((p_for + 3) > strlen(t)):
        return line
    if (__thg_str_substr(t, p_for, 3) != "for"):
        return line
    let type_full = _trim_edges(__thg_str_substr(t, p_for + 3, strlen(t) - p_for - 3))
    let colon = _find_char(type_full, ":")
    let type_name = type_full
    if (colon >= 0):
        type_name = __thg_str_substr(type_full, 0, colon)
    let indent = _leading_spaces(line)
    let prefix = __thg_str_substr(line, 0, indent)
    return prefix + "impl " + type_name + ":"

func _rewrite_visibility_header(line: String) -> String:
    let t = _trim_edges(line)
    if (_starts_with(t, "pub ") == 0):
        return line
    let indent = _leading_spaces(line)
    let prefix = __thg_str_substr(line, 0, indent)
    let body = _trim_edges(__thg_str_substr(t, 4, strlen(t) - 4))
    return prefix + body

func _rewrite_unsafe_header(line: String) -> String:
    let t = _trim_edges(line)
    if (t == "unsafe:"):
        let indent = _leading_spaces(line)
        let prefix = __thg_str_substr(line, 0, indent)
        return prefix + "if 1:"
    return line

func _strip_generic_clause(line: String) -> String:
    let left = _find_char(line, "[")
    let right = _find_char(line, "]")
    if (left < 0):
        return line
    if (right < 0):
        return line
    if (right <= left):
        return line
    return __thg_str_substr(line, 0, left) + __thg_str_substr(line, right + 1, strlen(line) - right - 1)

func _generic_mangle(func_name: String, type_args: String) -> String:
    return gt.mangle_symbol(func_name, type_args)

func _rewrite_generic_call_line(line: String, func_name: String, type_args: String) -> String:
    let call_sig = func_name + "[" + _trim_edges(type_args) + "]("
    let mangled = _generic_mangle(func_name, type_args) + "("
    return _replace_all(line, call_sig, mangled)

func _line_break_pos(text: String, start: i32) -> i32:
    let i = start
    let n = strlen(text)
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == _nl()):
            return i
        if ((i + 1) < n):
            if (__thg_str_substr(text, i, 2) == "\n"):
                return i
        i = i + 1
    return n

func _fold_all_comptime_calls(text: String, params_map: String, body_map: String) -> String:
    let out = text
    let guard = 0
    while (guard < 4096):
        let k = _find(out, "comptime")
        if (k < 0):
            return out
        let next = k + 8
        if (next >= strlen(out)):
            return out
        let next_ch = _char_at(out, next)
        if (next_ch == "("):
            let p = next
            let depth = 0
            while (p < strlen(out)):
                let ch = _char_at(out, p)
                if (ch == "("):
                    depth = depth + 1
                else:
                    if (ch == ")"):
                        depth = depth - 1
                        if (depth == 0):
                            let inner = _trim_edges(__thg_str_substr(out, next + 1, p - next - 1))
                            let folded = _eval_simple_int(inner, params_map, body_map)
                            let left = __thg_str_substr(out, 0, k)
                            let right = __thg_str_substr(out, p + 1, strlen(out) - p - 1)
                            out = left + folded + right
                            p = strlen(out)
                p = p + 1
            guard = guard + 1
        else:
            if (next_ch == " "):
                let start_expr = next + 1
                let end_expr = _line_break_pos(out, start_expr)
                let lp = _find_char(__thg_str_substr(out, start_expr, strlen(out) - start_expr), "(")
                if (lp >= 0):
                    let abs_lp = start_expr + lp
                    let p = abs_lp
                    let depth = 0
                    while (p < strlen(out)):
                        let ch = _char_at(out, p)
                        if (ch == "("):
                            depth = depth + 1
                        else:
                            if (ch == ")"):
                                depth = depth - 1
                                if (depth == 0):
                                    end_expr = p + 1
                                    p = strlen(out)
                        p = p + 1
                let expr = _trim_edges(__thg_str_substr(out, start_expr, end_expr - start_expr))
                let folded = _eval_simple_int(expr, params_map, body_map)
                let left = __thg_str_substr(out, 0, k)
                let right = __thg_str_substr(out, end_expr, strlen(out) - end_expr)
                out = left + folded + right
                guard = guard + 1
            else:
                return out
    return out

func _suggest_parenthesized_stmt_header(line: String, prefix: String) -> String:
    let s = _trim_edges(line)
    if (_starts_with(s, prefix) == 0):
        return ""
    let tail = _trim_edges(__thg_str_substr(s, strlen(prefix), strlen(s) - strlen(prefix)))
    if (tail.length() == 0):
        return ""
    if (_char_at(tail, tail.length() - 1) == ":"):
        tail = _trim_edges(__thg_str_substr(tail, 0, tail.length() - 1))
    if (tail.length() == 0):
        return ""
    if ((_char_at(tail, 0) == "(") and (_char_at(tail, tail.length() - 1) == ")")):
        return prefix + tail + ":"
    return prefix + "(" + tail + "):"

func _has_invalid_cond_stmt_headers(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    while (i < total):
        let line = _trim_edges(_line_at_raw(source, i))
        if (_starts_with(line, "if ") == 1):
            if (ph.is_if_stmt_header(line) == 0):
                return 1
        if (_starts_with(line, "while ") == 1):
            if (ph.is_while_stmt_header(line) == 0):
                return 1
        i = i + 1
    return 0

func preprocess(source: String) -> String:
    if (_has_invalid_cond_stmt_headers(source) == 1):
        return source
    let catalog = _collect_comptime_catalog(source)
    let folded = _fold_all_comptime_calls(catalog.source_wo_comptime_funcs, catalog.params_map, catalog.body_map)
    let total = _line_count_raw(folded)
    let i = 0
    let out = ""
    while (i < total):
        let line = _line_at_raw(folded, i)
        let t = _trim_edges(line)
        let keep = 1
        if (_starts_with(t, "trait ") == 1):
            keep = 0
        if (keep == 1):
            line = _rewrite_trait_impl_header(line)
            line = _rewrite_visibility_header(line)
            line = _rewrite_unsafe_header(line)
            line = _strip_generic_clause(line)
            out = out + line
            if (i < (total - 1)):
                out = out + "\n"
        i = i + 1
    return out

func check_result_try_sugar(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    let in_result_func = 0
    while (i < total):
        let line = _trim_edges(_line_at_raw(source, i))
        if (_find_char(line, _dq()) >= 0):
            i = i + 1
        else:
            if (_starts_with(line, "func ") == 1):
                if (_find_char(line, "?") >= 0):
                    in_result_func = 1
                else:
                    in_result_func = 0
            if (_find_char(line, "?") >= 0):
                if (in_result_func == 0):
                    fail = 1
            i = i + 1
    if (fail == 1):
        print("Semantic error: '?' is only allowed inside function returning Result...?.")
        return 1
    return 0

func check_defer_scope(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    let current_func_indent = -1
    while (i < total):
        let raw = _line_at_raw(source, i)
        let line = _trim_edges(raw)
        let indent = _leading_spaces(raw)
        if (_starts_with(line, "func ") == 1):
            current_func_indent = indent
        if (_is_blank(raw) == 0):
            if (indent <= current_func_indent):
                if (_starts_with(line, "func ") == 0):
                    current_func_indent = -1
        if (_starts_with(line, "defer ") == 1):
            if (current_func_indent < 0):
                fail = 1
        i = i + 1
    if (fail == 1):
        print("Semantic error: defer is only allowed inside function body.")
        return 1
    return 0

func check_new_syntax_headers(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    while (i < total):
        let line = _trim_edges(_line_at_raw(source, i))
        if (_starts_with(line, "pub ") == 1):
            if (ph.parse_visibility_decl(line).length() == 0):
                print("Semantic error: pub can only be used with func/struct/enum/type/impl/trait.")
                fail = 1
        if (_starts_with(line, "match ") == 1):
            if (ph.is_match_header(line) == 0):
                print("Semantic error: match header must end with ':'.")
                fail = 1
        if (_starts_with(line, "for ") == 1):
            if (_find_char(line, ":") >= 0):
                if (ph.is_range_loop_header(line) == 0):
                    if (_contains(line, " in ") == 1):
                        print("Semantic error: range loop must use 'for i in a..b:'.")
                        fail = 1
        if (_starts_with(line, "if ") == 1):
            if (ph.is_if_stmt_header(line) == 0):
                print("Semantic error [E_SYNTAX_IF_HEADER] line " + _to_string_i32(i + 1) + ": if header must be `if (condition):`.")
                let fix_if = _suggest_parenthesized_stmt_header(line, "if ")
                if (fix_if.length() > 0):
                    print("Hint: rewrite as `" + fix_if + "`.")
                fail = 1
        if (_starts_with(line, "while ") == 1):
            if (ph.is_while_stmt_header(line) == 0):
                print("Semantic error [E_SYNTAX_WHILE_HEADER] line " + _to_string_i32(i + 1) + ": while header must be `while (condition):`.")
                let fix_while = _suggest_parenthesized_stmt_header(line, "while ")
                if (fix_while.length() > 0):
                    print("Hint: rewrite as `" + fix_while + "`.")
                fail = 1
        if (_contains(line, "= if ") == 1):
            if (_contains(line, " else:") == 0):
                print("Semantic error: if-expression must be `let x = if cond: a else: b`.")
                fail = 1
            if (_contains(line, ":") == 0):
                print("Semantic error: if-expression must be `let x = if cond: a else: b`.")
                fail = 1
        if (_contains(line, " = |") == 1):
            if (ph.has_closure(line) == 0):
                print("Semantic error: closure must be `let f = |args| expr`.")
                fail = 1
        if (_starts_with(line, "unsafe") == 1):
            if (ph.is_unsafe_block_header(line) == 0):
                print("Semantic error: use unsafe block as 'unsafe:'.")
                fail = 1
        if (_starts_with(line, "impl ") == 1):
            if (_contains(line, " for ") == 1):
                if (ph.is_extension_impl_header(line) == 0):
                    print("Semantic error: extension impl must be 'impl Trait for Type:'.")
                    fail = 1
        i = i + 1
    return fail

func check_intent_headers(source: String) -> i32:
    let total = _line_count_raw(source)
    let i = 0
    let fail = 0
    while (i < total):
        let raw = _line_at_raw(source, i)
        let line = _trim_edges(raw)
        let indent = _leading_spaces(raw)
        if (_starts_with(line, "intent ") == 1):
            let intent_kind = ph.parse_intent_kind(line)
            if (intent_kind.length() == 0):
                print("Semantic error: invalid intent header. Use intent func/loop/calc/block with ':'.")
                fail = 1
            else:
                let has_goal = 0
                let has_constraints = 0
                let has_constraint_item = 0
                let has_examples = 0
                let has_example_item = 0
                let body_seen = 0
                let in_constraints = 0
                let in_examples = 0
                let constraints_indent = -1
                let examples_indent = -1
                let j = i + 1
                while (j < total):
                    let body_raw = _line_at_raw(source, j)
                    let body_line = _trim_edges(body_raw)
                    let body_indent = _leading_spaces(body_raw)
                    if (body_line.length() == 0):
                        j = j + 1
                    else:
                        if (body_indent <= indent):
                            j = total
                        else:
                            body_seen = 1
                            if (ph.is_intent_goal_line(body_line) == 1):
                                has_goal = 1
                                in_constraints = 0
                                in_examples = 0
                            else:
                                if (ph.is_intent_constraints_header(body_line) == 1):
                                    has_constraints = 1
                                    in_constraints = 1
                                    in_examples = 0
                                    constraints_indent = body_indent
                                else:
                                    if (ph.is_intent_examples_header(body_line) == 1):
                                        has_examples = 1
                                        in_constraints = 0
                                        in_examples = 1
                                        examples_indent = body_indent
                                    else:
                                        if (in_constraints == 1):
                                            if (body_indent > constraints_indent):
                                                has_constraint_item = 1
                                            else:
                                                in_constraints = 0
                                        if (in_examples == 1):
                                            if (body_indent > examples_indent):
                                                has_example_item = 1
                                                if (_contains(body_line, "==") == 0):
                                                    print("Semantic error: example assertion must use '=='.")
                                                    fail = 1
                                            else:
                                                in_examples = 0
                            j = j + 1
                if (body_seen == 0):
                    print("Semantic error: intent block must contain goal and constraints sections.")
                    fail = 1
                if (has_goal == 0):
                    print("Semantic error: intent requires 'goal: <name>'.")
                    fail = 1
                if (has_constraints == 0):
                    print("Semantic error: intent requires 'constraints:' section.")
                    fail = 1
                if (has_constraints == 1):
                    if (has_constraint_item == 0):
                        print("Semantic error: constraints section must include at least one constraint line.")
                        fail = 1
                if (has_examples == 1):
                    if (has_example_item == 0):
                        print("Semantic error: examples section must include at least one assertion line.")
                        fail = 1
        i = i + 1
    return fail

func validate(source: String) -> i32:
    let normalized = _normalize_validation_source(source)
    let analyzed = _mask_string_literals(normalized)
    if (check_result_try_sugar(analyzed) != 0):
        return 1
    if (check_defer_scope(analyzed) != 0):
        return 1
    if (check_new_syntax_headers(analyzed) != 0):
        return 1
    if (check_intent_headers(analyzed) != 0):
        return 1
    return 0

func _append_lower_rows(rows: String, key: String, count: i32, detail: String) -> String:
    if (count <= 0):
        return rows
    return rows + key + "|" + _to_string_i32(count) + "|" + detail + ";"

func _lower_rows_from_typed(typed: ProgramT) -> String:
    let rows = ""
    rows = _append_lower_rows(rows, "lower.match", typed.match_count, "switch_on_enum_tag")
    rows = _append_lower_rows(rows, "lower.range_loop", typed.range_loop_count, "init_cmp_inc")
    rows = _append_lower_rows(rows, "lower.if_expr", typed.if_expr_count, "phi_temp_assignment")
    rows = _append_lower_rows(rows, "lower.closure", typed.closure_count, "env_struct_lifted_func_capture_by_value")
    rows = _append_lower_rows(rows, "lower.enum_payload", typed.enum_payload_count, "tagged_layout_constructor_projection")
    rows = _append_lower_rows(rows, "lower.array_literal", typed.array_literal_count, "canonical_array_literal")
    rows = _append_lower_rows(rows, "lower.slice_expr", typed.slice_expr_count, "canonical_slice_view")
    rows = _append_lower_rows(rows, "lower.struct_shorthand", typed.tuple_destruct_count, "canonical_binding")
    rows = _append_lower_rows(rows, "lower.loop_label", typed.loop_label_count, "canonical_loop_blocks")
    rows = _append_lower_rows(rows, "lower.unsafe", typed.unsafe_count, "unsafe_region_marker")
    rows = _append_lower_rows(rows, "lower.visibility", typed.visibility_count, "visibility_marker")
    rows = _append_lower_rows(rows, "lower.extension_impl", typed.extension_impl_count, "impl_extension_bind")
    rows = _append_lower_rows(rows, "lower.raw_string", typed.raw_string_count, "raw_literal")
    rows = _append_lower_rows(rows, "lower.interpolated_string", typed.interpolated_string_count, "interpolation_expand")
    rows = _append_lower_rows(rows, "lower.result_sugar", typed.result_sugar_count, "result_try_desugar")
    rows = _append_lower_rows(rows, "lower.defer_scope", typed.defer_scope_count, "defer_stack_desugar")
    rows = _append_lower_rows(rows, "lower.comptime", typed.comptime_count, "comptime_folded")
    return rows

func lower_program(typed: ProgramT) -> CoreProgram:
    let lowered_source = preprocess(typed.normalized)
    let rows = _lower_rows_from_typed(typed)
    let core = cir.core_new(typed, lowered_source, rows)
    if (validate(lowered_source) != 0):
        return cir.core_set_error(core, "E_LOWER_VALIDATE", "lowered source failed validation")
    return core
