struct Token:
    kind: String
    text: String

extern func __thg_token_new(kind: String, text: String) -> ptr
extern func __thg_token_kind(tok: ptr) -> String
extern func __thg_token_text(tok: ptr) -> String
extern func __thg_token_free(tok: ptr) -> i32

func new_token(k: String, t: String) -> Token:
    return Token(k, t)

func new_handle(k: String, t: String) -> ptr:
    return __thg_token_new(k, t)

func kind_of(tok: ptr) -> String:
    return __thg_token_kind(tok)

func text_of(tok: ptr) -> String:
    return __thg_token_text(tok)

func free_handle(tok: ptr) -> i32:
    return __thg_token_free(tok)

func tok_newline() -> String:
    return "NEWLINE"

func tok_indent() -> String:
    return "INDENT"

func tok_dedent() -> String:
    return "DEDENT"

func tok_eof() -> String:
    return "EOF"

func tok_generic_open() -> String:
    return "LBRACKET"

func tok_generic_close() -> String:
    return "RBRACKET"

func tok_question() -> String:
    return "QUESTION"

func tok_trait() -> String:
    return "TRAIT"

func tok_interface() -> String:
    return "INTERFACE"

func tok_defer() -> String:
    return "DEFER"

func tok_comptime() -> String:
    return "COMPTIME"

func tok_enum() -> String:
    return "ENUM"

func tok_match() -> String:
    return "MATCH"

func tok_type() -> String:
    return "TYPE"

func tok_pub() -> String:
    return "PUB"

func tok_unsafe() -> String:
    return "UNSAFE"

func tok_for() -> String:
    return "FOR"

func tok_in() -> String:
    return "IN"

func tok_range() -> String:
    return "RANGE"

func tok_range_inclusive() -> String:
    return "RANGE_INCLUSIVE"

func tok_pipe() -> String:
    return "PIPE"

func tok_arrow() -> String:
    return "ARROW"

func tok_fat_arrow() -> String:
    return "FAT_ARROW"

func tok_raw_string() -> String:
    return "RAW_STRING"

func tok_lbrace() -> String:
    return ""

func tok_rbrace() -> String:
    return ""
