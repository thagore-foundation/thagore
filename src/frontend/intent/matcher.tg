extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _starts_with(text: String, prefix: String) -> i32:
    let pn = strlen(prefix)
    if (strlen(text) < pn):
        return 0
    if (__thg_str_substr(text, 0, pn) == prefix):
        return 1
    return 0

func _find_char(text: String, ch: String) -> i32:
    let i = 0
    let n = strlen(text)
    while (i < n):
        if (_char_at(text, i) == ch):
            return i
        i = i + 1
    return -1

func _is_ws(ch: String) -> i32:
    if (ch == " "):
        return 1
    if (ch == "\t"):
        return 1
    if (ch == "\n"):
        return 1
    if (ch == "\r"):
        return 1
    return 0

func _trim_edges(text: String) -> String:
    let n = strlen(text)
    if (n == 0):
        return ""
    let l = 0
    let i = 0
    let left_done = 0
    while (i < n):
        if (left_done == 0):
            if (_is_ws(_char_at(text, i)) == 1):
                i = i + 1
                l = i
            else:
                left_done = 1
                i = n
        else:
            i = n
    let r = n - 1
    let j = n - 1
    let right_done = 0
    while (j >= l):
        if (right_done == 0):
            if (_is_ws(_char_at(text, j)) == 1):
                j = j - 1
                r = j
            else:
                right_done = 1
                j = l - 1
        else:
            j = l - 1
    if (r < l):
        return ""
    return __thg_str_substr(text, l, r - l + 1)

func _line_count(source: String) -> i32:
    let n = strlen(source)
    if (n == 0):
        return 0
    let i = 0
    let count = 1
    while (i < n):
        if (_char_at(source, i) == "\n"):
            count = count + 1
        i = i + 1
    return count

func _line_at(source: String, index: i32) -> String:
    let n = strlen(source)
    let i = 0
    let line_idx = 0
    let line = ""
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == "\n"):
            if (line_idx == index):
                return line
            line_idx = line_idx + 1
            line = ""
        else:
            if (ch != "\r"):
                line = line + ch
        i = i + 1
    if (line_idx == index):
        return line
    return ""

func count_intent_markers(source: String) -> i32:
    let total = _line_count(source)
    let i = 0
    let out = 0
    while (i < total):
        let line = _trim_edges(_line_at(source, i))
        if (_starts_with(line, "intent ") == 1):
            out = out + 1
        i = i + 1
    return out

func parse_goals(source: String) -> String:
    let total = _line_count(source)
    let i = 0
    let out = ";"
    while (i < total):
        let line = _trim_edges(_line_at(source, i))
        if (_starts_with(line, "goal:") == 1):
            if (strlen(line) > 5):
                let goal = _trim_edges(__thg_str_substr(line, 5, strlen(line) - 5))
                if (goal.length() > 0):
                    out = out + goal + ";"
        i = i + 1
    return out

func _goal_at(goals_text: String, index: i32) -> String:
    let i = 0
    let n = strlen(goals_text)
    let token = ""
    let token_idx = 0
    while (i < n):
        let ch = _char_at(goals_text, i)
        if (ch == ";"):
            if (token.length() > 0):
                if (token_idx == index):
                    return token
                token_idx = token_idx + 1
            token = ""
        else:
            token = token + ch
        i = i + 1
    return ""

func goal_count(goals_text: String) -> i32:
    let i = 0
    let n = strlen(goals_text)
    let token = ""
    let count = 0
    while (i < n):
        let ch = _char_at(goals_text, i)
        if (ch == ";"):
            if (token.length() > 0):
                count = count + 1
            token = ""
        else:
            token = token + ch
        i = i + 1
    return count

func is_supported_goal(goal: String) -> i32:
    if (goal == "reduce_sum"):
        return 1
    if (goal == "map_filter_reduce"):
        return 1
    if (goal == "deduplicate_sorted"):
        return 1
    if (goal == "binary_search"):
        return 1
    if (goal == "string_contains"):
        return 1
    if (goal == "dot_product"):
        return 1
    if (goal == "polynomial_eval"):
        return 1
    if (goal == "fibonacci_dp"):
        return 1
    return 0

func first_unsupported_goal(source: String) -> String:
    let goals = parse_goals(source)
    let total = goal_count(goals)
    let i = 0
    while (i < total):
        let goal = _goal_at(goals, i)
        if (is_supported_goal(goal) == 0):
            return goal
        i = i + 1
    return ""

func validate_goals(source: String) -> i32:
    if (first_unsupported_goal(source).length() > 0):
        return 0
    return 1

func select_rule(goal: String, mode: String) -> String:
    if (goal == "reduce_sum"):
        if (mode == "max"):
            return "rule.reduce_sum.simd.v2"
        return "rule.reduce_sum.scalar.v1"
    if (goal == "map_filter_reduce"):
        if (mode == "max"):
            return "rule.map_filter_reduce.fused.v2"
        return "rule.map_filter_reduce.fused.v1"
    if (goal == "deduplicate_sorted"):
        if (mode == "max"):
            return "rule.deduplicate_sorted.branchless.v2"
        return "rule.deduplicate_sorted.linear.v1"
    if (goal == "binary_search"):
        if (mode == "max"):
            return "rule.binary_search.branchless.v2"
        return "rule.binary_search.classic.v1"
    if (goal == "string_contains"):
        if (mode == "max"):
            return "rule.string_contains.twoway.v2"
        return "rule.string_contains.scan.v1"
    if (goal == "dot_product"):
        if (mode == "max"):
            return "rule.dot_product.simd.v2"
        return "rule.dot_product.scalar.v1"
    if (goal == "polynomial_eval"):
        if (mode == "max"):
            return "rule.polynomial_eval.simd.v2"
        return "rule.polynomial_eval.horner.v1"
    if (goal == "fibonacci_dp"):
        if (mode == "max"):
            return "rule.fibonacci_dp.iterative.v2"
        return "rule.fibonacci_dp.iterative.v1"
    return "rule.unsupported"
