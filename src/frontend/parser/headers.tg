import "src/frontend/semantic/traits.tg" as gt

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _find_char(text: String, ch: String) -> i32:
    let i = 0
    let n = strlen(text)
    while (i < n):
        if (_char_at(text, i) == ch):
            return i
        i = i + 1
    return -1

func _find(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 0
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return i
        i = i + 1
    return -1

func _ends_with_colon(text: String) -> i32:
    let s = gt.trim(text)
    let n = strlen(s)
    if (n <= 0):
        return 0
    if (_char_at(s, n - 1) == ":"):
        return 1
    return 0

func _drop_trailing_colon(text: String) -> String:
    let s = gt.trim(text)
    if (_ends_with_colon(s) == 0):
        return s
    let n = strlen(s)
    if (n <= 1):
        return ""
    return gt.trim(__thg_str_substr(s, 0, n - 1))

func _starts_with(text: String, prefix: String) -> i32:
    let pn = strlen(prefix)
    if (strlen(text) < pn):
        return 0
    if (__thg_str_substr(text, 0, pn) == prefix):
        return 1
    return 0

func _min_positive(a: i32, b: i32) -> i32:
    if (a < 0):
        return b
    if (b < 0):
        return a
    if (a < b):
        return a
    return b

func parse_func_name(header: String) -> String:
    let s = gt.trim(header)
    if (_starts_with(s, "func") == 0):
        return ""
    let body = __thg_str_substr(s, 4, strlen(s) - 4)
    let p_paren = _find_char(body, "(")
    let p_bracket = _find_char(body, "[")
    let end = _min_positive(p_paren, p_bracket)
    if (end < 0):
        end = _find_char(body, ":")
    if (end < 0):
        return body
    return __thg_str_substr(body, 0, end)

func parse_func_generic_clause(header: String) -> String:
    return gt.extract_generic_clause(header)

func parse_trait_name(header: String) -> String:
    return gt.extract_trait_name(header)

func parse_impl_pair(header: String) -> String:
    return gt.extract_impl_pair(header)

func has_result_sugar(header: String) -> i32:
    let s = gt.trim(header)
    let n = strlen(s)
    if (n <= 0):
        return 0
    let i = n - 1
    if (_char_at(s, i) == ":"):
        i = i - 1
    if (i < 0):
        return 0
    if (_char_at(s, i) == "?"):
        return 1
    return 0

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func parse_enum_name(header: String) -> String:
    let s = gt.trim(header)
    if (_starts_with(s, "enum") == 0):
        return ""
    let body = __thg_str_substr(s, 4, strlen(s) - 4)
    let p_generic = _find_char(body, "[")
    let p_colon = _find_char(body, ":")
    let end = _min_positive(p_generic, p_colon)
    if (end < 0):
        return body
    return __thg_str_substr(body, 0, end)

func parse_type_alias_name(header: String) -> String:
    let s = gt.trim(header)
    if (_starts_with(s, "type") == 0):
        return ""
    let body = __thg_str_substr(s, 4, strlen(s) - 4)
    let eq = _find_char(body, "=")
    if (eq < 0):
        return gt.trim(body)
    return gt.trim(__thg_str_substr(body, 0, eq))

func parse_visibility_decl(header: String) -> String:
    let s = gt.trim(header)
    if (_starts_with(s, "pub") == 0):
        return ""
    if (strlen(s) <= 3):
        return ""
    let body = __thg_str_substr(s, 3, strlen(s) - 3)
    if (_starts_with(body, "func") == 1):
        return "func"
    if (_starts_with(body, "struct") == 1):
        return "struct"
    if (_starts_with(body, "enum") == 1):
        return "enum"
    if (_starts_with(body, "type") == 1):
        return "type"
    if (_starts_with(body, "impl") == 1):
        return "impl"
    if (_starts_with(body, "trait") == 1):
        return "trait"
    return ""

func is_match_header(line: String) -> i32:
    let s = gt.trim(line)
    if (_starts_with(s, "match") == 0):
        return 0
    if (_find_char(s, ":") < 0):
        return 0
    if (_starts_with(s, "match:") == 1):
        return 0
    if (_starts_with(s, "match :") == 1):
        return 0
    return 1

func is_range_loop_header(line: String) -> i32:
    let s = gt.trim(line)
    if (_starts_with(s, "for") == 0):
        return 0
    if (_contains(s, "in") == 0):
        return 0
    if (_contains(s, "..") == 0):
        return 0
    if (_contains(s, "...") == 1):
        return 0
    if (_find_char(s, ":") < 0):
        return 0
    if (_starts_with(s, "for in") == 1):
        return 0
    if (_contains(s, "for in ") == 1):
        return 0
    if (_contains(s, " in :") == 1):
        return 0
    return 1

func has_if_expression(line: String) -> i32:
    let s = gt.trim(line)
    if (_contains(s, "=") == 0):
        return 0
    if (_contains(s, "if") == 0):
        return 0
    if (_contains(s, "else:") == 0):
        return 0
    return 1

func has_tuple_destructuring(line: String) -> i32:
    let s = gt.trim(line)
    if (_starts_with(s, "let(") == 0):
        return 0
    if (_contains(s, ")=") == 0):
        return 0
    return 1

func has_struct_init_shorthand(line: String) -> i32:
    let s = gt.trim(line)
    if (_contains(s, "{") == 0):
        return 0
    if (_contains(s, "}") == 0):
        return 0
    if (_contains(s, ":") == 1):
        return 0
    return 1

func has_array_literal(line: String) -> i32:
    let s = gt.trim(line)
    if (_contains(s, "[") == 0):
        return 0
    if (_contains(s, "]") == 0):
        return 0
    if (_contains(s, "=") == 0):
        return 0
    return 1

func has_slice_expr(line: String) -> i32:
    let s = gt.trim(line)
    if (_contains(s, "[") == 0):
        return 0
    if (_contains(s, "]") == 0):
        return 0
    if (_contains(s, ":") == 0):
        return 0
    return 1

func has_raw_string(line: String) -> i32:
    let s = gt.trim(line)
    if (_contains(s, "r#") == 1):
        return 1
    return 0

func has_closure(line: String) -> i32:
    let s = gt.trim(line)
    let eq = _find_char(s, "=")
    if (eq < 0):
        return 0
    if ((eq + 1) >= strlen(s)):
        return 0
    let rhs = gt.trim(__thg_str_substr(s, eq + 1, strlen(s) - eq - 1))
    if (strlen(rhs) < 3):
        return 0
    if (_char_at(rhs, 0) != "|"):
        return 0
    let tail = __thg_str_substr(rhs, 1, strlen(rhs) - 1)
    let close = _find_char(tail, "|")
    if (close < 0):
        return 0
    if ((close + 1) >= strlen(tail)):
        return 0
    let body = gt.trim(__thg_str_substr(tail, close + 1, strlen(tail) - close - 1))
    if (strlen(body) == 0):
        return 0
    return 1

func has_loop_label(line: String) -> i32:
    let s = gt.trim(line)
    let p = _find_char(s, ":")
    if (p <= 0):
        return 0
    let head = gt.trim(__thg_str_substr(s, 0, p))
    let tail = gt.trim(__thg_str_substr(s, p + 1, strlen(s) - p - 1))
    if (strlen(head) == 0):
        return 0
    if (_starts_with(tail, "for") == 1):
        return 1
    if (_starts_with(tail, "while") == 1):
        return 1
    return 0

func is_unsafe_block_header(line: String) -> i32:
    let s = gt.trim(line)
    if (s == "unsafe:"):
        return 1
    return 0

func is_extension_impl_header(line: String) -> i32:
    let s = gt.trim(line)
    if (_starts_with(s, "impl") == 0):
        return 0
    if (_contains(s, "for") == 0):
        return 0
    if (_find_char(s, ":") < 0):
        return 0
    return 1

func parse_intent_kind(line: String) -> String:
    let s = gt.trim(line)
    if (_starts_with(s, "intentfunc") == 1):
        if (_find_char(s, ":") >= 0):
            return "func"
        return ""
    if (_starts_with(s, "intentloop") == 1):
        if (_find_char(s, ":") >= 0):
            return "loop"
        return ""
    if (_starts_with(s, "intentcalc(") == 1):
        if (_find_char(s, ":") >= 0):
            return "calc"
        return ""
    if (s == "intentblock:"):
        return "block"
    return ""

func is_intent_header(line: String) -> i32:
    if (parse_intent_kind(line).length() > 0):
        return 1
    return 0

func is_intent_goal_line(line: String) -> i32:
    let s = gt.trim(line)
    if (_starts_with(s, "goal:") == 0):
        return 0
    if (strlen(s) <= 5):
        return 0
    let body = gt.trim(__thg_str_substr(s, 5, strlen(s) - 5))
    if (body.length() == 0):
        return 0
    return 1

func is_intent_constraints_header(line: String) -> i32:
    let s = gt.trim(line)
    if (s == "constraints:"):
        return 1
    return 0

func is_intent_examples_header(line: String) -> i32:
    let s = gt.trim(line)
    if (s == "examples:"):
        return 1
    return 0
