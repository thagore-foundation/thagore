func ast_inc_raw_string(ast: ProgramAstNative) -> ProgramAstNative:
    return _bump(ast, "raw_string")

func ast_inc_interpolated_string(ast: ProgramAstNative) -> ProgramAstNative:
    return _bump(ast, "interpolated_string")

func ast_inc_result_sugar(ast: ProgramAstNative) -> ProgramAstNative:
    return _bump(ast, "result_sugar")

func ast_inc_defer_scope(ast: ProgramAstNative) -> ProgramAstNative:
    return _bump(ast, "defer_scope")

func ast_inc_comptime(ast: ProgramAstNative) -> ProgramAstNative:
    return _bump(ast, "comptime")
