    return ProgramAstNative(ast.source, ast.normalized, ast.enums, ast.aliases, ast.funcs, ast.enum_payload_count, ast.match_count, ast.range_loop_count, ast.if_expr_count, ast.closure_count, ast.unsafe_count + 1, ast.extension_impl_count, ast.visibility_count, ast.tuple_destruct_count, ast.array_literal_count, ast.slice_expr_count, ast.loop_label_count, ast.raw_string_count)

