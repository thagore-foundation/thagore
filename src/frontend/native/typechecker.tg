import "src/frontend/native/parser.tg" as parser
import "src/frontend/native/typedir.tg" as tir
import "src/frontend/lowering/pipeline.tg" as pipe
import "src/frontend/intent/matcher.tg" as im

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _find(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 0
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return i
        i = i + 1
    return -1

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _is_ident_char(ch: String) -> i32:
    if (ch == "_"):
        return 1
    if (_contains("abcdefghijklmnopqrstuvwxyz", ch) == 1):
        return 1
    if (_contains("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) == 1):
        return 1
    if (_contains("0123456789", ch) == 1):
        return 1
    return 0

func _is_supported_goal_local(goal: String) -> i32:
    if (goal == "auto_plan"):
        return 1
    if (goal == "reduce_sum"):
        return 1
    if (goal == "map_filter_reduce"):
        return 1
    if (goal == "deduplicate_sorted"):
        return 1
    if (goal == "binary_search"):
        return 1
    if (goal == "string_contains"):
        return 1
    if (goal == "dot_product"):
        return 1
    if (goal == "polynomial_eval"):
        return 1
    if (goal == "fibonacci_dp"):
        return 1
    if (goal == "sort_ascending"):
        return 1
    if (goal == "search_element"):
        return 1
    if (goal == "sqrt_bounded_loop"):
        return 1
    return 0

func _first_unsupported_goal_local(source: String) -> String:
    let n = strlen(source)
    let i = 0
    while ((i + 5) <= n):
        if (__thg_str_substr(source, i, 5) == "goal:"):
            let j = i + 5
            let in_ws = 1
            let g = ""
            while (j < n):
                let ch = _char_at(source, j)
                if (in_ws == 1):
                    if ((ch == " ") or (ch == "\t")):
                        j = j + 1
                    else:
                        in_ws = 0
                else:
                    if (_is_ident_char(ch) == 1):
                        g = g + ch
                        j = j + 1
                    else:
                        j = n
            if (g.length() > 0):
                if (_is_supported_goal_local(g) == 0):
                    return g
            i = i + 5
        else:
            i = i + 1
    return ""

func _has_match_keyword(source: String) -> i32:
    let n = strlen(source)
    let i = 0
    while ((i + 5) <= n):
        if (__thg_str_substr(source, i, 5) == "match"):
            let left_ok = 1
            let right_ok = 1
            if (i > 0):
                if (_is_ident_char(_char_at(source, i - 1)) == 1):
                    left_ok = 0
            if ((i + 5) < n):
                if (_is_ident_char(_char_at(source, i + 5)) == 1):
                    right_ok = 0
            if (left_ok == 1):
                if (right_ok == 1):
                    return 1
        i = i + 1
    return 0

func _validate_main_decl(func_table: String, source: String) -> i32:
    if (_contains(func_table, ";main|") == 1):
        return 0
    if (_contains(source, "func main(") == 1):
        return 0
    if (_contains(source, "func main (") == 1):
        return 0
    print("Typecheck error: missing entry function `func main`.")
    return 1

func _has_feature(feature_set: String, feature: String) -> i32:
    if (_contains(feature_set, ";" + feature + ";") == 1):
        return 1
    return 0

func _feature_count(feature_set: String, feature: String) -> i32:
    if (_has_feature(feature_set, feature) == 1):
        return 1
    return 0

func _has_range_keyword(source: String) -> i32:
    if (_contains(source, "for ") == 1):
        if (_contains(source, " in ") == 1):
            if (_contains(source, "..") == 1):
                return 1
    return 0

func _validate_header_contracts(source: String) -> i32:
    if (_contains(source, "match :") == 1):
        print("Typecheck error [E_TYPE_MATCH_HEADER]: malformed `match` header.")
        return 1
    if (_contains(source, "for in ") == 1):
        print("Typecheck error [E_TYPE_RANGE_HEADER]: malformed `for .. in a..b:` header.")
        return 1
    if (_contains(source, "...") == 1):
        if (_has_range_keyword(source) == 1):
            print("Typecheck error [E_TYPE_RANGE_HEADER]: malformed `for .. in a..b:` header.")
            return 1
    if (_contains(source, " in ..") == 1):
        if (_has_range_keyword(source) == 1):
            print("Typecheck error [E_TYPE_RANGE_HEADER]: malformed `for .. in a..b:` header.")
            return 1
    if (_contains(source, "..:") == 1):
        if (_has_range_keyword(source) == 1):
            print("Typecheck error [E_TYPE_RANGE_HEADER]: malformed `for .. in a..b:` header.")
            return 1
    return 0

func _validate_feature_contract(feature_set: String, source: String) -> i32:
    if (parser.parse_match_count(source) > 0):
        if (_has_feature(feature_set, "match") == 0):
            print("Typecheck error [E_TYPE_FEATURE_MATCH]: parser/type feature contract mismatch for `match`.")
            return 1
    if (parser.parse_range_loop_count(source) > 0):
        if (_has_feature(feature_set, "range_loop") == 0):
            print("Typecheck error [E_TYPE_FEATURE_RANGE]: parser/type feature contract mismatch for `for .. in`.")
            return 1
    if (parser.parse_if_expr_count(source) > 0):
        if (_has_feature(feature_set, "if_expr") == 0):
            print("Typecheck error [E_TYPE_FEATURE_IF_EXPR]: parser/type feature contract mismatch for `if expression`.")
            return 1
    if (parser.parse_closure_count(source) > 0):
        if (_has_feature(feature_set, "closure") == 0):
            print("Typecheck error [E_TYPE_FEATURE_CLOSURE]: parser/type feature contract mismatch for `closure`.")
            return 1
    if (parser.parse_result_sugar_count(source) > 0):
        if (_has_feature(feature_set, "result_sugar") == 0):
            print("Typecheck error [E_TYPE_FEATURE_RESULT]: parser/type feature contract mismatch for `Result/?`.")
            return 1
    if (parser.parse_defer_scope_count(source) > 0):
        if (_has_feature(feature_set, "defer_scope") == 0):
            print("Typecheck error [E_TYPE_FEATURE_DEFER]: parser/type feature contract mismatch for `defer`.")
            return 1
    if (parser.parse_comptime_count(source) > 0):
        if (_has_feature(feature_set, "comptime") == 0):
            print("Typecheck error [E_TYPE_FEATURE_COMPTIME]: parser/type feature contract mismatch for `comptime`.")
            return 1
    return 0

func _validate_match_usage(feature_set: String, enum_table: String, source: String) -> i32:
    feature_set = feature_set
    let has_match = 0
    if (_contains(source, "match ") == 1):
        has_match = 1
    if (_contains(source, "match(") == 1):
        has_match = 1
    if (_contains(source, "match\t") == 1):
        has_match = 1
    if (has_match == 0):
        return 0
    if (enum_table == ";"):
        print("Typecheck error: `match` requires at least one enum declaration.")
        return 1
    return 0

func validate_source(source: String) -> i32:
    let normalized = parser.parse_normalized(source)
    let feature_set = parser.parse_feature_set(source)
    let enums = parser.parse_enums(source)
    let aliases = parser.parse_aliases(source)
    let funcs = parser.parse_funcs(source)
    let typed = tir.typed_new(source, normalized, feature_set, enums, aliases, funcs, _feature_count(feature_set, "enum_payload"), _feature_count(feature_set, "match"), _feature_count(feature_set, "range_loop"), _feature_count(feature_set, "if_expr"), _feature_count(feature_set, "closure"), _feature_count(feature_set, "unsafe"), _feature_count(feature_set, "extension_impl"), _feature_count(feature_set, "visibility"), _feature_count(feature_set, "tuple_destruct"), _feature_count(feature_set, "array_literal"), _feature_count(feature_set, "slice_expr"), _feature_count(feature_set, "loop_label"), _feature_count(feature_set, "raw_string"), _feature_count(feature_set, "result_sugar"), _feature_count(feature_set, "defer_scope"), _feature_count(feature_set, "comptime"))
    if (_validate_main_decl(typed.funcs, source) != 0):
        return 1
    if (_validate_header_contracts(source) != 0):
        return 1
    if (_validate_feature_contract(typed.feature_set, source) != 0):
        return 1
    if (_validate_match_usage(typed.feature_set, typed.enums, source) != 0):
        return 1
    let unsupported_goal = _first_unsupported_goal_local(source)
    if (unsupported_goal.length() > 0):
        print("Typecheck error [E_TYPE_INTENT_GOAL]: unsupported intent goal.")
        print(unsupported_goal)
        return 1
    if (im.validate_goals(source) == 0):
        print("Typecheck error [E_TYPE_INTENT_GOAL]: unsupported intent goal.")
        print(im.first_unsupported_goal(source))
        return 1
    if (pipe.validate(typed.normalized) != 0):
        print("Typecheck error [E_TYPE_PIPELINE_VALIDATE]: language validation failed.")
        return 1
    return 0

func typecheck_to_normalized(source: String) -> String:
    let normalized = parser.parse_normalized(source)
    let feature_set = parser.parse_feature_set(source)
    let enums = parser.parse_enums(source)
    let aliases = parser.parse_aliases(source)
    let funcs = parser.parse_funcs(source)
    let typed = tir.typed_new(source, normalized, feature_set, enums, aliases, funcs, _feature_count(feature_set, "enum_payload"), _feature_count(feature_set, "match"), _feature_count(feature_set, "range_loop"), _feature_count(feature_set, "if_expr"), _feature_count(feature_set, "closure"), _feature_count(feature_set, "unsafe"), _feature_count(feature_set, "extension_impl"), _feature_count(feature_set, "visibility"), _feature_count(feature_set, "tuple_destruct"), _feature_count(feature_set, "array_literal"), _feature_count(feature_set, "slice_expr"), _feature_count(feature_set, "loop_label"), _feature_count(feature_set, "raw_string"), _feature_count(feature_set, "result_sugar"), _feature_count(feature_set, "defer_scope"), _feature_count(feature_set, "comptime"))
    return typed.normalized
