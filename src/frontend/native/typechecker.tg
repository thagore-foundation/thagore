import "src/frontend/native/parser.tg" as parser
import "src/frontend/native/typedir.tg" as tir
import "src/frontend/lowering/pipeline.tg" as pipe
import "src/frontend/intent/matcher.tg" as im

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _validate_main_decl(func_table: String, source: String) -> i32:
    if (_contains(func_table, ";main|") == 1):
        return 0
    if (_contains(source, "func main(") == 1):
        return 0
    if (_contains(source, "func main (") == 1):
        return 0
    print("Typecheck error: missing entry function `func main`.")
    return 1

func _has_feature(feature_set: String, feature: String) -> i32:
    if (_contains(feature_set, ";" + feature + ";") == 1):
        return 1
    return 0

func _feature_count(feature_set: String, feature: String) -> i32:
    if (_has_feature(feature_set, feature) == 1):
        return 1
    return 0

func _validate_match_usage(feature_set: String, enum_table: String, source: String) -> i32:
    let has_match = _has_feature(feature_set, "match")
    if (has_match == 0):
        if (_contains(source, "match ") == 0):
            return 0
    if (enum_table == ";"):
        print("Typecheck error: `match` requires at least one enum declaration.")
        return 1
    return 0

func validate_source(source: String) -> i32:
    let normalized = parser.parse_normalized(source)
    let feature_set = parser.parse_feature_set(source)
    let enums = parser.parse_enums(source)
    let aliases = parser.parse_aliases(source)
    let funcs = parser.parse_funcs(source)
    let typed = tir.typed_new(source, normalized, feature_set, enums, aliases, funcs, _feature_count(feature_set, "enum_payload"), _feature_count(feature_set, "match"), _feature_count(feature_set, "range_loop"), _feature_count(feature_set, "if_expr"), _feature_count(feature_set, "closure"), _feature_count(feature_set, "unsafe"), _feature_count(feature_set, "extension_impl"), _feature_count(feature_set, "visibility"), _feature_count(feature_set, "tuple_destruct"), _feature_count(feature_set, "array_literal"), _feature_count(feature_set, "slice_expr"), _feature_count(feature_set, "loop_label"), _feature_count(feature_set, "raw_string"))
    if (_validate_main_decl(typed.funcs, source) != 0):
        return 1
    if (_validate_match_usage(typed.feature_set, typed.enums, source) != 0):
        return 1
    if (im.validate_goals(source) == 0):
        print("Typecheck error: unsupported intent goal.")
        print(im.first_unsupported_goal(source))
        return 1
    if (pipe.validate(typed.normalized) != 0):
        print("Typecheck error: language validation failed.")
        return 1
    return 0

func typecheck_to_normalized(source: String) -> String:
    let normalized = parser.parse_normalized(source)
    let feature_set = parser.parse_feature_set(source)
    let enums = parser.parse_enums(source)
    let aliases = parser.parse_aliases(source)
    let funcs = parser.parse_funcs(source)
    let typed = tir.typed_new(source, normalized, feature_set, enums, aliases, funcs, _feature_count(feature_set, "enum_payload"), _feature_count(feature_set, "match"), _feature_count(feature_set, "range_loop"), _feature_count(feature_set, "if_expr"), _feature_count(feature_set, "closure"), _feature_count(feature_set, "unsafe"), _feature_count(feature_set, "extension_impl"), _feature_count(feature_set, "visibility"), _feature_count(feature_set, "tuple_destruct"), _feature_count(feature_set, "array_literal"), _feature_count(feature_set, "slice_expr"), _feature_count(feature_set, "loop_label"), _feature_count(feature_set, "raw_string"))
    return typed.normalized
