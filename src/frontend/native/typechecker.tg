import "src/frontend/native/parser.tg" as parser
import "src/frontend/lowering/pipeline.tg" as pipe
import "src/frontend/intent/matcher.tg" as im
import "src/frontend/semantic/pass.tg" as sempass

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __string_from_codepoint(cp: i32) -> String

struct ProgramT:
    source: String
    normalized: String
    feature_set: String
    enums: String
    aliases: String
    funcs: String
    symbols: String
    exprs: String
    stmts: String
    blocks: String
    trait_rows: String
    impl_rows: String
    error_count: i32
    error_code: String
    error_message: String
    enum_payload_count: i32
    match_count: i32
    range_loop_count: i32
    if_expr_count: i32
    closure_count: i32
    unsafe_count: i32
    extension_impl_count: i32
    visibility_count: i32
    tuple_destruct_count: i32
    array_literal_count: i32
    slice_expr_count: i32
    loop_label_count: i32
    raw_string_count: i32
    interpolated_string_count: i32
    result_sugar_count: i32
    defer_scope_count: i32
    comptime_count: i32

func _program_new(source: String, normalized: String, feature_set: String, enums: String, aliases: String, funcs: String, enum_payload_count: i32, match_count: i32, range_loop_count: i32, if_expr_count: i32, closure_count: i32, unsafe_count: i32, extension_impl_count: i32, visibility_count: i32, tuple_destruct_count: i32, array_literal_count: i32, slice_expr_count: i32, loop_label_count: i32, raw_string_count: i32, interpolated_string_count: i32, result_sugar_count: i32, defer_scope_count: i32, comptime_count: i32) -> ProgramT:
    return ProgramT(source, normalized, feature_set, enums, aliases, funcs, ";", ";", ";", ";", ";", ";", 0, "", "", enum_payload_count, match_count, range_loop_count, if_expr_count, closure_count, unsafe_count, extension_impl_count, visibility_count, tuple_destruct_count, array_literal_count, slice_expr_count, loop_label_count, raw_string_count, interpolated_string_count, result_sugar_count, defer_scope_count, comptime_count)

func _program_set_error(program: ProgramT, code: String, message: String) -> ProgramT:
    return ProgramT(program.source, program.normalized, program.feature_set, program.enums, program.aliases, program.funcs, program.symbols, program.exprs, program.stmts, program.blocks, program.trait_rows, program.impl_rows, program.error_count + 1, code, message, program.enum_payload_count, program.match_count, program.range_loop_count, program.if_expr_count, program.closure_count, program.unsafe_count, program.extension_impl_count, program.visibility_count, program.tuple_destruct_count, program.array_literal_count, program.slice_expr_count, program.loop_label_count, program.raw_string_count, program.interpolated_string_count, program.result_sugar_count, program.defer_scope_count, program.comptime_count)

func _program_has_error(program: ProgramT) -> i32:
    if (program.error_count > 0):
        return 1
    return 0

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _bs() -> String:
    return __string_from_codepoint(92)

func _nl() -> String:
    return __string_from_codepoint(10)

func _decode_escaped_newlines(text: String) -> String:
    let n = strlen(text)
    let i = 0
    let out = ""
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == _bs()):
            if ((i + 1) < n):
                let nx = _char_at(text, i + 1)
                if (nx == "n"):
                    out = out + _nl()
                    i = i + 2
                else:
                    out = out + ch
                    i = i + 1
            else:
                out = out + ch
                i = i + 1
        else:
            out = out + ch
            i = i + 1
    return out

func _normalize_source_newlines(source: String) -> String:
    if (_contains(source, "\\n") == 1):
        return _decode_escaped_newlines(source)
    return source

func _program_from_source(source: String) -> ProgramT:
    let source_norm = _normalize_source_newlines(source)
    let normalized = parser.parse_normalized(source_norm)
    let feature_set = parser.parse_feature_set(source_norm)
    let interpolated_count = 0
    if (_contains(feature_set, ";interpolated_string;") == 1):
        interpolated_count = 1
    return _program_new(source_norm, normalized, feature_set, parser.parse_enums(source_norm), parser.parse_aliases(source_norm), parser.parse_funcs(source_norm), parser.parse_enum_payload_count(source_norm), parser.parse_match_count(source_norm), parser.parse_range_loop_count(source_norm), parser.parse_if_expr_count(source_norm), parser.parse_closure_count(source_norm), parser.parse_unsafe_count(source_norm), parser.parse_extension_impl_count(source_norm), parser.parse_visibility_count(source_norm), parser.parse_tuple_destruct_count(source_norm), parser.parse_array_literal_count(source_norm), parser.parse_slice_expr_count(source_norm), parser.parse_loop_label_count(source_norm), parser.parse_raw_string_count(source_norm), interpolated_count, parser.parse_result_sugar_count(source_norm), parser.parse_defer_scope_count(source_norm), parser.parse_comptime_count(source_norm))

func _validate_feature_edges(program: ProgramT) -> ProgramT:
    let out = program
    if (program.match_count > 0):
        if (program.enums == ";"):
            out = _program_set_error(out, "E_TYPE_MATCH_MISSING_ENUM", "match requires at least one enum declaration")
    if (_contains(program.normalized, "...") == 1):
        if (_contains(program.normalized, "for ") == 1):
            if (_contains(program.normalized, " in ") == 1):
                out = _program_set_error(out, "E_TYPE_RANGE_HEADER", "malformed range header `for i in a..b:`")
    if (program.range_loop_count > 0):
        if (_contains(program.feature_set, ";range_loop;") == 0):
            out = _program_set_error(out, "E_TYPE_RANGE_HEADER", "malformed range header `for i in a..b:`")
    if (program.if_expr_count > 0):
        if (_contains(program.feature_set, ";if_expr;") == 0):
            out = _program_set_error(out, "E_TYPE_IF_EXPR", "malformed if-expression")
    if (program.closure_count > 0):
        if (_contains(program.feature_set, ";closure;") == 0):
            out = _program_set_error(out, "E_TYPE_CLOSURE", "malformed closure capture/expression")
    return out

func _validate_constraints(program: ProgramT) -> ProgramT:
    let out = program
    if (sempass.preflight(program.normalized) != 0):
        out = _program_set_error(out, "E_TYPE_TRAIT_CONSTRAINT", "trait/impl/generic-bound semantic preflight failed")
    if (im.validate_goals(program.normalized) == 0):
        out = _program_set_error(out, "E_TYPE_INTENT_GOAL", "unsupported intent goal")
    if (pipe.validate(program.normalized) != 0):
        out = _program_set_error(out, "E_TYPE_PIPELINE_VALIDATE", "language validation failed")
    return out

func typecheck_to_typed(source: String) -> ProgramT:
    let program = _program_from_source(source)
    let program1 = _validate_feature_edges(program)
    let program2 = _validate_constraints(program1)
    return program2

func validate_source(source: String) -> i32:
    let typed = typecheck_to_typed(source)
    if (_program_has_error(typed) == 1):
        if (typed.error_code.length() > 0):
            print("Typecheck error [" + typed.error_code + "]: " + typed.error_message)
        else:
            print("Typecheck error [E_TYPE_GENERIC]: unknown typecheck error")
        return 1
    return 0

func typecheck_to_normalized(source: String) -> String:
    return typecheck_to_typed(source).normalized
