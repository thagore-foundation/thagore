import "src/frontend/parser/parser_headers.tg" as ph
import "src/frontend/semantic/generics_traits.tg" as gt

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _line_at(source: String, index: i32) -> String:
    let i = 0
    let n = strlen(source)
    let line_idx = 0
    let line = ""
    while (i < n):
        let ch = _char_at(source, i)
        let escaped_newline = 0
        if (ch == "\\"):
            if ((i + 1) < n):
                if (_char_at(source, i + 1) == "n"):
                    escaped_newline = 1
        if (ch == "\n"):
            if (line_idx == index):
                return line
            line_idx = line_idx + 1
            line = ""
        else:
            if (escaped_newline == 1):
                if (line_idx == index):
                    return line
                line_idx = line_idx + 1
                line = ""
                i = i + 1
            else:
                if (ch == "\r"):
                    line = line
                else:
                    line = line + ch
        i = i + 1
    if (line_idx == index):
        return line
    return ""

func _line_count(source: String) -> i32:
    let n = strlen(source)
    if (n == 0):
        return 0
    let i = 0
    let count = 1
    while (i < n):
        let ch = _char_at(source, i)
        if (ch == "\n"):
            count = count + 1
        else:
            if (ch == "\\"):
                if ((i + 1) < n):
                    if (_char_at(source, i + 1) == "n"):
                        count = count + 1
                        i = i + 1
        i = i + 1
    return count

func _starts_with(text: String, prefix: String) -> i32:
    let pn = strlen(prefix)
    if (strlen(text) < pn):
        return 0
    if (__thg_str_substr(text, 0, pn) == prefix):
        return 1
    return 0

func _find_char(text: String, ch: String) -> i32:
    let i = 0
    let n = strlen(text)
    while (i < n):
        if (_char_at(text, i) == ch):
            return i
        i = i + 1
    return -1

func _split_left(text: String, sep: String) -> String:
    let i = _find_char(text, sep)
    if (i < 0):
        return text
    return __thg_str_substr(text, 0, i)

func _set_contains(set_text: String, name: String) -> i32:
    if (name.length() == 0):
        return 0
    let needle = ";" + name + ";"
    let i = 0
    let n = strlen(set_text)
    let m = strlen(needle)
    while ((i + m) <= n):
        if (__thg_str_substr(set_text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _set_add_unique(set_text: String, name: String) -> String:
    if (name.length() == 0):
        return set_text
    if (_set_contains(set_text, name) == 1):
        return set_text
    return set_text + name + ";"

func count_trait_defs(source: String) -> i32:
    let total = _line_count(source)
    let i = 0
    let count = 0
    while (i < total):
        let line = gt.trim(_line_at(source, i))
        if (_starts_with(line, "trait") == 1):
            if (ph.parse_trait_name(line).length() > 0):
                count = count + 1
        i = i + 1
    return count

func count_impl_defs(source: String) -> i32:
    let total = _line_count(source)
    let i = 0
    let count = 0
    while (i < total):
        let line = gt.trim(_line_at(source, i))
        if (_starts_with(line, "impl") == 1):
            if (ph.parse_impl_pair(line).length() > 0):
                count = count + 1
        i = i + 1
    return count

func count_generic_funcs(source: String) -> i32:
    let total = _line_count(source)
    let i = 0
    let count = 0
    while (i < total):
        let line = gt.trim(_line_at(source, i))
        if (_starts_with(line, "func") == 1):
            if (ph.parse_func_generic_clause(line).length() > 0):
                count = count + 1
        i = i + 1
    return count

func count_result_sugar(source: String) -> i32:
    let total = _line_count(source)
    let i = 0
    let count = 0
    while (i < total):
        let line = gt.trim(_line_at(source, i))
        if (_starts_with(line, "func") == 1):
            if (ph.has_result_sugar(line) == 1):
                count = count + 1
        i = i + 1
    return count

func build_trait_set(source: String) -> String:
    let total = _line_count(source)
    let i = 0
    let out = ";"
    while (i < total):
        let line = gt.trim(_line_at(source, i))
        if (_starts_with(line, "trait") == 1):
            let name = ph.parse_trait_name(line)
            out = _set_add_unique(out, name)
        i = i + 1
    return out

func count_unknown_impl_traits(source: String) -> i32:
    let trait_set = build_trait_set(source)
    let total = _line_count(source)
    let i = 0
    let misses = 0
    while (i < total):
        let line = gt.trim(_line_at(source, i))
        if (_starts_with(line, "impl") == 1):
            let pair = ph.parse_impl_pair(line)
            let trait_name = _split_left(pair, "|")
            if (trait_name.length() > 0):
                if (_set_contains(trait_set, trait_name) == 0):
                    misses = misses + 1
        i = i + 1
    return misses

func analyze_summary(source: String) -> String:
    let a = count_generic_funcs(source)
    let b = count_trait_defs(source)
    let c = count_impl_defs(source)
    let d = count_result_sugar(source)
    let e = count_unknown_impl_traits(source)
    let ga = "0"
    if (a > 0):
        ga = "1"
    let gb = "0"
    if (b > 0):
        gb = "1"
    let gc = "0"
    if (c > 0):
        gc = "1"
    let gd = "0"
    if (d > 0):
        gd = "1"
    let ge = "0"
    if (e > 0):
        ge = "1"
    return "generic_funcs=" + ga + ";traits=" + gb + ";impls=" + gc + ";result_sugar=" + gd + ";unknown_impl_traits=" + ge

func preflight(source: String) -> i32:
    analyze_summary(source)
    let unknown_impl_traits = count_unknown_impl_traits(source)
    if (unknown_impl_traits > 0):
        print("Semantic error: impl references unknown trait.")
        print("Unknown trait impl count:")
        print(unknown_impl_traits)
        return 1
    return 0
