extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __string_from_codepoint(cp: i32) -> String

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _find_char(text: String, ch: String) -> i32:
    let i = 0
    let n = strlen(text)
    while (i < n):
        if (_char_at(text, i) == ch):
            return i
        i = i + 1
    return -1

func _tab() -> String:
    return __string_from_codepoint(9)

func _nl() -> String:
    return __string_from_codepoint(10)

func _cr() -> String:
    return __string_from_codepoint(13)

func _is_space(ch: String) -> i32:
    if (ch == " "):
        return 1
    if (ch == _tab()):
        return 1
    if (ch == _nl()):
        return 1
    if (ch == _cr()):
        return 1
    return 0

func trim(text: String) -> String:
    let out = ""
    let i = 0
    let n = strlen(text)
    while (i < n):
        let ch = _char_at(text, i)
        if (_is_space(ch) == 0):
            out = out + ch
        i = i + 1
    return out

func _split_by_comma(spec: String, at: i32) -> String:
    let clean = trim(spec)
    let part = ""
    let idx = 0
    let token_idx = 0
    let n = strlen(clean)
    while (idx < n):
        let ch = _char_at(clean, idx)
        if (ch == ","):
            if (token_idx == at):
                return part
            token_idx = token_idx + 1
            part = ""
        else:
            part = part + ch
        idx = idx + 1
    if (token_idx == at):
        return part
    return ""

func _split_name(token: String) -> String:
    let i = 0
    let n = strlen(token)
    while (i < n):
        if (_char_at(token, i) == ":"):
            return __thg_str_substr(token, 0, i)
        i = i + 1
    return token

func _split_bound(token: String) -> String:
    let i = 0
    let n = strlen(token)
    while (i < n):
        if (_char_at(token, i) == ":"):
            return __thg_str_substr(token, i + 1, n - i - 1)
        i = i + 1
    return ""

func _is_alpha_num(ch: String) -> i32:
    if (_find_char("abcdefghijklmnopqrstuvwxyz", ch) >= 0):
        return 1
    if (_find_char("ABCDEFGHIJKLMNOPQRSTUVWXYZ", ch) >= 0):
        return 1
    if (_find_char("0123456789", ch) >= 0):
        return 1
    if (ch == "_"):
        return 1
    return 0

func extract_generic_clause(signature: String) -> String:
    let s = trim(signature)
    let left = _find_char(s, "[")
    if (left < 0):
        return ""
    let right = _find_char(s, "]")
    if (right < 0):
        return ""
    if (right <= left):
        return ""
    return __thg_str_substr(s, left + 1, right - left - 1)

func generic_param_count(spec: String) -> i32:
    let clean = trim(spec)
    if (strlen(clean) == 0):
        return 0
    let count = 1
    let i = 0
    let n = strlen(clean)
    while (i < n):
        if (_char_at(clean, i) == ","):
            count = count + 1
        i = i + 1
    return count

func generic_param_name_at(spec: String, index: i32) -> String:
    return _split_name(_split_by_comma(spec, index))

func generic_param_bound_at(spec: String, index: i32) -> String:
    return _split_bound(_split_by_comma(spec, index))

func sanitize_atom(atom: String) -> String:
    let clean = trim(atom)
    let out = ""
    let i = 0
    let n = strlen(clean)
    while (i < n):
        let ch = _char_at(clean, i)
        if (_is_alpha_num(ch) == 1):
            out = out + ch
        else:
            out = out + "_"
        i = i + 1
    return out

func mangle_symbol(base: String, type_args_csv: String) -> String:
    let spec = trim(type_args_csv)
    if (strlen(spec) == 0):
        return base
    let total = generic_param_count(spec)
    let i = 0
    let out = base
    while (i < total):
        out = out + "__" + sanitize_atom(_split_by_comma(spec, i))
        i = i + 1
    return out

func extract_trait_name(line: String) -> String:
    let s = trim(line)
    if (__thg_str_substr(s, 0, 5) != "trait"):
        return ""
    let body = trim(__thg_str_substr(s, 5, strlen(s) - 5))
    let colon = _find_char(body, ":")
    if (colon < 0):
        return body
    return __thg_str_substr(body, 0, colon)

func _find_for_kw(text: String) -> i32:
    let n = strlen(text)
    let i = 0
    while ((i + 3) <= n):
        if (__thg_str_substr(text, i, 3) == "for"):
            return i
        i = i + 1
    return -1

func extract_impl_pair(line: String) -> String:
    let s = trim(line)
    if (__thg_str_substr(s, 0, 4) != "impl"):
        return ""
    let body = trim(__thg_str_substr(s, 4, strlen(s) - 4))
    let p = _find_for_kw(body)
    if (p < 0):
        return ""
    let left = trim(__thg_str_substr(body, 0, p))
    let right_full = trim(__thg_str_substr(body, p + 3, strlen(body) - p - 3))
    let colon = _find_char(right_full, ":")
    if (colon < 0):
        return left + "|" + right_full
    return left + "|" + __thg_str_substr(right_full, 0, colon)

func make_instance_key(symbol: String, args_csv: String) -> String:
    return mangle_symbol(symbol, args_csv)
