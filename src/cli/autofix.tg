            explain_json = explain_json + _json_quote("candidates") + ":[" + c1 + "," + c2 + "," + c3 + "," + c4 + "," + c5 + "," + c6 + "," + c7 + "," + c8 + "]"
            explain_json = explain_json + "}"
            print(explain_json)
        else:
            print("[autofix][explain] rule=canonical_whitespace_tabs_to_spaces diagnostic=PARSE_INDENT_TAB confidence=0.99 risk=safe candidate=" + _to_string_i32(cand_tabs) + " selected=" + _to_string_i32(sel_tabs) + " reason=" + reason_tabs)
            print("[autofix][explain] rule=canonical_whitespace_trim_trailing diagnostic=PARSE_TRAILING_WHITESPACE confidence=0.97 risk=safe candidate=" + _to_string_i32(cand_trim_ws) + " selected=" + _to_string_i32(sel_trim_ws) + " reason=" + reason_trim_ws)
            print("[autofix][explain] rule=canonical_newline_final_newline diagnostic=PARSE_MISSING_FINAL_NEWLINE confidence=0.99 risk=safe candidate=" + _to_string_i32(cand_final_nl) + " selected=" + _to_string_i32(sel_final_nl) + " reason=" + reason_final_nl)
            print("[autofix][explain] rule=normalize_deprecated_fn_keyword diagnostic=PARSE_DEPRECATED_FN_KEYWORD confidence=0.95 risk=safe candidate=" + _to_string_i32(cand_dep_fn) + " selected=" + _to_string_i32(sel_dep_fn) + " reason=" + reason_dep_fn)
            print("[autofix][explain] rule=remove_duplicate_trivial_modifiers diagnostic=PARSE_DUPLICATE_MODIFIER confidence=0.96 risk=safe candidate=" + _to_string_i32(cand_dup_mod) + " selected=" + _to_string_i32(sel_dup_mod) + " reason=" + reason_dup_mod)
            print("[autofix][explain] rule=add_missing_std_import diagnostic=SYM_MISSING_STD_IMPORT confidence=0.96 risk=safe candidate=" + _to_string_i32(cand_imports) + " selected=" + _to_string_i32(sel_imports) + " reason=" + reason_imports)
            print("[autofix][explain] rule=missing_colon_block_header diagnostic=PARSE_MISSING_BLOCK_COLON confidence=0.98 risk=safe candidate=" + _to_string_i32(cand_colon) + " selected=" + _to_string_i32(sel_colon) + " reason=" + reason_colon)
            print("[autofix][explain] rule=infer_return_annotation_literal diagnostic=TYPE_MISSING_RETURN_ANNOTATION confidence=0.82 threshold=0.80 risk=aggressive candidate=" + _to_string_i32(cand_ret) + " selected=" + _to_string_i32(sel_ret) + " reason=" + reason_ret)

    let files_scanned = 1
    let files_changed = 0
    let fixes_applied = 0
    let fixes_skipped = 0
    let backup_file = ""
    let rebuild = "no-change"
    let max_files_touched = 10
    let can_apply = 1
    if ((apply_flag == 1) and (lock_strict == 1) and (lock_used == 1) and (lock_exists == 1) and (lock_blocked_total > 0)):
        can_apply = 0
        rebuild = "lock-blocked"
        failure_reason = "lock-strict-blocked"
        failing_diagnostic = "LOCK_STRICT_BLOCKED"
        conflict_files_set = _set_add_unique(conflict_files_set, entry_path)
        print("[autofix] lock strict violation: blocked fixes=" + _to_string_i32(lock_blocked_total))

    if ((apply_flag == 1) and (can_apply == 1)):
        fixes_applied = selected_total
        fixes_skipped = candidate_total - selected_total
        if (selected_total > 0):
            if (current == source):
                print("[autofix] conflict: planner selected fixes but generated no source delta.")
                can_apply = 0
                rebuild = "conflict"
                failure_reason = "planner-selected-no-delta"
                failing_diagnostic = "AUTOFIX_CONFLICT_NO_DELTA"
                conflict_fix_ids_set = _set_add_unique(conflict_fix_ids_set, "planned-fixes")
                conflict_files_set = _set_add_unique(conflict_files_set, entry_path)
            else:
                if ((files_changed + 1) > max_files_touched):
                    print("[autofix] conflict: max files touched exceeded.")
                    can_apply = 0
                    rebuild = "conflict"
                    failure_reason = "max-files-touched-exceeded"
                    failing_diagnostic = "AUTOFIX_CONFLICT_MAX_FILES"
                    conflict_fix_ids_set = _set_add_unique(conflict_fix_ids_set, "max-files-touched")
                    conflict_files_set = _set_add_unique(conflict_files_set, entry_path)
                else:
                    _ensure_dirs()
                    let backup_file_local = ".thagore/fix/backups/" + session_id + "__" + _sanitize_path(entry_path) + ".bak"
                    if (fs.write_text(backup_file_local, source) == 0):
                        print("[autofix] error: failed to write backup: " + backup_file_local)
                        can_apply = 0
                        rebuild = "io-error"
                        failure_reason = "failed-write-backup"
                        failing_diagnostic = "AUTOFIX_IO_BACKUP_WRITE_FAILED"
                        conflict_files_set = _set_add_unique(conflict_files_set, entry_path)
                    else:
                        if (fs.write_text(entry_path, current) == 0):
                            print("[autofix] error: failed to write source: " + entry_path)
                            can_apply = 0
                            rebuild = "io-error"
                            failure_reason = "failed-write-source"
                            failing_diagnostic = "AUTOFIX_IO_SOURCE_WRITE_FAILED"
                            conflict_files_set = _set_add_unique(conflict_files_set, entry_path)
                        else:
                            backup_file = backup_file_local
                            files_changed = 1
                            rebuild = "pending"
                            if (strlen(lock_path) > 0):
                                let lock_out = lock_rules_set
                                if (lock_exists == 0):
                                    lock_out = ";"
                                if (_set_contains(applied_rules_set, "canonical_whitespace_tabs_to_spaces") == 1):
                                    lock_out = _set_add_unique(lock_out, "canonical_whitespace_tabs_to_spaces")
                                if (_set_contains(applied_rules_set, "canonical_whitespace_trim_trailing") == 1):
                                    lock_out = _set_add_unique(lock_out, "canonical_whitespace_trim_trailing")
                                if (_set_contains(applied_rules_set, "canonical_newline_final_newline") == 1):
                                    lock_out = _set_add_unique(lock_out, "canonical_newline_final_newline")
                                if (_set_contains(applied_rules_set, "normalize_deprecated_fn_keyword") == 1):
                                    lock_out = _set_add_unique(lock_out, "normalize_deprecated_fn_keyword")
                                if (_set_contains(applied_rules_set, "remove_duplicate_trivial_modifiers") == 1):
                                    lock_out = _set_add_unique(lock_out, "remove_duplicate_trivial_modifiers")
                                if (_set_contains(applied_rules_set, "add_missing_std_import") == 1):
                                    lock_out = _set_add_unique(lock_out, "add_missing_std_import")
                                if (_set_contains(applied_rules_set, "missing_colon_block_header") == 1):
                                    lock_out = _set_add_unique(lock_out, "missing_colon_block_header")
                                if (_set_contains(applied_rules_set, "infer_return_annotation_literal") == 1):
                                    lock_out = _set_add_unique(lock_out, "infer_return_annotation_literal")
                                if (_write_lock_file(lock_path, mode, lock_out) != 0):
                                    can_apply = 0
                                    rebuild = "io-error"
                                    failure_reason = "failed-write-lock"
                                    failing_diagnostic = "AUTOFIX_IO_LOCK_WRITE_FAILED"
                                    conflict_files_set = _set_add_unique(conflict_files_set, lock_path)
                                    if (fs.write_text(entry_path, source) == 0):
                                        print("[autofix] rollback error: failed to restore source after lock write failure: " + entry_path)
                                        failure_reason = "failed-write-lock-and-restore"
                                        failing_diagnostic = "AUTOFIX_IO_LOCK_WRITE_AND_RESTORE_FAILED"
                                        conflict_files_set = _set_add_unique(conflict_files_set, entry_path)
                                    else:
                                        print("[autofix] rollback: source restored after lock write failure.")
                                        current = source
                                        files_changed = 0
                                        backup_file = ""
            if (can_apply == 0):
                fixes_applied = 0
                fixes_skipped = candidate_total
                fixes_json = _mark_fixes_unapplied(fixes_json)
        else:
            rebuild = "no-change"
    else:
        fixes_applied = 0
        fixes_skipped = candidate_total
        if (dry_run_flag == 1):
            rebuild = "dry-run"
        else:
            if (explain_flag == 1):
                rebuild = "explain"
            else:
                if (rebuild != "lock-blocked"):
                    rebuild = "no-change"

    if ((from_build == 1) and (rebuild != "lock-blocked")):
        rebuild = "retrying"
    let old_hash = _hash_text(source)
    let new_hash = _hash_text(current)
    let report_path = _write_report(session_id, mode, entry_path, files_scanned, files_changed, fixes_applied, fixes_skipped, rebuild, fixes_json, backup_file, diagnostics_seen_set, applied_rules_set, candidate_rules_set, old_hash, new_hash, lock_path, failure_reason, failing_diagnostic, conflict_fix_ids_set, conflict_files_set)
    _emit_summary(session_id, mode, files_scanned, files_changed, fixes_applied, fixes_skipped, rebuild)
    if ((apply_flag == 1) and (mode == "aggressive") and (sel_ret > 0)):
        print("[autofix] warning: aggressive fixes applied; review report carefully before commit.")

    if (dry_run_flag == 1):
        print("no source files were modified")
    if ((apply_flag == 1) and (fixes_applied > 0)):
        print("rollback: thagore fix rollback " + session_id)
    if ((apply_flag == 1) and (fixes_applied > 0)):
        print("report: " + report_path)
    if ((apply_flag == 1) and (can_apply == 0)):
        print("[autofix] applied_fixes=0")
        print("[autofix] failing_diagnostic=" + failing_diagnostic)
        if (strlen(_set_to_json_array(conflict_fix_ids_set)) > 2):
            print("[autofix] conflict_fix_ids=" + _set_to_json_array(conflict_fix_ids_set))
        if (strlen(_set_to_json_array(conflict_files_set)) > 2):
            print("[autofix] conflict_files=" + _set_to_json_array(conflict_files_set))
        print("[autofix] report: " + report_path)
        return -2
    return selected_total

func apply_for_build(entry_path: String, mode: String, lock_path: String, lock_strict: i32) -> i32:
    return _run_fix_engine(entry_path, mode, 1, 0, 0, 0, 1, lock_path, lock_strict)

func run_fix_dry_run(entry_path: String, mode: String, lock_path: String, lock_strict: i32) -> i32:
    let rc = _run_fix_engine(entry_path, mode, 0, 1, 0, 0, 0, lock_path, lock_strict)
    if (rc < 0):
        return 1
    return 0

func run_fix_apply(entry_path: String, mode: String, lock_path: String, lock_strict: i32) -> i32:
    let rc = _run_fix_engine(entry_path, mode, 1, 0, 0, 0, 0, lock_path, lock_strict)
    if (rc < 0):
        return 1
    return 0

func run_fix_explain(entry_path: String, mode: String, as_json: i32, lock_path: String, lock_strict: i32) -> i32:
    let rc = _run_fix_engine(entry_path, mode, 0, 0, 1, as_json, 0, lock_path, lock_strict)
    if (rc < 0):
        return 1
    return 0

func run_fix_doctor(entry_path: String, mode: String, lock_path: String, lock_strict: i32) -> i32:
    print("[autofix][doctor] scanning " + entry_path)
    let found = _run_fix_engine(entry_path, mode, 0, 1, 0, 0, 0, lock_path, lock_strict)
    if (found < 0):
        return 1
    if (found <= 0):
        print("[autofix][doctor] no safe fixes suggested.")
    else:
        print("[autofix][doctor] suggested fixes: " + _to_string_i32(found))
    return 0

func run_fix_rollback(session_id: String) -> i32:
    let session_path = ".thagore/fix/sessions/" + session_id + ".json"
    if (fs.exists(session_path) == 0):
        print("[autofix] rollback error: session not found: " + session_id)
        print("[autofix] files_restored=0")
        print("[autofix] files_failed=1")
        print("[autofix] restore_error=session-not-found")
        return 1
    let session_text = fs.read_text(session_path)
    let entry = _json_get_string(session_text, "entry")
    let backup = _json_get_string(session_text, "backup_file")
    if (strlen(entry) == 0):
        print("[autofix] rollback error: missing entry in session.")
        print("[autofix] files_restored=0")
        print("[autofix] files_failed=1")
        print("[autofix] restore_error=missing-entry")
        return 1
    if (strlen(backup) == 0):
        print("[autofix] rollback error: no backup for this session.")
        print("[autofix] files_restored=0")
        print("[autofix] files_failed=1")
        print("[autofix] restore_error=missing-backup")
        return 1
    if (fs.exists(backup) == 0):
        print("[autofix] rollback error: backup not found: " + backup)
        print("[autofix] files_restored=0")
        print("[autofix] files_failed=1")
        print("[autofix] restore_error=backup-not-found")
        return 1
    let old_source = fs.read_text(backup)
    if (fs.write_text(entry, old_source) == 0):
        print("[autofix] rollback error: failed to restore file.")
        print("[autofix] files_restored=0")
        print("[autofix] files_failed=1")
        print("[autofix] restore_failed_file=" + entry)
        print("[autofix] restore_error=write-failed")
        return 1
    print("[autofix] rollback session=" + session_id)
    print("[autofix] files_restored=1")
    print("[autofix] files_failed=0")
    print("[autofix] restored: " + entry)
    return 0
