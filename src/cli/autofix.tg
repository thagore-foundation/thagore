            c8 = c8 + _json_quote("candidate_count") + ":" + _to_string_i32(cand_final_nl) + ","
            c8 = c8 + _json_quote("selected_count") + ":" + _to_string_i32(sel_final_nl) + ","
            c8 = c8 + _json_quote("reason") + ":" + _json_quote(reason_final_nl) + ","
            c8 = c8 + _json_quote("preview_old") + ":" + _json_quote(preview_final_nl_old) + ","
            c8 = c8 + _json_quote("preview_new") + ":" + _json_quote(preview_final_nl_new)
            c8 = c8 + "}"

            let explain_json = "{"
            explain_json = explain_json + _json_quote("mode") + ":" + _json_quote(mode) + ","
