            c5 = c5 + _json_quote("confidence") + ":0.96,"
            c5 = c5 + _json_quote("risk") + ":" + _json_quote("safe") + ","
            c5 = c5 + _json_quote("candidate_count") + ":" + _to_string_i32(cand_imports) + ","
            c5 = c5 + _json_quote("selected_count") + ":" + _to_string_i32(sel_imports) + ","
            c5 = c5 + _json_quote("reason") + ":" + _json_quote(reason_imports) + ","
            c5 = c5 + _json_quote("preview_old") + ":" + _json_quote(preview_imports_old) + ","
            c5 = c5 + _json_quote("preview_new") + ":" + _json_quote(preview_imports_new)
