            c6 = c6 + _json_quote("diagnostic_code") + ":" + _json_quote("PARSE_MISSING_BLOCK_COLON") + ","
            c6 = c6 + _json_quote("confidence") + ":0.98,"
            c6 = c6 + _json_quote("risk") + ":" + _json_quote("safe") + ","
            c6 = c6 + _json_quote("candidate_count") + ":" + _to_string_i32(cand_colon) + ","
            c6 = c6 + _json_quote("selected_count") + ":" + _to_string_i32(sel_colon) + ","
            c6 = c6 + _json_quote("reason") + ":" + _json_quote(reason_colon) + ","
            c6 = c6 + _json_quote("preview_old") + ":" + _json_quote(preview_colon_old) + ","
            c6 = c6 + _json_quote("preview_new") + ":" + _json_quote(preview_colon_new)
            c6 = c6 + "}"

            let c7 = "{"
            c7 = c7 + _json_quote("rule") + ":" + _json_quote("infer_return_annotation_literal") + ","
            c7 = c7 + _json_quote("diagnostic_code") + ":" + _json_quote("TYPE_MISSING_RETURN_ANNOTATION") + ","
            c7 = c7 + _json_quote("confidence") + ":0.82,"
            c7 = c7 + _json_quote("min_confidence") + ":0.80,"
            c7 = c7 + _json_quote("risk") + ":" + _json_quote("aggressive") + ","
            c7 = c7 + _json_quote("candidate_count") + ":" + _to_string_i32(cand_ret) + ","
            c7 = c7 + _json_quote("selected_count") + ":" + _to_string_i32(sel_ret) + ","
            c7 = c7 + _json_quote("reason") + ":" + _json_quote(reason_ret) + ","
            c7 = c7 + _json_quote("preview_old") + ":" + _json_quote(preview_ret_old) + ","
            c7 = c7 + _json_quote("preview_new") + ":" + _json_quote(preview_ret_new)
            c7 = c7 + "}"

            let c8 = "{"
            c8 = c8 + _json_quote("rule") + ":" + _json_quote("canonical_newline_final_newline") + ","
