import "token.tg" as token

extern func __thg_lex_tokenize(source: String) -> ptr
extern func __thg_tok_count(stream: ptr) -> i32
extern func __thg_tok_kind(stream: ptr, index: i32) -> String
extern func __thg_tok_text(stream: ptr, index: i32) -> String
extern func __thg_tok_tag(stream: ptr, index: i32) -> i32
extern func __thg_ptr_null() -> ptr

struct Lexer:
    source: String
    indent_stack: ptr
    last_indent: i32

func new(source: String) -> Lexer:
    # indent_stack bootstrap bằng runtime stream để giữ tương thích self-host.
    return Lexer(source, __thg_ptr_null(), 0)

func _indent_case(current_indent_level: i32, last_indent: i32) -> i32:
    if (current_indent_level > last_indent):
        return 1
    if (current_indent_level < last_indent):
        return -1
    return 0

func classify_newline(current_indent_level: i32, last_indent: i32) -> String:
    let code = _indent_case(current_indent_level, last_indent)
    if (code > 0):
        return token.tok_indent()
    if (code < 0):
        return token.tok_dedent()
    return token.tok_newline()

func tokenize_stream(source: String) -> ptr:
    return __thg_lex_tokenize(source)

func stream_count(stream: ptr) -> i32:
    return __thg_tok_count(stream)

func stream_kind(stream: ptr, index: i32) -> String:
    return __thg_tok_kind(stream, index)

func stream_text(stream: ptr, index: i32) -> String:
    return __thg_tok_text(stream, index)

func stream_tag(stream: ptr, index: i32) -> i32:
    return __thg_tok_tag(stream, index)

func tokenize(source: String) -> i32:
    let stream = tokenize_stream(source)
    let total = stream_count(stream)
    if (total > 0):
        return total - 1
    return 0
