extern func __thg_interp_new() -> ptr
extern func __thg_interp_eval_expr(interp: ptr, node: ptr) -> i32
extern func __thg_interp_exec_stmt(interp: ptr, node: ptr) -> i32

struct Interpreter:
    handle: ptr

impl Interpreter:
    func eval_expr(self, node: ptr) -> i32:
        return __thg_interp_eval_expr(self.handle, node)

    func exec_stmt(self, node: ptr) -> i32:
        return __thg_interp_exec_stmt(self.handle, node)

func new() -> Interpreter:
    return Interpreter(__thg_interp_new())
