extern func __thg_codegen_emit_llvm(root: ptr) -> String
extern func __thg_codegen_emit_llvm_from_source(source: String, module_name: String) -> String

func emit_program(root: ptr) -> String:
    return __thg_codegen_emit_llvm(root)

func emit_program_from_source(source: String, module_name: String) -> String:
    return __thg_codegen_emit_llvm_from_source(source, module_name)

func system_decls() -> String:
    # Stage1 runtime codegen already emits required declarations.
    # Keep this empty to avoid escaped "\n" literals in self-hosted string handling.
    return ""
