struct Token:
    kind: String
    text: String

extern func __thg_token_new(kind: String, text: String) -> ptr
extern func __thg_token_kind(tok: ptr) -> String
extern func __thg_token_text(tok: ptr) -> String
extern func __thg_token_free(tok: ptr) -> i32

func new_token(k: String, t: String) -> Token:
    return Token(k, t)

func new_handle(k: String, t: String) -> ptr:
    return __thg_token_new(k, t)

func kind_of(tok: ptr) -> String:
    return __thg_token_kind(tok)

func text_of(tok: ptr) -> String:
    return __thg_token_text(tok)

func free_handle(tok: ptr) -> i32:
    return __thg_token_free(tok)
