import env
import fs
import process
import "src/syntax/parser.tg" as parser
import "src/compiler/eval.tg" as eval
import "src/compiler/codegen.tg" as codegen
import "src/compiler/codegen_llvm.tg" as codegen_llvm

func _version() -> String:
    return "0.4.0"

func _basename_no_ext(path: String) -> String:
    let i = 0
    let last_sep = -1
    let last_dot = -1
    while (i < path.length()):
        let ch = path.substr(i, 1)
        if (ch == "/"):
            last_sep = i
            last_dot = -1
        else:
            if (ch == "\\"):
                last_sep = i
                last_dot = -1
            else:
                if (ch == "."):
                    last_dot = i
        i = i + 1

    let start = last_sep + 1
    if (last_dot < start):
        last_dot = path.length()
    return path.substr(start, last_dot - start)

func _emit_ir_from_source(source: String, module_name: String) -> String:
    return codegen_llvm.emit_program_from_source(source, module_name)

func _probe_clang(path: String) -> i32:
    let cmd = path + " --version"
    return process.run(cmd)

func _detect_clang() -> String:
    if (_probe_clang("clang") == 0):
        return "clang"

    let clang_win = "C:\\Program Files\\LLVM\\bin\\clang.exe"
    if (_probe_clang(clang_win) == 0):
        return clang_win

    let clang_local = "llvm/clang+llvm-21.1.8-x86_64-pc-windows-msvc/bin/clang.exe"
    if (_probe_clang(clang_local) == 0):
        return clang_local

    let clang_usr_bin = "/usr/bin/clang"
    if (_probe_clang(clang_usr_bin) == 0):
        return clang_usr_bin

    let clang_usr_local = "/usr/local/bin/clang"
    if (_probe_clang(clang_usr_local) == 0):
        return clang_usr_local

    return ""

func _is_windows() -> i32:
    if (process.run("cmd /c ver >nul 2>nul") == 0):
        return 1
    return 0

func _has_cmd(cmd: String) -> i32:
    if (_is_windows() == 1):
        if (process.run("where " + cmd + " >nul 2>nul") == 0):
            return 1
        return 0
    if (process.run("command -v " + cmd + " >/dev/null 2>&1") == 0):
        return 1
    return 0

func _default_output_name(base: String) -> String:
    if (_is_windows() == 1):
        return base + ".exe"
    return base

func _looks_like_tg(path: String) -> i32:
    if (path.length() < 3):
        return 0
    let suffix = path.substr(path.length() - 3, 3)
    if (suffix == ".tg"):
        return 1
    return 0

func _compile_to_exe(input_path: String, output_override: String) -> i32:
    let source = fs.read_text(input_path)
    if (source.length() == 0):
        print("Error: Empty file or file not found.")
        return 1

    let base = _basename_no_ext(input_path)
    let output_exe = output_override
    if (output_exe.length() == 0):
        output_exe = _default_output_name(base)

    let output_ll = base + ".ll"
    let core_ir = codegen_llvm.system_decls()
    let user_ir = _emit_ir_from_source(source, base)
    if (user_ir.length() == 0):
        print("Error: LLVM IR generation failed")
        return 1

    let merged_ir = core_ir + user_ir
    let ok_temp = fs.write_text(output_ll, merged_ir)
    if (ok_temp == 0):
        print("Error: cannot write LLVM IR file")
        return 1

    let clang_bin = _detect_clang()
    if (clang_bin.length() == 0):
        print("CRITICAL: Clang not found via PATH or standard locations. Please install LLVM.")
        return 1

    let cmd = clang_bin + " " + output_ll + " thag_runtime.lib -o " + output_exe + " -Wno-override-module"
    let build_code = process.run(cmd)
    if (build_code != 0):
        print("Build failed. Ensure clang is installed and available in PATH.")
        print("Command executed:")
        print(cmd)
        return build_code

    print("Build success.")
    print(output_exe)
    return 0

func _run_script(input_path: String) -> i32:
    let source = fs.read_text(input_path)
    if (source.length() == 0):
        print("Error: Empty file or file not found.")
        return 1

    let program_ast = parser.parse_program(source)
    let interpreter = eval.new()
    let exit_code = interpreter.exec_stmt(program_ast)
    return exit_code

func _check_script(input_path: String) -> i32:
    let source = fs.read_text(input_path)
    if (source.length() == 0):
        print("Error: Empty file or file not found.")
        return 1

    let program_ast = parser.parse_program(source)
    program_ast = program_ast
    print("Check success: syntax/parse valid.")
    return 0

func _print_help() -> i32:
    print("Thagore Compiler CLI")
    print("Usage:")
    print("  thagore build <file.tg> [-o output]")
    print("  thagore run <file.tg>")
    print("  thagore check <file.tg>")
    print("  thagore doctor")
    print("  thagore install toolchain")
    print("  thagore --help")
    print("  thagore --version")
    print("")
    print("Compatibility:")
    print("  Alias 'thag' is still supported and will be deprecated later.")
    return 0

func _print_version() -> i32:
    print("thagore " + _version())
    return 0

func _doctor() -> i32:
    let code = 0
    print("Thagore doctor")

    if (_detect_clang().length() > 0):
        print("  [ok] clang")
    else:
        print("  [missing] clang")
        code = 1

    if (_has_cmd("cmake") == 1):
        print("  [ok] cmake")
    else:
        print("  [missing] cmake")
        code = 1

    if (_has_cmd("git") == 1):
        print("  [ok] git")
    else:
        print("  [missing] git")
        code = 1

    if (_has_cmd("ninja") == 1):
        print("  [ok] ninja")
    else:
        print("  [missing] ninja")
        code = 1

    if (_is_windows() == 0):
        if (_has_cmd("lld") == 1):
            print("  [ok] lld")
        else:
            print("  [missing] lld")
            code = 1

    return code

func _install_toolchain() -> i32:
    print("Installing toolchain...")
    if (_is_windows() == 1):
        if (_has_cmd("winget") == 1):
            if (process.run("winget install --id LLVM.LLVM --version 21.1.8 --silent --accept-package-agreements --accept-source-agreements") != 0):
                return 1
            if (process.run("winget install --id Kitware.CMake --silent --accept-package-agreements --accept-source-agreements") != 0):
                return 1
            if (process.run("winget install --id Ninja-build.Ninja --silent --accept-package-agreements --accept-source-agreements") != 0):
                return 1
            if (process.run("winget install --id Git.Git --silent --accept-package-agreements --accept-source-agreements") != 0):
                return 1
        else:
            if (_has_cmd("choco") == 1):
                if (process.run("choco install llvm cmake ninja git -y") != 0):
                    return 1
            else:
                print("Error: winget/choco not found. Install LLVM 21.1.8, cmake, ninja, git manually.")
                return 1
    else:
        if (_has_cmd("brew") == 1):
            if (process.run("brew update") != 0):
                return 1
            if (process.run("brew install llvm cmake ninja git") != 0):
                return 1
        else:
            if (_has_cmd("apt-get") == 1):
                if (process.run("sudo apt-get update") != 0):
                    return 1
                if (process.run("curl -fsSL https://apt.llvm.org/llvm.sh -o /tmp/llvm.sh") != 0):
                    return 1
                if (process.run("chmod +x /tmp/llvm.sh") != 0):
                    return 1
                if (process.run("sudo /tmp/llvm.sh 21 all") != 0):
                    return 1
                if (process.run("sudo apt-get install -y cmake ninja-build git") != 0):
                    return 1
            else:
                print("Error: supported package manager not detected (brew/apt-get).")
                return 1

    print("Toolchain install done.")
    return _doctor()

func _run_command(command: String, script_arg: String, output_arg: String) -> i32:
    if (command == "build"):
        return _compile_to_exe(script_arg, output_arg)
    else:
        if (command == "run"):
            return _run_script(script_arg)
        else:
            if (command == "check"):
                return _check_script(script_arg)
    print("Unknown command: " + command)
    return 2

func main() -> i32:
    if (env.count() < 2):
        return _print_help()

    let arg1 = env.get(1)
    if (arg1 == "--help"):
        return _print_help()
    else:
        if (arg1 == "-h"):
            return _print_help()
    if (arg1 == "--version"):
        return _print_version()
    else:
        if (arg1 == "-V"):
            return _print_version()
    if (arg1 == "doctor"):
        return _doctor()
    if (arg1 == "install"):
        if (env.count() >= 3):
            if (env.get(2) == "toolchain"):
                return _install_toolchain()

    if (_looks_like_tg(arg1) == 1):
        let build_mode = 0
        let output_arg_legacy = ""
        let j = 2
        while (j < env.count()):
            let legacy_arg = env.get(j)
            if (legacy_arg == "--build"):
                build_mode = 1
                j = j + 1
            else:
                if (legacy_arg == "-o"):
                    if ((j + 1) >= env.count()):
                        print("Error: missing output path after -o")
                        return 2
                    output_arg_legacy = env.get(j + 1)
                    j = j + 2
                else:
                    j = j + 1
        if (build_mode == 1):
            return _compile_to_exe(arg1, output_arg_legacy)
        return _run_script(arg1)

    let command = arg1
    if (command != "build"):
        if (command != "run"):
            if (command != "check"):
                print("Error: invalid command.")
                print("Expected one of: build, run, check, doctor, install toolchain")
                return 2

    if (env.count() < 3):
        print("Error: missing input file.")
        return 2

    let script_arg = env.get(2)
    let output_arg = ""
    let i = 3
    while (i < env.count()):
        let arg = env.get(i)
        if (arg == "-o"):
            if ((i + 1) >= env.count()):
                print("Error: missing output path after -o")
                return 2
            output_arg = env.get(i + 1)
            i = i + 2
        else:
            i = i + 1

    return _run_command(command, script_arg, output_arg)
