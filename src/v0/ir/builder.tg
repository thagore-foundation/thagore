import "src/v0/ir/module.tg"

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _v0_contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _v0_add_set(set_text: String, row: String) -> String:
    if (_v0_contains(set_text, ";" + row + ";") == 1):
        return set_text
    return set_text + row + ";"

func v0_ir_add_function(module: V0IrModule, func_name: String, return_type: String) -> V0IrModule:
    let row = "fn|" + func_name + "|" + return_type
    return V0IrModule(_v0_add_set(module.functions, row), module.blocks, module.instrs, module.strings, module.error_count, module.error_code, module.error_message)

func v0_ir_add_block(module: V0IrModule, func_name: String, block_name: String) -> V0IrModule:
    let row = "bb|" + func_name + "|" + block_name
    return V0IrModule(module.functions, _v0_add_set(module.blocks, row), module.instrs, module.strings, module.error_count, module.error_code, module.error_message)

func v0_ir_add_instr(module: V0IrModule, func_name: String, block_name: String, op: String, arg0: String, arg1: String, result_type: String) -> V0IrModule:
    let row = "ins|" + func_name + "|" + block_name + "|" + op + "|" + arg0 + "|" + arg1 + "|" + result_type
    return V0IrModule(module.functions, module.blocks, module.instrs + row + ";", module.strings, module.error_count, module.error_code, module.error_message)

func v0_ir_add_string(module: V0IrModule, key: String, value: String) -> V0IrModule:
    let row = "str|" + key + "|" + value
    return V0IrModule(module.functions, module.blocks, module.instrs, _v0_add_set(module.strings, row), module.error_count, module.error_code, module.error_message)
