    return 0

func first_unsupported_goal(source: String) -> String:
    let goals = parse_goals(source)
    let total = goal_count(goals)
    let i = 0
    while (i < total):
        let goal = _goal_at(goals, i)
        if (is_supported_goal(goal) == 0):
            return goal
        i = i + 1
    return ""

func validate_goals(source: String) -> i32:
    if (first_unsupported_goal(source).length() > 0):
        return 0
    return 1

func select_rule(goal: String, mode: String) -> String:
    if (goal == "auto_plan"):
        return "rule.auto_plan.resolve.v1"
    if (goal == "off"):
        return "rule.intent.off"
    if (goal == "reduce_sum"):
        if (mode == "max"):
            return "rule.reduce_sum.simd.v2"
        return "rule.reduce_sum.scalar.v1"
    if (goal == "map_filter_reduce"):
        if (mode == "max"):
            return "rule.map_filter_reduce.fused.v2"
        return "rule.map_filter_reduce.fused.v1"
    if (goal == "deduplicate_sorted"):
        if (mode == "max"):
            return "rule.deduplicate_sorted.branchless.v2"
        return "rule.deduplicate_sorted.linear.v1"
    if (goal == "binary_search"):
        if (mode == "max"):
            return "rule.binary_search.branchless.v2"
        return "rule.binary_search.classic.v1"
    if (goal == "binary_search_sorted"):
        return "rule.search.binary.sorted.v1"
    if (goal == "lower_bound_sorted"):
        return "rule.search.lower_bound.sorted.v1"
    if (goal == "upper_bound_sorted"):
        return "rule.search.upper_bound.sorted.v1"
    if (goal == "count_less_sorted"):
        return "rule.search.count_less.sorted.v1"
    if (goal == "count_less_equal_sorted"):
        return "rule.search.count_less_equal.sorted.v1"
    if (goal == "count_greater_sorted"):
        return "rule.search.count_greater.sorted.v1"
    if (goal == "count_greater_equal_sorted"):
        return "rule.search.count_greater_equal.sorted.v1"
    if (goal == "count_equal_sorted"):
        return "rule.search.count_equal.sorted.v1"
    if (goal == "count_not_equal_sorted"):
        return "rule.search.count_not_equal.sorted.v1"
    if (goal == "count_range_sorted"):
        return "rule.search.count_range.sorted.v1"
    if (goal == "count_outside_range_sorted"):
        return "rule.search.count_outside_range.sorted.v1"
    if (goal == "two_sum_sorted_exists"):
        return "rule.search.two_sum.sorted.v1"
    if (goal == "string_contains"):
        if (mode == "max"):
            return "rule.string_contains.twoway.v2"
        return "rule.string_contains.scan.v1"
    if (goal == "dot_product"):
        if (mode == "max"):
            return "rule.dot_product.simd.v2"
        return "rule.dot_product.scalar.v1"
    if (goal == "polynomial_eval"):
        if (mode == "max"):
            return "rule.polynomial_eval.simd.v2"
        return "rule.polynomial_eval.horner.v1"
    if (goal == "fibonacci_dp"):
        if (mode == "max"):
            return "rule.fibonacci_dp.iterative.v2"
        return "rule.fibonacci_dp.iterative.v1"
    if (goal == "tribonacci_dp"):
        return "rule.dp.trib.iterative.v1"
    if (goal == "factorial_iterative"):
        return "rule.math.factorial.loop.v1"
    if (goal == "power_fast"):
        return "rule.math.pow.binary_exp.v1"
    if (goal == "gcd_euclid"):
        return "rule.math.gcd.euclid.v1"
    if (goal == "is_prime_fast"):
        return "rule.number.prime.sqrt.v1"
    if (goal == "count_divisors_sqrt"):
        return "rule.number.divisors.sqrt.v1"
    if (goal == "interval_cover_greedy"):
        return "rule.greedy.interval_cover.v1"
    if (goal == "bit_peel_iterative"):
        return "rule.number.bit_peel.iterative.v1"
    if (goal == "sum_formula"):
        return "rule.math.sum.formula.v1"
    if (goal == "sum_squares_formula"):
        return "rule.math.sum_squares.formula.v1"
    if (goal == "sum_cubes_formula"):
        return "rule.math.sum_cubes.formula.v1"
    if (goal == "sum_even_squares_formula"):
        return "rule.math.sum_even_squares.formula.v1"
    if (goal == "sum_odd_squares_formula"):
        return "rule.math.sum_odd_squares.formula.v1"
    if (goal == "sum_even_cubes_formula"):
        return "rule.math.sum_even_cubes.formula.v1"
    if (goal == "sum_odd_cubes_formula"):
        return "rule.math.sum_odd_cubes.formula.v1"
    if (goal == "sum_even_formula"):
        return "rule.math.sum_even.formula.v1"
    if (goal == "sum_odd_formula"):
        return "rule.math.sum_odd.formula.v1"
    if (goal == "sort_ascending"):
        if (mode == "max"):
            return "rule.sort_ascending.introsort.v2"
        return "rule.sort_ascending.quicksort.v1"
    if (goal == "search_element"):
        if (mode == "max"):
            return "rule.search_element.binary_iter.v2"
        return "rule.search_element.binary_classic.v1"
    if (goal == "sqrt_bounded_loop"):
        if (mode == "max"):
            return "rule.sqrt_bounded_loop.mul_guard.v2"
        return "rule.sqrt_bounded_loop.div_guard.v1"
    return "rule.unsupported"
