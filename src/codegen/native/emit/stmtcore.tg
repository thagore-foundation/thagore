import "src/lowering/coreir/nodes.tg"
import "src/codegen/native/emit/helpers.tg"
import "src/codegen/native/emit/expr.tg"

struct EmitExprResult:
    next_temp: i32
    next_str: i32
    value: String
    ir: String
    globals: String

struct EmitStmtResult:
    next_temp: i32
    next_label: i32
    next_str: i32
    ir: String
    slots: String
    globals: String

struct EmitPrintResult:
    next_temp: i32
    next_str: i32
    ir: String
    globals: String


func _collect_string_globals(source: String) -> String:
    let total = _line_count(source)
    let i = 0
    let out = ""
    let seen = ";"
    while (i < total):
        let line = _trim_edges(_line_at(source, i))
        if (_starts_with(line, "print(") == 1):
            let lp = _find(line, "(")
            let rp = _find(line, ")")
            if ((lp >= 0) and (rp > lp)):
                let arg = _trim_edges(__thg_str_substr(line, lp + 1, rp - lp - 1))
                let lit = _unwrap_string_literal(arg)
                if (lit.length() > 0):
                    let gid = _string_gid(lit)
                    let key = ";" + gid + ";"
                    if (_contains(seen, key) == 0):
                        seen = seen + gid + ";"
                        let n = strlen(lit) + 1
                        let bytes = _emit_i8_array(lit)
                        out = out + _s6(gid, " = private unnamed_addr constant [", _to_string_i32(n), " x i8] [", bytes, ", i8 0]__NL__")
        i = i + 1
    return out

func _extract_call_arg_number(text: String, callee: String, default_val: i32) -> i32:
    let needle = callee + "("
    let p = _find(text, needle)
    if (p < 0):
        return default_val
    let start = p + strlen(needle)
    let i = start
    let n = strlen(text)
    let buf = ""
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == ")"):
            i = n
        else:
            if (_contains("0123456789", ch) == 1):
                buf = buf + ch
            i = i + 1
    if (buf.length() == 0):
        return default_val
    return _parse_i32(buf)

func _emit_stmt_line(line_raw: String, slots: String, t: i32, l: i32, sidx: i32, globals: String) -> EmitStmtResult:
    let line = _trim_edges(line_raw)
    if (line.length() == 0):
        return EmitStmtResult(t, l, sidx, "", slots, globals)
    if (_starts_with(line, "let ") == 1):
        let p = _find(line, "=")
        if (p < 0):
            return EmitStmtResult(t, l, sidx, "", slots, globals)
        let name = _trim_edges(__thg_str_substr(line, 4, p - 4))
        let expr = _trim_edges(__thg_str_substr(line, p + 1, strlen(line) - p - 1))
        let e = _emit_expr(expr, slots, t, sidx, globals)
        let slot = _s3("%", name, ".addr")
        let ir = e.ir + "  " + slot + " = alloca i32__NL__" + "  store i32 " + e.value + ", ptr " + slot + "__NL__"
        let next_slots = _map_set(slots, name, slot)
        return EmitStmtResult(e.next_temp, l, e.next_str, ir, next_slots, e.globals)
    if (_starts_with(line, "return ") == 1):
        let expr = _trim_edges(__thg_str_substr(line, 7, strlen(line) - 7))
        let e = _emit_expr(expr, slots, t, sidx, globals)
        let ret_v = e.value
        if (_contains(e.value, "%tmp") == 1):
            ret_v = e.value
        return EmitStmtResult(e.next_temp, l, e.next_str, e.ir + "  ret i32 " + ret_v + "__NL__", slots, e.globals)
    if (_starts_with(line, "print(") == 1):
        let p = _emit_print_stmt(line, slots, t, sidx, globals)
        return EmitStmtResult(p.next_temp, l, p.next_str, p.ir, slots, p.globals)
    let p_assign = _find(line, "=")
    if (p_assign > 0):
        let name = _trim_edges(__thg_str_substr(line, 0, p_assign))
        let slot = _map_get(slots, name)
        if (slot.length() > 0):
            let expr = _trim_edges(__thg_str_substr(line, p_assign + 1, strlen(line) - p_assign - 1))
            let e = _emit_expr(expr, slots, t, sidx, globals)
            let ir = e.ir + "  store i32 " + e.value + ", ptr " + slot + "__NL__"
            return EmitStmtResult(e.next_temp, l, e.next_str, ir, slots, e.globals)
    let call_only = _emit_expr(line, slots, t, sidx, globals)
    return EmitStmtResult(call_only.next_temp, l, call_only.next_str, call_only.ir, slots, call_only.globals)

func _emit_if_block(lines: String, base_indent: i32, start_idx: i32, cond_text: String, slots: String, t: i32, l: i32, sidx: i32, globals: String) -> EmitStmtResult:
    let cond = _emit_expr(cond_text, slots, t, sidx, globals)
    let then_label = _s2("if.then.", _tag(l))
    let else_label = _s2("if.else.", _tag(l))
    let end_label = _s2("if.end.", _tag(l))
    let ir = _s2(cond.ir, _s6("  br i1 ", cond.value, ", label %", then_label, ", label %", _s2(else_label, "__NL__")))
    ir = _s3(ir, then_label, ":__NL__")
    let i = start_idx
    let total = _line_count(lines)
    let st = slots
    let tt = cond.next_temp
    let ss = cond.next_str
    let gg = cond.globals
    while (i < total):
        let raw = _line_at(lines, i)
        let indent = _leading_spaces(raw)
        let line = _trim_edges(raw)
        if (line.length() == 0):
            i = i + 1
        else:
            if (indent <= base_indent):
                i = total
            else:
                if (_starts_with(line, "else:") == 1):
                    i = total
                else:
                    let one = _emit_stmt_line(line, st, tt, l + 3, ss, gg)
                    ir = ir + one.ir
                    st = one.slots
                    tt = one.next_temp
                    ss = one.next_str
                    if (_contains(one.globals, "@.str.") == 1):
                        gg = one.globals
                    i = i + 1
    ir = _s2(ir, _s3("  br label %", end_label, "__NL__"))
    ir = _s3(ir, else_label, ":__NL__")
    ir = _s2(ir, _s3("  br label %", end_label, "__NL__"))
    ir = _s3(ir, end_label, ":__NL__")
    return EmitStmtResult(tt, l + 10, ss, ir, st, gg)

