import "src/driver/cli/common/core.tg"
import "lib/io.tg" as io

func _install_print_help() -> void:
    print("thagore install toolchain")
    print("Usage:")
    print("  thagore install toolchain [--yes|--interactive] [--dry-run]")
    print("       [--llvm-version 21.1.8] [--target-os auto|windows|ubuntu|macos|linux|portable]")
    print("       [--arch auto|amd64|x86_64|arm64|aarch64]")
    print("       [--profile standard|custom] [--targets t1,t2,...]")

func _install_confirm_install(yes: i32, os_name: String, arch: String, llvm_version: String) -> i32:
    if (yes == 1):
        return 1
    let answer = _trim(io.input_prompt("Cai LLVM " + llvm_version + " cho " + os_name + "/" + arch + "? [Y/n]: "))
    if ((strlen(answer) == 0) or (answer == "y") or (answer == "Y") or (answer == "yes") or (answer == "YES")):
        return 1
    return 0
