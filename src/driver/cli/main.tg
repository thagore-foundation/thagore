import "src/driver/cli/common/core.tg"
import "src/driver/cli/fix/flow.tg"
import "src/driver/cli/test/flow.tg"
import "src/driver/cli/build/flow.tg"
import "src/driver/cli/install/flow.tg"
import "src/driver/cli/update/flow.tg"
import "src/driver/cli/update/version.tg"

func _print_help() -> void:
    print("thagore " + _update_current_version_text())
    print("Usage:")
    print("  thagore --help")
    print("  thagore --version")
    print("  thagore build <input.tg> [-o output]")
    print("  thagore <input.tg> [-o output]")
    print("  thagore test [filter] [--workspace|--all] [--json]")
    print("  thagore fix <doctor|dry-run|apply|explain|rollback> ...")
    print("  thagore install toolchain [--yes]")
    print("  thagore update <check|apply|rollback> [flags]")

func main() -> i32:
    let argc = env.count()
    if (argc <= 1):
        _print_help()
        return 0
    let cmd = _trim(env.get(1))
    if ((cmd == "--help") or (cmd == "help")):
        _print_help()
        return 0
    if ((cmd == "--version") or (cmd == "version")):
        print("thagore " + _update_current_version_text())
        return 0
    _update_auto_notify_if_needed(cmd)
    if (cmd == "fix"):
        if (argc <= 2):
            print("ERROR: missing fix subcommand.")
            return 1
        let sub = _trim(env.get(2))
        if (sub == "rollback"):
            if (argc <= 3):
                print("ERROR: missing fix session id.")
                return 1
            return autofix.run_fix_rollback(_trim(env.get(3)))
        let entry = ""
        let level = "safe"
        let as_json = 0
        let lock_path = ""
        let lock_strict = 0
        let lock_locked = 0
        let workspace = 0
        let exclude_csv = ""
        let max_files = 25
        let max_iterations = 3
        let fix_message_json = 0
        let i_fix = 3
        while (i_fix < argc):
            let arg_fix = _trim(env.get(i_fix))
            if (_starts_with(arg_fix, "--level=") == 1):
                level = _fix_level(_value_after_prefix(arg_fix, "--level="))
            else:
                if ((arg_fix == "--level") and ((i_fix + 1) < argc)):
                    level = _fix_level(_trim(env.get(i_fix + 1)))
                    i_fix = i_fix + 1
                else:
                    if (_starts_with(arg_fix, "--lock=") == 1):
                        lock_path = _trim(_value_after_prefix(arg_fix, "--lock="))
                    else:
                        if ((arg_fix == "--lock") and ((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                            lock_path = _trim(env.get(i_fix + 1))
                            i_fix = i_fix + 1
                        else:
                            if (arg_fix == "--lock"):
                                lock_path = "thagore.fix.lock"
                            else:
                                if (arg_fix == "--lock-strict"):
                                    lock_strict = 1
                                else:
                                    if (arg_fix == "--locked"):
                                        lock_locked = 1
                                    else:
                                        if ((arg_fix == "--workspace") or (arg_fix == "--all")):
                                            workspace = 1
                                        else:
                                            if (_starts_with(arg_fix, "--exclude=") == 1):
                                                let ex = _trim(_value_after_prefix(arg_fix, "--exclude="))
                                                if (strlen(exclude_csv) == 0):
                                                    exclude_csv = ex
                                                else:
                                                    exclude_csv = exclude_csv + "," + ex
                                            else:
                                                if (arg_fix == "--exclude"):
                                                    if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                        let ex2 = _trim(env.get(i_fix + 1))
                                                        if (strlen(exclude_csv) == 0):
                                                            exclude_csv = ex2
                                                        else:
                                                            exclude_csv = exclude_csv + "," + ex2
                                                        i_fix = i_fix + 1
                                                    else:
                                                        print("ERROR: --exclude requires a value.")
                                                        return 1
                                                else:
                                                    if (_starts_with(arg_fix, "--max-files=") == 1):
                                                        max_files = _parse_i32_default(_value_after_prefix(arg_fix, "--max-files="), max_files)
                                                    else:
                                                        if (arg_fix == "--max-files"):
                                                            if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                max_files = _parse_i32_default(_trim(env.get(i_fix + 1)), max_files)
                                                                i_fix = i_fix + 1
                                                            else:
                                                                print("ERROR: --max-files requires a value.")
                                                                return 1
                                                        else:
                                                            if (_starts_with(arg_fix, "--max-iterations=") == 1):
                                                                max_iterations = _parse_i32_default(_value_after_prefix(arg_fix, "--max-iterations="), max_iterations)
                                                            else:
                                                                if (arg_fix == "--max-iterations"):
                                                                    if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                        max_iterations = _parse_i32_default(_trim(env.get(i_fix + 1)), max_iterations)
                                                                        i_fix = i_fix + 1
                                                                    else:
                                                                        print("ERROR: --max-iterations requires a value.")
                                                                        return 1
                                                                else:
                                                                    if (arg_fix == "--json"):
                                                                        as_json = 1
                                                                    else:
                                                                        if (_starts_with(arg_fix, "--message-format=") == 1):
                                                                            let fmt_fix = _trim(_value_after_prefix(arg_fix, "--message-format="))
                                                                            let mode_fix = _test_message_format_mode(fmt_fix)
                                                                            if (mode_fix < 0):
                                                                                print("ERROR: unsupported --message-format: " + fmt_fix)
                                                                                return 1
                                                                            fix_message_json = mode_fix
                                                                        else:
                                                                            if (arg_fix == "--message-format"):
                                                                                if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                                    let fmt_fix2 = _trim(env.get(i_fix + 1))
                                                                                    let mode_fix2 = _test_message_format_mode(fmt_fix2)
                                                                                    if (mode_fix2 < 0):
                                                                                        print("ERROR: unsupported --message-format: " + fmt_fix2)
                                                                                        return 1
                                                                                    fix_message_json = mode_fix2
                                                                                    i_fix = i_fix + 1
                                                                                else:
                                                                                    print("ERROR: --message-format requires a value (json|human).")
                                                                                    return 1
                                                                            else:
                                                                                if (_starts_with(arg_fix, "--") == 1):
                                                                                    print("ERROR: unknown fix flag: " + arg_fix)
                                                                                    return 1
                                                                                else:
                                                                                    if (strlen(entry) == 0):
                                                                                        entry = arg_fix
                                                                                    else:
                                                                                        print("ERROR: multiple fix entry paths are not supported: " + arg_fix)
                                                                                        return 1
            i_fix = i_fix + 1
        if (strlen(entry) == 0):
            print("ERROR: missing entry path for fix command.")
            return 1
        if (max_files < 1):
            max_files = 1
        if (max_iterations < 1):
            max_iterations = 1
        let exclude_set = _csv_to_set(exclude_csv)
        if ((sub == "doctor") or (sub == "dry-run") or (sub == "apply") or (sub == "explain")):
            return _run_fix_multi(sub, entry, level, as_json, lock_path, lock_strict, lock_locked, workspace, exclude_set, max_files, max_iterations, fix_message_json)
        print("ERROR: unknown fix subcommand: " + sub)
        return 1
    if (cmd == "test"):
        let filter = ""
        let workspace = 0
        let no_run = 0
        let fail_fast = 0
        let as_json = 0
        let list_only = 0
        let exclude_csv = ""
        let package_csv = ""
        let exclude_package_csv = ""
        let i_test = 2
        while (i_test < argc):
            let arg_test = _trim(env.get(i_test))
            if ((arg_test == "--help") or (arg_test == "-h")):
                _print_help()
                return 0
            else:
                if ((arg_test == "--workspace") or (arg_test == "--all")):
                    workspace = 1
                else:
                    if (arg_test == "--no-run"):
                        no_run = 1
                    else:
                        if (arg_test == "--fail-fast"):
                            fail_fast = 1
                        else:
                            if (arg_test == "--json"):
                                as_json = 1
                            else:
                                if (_starts_with(arg_test, "--message-format=") == 1):
                                    let fmt = _trim(_value_after_prefix(arg_test, "--message-format="))
                                    let mode = _test_message_format_mode(fmt)
                                    if (mode < 0):
                                        print("ERROR: unsupported --message-format: " + fmt)
                                        return 1
                                    as_json = mode
                                else:
                                    if (arg_test == "--message-format"):
                                        if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                            let fmt2 = _trim(env.get(i_test + 1))
                                            let mode2 = _test_message_format_mode(fmt2)
                                            if (mode2 < 0):
                                                print("ERROR: unsupported --message-format: " + fmt2)
                                                return 1
                                            as_json = mode2
                                            i_test = i_test + 1
                                        else:
                                            print("ERROR: --message-format requires a value (json|human).")
                                            return 1
                                    else:
                                        if (arg_test == "--list"):
                                            list_only = 1
                                        else:
                                            if (_starts_with(arg_test, "--package=") == 1):
                                                let pkg_eq = _trim(_value_after_prefix(arg_test, "--package="))
                                                if (strlen(pkg_eq) == 0):
                                                    print("ERROR: --package requires a package name.")
                                                    return 1
                                                if (strlen(package_csv) == 0):
                                                    package_csv = pkg_eq
                                                else:
                                                    package_csv = package_csv + "," + pkg_eq
                                            else:
                                                if ((arg_test == "--package") or (arg_test == "-p")):
                                                    if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                                        let pkg_next = _trim(env.get(i_test + 1))
                                                        if (strlen(pkg_next) == 0):
                                                            print("ERROR: --package requires a package name.")
                                                            return 1
                                                        if (strlen(package_csv) == 0):
                                                            package_csv = pkg_next
                                                        else:
                                                            package_csv = package_csv + "," + pkg_next
                                                        i_test = i_test + 1
                                                    else:
                                                        print("ERROR: --package requires a package name.")
                                                        return 1
                                                else:
                                                    if (_starts_with(arg_test, "--exclude=") == 1):
                                                        let ex = _trim(_value_after_prefix(arg_test, "--exclude="))
                                                        if (strlen(exclude_csv) == 0):
                                                            exclude_csv = ex
                                                        else:
                                                            exclude_csv = exclude_csv + "," + ex
                                                    else:
                                                        if (arg_test == "--exclude"):
                                                            if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                                                let ex2 = _trim(env.get(i_test + 1))
                                                                if (strlen(exclude_csv) == 0):
                                                                    exclude_csv = ex2
                                                                else:
                                                                    exclude_csv = exclude_csv + "," + ex2
                                                                i_test = i_test + 1
                                                            else:
                                                                print("ERROR: --exclude requires a value.")
                                                                return 1
                                                        else:
                                                            if (_starts_with(arg_test, "--exclude-package=") == 1):
                                                                let ex_pkg = _trim(_value_after_prefix(arg_test, "--exclude-package="))
                                                                if (strlen(exclude_package_csv) == 0):
                                                                    exclude_package_csv = ex_pkg
                                                                else:
                                                                    exclude_package_csv = exclude_package_csv + "," + ex_pkg
                                                            else:
                                                                if (arg_test == "--exclude-package"):
                                                                    if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                                                        let ex_pkg2 = _trim(env.get(i_test + 1))
                                                                        if (strlen(exclude_package_csv) == 0):
                                                                            exclude_package_csv = ex_pkg2
                                                                        else:
                                                                            exclude_package_csv = exclude_package_csv + "," + ex_pkg2
                                                                        i_test = i_test + 1
                                                                    else:
                                                                        print("ERROR: --exclude-package requires a value.")
                                                                        return 1
                                                                else:
                                                                    if (_starts_with(arg_test, "--") == 1):
                                                                        print("ERROR: unknown test flag: " + arg_test)
                                                                        return 1
                                                                    else:
                                                                        if (strlen(filter) == 0):
                                                                            filter = arg_test
                                                                        else:
                                                                            print("ERROR: multiple test filters are not supported: " + arg_test)
                                                                            return 1
            i_test = i_test + 1
        let exclude_set = _csv_to_set(exclude_csv)
        let package_set = _csv_to_set(package_csv)
        let exclude_package_set = _csv_to_set(exclude_package_csv)
        return _run_tests(filter, workspace, no_run, fail_fast, as_json, list_only, exclude_set, package_set, exclude_package_set)
    if (cmd == "install"):
        if (argc <= 2):
            print("ERROR: missing install subcommand.")
            return 1
        if (_trim(env.get(2)) == "toolchain"):
            return _install_toolchain(argc, 3)
        print("ERROR: unknown install subcommand: " + _trim(env.get(2)))
        return 1
    if (cmd == "update"):
        return _update_dispatch(argc, 2)
    let emit_only = 0
    let autofix_mode = "off"
    let autofix_lock = ""
    let autofix_lock_strict = 0
    let autofix_lock_locked = 0
    let autofix_max_iterations = 3
    let autofix_max_files = 10
    let autofix_workspace = 0
    let autofix_exclude_csv = ""
    let input_path = ""
    let out_path = ""
    let i = 1
    if (cmd == "--emit-llvm-internal"):
        if (argc <= 2):
            print("ERROR: missing input path.")
            return 1
        input_path = _trim(env.get(2))
        emit_only = 1
        i = 3
    else:
        if ((cmd == "build") or (cmd == "--build")):
            if (argc <= 2):
                print("ERROR: missing input path.")
                return 1
            input_path = _trim(env.get(2))
            i = 3
        else:
            input_path = cmd
            i = 2
    while (i < argc):
        let arg = _trim(env.get(i))
        if (arg == "--emit-llvm"):
            emit_only = 1
        else:
            if (_starts_with(arg, "--autofix=") == 1):
                autofix_mode = _value_after_prefix(arg, "--autofix=")
            else:
                if (arg == "--autofix"):
                    if (((i + 1) < argc) and (_starts_with(_trim(env.get(i + 1)), "--") == 0)):
                        autofix_mode = _trim(env.get(i + 1))
                        i = i + 1
                    else:
                        autofix_mode = "safe"
                else:
                    if (_starts_with(arg, "--autofix-lock=") == 1):
                        autofix_lock = _trim(_value_after_prefix(arg, "--autofix-lock="))
                    else:
                        if ((arg == "--autofix-lock") and ((i + 1) < argc) and (_starts_with(_trim(env.get(i + 1)), "--") == 0)):
                            autofix_lock = _trim(env.get(i + 1))
                            i = i + 1
                        else:
                            if (arg == "--autofix-lock"):
                                autofix_lock = "thagore.fix.lock"
                            else:
                                if (arg == "--autofix-lock-strict"):
                                    autofix_lock_strict = 1
                                else:
                                    if (arg == "--autofix-locked"):
                                        autofix_lock_locked = 1
                                    else:
                                        if (_starts_with(arg, "--autofix-max-iterations=") == 1):
                                            autofix_max_iterations = _parse_i32_default(_value_after_prefix(arg, "--autofix-max-iterations="), autofix_max_iterations)
                                        else:
                                            if ((arg == "--autofix-max-iterations") and ((i + 1) < argc)):
                                                autofix_max_iterations = _parse_i32_default(_trim(env.get(i + 1)), autofix_max_iterations)
                                                i = i + 1
                                            else:
                                                if (_starts_with(arg, "--autofix-max-files=") == 1):
                                                    autofix_max_files = _parse_i32_default(_value_after_prefix(arg, "--autofix-max-files="), autofix_max_files)
                                                else:
                                                    if ((arg == "--autofix-max-files") and ((i + 1) < argc)):
                                                        autofix_max_files = _parse_i32_default(_trim(env.get(i + 1)), autofix_max_files)
                                                        i = i + 1
                                                    else:
                                                        if (_starts_with(arg, "--autofix-exclude=") == 1):
                                                            autofix_exclude_csv = _trim(_value_after_prefix(arg, "--autofix-exclude="))
                                                        else:
                                                            if ((arg == "--autofix-exclude") and ((i + 1) < argc)):
                                                                autofix_exclude_csv = _trim(env.get(i + 1))
                                                                i = i + 1
                                                            else:
                                                                if (arg == "--autofix-workspace"):
                                                                    autofix_workspace = 1
                                                                else:
                                                                    if ((arg == "-o") and ((i + 1) < argc)):
                                                                        out_path = _trim(env.get(i + 1))
                                                                        i = i + 1
        i = i + 1
    if (out_path.length() == 0):
        out_path = _default_output(input_path)
    let autofix_exclude_set = _csv_to_set(autofix_exclude_csv)
    return _build(input_path, out_path, emit_only, autofix_mode, autofix_lock, autofix_lock_strict, autofix_lock_locked, autofix_max_iterations, autofix_max_files, autofix_workspace, autofix_exclude_set)
