import "lib/env.tg" as env
import "lib/fs.tg" as fs
import "lib/process.tg" as process
import "lib/time.tg" as time
import "src/driver/autofix/engine.tg" as autofix
import "src/lowering/transform/program.tg" as lowering
import "src/semantics/typecheck/program.tg" as typechecker
import "src/semantics/typedir/nodes.tg" as typedir
import "src/codegen/llvm/entry.tg" as emitter

extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __string_from_codepoint(cp: i32) -> String

struct AutofixApplyBatchResult:
    changed: i32
    files_touched: i32
    sessions_set: String
    error: i32

func _batch_result(changed: i32, files_touched: i32, sessions_set: String, error: i32) -> AutofixApplyBatchResult:
    return AutofixApplyBatchResult(changed, files_touched, sessions_set, error)

func _char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func _dq() -> String:
    return __string_from_codepoint(34)

func _nl() -> String:
    return __string_from_codepoint(10)

func _trim(text: String) -> String:
    let n = strlen(text)
    if (n == 0):
        return text
    let l = 0
    while (l < n):
        let ch = _char_at(text, l)
        if ((ch == " ") or (ch == "\t") or (ch == "\r") or (ch == "\n")):
            l = l + 1
        else:
            l = n
    let left = 0
    let i = 0
    while (i < n):
        let ch = _char_at(text, i)
        if ((ch == " ") or (ch == "\t") or (ch == "\r") or (ch == "\n")):
            i = i + 1
            left = i
        else:
            i = n
    let right = n - 1
    let j = n - 1
    while (j >= left):
        let ch2 = _char_at(text, j)
        if ((ch2 == " ") or (ch2 == "\t") or (ch2 == "\r") or (ch2 == "\n")):
            j = j - 1
            right = j
        else:
            j = left - 1
    if (right < left):
        return ""
    return __thg_str_substr(text, left, right - left + 1)

func _contains(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 1
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return 1
        i = i + 1
    return 0

func _starts_with(text: String, prefix: String) -> i32:
    let n = strlen(prefix)
    if (strlen(text) < n):
        return 0
    if (__thg_str_substr(text, 0, n) == prefix):
        return 1
    return 0

func _ends_with(text: String, suffix: String) -> i32:
    let n = strlen(text)
    let m = strlen(suffix)
    if (m > n):
        return 0
    if (__thg_str_substr(text, n - m, m) == suffix):
        return 1
    return 0

func _find_char(text: String, ch: String) -> i32:
    let i = 0
    let n = strlen(text)
    while (i < n):
        if (_char_at(text, i) == ch):
            return i
        i = i + 1
    return -1

func _replace_all(text: String, old_frag: String, new_frag: String) -> String:
    if (strlen(old_frag) == 0):
        return text
    let out = ""
    let i = 0
    let n = strlen(text)
    let k = strlen(old_frag)
    while (i < n):
        if ((i + k) <= n):
            if (__thg_str_substr(text, i, k) == old_frag):
                out = out + new_frag
                i = i + k
            else:
                out = out + _char_at(text, i)
                i = i + 1
        else:
            out = out + _char_at(text, i)
            i = i + 1
    return out

func _normalize_path(path: String) -> String:
    return _replace_all(path, "\\", "/")

func _dir_name(path: String) -> String:
    let p = _normalize_path(path)
    let n = strlen(p)
    let i = 0
    let last = -1
    while (i < n):
        if (_char_at(p, i) == "/"):
            last = i
        i = i + 1
    if (last < 0):
        return "."
    if (last == 0):
        return "/"
    return __thg_str_substr(p, 0, last)

func _line_count(text: String) -> i32:
    let n = strlen(text)
    if (n == 0):
        return 0
    let i = 0
    let c = 1
    while (i < n):
        if (_char_at(text, i) == _nl()):
            c = c + 1
        i = i + 1
    return c

func _line_at(text: String, index: i32) -> String:
    let n = strlen(text)
    let i = 0
    let line_idx = 0
    let line = ""
    while (i < n):
        let ch = _char_at(text, i)
        if (ch == _nl()):
            if (line_idx == index):
                return line
            line_idx = line_idx + 1
            line = ""
            i = i + 1
        else:
            line = line + ch
            i = i + 1
    if (line_idx == index):
        return line
    return ""

func _set_contains(set_text: String, value: String) -> i32:
    return _contains(set_text, ";" + value + ";")

func _set_add_unique(set_text: String, value: String) -> String:
    if (strlen(value) == 0):
        return set_text
    if (_set_contains(set_text, value) == 1):
        return set_text
    return set_text + value + ";"

func _set_union(left: String, right: String) -> String:
    let out = left
    let i = 0
    let n = strlen(right)
    let token = ""
    while (i < n):
        let ch = _char_at(right, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                out = _set_add_unique(out, token)
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        out = _set_add_unique(out, token)
    return out

func _set_difference(left: String, right: String) -> String:
    let out = ";"
    let n = strlen(left)
    let i = 0
    let token = ""
    while (i < n):
        let ch = _char_at(left, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                if (_set_contains(right, token) == 0):
                    out = _set_add_unique(out, token)
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        if (_set_contains(right, token) == 0):
            out = _set_add_unique(out, token)
    return out

func _set_count(set_text: String) -> i32:
    let n = strlen(set_text)
    let i = 0
    let token = ""
    let count = 0
    while (i < n):
        let ch = _char_at(set_text, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                count = count + 1
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        count = count + 1
    return count

func _set_to_json_array(set_text: String) -> String:
    let out = "["
    let first = 1
    let n = strlen(set_text)
    let i = 0
    let token = ""
    while (i < n):
        let ch = _char_at(set_text, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                if (first == 0):
                    out = out + ","
                out = out + _json_quote(token)
                first = 0
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        if (first == 0):
            out = out + ","
        out = out + _json_quote(token)
    out = out + "]"
    return out

func _find(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 0
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return i
        i = i + 1
    return -1

func _char_score(ch: String) -> i32:
    let table = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_./:-+*<>=()[]{}!?,' " + _dq() + " \\t\\n\\r"
    let idx = _find_char(table, ch)
    if (idx < 0):
        return 97
    return idx + 1

func _hash_text(text: String) -> i32:
    let h = 0
    let i = 0
    let n = strlen(text)
    while (i < n):
        let ch = _char_at(text, i)
        let raw = h * 131 + _char_score(ch) + i + 1
        let q = raw / 2147483647
        h = raw - (q * 2147483647)
        i = i + 1
    return h

func _lock_digest(lock_path: String) -> String:
    let p = _trim(lock_path)
    if (strlen(p) == 0):
        return ""
    if (fs.exists(p) == 0):
        return "missing"
    return _to_string_i32(_hash_text(fs.read_text(p)))

func _json_get_i32(text: String, key: String, fallback: i32) -> i32:
    let needle = _json_quote(key) + ":"
    let p = _find(text, needle)
    if (p < 0):
        return fallback
    let j = p + strlen(needle)
    while (j < strlen(text)):
        let c = _char_at(text, j)
        if ((c == " ") or (c == "\t") or (c == "\r") or (c == "\n")):
            j = j + 1
        else:
            let sign = 1
            if (c == "-"):
                sign = -1
                j = j + 1
            let value = 0
            let digits = 0
            while (j < strlen(text)):
                let d = _char_at(text, j)
                let dv = _find_char("0123456789", d)
                if (dv >= 0):
                    value = (value * 10) + dv
                    digits = digits + 1
                    j = j + 1
                else:
                    j = strlen(text)
            if (digits == 0):
                return fallback
            if (sign < 0):
                return 0 - value
            return value
    return fallback

func _json_get_string(text: String, key: String) -> String:
    let dq = _dq()
    let needle = dq + key + dq + ": " + dq
    let p = _find(text, needle)
    let used = needle
    if (p < 0):
        let compact = dq + key + dq + ":" + dq
        p = _find(text, compact)
        if (p >= 0):
            used = compact
    if (p < 0):
        return ""
    let i = p + strlen(used)
    let out = ""
    while (i < strlen(text)):
        let ch = _char_at(text, i)
        if (ch == dq):
            return out
        if (ch == "\\"):
            if ((i + 1) < strlen(text)):
                let nx = _char_at(text, i + 1)
                if (nx == "n"):
                    out = out + _nl()
                else:
                    if (nx == "r"):
                        out = out + "\r"
                    else:
                        out = out + nx
                i = i + 2
            else:
                i = i + 1
        else:
            out = out + ch
            i = i + 1
    return out

func _json_get_string_array_set(text: String, key: String) -> String:
    let dq = _dq()
    let p = _find(text, dq + key + dq + ":")
    if (p < 0):
        return ";"
    let i = p + strlen(dq + key + dq + ":")
    let n = strlen(text)
    while (i < n):
        let ch0 = _char_at(text, i)
        if ((ch0 == " ") or (ch0 == "\t") or (ch0 == "\r") or (ch0 == "\n")):
            i = i + 1
        else:
            if (ch0 != "["):
                return ";"
            i = i + 1
            let out = ";"
            let token = ""
            let in_string = 0
            let escaped = 0
            while (i < n):
                let ch = _char_at(text, i)
                if (in_string == 0):
                    if (ch == dq):
                        in_string = 1
                        token = ""
                    else:
                        if (ch == "]"):
                            return out
                else:
                    if (escaped == 1):
                        token = token + ch
                        escaped = 0
                    else:
                        if (ch == "\\"):
                            escaped = 1
                        else:
                            if (ch == dq):
                                out = _set_add_unique(out, token)
                                in_string = 0
                            else:
                                token = token + ch
                i = i + 1
            return out
    return ";"

func _bundle_member_union_string_array_set(member_sessions_set: String, key: String) -> String:
    let out = ";"
    let token = ""
    let i = 0
    let n = strlen(member_sessions_set)
    while (i < n):
        let ch = _char_at(member_sessions_set, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                let session_path = ".thagore/fix/sessions/" + token + ".json"
                if (fs.exists(session_path) == 1):
                    out = _set_union(out, _json_get_string_array_set(fs.read_text(session_path), key))
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        let session_path2 = ".thagore/fix/sessions/" + token + ".json"
        if (fs.exists(session_path2) == 1):
            out = _set_union(out, _json_get_string_array_set(fs.read_text(session_path2), key))
    return out

func _session_metric_i32(session_id: String, key: String) -> i32:
    let sid = _trim(session_id)
    if (strlen(sid) == 0):
        return 0
    let session_path = ".thagore/fix/sessions/" + sid + ".json"
    if (fs.exists(session_path) == 0):
        return 0
    let session_text = fs.read_text(session_path)
    return _json_get_i32(session_text, key, 0)

func _session_files_changed(session_id: String) -> i32:
    return _session_metric_i32(session_id, "files_changed")

func _session_fixes_applied(session_id: String) -> i32:
    return _session_metric_i32(session_id, "fixes_applied")

func _session_fixes_skipped(session_id: String) -> i32:
    return _session_metric_i32(session_id, "fixes_skipped")

func _session_files_scanned(session_id: String) -> i32:
    return _session_metric_i32(session_id, "files_scanned")

func _session_entry(session_id: String) -> String:
    let sid = _trim(session_id)
    if (strlen(sid) == 0):
        return ""
    let session_path = ".thagore/fix/sessions/" + sid + ".json"
    if (fs.exists(session_path) == 0):
        return ""
    let session_text = fs.read_text(session_path)
    return _normalize_path(_json_get_string(session_text, "entry"))

func _validate_locked_workspace_targets(lock_path: String, targets: String) -> i32:
    if (strlen(lock_path) == 0):
        print("[autofix] error: --locked requires --lock <path>.")
        return 0
    if (fs.exists(lock_path) == 0):
        print("[autofix] error: lock file not found under --locked: " + lock_path)
        return 0
    let lock_text = fs.read_text(lock_path)
    let entries_set = _json_get_string(lock_text, "entries_set")
    if (strlen(entries_set) == 0):
        entries_set = ";"
    let missing = _set_difference(targets, entries_set)
    if (strlen(missing) > 1):
        print("[autofix] locked violation: workspace targets missing from lock entries_set.")
        print("[autofix] lock_missing_entries=" + _set_to_json_array(missing))
        return 0
    return 1

func _write_bundle_session(entry_path: String, mode: String, lock_path: String, member_sessions_set: String, passes: i32, files_scanned: i32, files_changed: i32, fixes_applied: i32, fixes_skipped: i32) -> String:
    if (_set_count(member_sessions_set) <= 1):
        return ""
    fs.mkdir(".thagore")
    fs.mkdir(".thagore/fix")
    fs.mkdir(".thagore/fix/reports")
    fs.mkdir(".thagore/fix/sessions")
    let bundle_id = "BND-" + _to_string_i32(time.now_ms()) + "-" + _sanitize_test_id(entry_path)
    let session_path = ".thagore/fix/sessions/" + bundle_id + ".json"
    let report_path = ".thagore/fix/reports/" + bundle_id + ".json"
    let lock_digest = _lock_digest(lock_path)
    let diagnostics_seen_set = _bundle_member_union_string_array_set(member_sessions_set, "diagnostics_seen")
    let applied_rules_set = _bundle_member_union_string_array_set(member_sessions_set, "applied_rules")
    let summary = "{"
    summary = summary + _json_quote("passes") + ":" + _to_string_i32(passes) + ","
    summary = summary + _json_quote("files_scanned") + ":" + _to_string_i32(files_scanned) + ","
    summary = summary + _json_quote("files_changed") + ":" + _to_string_i32(files_changed) + ","
    summary = summary + _json_quote("fixes_applied") + ":" + _to_string_i32(fixes_applied) + ","
    summary = summary + _json_quote("fixes_skipped") + ":" + _to_string_i32(fixes_skipped)
    summary = summary + "}"
    let report = "{"
    report = report + _json_quote("schema_version") + ":1,"
    report = report + _json_quote("session_id") + ":" + _json_quote(bundle_id) + ","
    report = report + _json_quote("session_type") + ":" + _json_quote("bundle") + ","
    report = report + _json_quote("tool") + ":" + _json_quote("thagore fix") + ","
    report = report + _json_quote("tool_version") + ":" + _json_quote("0.4.0-native-cli") + ","
    report = report + _json_quote("entry") + ":" + _json_quote(_normalize_path(entry_path)) + ","
    report = report + _json_quote("mode") + ":" + _json_quote(mode) + ","
    report = report + _json_quote("lock_path") + ":" + _json_quote(lock_path) + ","
    report = report + _json_quote("lock_digest") + ":" + _json_quote(lock_digest) + ","
    report = report + _json_quote("diagnostics_seen_set") + ":" + _json_quote(diagnostics_seen_set) + ","
    report = report + _json_quote("diagnostics_seen") + ":" + _set_to_json_array(diagnostics_seen_set) + ","
    report = report + _json_quote("applied_rules_set") + ":" + _json_quote(applied_rules_set) + ","
    report = report + _json_quote("applied_rules") + ":" + _set_to_json_array(applied_rules_set) + ","
    report = report + _json_quote("member_sessions_set") + ":" + _json_quote(member_sessions_set) + ","
    report = report + _json_quote("member_sessions") + ":" + _set_to_json_array(member_sessions_set) + ","
    report = report + _json_quote("summary") + ":" + summary
    report = report + "}" + _nl()
    fs.write_text(report_path, report)
    let session = "{"
    session = session + _json_quote("schema_version") + ":1,"
    session = session + _json_quote("session_id") + ":" + _json_quote(bundle_id) + ","
    session = session + _json_quote("session_type") + ":" + _json_quote("bundle") + ","
    session = session + _json_quote("tool") + ":" + _json_quote("thagore fix") + ","
    session = session + _json_quote("tool_version") + ":" + _json_quote("0.4.0-native-cli") + ","
    session = session + _json_quote("entry") + ":" + _json_quote(_normalize_path(entry_path)) + ","
    session = session + _json_quote("mode") + ":" + _json_quote(mode) + ","
    session = session + _json_quote("lock_path") + ":" + _json_quote(lock_path) + ","
    session = session + _json_quote("lock_digest") + ":" + _json_quote(lock_digest) + ","
    session = session + _json_quote("diagnostics_seen_set") + ":" + _json_quote(diagnostics_seen_set) + ","
    session = session + _json_quote("diagnostics_seen") + ":" + _set_to_json_array(diagnostics_seen_set) + ","
    session = session + _json_quote("applied_rules_set") + ":" + _json_quote(applied_rules_set) + ","
    session = session + _json_quote("applied_rules") + ":" + _set_to_json_array(applied_rules_set) + ","
    session = session + _json_quote("member_sessions_set") + ":" + _json_quote(member_sessions_set) + ","
    session = session + _json_quote("summary") + ":" + summary + ","
    session = session + _json_quote("report_file") + ":" + _json_quote(report_path)
    session = session + "}" + _nl()
    if (fs.write_text(session_path, session) == 0):
        return ""
    fs.write_text(".thagore/fix/last_session.id", bundle_id)
    fs.write_text(".thagore/fix/last_report.path", report_path)
    if (fixes_applied > 0):
        fs.write_text(".thagore/fix/last_applied_report.path", report_path)
    return bundle_id

func _emit_fix_begin_json(sub: String, mode: String, workspace: i32, discovered_total: i32, lock_path: String, lock_locked: i32) -> void:
    let lock_digest = _lock_digest(lock_path)
    let json = "{"
    json = json + _json_quote("schema_version") + ":1,"
    json = json + _json_quote("event_schema") + ":" + _json_quote("thagore.fix.v1") + ","
    json = json + _json_quote("type") + ":" + _json_quote("fix") + ","
    json = json + _json_quote("event") + ":" + _json_quote("started") + ","
    json = json + _json_quote("tool") + ":" + _json_quote("thagore fix") + ","
    json = json + _json_quote("tool_version") + ":" + _json_quote("0.4.0-native-cli") + ","
    json = json + _json_quote("subcommand") + ":" + _json_quote(sub) + ","
    json = json + _json_quote("mode") + ":" + _json_quote(mode) + ","
    json = json + _json_quote("workspace") + ":" + _json_bool(workspace) + ","
    json = json + _json_quote("locked") + ":" + _json_bool(lock_locked) + ","
    json = json + _json_quote("lock_path") + ":" + _json_quote(lock_path) + ","
    json = json + _json_quote("lock_digest") + ":" + _json_quote(lock_digest) + ","
    json = json + _json_quote("discovered_total") + ":" + _to_string_i32(discovered_total)
    json = json + "}"
    print(json)

func _emit_fix_target_json(target: String, sub: String, rc: i32, session_id: String, files_scanned: i32, files_changed: i32, fixes_applied: i32, fixes_skipped: i32, lock_path: String) -> void:
    let status = "ok"
    if (rc != 0):
        status = "failed"
    let lock_digest = _lock_digest(lock_path)
    let json = "{"
    json = json + _json_quote("schema_version") + ":1,"
    json = json + _json_quote("event_schema") + ":" + _json_quote("thagore.fix.v1") + ","
    json = json + _json_quote("type") + ":" + _json_quote("fix_target") + ","
    json = json + _json_quote("target") + ":" + _json_quote(target) + ","
    json = json + _json_quote("subcommand") + ":" + _json_quote(sub) + ","
    json = json + _json_quote("status") + ":" + _json_quote(status) + ","
    json = json + _json_quote("code") + ":" + _to_string_i32(rc) + ","
    json = json + _json_quote("session_id") + ":" + _json_quote(session_id) + ","
    json = json + _json_quote("files_scanned") + ":" + _to_string_i32(files_scanned) + ","
    json = json + _json_quote("files_changed") + ":" + _to_string_i32(files_changed) + ","
    json = json + _json_quote("fixes_applied") + ":" + _to_string_i32(fixes_applied) + ","
    json = json + _json_quote("fixes_skipped") + ":" + _to_string_i32(fixes_skipped) + ","
    json = json + _json_quote("lock_path") + ":" + _json_quote(lock_path) + ","
    json = json + _json_quote("lock_digest") + ":" + _json_quote(lock_digest)
    json = json + "}"
    print(json)

func _emit_fix_iteration_json(iteration: i32, files_scanned: i32, files_changed: i32, fixes_applied: i32, fixes_skipped: i32) -> void:
    let json = "{"
    json = json + _json_quote("schema_version") + ":1,"
    json = json + _json_quote("event_schema") + ":" + _json_quote("thagore.fix.v1") + ","
    json = json + _json_quote("type") + ":" + _json_quote("fix_iteration") + ","
    json = json + _json_quote("iteration") + ":" + _to_string_i32(iteration) + ","
    json = json + _json_quote("files_scanned") + ":" + _to_string_i32(files_scanned) + ","
    json = json + _json_quote("files_changed") + ":" + _to_string_i32(files_changed) + ","
    json = json + _json_quote("fixes_applied") + ":" + _to_string_i32(fixes_applied) + ","
    json = json + _json_quote("fixes_skipped") + ":" + _to_string_i32(fixes_skipped)
    json = json + "}"
    print(json)

func _emit_fix_summary_json(sub: String, discovered_total: i32, attempts: i32, passes: i32, files_scanned: i32, files_changed: i32, fixes_applied: i32, fixes_skipped: i32, exit_code: i32, bundle_session_id: String, lock_path: String) -> void:
    let status = "ok"
    if (exit_code != 0):
        status = "failed"
    let lock_digest = _lock_digest(lock_path)
    let json = "{"
    json = json + _json_quote("schema_version") + ":1,"
    json = json + _json_quote("event_schema") + ":" + _json_quote("thagore.fix.v1") + ","
    json = json + _json_quote("type") + ":" + _json_quote("fix_summary") + ","
    json = json + _json_quote("subcommand") + ":" + _json_quote(sub) + ","
    json = json + _json_quote("status") + ":" + _json_quote(status) + ","
    json = json + _json_quote("exit_code") + ":" + _to_string_i32(exit_code) + ","
    json = json + _json_quote("discovered_total") + ":" + _to_string_i32(discovered_total) + ","
    json = json + _json_quote("attempts") + ":" + _to_string_i32(attempts) + ","
    json = json + _json_quote("passes") + ":" + _to_string_i32(passes) + ","
    json = json + _json_quote("files_scanned") + ":" + _to_string_i32(files_scanned) + ","
    json = json + _json_quote("files_changed") + ":" + _to_string_i32(files_changed) + ","
    json = json + _json_quote("fixes_applied") + ":" + _to_string_i32(fixes_applied) + ","
    json = json + _json_quote("fixes_skipped") + ":" + _to_string_i32(fixes_skipped) + ","
    json = json + _json_quote("bundle_session_id") + ":" + _json_quote(bundle_session_id) + ","
    json = json + _json_quote("lock_path") + ":" + _json_quote(lock_path) + ","
    json = json + _json_quote("lock_digest") + ":" + _json_quote(lock_digest)
    json = json + "}"
    print(json)

func _is_protected_autofix_path(path: String) -> i32:
    let p = _normalize_path(path)
    if (_starts_with(p, ".github/") == 1):
        return 1
    if (_starts_with(p, ".thagore/") == 1):
        return 1
    return 0

func _extract_import_path(line: String) -> String:
    let s = _trim(line)
    if (_starts_with(s, "import ") == 0):
        return ""
    let q1 = _find_char(s, _dq())
    if (q1 < 0):
        return ""
    let j = q1 + 1
    let n = strlen(s)
    while (j < n):
        if (_char_at(s, j) == _dq()):
            return __thg_str_substr(s, q1 + 1, j - q1 - 1)
        j = j + 1
    return ""

func _resolve_import_path(entry_path: String, import_path: String) -> String:
    let imp = _normalize_path(import_path)
    if (_starts_with(imp, "/") == 1):
        return imp
    if (_contains(imp, ":") == 1):
        return imp
    if ((_starts_with(imp, "lib/") == 1) or (_starts_with(imp, "src/") == 1) or (_starts_with(imp, "tests/") == 1) or (_starts_with(imp, "examples/") == 1)):
        return imp
    let base = _dir_name(entry_path)
    if (base == "."):
        return imp
    return _normalize_path(base + "/" + imp)

func _path_excluded(path: String, exclude_set: String) -> i32:
    let p = _normalize_path(path)
    let n = strlen(exclude_set)
    let i = 0
    let token = ""
    while (i < n):
        let ch = _char_at(exclude_set, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                let t = _normalize_path(token)
                if ((p == t) or (_starts_with(p, t + "/") == 1)):
                    return 1
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        let t2 = _normalize_path(token)
        if ((p == t2) or (_starts_with(p, t2 + "/") == 1)):
            return 1
    return 0

func _csv_to_set(csv: String) -> String:
    let out = ";"
    let i = 0
    let n = strlen(csv)
    let token = ""
    while (i < n):
        let ch = _char_at(csv, i)
        if (ch == ","):
            let t = _trim(token)
            if (strlen(t) > 0):
                out = _set_add_unique(out, _normalize_path(t))
            token = ""
        else:
            token = token + ch
        i = i + 1
    let t2 = _trim(token)
    if (strlen(t2) > 0):
        out = _set_add_unique(out, _normalize_path(t2))
    return out

func _collect_direct_autofix_targets(entry_path: String, exclude_set: String) -> String:
    let entry = _normalize_path(entry_path)
    let targets = ";" + entry + ";"
    if (fs.exists(entry_path) == 0):
        return targets
    let source = fs.read_text(entry_path)
    let total = _line_count(source)
    let i = 0
    while (i < total):
        let line = _line_at(source, i)
        let imp = _extract_import_path(line)
        if ((strlen(imp) > 0) and (_ends_with(imp, ".tg") == 1) and (_starts_with(imp, "lib/") == 0)):
            let resolved = _resolve_import_path(entry_path, imp)
            if ((resolved != entry) and (fs.exists(resolved) == 1) and (_is_protected_autofix_path(resolved) == 0) and (_path_excluded(resolved, exclude_set) == 0)):
                targets = _set_add_unique(targets, resolved)
        i = i + 1
    return targets

func _collect_autofix_targets(entry_path: String, recursive_workspace: i32, exclude_set: String) -> String:
    let seen = ";"
    let queue = ";" + _normalize_path(entry_path) + ";"
    let progress = 1
    while (progress == 1):
        progress = 0
        let i = 0
        let n = strlen(queue)
        let token = ""
        while (i < n):
            let ch = _char_at(queue, i)
            if (ch == ";"):
                if (strlen(token) > 0):
                    if (_set_contains(seen, token) == 0):
                        seen = _set_add_unique(seen, token)
                        progress = 1
                        if (recursive_workspace == 1):
                            queue = _set_union(queue, _collect_direct_autofix_targets(token, exclude_set))
                        else:
                            if (token == _normalize_path(entry_path)):
                                queue = _set_union(queue, _collect_direct_autofix_targets(token, exclude_set))
                    token = ""
            else:
                token = token + ch
            i = i + 1
    if (_path_excluded(entry_path, exclude_set) == 1):
        return ";"
    return seen

func _error_severity_rank(code: i32) -> i32:
    if (code == 0):
        return 0
    if (code == 21):
        return 1
    if (code == 2):
        return 2
    if (code == 1):
        return 3
    if (code == 11):
        return 4
    return 5

func _rollback_sessions(session_set: String) -> void:
    let n = strlen(session_set)
    let i = 0
    let token = ""
    while (i < n):
        let ch = _char_at(session_set, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                let rc = autofix.run_fix_rollback(token)
                if (rc != 0):
                    print("[autofix] rollback warning: failed session=" + token)
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        let rc2 = autofix.run_fix_rollback(token)
        if (rc2 != 0):
            print("[autofix] rollback warning: failed session=" + token)

func _apply_autofix_batch(entry_path: String, mode: String, lock_path: String, lock_strict: i32, lock_locked: i32, max_files_touched: i32, recursive_workspace: i32, exclude_set: String) -> AutofixApplyBatchResult:
    let targets = _collect_autofix_targets(entry_path, recursive_workspace, exclude_set)
    let changed_total = 0
    let files_touched = 0
    let sessions = ";"
    let n = strlen(targets)
    let i = 0
    let token = ""
    while (i < n):
        let ch = _char_at(targets, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                if (files_touched >= max_files_touched):
                    print("[autofix] conflict: max files touched exceeded.")
                    return _batch_result(changed_total, files_touched, sessions, 1)
                let changed = autofix.apply_for_build(token, mode, lock_path, lock_strict, lock_locked)
                if (changed < 0):
                    return _batch_result(changed_total, files_touched, sessions, 1)
                if (changed > 0):
                    changed_total = changed_total + changed
                    files_touched = files_touched + 1
                    let sid = autofix.latest_session_id()
                    if (strlen(sid) > 0):
                        sessions = _set_add_unique(sessions, sid)
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        if (files_touched >= max_files_touched):
            print("[autofix] conflict: max files touched exceeded.")
            return _batch_result(changed_total, files_touched, sessions, 1)
        let changed_last = autofix.apply_for_build(token, mode, lock_path, lock_strict, lock_locked)
        if (changed_last < 0):
            return _batch_result(changed_total, files_touched, sessions, 1)
        if (changed_last > 0):
            changed_total = changed_total + changed_last
            files_touched = files_touched + 1
            let sid_last = autofix.latest_session_id()
            if (strlen(sid_last) > 0):
                sessions = _set_add_unique(sessions, sid_last)
    return _batch_result(changed_total, files_touched, sessions, 0)

func _run_fix_multi(sub: String, entry_path: String, mode: String, as_json: i32, lock_path: String, lock_strict: i32, lock_locked: i32, workspace: i32, exclude_set: String, max_files: i32, max_iterations: i32, message_json: i32) -> i32:
    let targets = _collect_autofix_targets(entry_path, workspace, exclude_set)
    let discovered_total = _set_count(targets)
    if (discovered_total <= 0):
        print("ERROR: no eligible .tg files found for fix.")
        return 1
    if (message_json == 1):
        _emit_fix_begin_json(sub, mode, workspace, discovered_total, lock_path, lock_locked)
    if (lock_locked == 1):
        if (_validate_locked_workspace_targets(lock_path, targets) == 0):
            if (message_json == 1):
                _emit_fix_summary_json(sub, discovered_total, 0, 0, 0, 0, 0, 0, 1, "", lock_path)
            return 1
    if (max_files < 1):
        max_files = 1
    if (max_iterations < 1):
        max_iterations = 1
    if (max_iterations > 12):
        max_iterations = 12
    if (sub == "apply"):
        let failed = 0
        let sessions_changed = ";"
        let files_touched_set = ";"
        let files_touched = 0
        let total_fixes_applied = 0
        let total_fixes_skipped = 0
        let total_files_scanned = 0
        let pass_idx = 0
        let passes_executed = 0
        let attempts_total = 0
        let bundle_id = ""
        while (pass_idx < max_iterations):
            let pass_fixes_applied = 0
            let pass_fixes_skipped = 0
            let pass_files_changed = 0
            let pass_files_scanned = 0
            let n_apply = strlen(targets)
            let i_apply = 0
            let token_apply = ""
            while (i_apply < n_apply):
                let ch_apply = _char_at(targets, i_apply)
                if (ch_apply == ";"):
                    if (strlen(token_apply) > 0):
                        attempts_total = attempts_total + 1
                        let token_norm = _normalize_path(token_apply)
                        if ((files_touched >= max_files) and (_set_contains(files_touched_set, token_norm) == 0)):
                            print("[autofix] conflict: max files touched exceeded.")
                            failed = 1
                            if (message_json == 1):
                                _emit_fix_target_json(token_norm, sub, 1, "", 0, 0, 0, 0, lock_path)
                            i_apply = n_apply
                        else:
                            let rc_apply = autofix.run_fix_apply(token_norm, mode, lock_path, lock_strict, lock_locked)
                            let sid = ""
                            let scanned = 0
                            let changed = 0
                            let applied = 0
                            let skipped = 0
                            if (rc_apply != 0):
                                failed = 1
                                if (message_json == 1):
                                    _emit_fix_target_json(token_norm, sub, rc_apply, "", 0, 0, 0, 0, lock_path)
                                i_apply = n_apply
                            else:
                                sid = autofix.latest_session_id()
                                scanned = _session_files_scanned(sid)
                                changed = _session_files_changed(sid)
                                applied = _session_fixes_applied(sid)
                                skipped = _session_fixes_skipped(sid)
                                pass_files_scanned = pass_files_scanned + scanned
                                pass_files_changed = pass_files_changed + changed
                                pass_fixes_applied = pass_fixes_applied + applied
                                pass_fixes_skipped = pass_fixes_skipped + skipped
                                total_files_scanned = total_files_scanned + scanned
                                total_fixes_applied = total_fixes_applied + applied
                                total_fixes_skipped = total_fixes_skipped + skipped
                                if (changed > 0):
                                    let changed_entry = _session_entry(sid)
                                    if (strlen(changed_entry) == 0):
                                        changed_entry = token_norm
                                    if (_set_contains(files_touched_set, changed_entry) == 0):
                                        files_touched_set = _set_add_unique(files_touched_set, changed_entry)
                                        files_touched = files_touched + 1
                                    sessions_changed = _set_add_unique(sessions_changed, sid)
                                if (message_json == 1):
                                    _emit_fix_target_json(token_norm, sub, 0, sid, scanned, changed, applied, skipped, lock_path)
                        token_apply = ""
                else:
                    token_apply = token_apply + ch_apply
                i_apply = i_apply + 1
            passes_executed = passes_executed + 1
            if (message_json == 1):
                _emit_fix_iteration_json(pass_idx + 1, pass_files_scanned, pass_files_changed, pass_fixes_applied, pass_fixes_skipped)
            else:
                print("[autofix] workspace iteration=" + _to_string_i32(pass_idx + 1) + " files_scanned=" + _to_string_i32(pass_files_scanned) + " files_changed=" + _to_string_i32(pass_files_changed) + " fixes_applied=" + _to_string_i32(pass_fixes_applied) + " fixes_skipped=" + _to_string_i32(pass_fixes_skipped))
            if (failed == 1):
                pass_idx = max_iterations
            else:
                if (pass_fixes_applied <= 0):
                    pass_idx = max_iterations
                else:
                    pass_idx = pass_idx + 1
        if (message_json == 0):
            print("[autofix] workspace summary passes=" + _to_string_i32(passes_executed) + " files_scanned=" + _to_string_i32(total_files_scanned) + " files_changed=" + _to_string_i32(files_touched) + " fixes_applied=" + _to_string_i32(total_fixes_applied) + " fixes_skipped=" + _to_string_i32(total_fixes_skipped))
        if (failed == 0):
            bundle_id = _write_bundle_session(entry_path, mode, lock_path, sessions_changed, passes_executed, total_files_scanned, files_touched, total_fixes_applied, total_fixes_skipped)
            if (strlen(bundle_id) > 0):
                print("rollback: thagore fix rollback " + bundle_id)
        if (message_json == 1):
            let exit_code = 0
            if (failed != 0):
                exit_code = 1
            _emit_fix_summary_json(sub, discovered_total, attempts_total, passes_executed, total_files_scanned, files_touched, total_fixes_applied, total_fixes_skipped, exit_code, bundle_id, lock_path)
        if (failed != 0):
            return 1
        return 0
    let failed = 0
    let attempts = 0
    let total_files_scanned = 0
    let total_files_changed = 0
    let total_fixes_applied = 0
    let total_fixes_skipped = 0
    let n = strlen(targets)
    let i = 0
    let token = ""
    while (i < n):
        let ch = _char_at(targets, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                attempts = attempts + 1
                let target = token
                let rc = 1
                if (sub == "doctor"):
                    rc = autofix.run_fix_doctor(target, mode, lock_path, lock_strict, lock_locked)
                else:
                    if (sub == "dry-run"):
                        rc = autofix.run_fix_dry_run(target, mode, lock_path, lock_strict, lock_locked)
                    else:
                        if (sub == "explain"):
                            rc = autofix.run_fix_explain(target, mode, as_json, lock_path, lock_strict, lock_locked)
                let sid = ""
                let scanned = 0
                let changed = 0
                let applied = 0
                let skipped = 0
                if (rc == 0):
                    sid = autofix.latest_session_id()
                    scanned = _session_files_scanned(sid)
                    changed = _session_files_changed(sid)
                    applied = _session_fixes_applied(sid)
                    skipped = _session_fixes_skipped(sid)
                    total_files_scanned = total_files_scanned + scanned
                    total_files_changed = total_files_changed + changed
                    total_fixes_applied = total_fixes_applied + applied
                    total_fixes_skipped = total_fixes_skipped + skipped
                if (message_json == 1):
                    _emit_fix_target_json(target, sub, rc, sid, scanned, changed, applied, skipped, lock_path)
                if (rc != 0):
                    failed = 1
                    if ((sub == "dry-run") or (sub == "doctor")):
                        i = n
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (message_json == 1):
        let exit_code = 0
        if (failed != 0):
            exit_code = 1
        _emit_fix_summary_json(sub, discovered_total, attempts, 1, total_files_scanned, total_files_changed, total_fixes_applied, total_fixes_skipped, exit_code, "", lock_path)
    return failed

func _quote(s: String) -> String:
    return _dq() + s + _dq()

func _value_after_prefix(text: String, prefix: String) -> String:
    if (_starts_with(text, prefix) == 0):
        return ""
    return __thg_str_substr(text, strlen(prefix), strlen(text) - strlen(prefix))

func _unescape_newlines(text: String) -> String:
    let n = strlen(text)
    let i = 0
    let out = ""
    let nl = __string_from_codepoint(10)
    let cr = __string_from_codepoint(13)
    while (i < n):
        if ((i + 1) < n):
            let c0 = _char_at(text, i)
            let c1 = _char_at(text, i + 1)
            if ((c0 == "\\") and (c1 == "n")):
                out = out + nl
                i = i + 2
            else:
                if (((i + 3) < n) and (c0 == "\\") and (c1 == "r")):
                    if ((_char_at(text, i + 2) == "\\") and (_char_at(text, i + 3) == "n")):
                        out = out + cr + nl
                        i = i + 4
                    else:
                        out = out + c0
                        i = i + 1
                else:
                    out = out + c0
                    i = i + 1
        else:
            out = out + _char_at(text, i)
            i = i + 1
    return out

func _base_name(path: String) -> String:
    let n = strlen(path)
    let last_sep = -1
    let i = 0
    while (i < n):
        let ch = _char_at(path, i)
        if (ch == "/"):
            last_sep = i
        i = i + 1
    if (last_sep < 0):
        return path
    return __thg_str_substr(path, last_sep + 1, n - last_sep - 1)

func _strip_ext(name: String) -> String:
    let n = strlen(name)
    let last_dot = -1
    let i = 0
    while (i < n):
        if (_char_at(name, i) == "."):
            last_dot = i
        i = i + 1
    if (last_dot < 0):
        return name
    return __thg_str_substr(name, 0, last_dot)

func _default_output(input_path: String) -> String:
    return _strip_ext(_base_name(input_path))

func _digit_char(d: i32) -> String:
    return __thg_str_substr("0123456789", d, 1)

func _to_string_i32(value: i32) -> String:
    if (value == 0):
        return "0"
    if (value == (-2147483647 - 1)):
        return "-2147483648"
    let n = value
    let sign = ""
    if (n < 0):
        sign = "-"
        n = 0 - n
    let rev = ""
    while (n > 0):
        let q = n / 10
        let r = n - (q * 10)
        rev = rev + _digit_char(r)
        n = q
    let out = ""
    let i2 = strlen(rev) - 1
    while (i2 >= 0):
        out = out + _char_at(rev, i2)
        i2 = i2 - 1
    return sign + out

func _is_digit(ch: String) -> i32:
    if (_find_char("0123456789", ch) >= 0):
        return 1
    return 0

func _parse_i32_default(text: String, fallback: i32) -> i32:
    let s = _trim(text)
    if (strlen(s) == 0):
        return fallback
    let i = 0
    let sign = 1
    if (_char_at(s, 0) == "-"):
        sign = -1
        i = 1
    let value = 0
    let digits = 0
    while (i < strlen(s)):
        let ch = _char_at(s, i)
        if (_is_digit(ch) == 1):
            value = (value * 10) + _find_char("0123456789", ch)
            digits = digits + 1
            i = i + 1
        else:
            i = strlen(s)
    if (digits == 0):
        return fallback
    if (sign < 0):
        return 0 - value
    return value

func _append_line(listing: String, line: String) -> String:
    if (strlen(line) == 0):
        return listing
    if (strlen(listing) == 0):
        return line
    return listing + _nl() + line

func _json_escape(text: String) -> String:
    let out = _replace_all(text, "\\", "\\\\")
    out = _replace_all(out, _dq(), "\\" + _dq())
    out = _replace_all(out, _nl(), "\\n")
    return out

func _json_quote(text: String) -> String:
    return _dq() + _json_escape(text) + _dq()

func _json_bool(v: i32) -> String:
    if (v == 0):
        return "false"
    return "true"

func _sanitize_test_id(text: String) -> String:
    let out = _replace_all(text, "\\", "_")
    out = _replace_all(out, "/", "_")
    out = _replace_all(out, ":", "_")
    out = _replace_all(out, " ", "_")
    out = _replace_all(out, ".", "_")
    return out

func _is_test_file_name(name: String) -> i32:
    if ((_starts_with(name, "test_") == 1) and (_ends_with(name, ".tg") == 1)):
        return 1
    if (_ends_with(name, "_test.tg") == 1):
        return 1
    return 0

func _test_name_matches(path: String, filter: String) -> i32:
    let f = _trim(filter)
    if (strlen(f) == 0):
        return 1
    let b = _base_name(path)
    if (_contains(path, f) == 1):
        return 1
    if (_contains(b, f) == 1):
        return 1
    return 0

func _path_matches_package_token(path: String, package_name: String) -> i32:
    let pkg = _trim(package_name)
    if (strlen(pkg) == 0):
        return 0
    let p = _normalize_path(path)
    let b = _base_name(p)
    if (_contains(p, "/" + pkg + "/") == 1):
        return 1
    if (b == ("test_" + pkg + ".tg")):
        return 1
    if (_starts_with(b, "test_" + pkg + "_") == 1):
        return 1
    if (_starts_with(b, pkg + "_test") == 1):
        return 1
    return 0

func _path_matches_package(path: String, package_set: String) -> i32:
    let n = strlen(package_set)
    let i = 0
    let token = ""
    let has_any = 0
    while (i < n):
        let ch = _char_at(package_set, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                has_any = 1
                if (_path_matches_package_token(path, token) == 1):
                    return 1
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        has_any = 1
        if (_path_matches_package_token(path, token) == 1):
            return 1
    if (has_any == 0):
        return 1
    return 0

func _path_matches_excluded_package(path: String, exclude_package_set: String) -> i32:
    let n = strlen(exclude_package_set)
    let i = 0
    let token = ""
    while (i < n):
        let ch = _char_at(exclude_package_set, i)
        if (ch == ";"):
            if (strlen(token) > 0):
                if (_path_matches_package_token(path, token) == 1):
                    return 1
                token = ""
        else:
            token = token + ch
        i = i + 1
    if (strlen(token) > 0):
        if (_path_matches_package_token(path, token) == 1):
            return 1
    return 0

func _dir_children(dir: String) -> String:
    let listing = fs.list_dir(dir)
    let out = ""
    let total = _line_count(listing)
    let i = 0
    while (i < total):
        let name = _trim(_line_at(listing, i))
        if (strlen(name) > 0):
            let child = _normalize_path(dir + "/" + name)
            out = _append_line(out, child)
        i = i + 1
    return out

func _looks_like_directory(path: String) -> i32:
    if (fs.exists(path) == 0):
        return 0
    if (_ends_with(path, ".tg") == 1):
        return 0
    let listing = fs.list_dir(path)
    if (strlen(listing) > 0):
        return 1
    let b = _base_name(path)
    if (_contains(b, ".") == 1):
        return 0
    return 1

func _test_file_selected(path: String, filter: String, exclude_set: String, package_set: String, exclude_package_set: String) -> i32:
    if (_path_excluded(path, exclude_set) == 1):
        return 0
    if (_test_name_matches(path, filter) == 0):
        return 0
    if (_path_matches_package(path, package_set) == 0):
        return 0
    if (_path_matches_excluded_package(path, exclude_package_set) == 1):
        return 0
    return 1

func _discover_tests(filter: String, workspace: i32, exclude_set: String, package_set: String, exclude_package_set: String) -> String:
    let out = ""
    if (fs.exists("tests") == 0):
        return out
    if (workspace == 0):
        let top = _dir_children("tests")
        let total_top = _line_count(top)
        let i_top = 0
        while (i_top < total_top):
            let path = _trim(_line_at(top, i_top))
            if (strlen(path) > 0):
                if (_is_test_file_name(_base_name(path)) == 1):
                    if (_test_file_selected(path, filter, exclude_set, package_set, exclude_package_set) == 1):
                        out = _append_line(out, path)
            i_top = i_top + 1
        return out

    let queue = ";tests;"
    let seen = ";"
    let progress = 1
    while (progress == 1):
        progress = 0
        let next_queue = ";"
        let i = 0
        let n = strlen(queue)
        let token = ""
        while (i < n):
            let ch = _char_at(queue, i)
            if (ch == ";"):
                if (strlen(token) > 0):
                    if (_set_contains(seen, token) == 0):
                        seen = _set_add_unique(seen, token)
                        progress = 1
                        let children = _dir_children(token)
                        let total_children = _line_count(children)
                        let j = 0
                        while (j < total_children):
                            let child = _trim(_line_at(children, j))
                            if (strlen(child) > 0):
                                let child_name = _base_name(child)
                                if (_is_test_file_name(child_name) == 1):
                                    if (_test_file_selected(child, filter, exclude_set, package_set, exclude_package_set) == 1):
                                        out = _append_line(out, child)
                                else:
                                    if (_path_excluded(child, exclude_set) == 0):
                                        if (_looks_like_directory(child) == 1):
                                            next_queue = _set_add_unique(next_queue, child)
                            j = j + 1
                    token = ""
            else:
                token = token + ch
            i = i + 1
        queue = next_queue
    return out

func _count_lines_nonempty(text: String) -> i32:
    let total = _line_count(text)
    let count = 0
    let i = 0
    while (i < total):
        if (strlen(_trim(_line_at(text, i))) > 0):
            count = count + 1
        i = i + 1
    return count

func _lines_to_set(lines: String) -> String:
    let out = ";"
    let total = _line_count(lines)
    let i = 0
    while (i < total):
        let item = _trim(_line_at(lines, i))
        if (strlen(item) > 0):
            out = _set_add_unique(out, item)
        i = i + 1
    return out

func _test_event_schema() -> String:
    return "thagore.test.v1"

func _test_mode_name(no_run: i32, list_only: i32) -> String:
    if (list_only == 1):
        return "list"
    if (no_run == 1):
        return "no-run"
    return "run"

func _test_report_path(run_id: String) -> String:
    return ".thagore/test/reports/" + _sanitize_test_id(run_id) + ".json"

func _write_test_report(run_id: String, no_run: i32, list_only: i32, workspace: i32, fail_fast: i32, filter: String, total: i32, built: i32, build_failed: i32, run_passed: i32, run_failed: i32, discovered_set: String, build_failed_set: String, run_failed_set: String, started_ms: i32, duration_ms: i32) -> String:
    fs.mkdir(".thagore")
    fs.mkdir(".thagore/test")
    fs.mkdir(".thagore/test/reports")
    let mode = _test_mode_name(no_run, list_only)
    let failed_total = build_failed + run_failed
    let status = "ok"
    if (failed_total > 0):
        status = "failed"
    let exit_code = 0
    if (failed_total > 0):
        exit_code = 1
    let ended_ms = started_ms + duration_ms
    let report_path = _test_report_path(run_id)
    let summary = "{"
    summary = summary + _json_quote("total") + ":" + _to_string_i32(total) + ","
    summary = summary + _json_quote("built") + ":" + _to_string_i32(built) + ","
    summary = summary + _json_quote("build_failed") + ":" + _to_string_i32(build_failed) + ","
    summary = summary + _json_quote("run_passed") + ":" + _to_string_i32(run_passed) + ","
    summary = summary + _json_quote("run_failed") + ":" + _to_string_i32(run_failed) + ","
    summary = summary + _json_quote("exit_code") + ":" + _to_string_i32(exit_code)
    summary = summary + "}"
    let report = "{"
    report = report + _json_quote("schema_version") + ":1,"
    report = report + _json_quote("report_schema") + ":" + _json_quote("thagore.test.report.v1") + ","
    report = report + _json_quote("event_schema") + ":" + _json_quote(_test_event_schema()) + ","
    report = report + _json_quote("run_id") + ":" + _json_quote(run_id) + ","
    report = report + _json_quote("tool") + ":" + _json_quote("thagore test") + ","
    report = report + _json_quote("tool_version") + ":" + _json_quote("0.4.0-native-cli") + ","
    report = report + _json_quote("status") + ":" + _json_quote(status) + ","
    report = report + _json_quote("mode") + ":" + _json_quote(mode) + ","
    report = report + _json_quote("list_only") + ":" + _json_bool(list_only) + ","
    report = report + _json_quote("workspace") + ":" + _json_bool(workspace) + ","
    report = report + _json_quote("fail_fast") + ":" + _json_bool(fail_fast) + ","
    report = report + _json_quote("filter") + ":" + _json_quote(filter) + ","
    report = report + _json_quote("started_ms") + ":" + _to_string_i32(started_ms) + ","
    report = report + _json_quote("ended_ms") + ":" + _to_string_i32(ended_ms) + ","
    report = report + _json_quote("duration_ms") + ":" + _to_string_i32(duration_ms) + ","
    report = report + _json_quote("discovered_tests_set") + ":" + _json_quote(discovered_set) + ","
    report = report + _json_quote("discovered_tests") + ":" + _set_to_json_array(discovered_set) + ","
    report = report + _json_quote("build_failed_tests_set") + ":" + _json_quote(build_failed_set) + ","
    report = report + _json_quote("build_failed_tests") + ":" + _set_to_json_array(build_failed_set) + ","
    report = report + _json_quote("run_failed_tests_set") + ":" + _json_quote(run_failed_set) + ","
    report = report + _json_quote("run_failed_tests") + ":" + _set_to_json_array(run_failed_set) + ","
    report = report + _json_quote("summary") + ":" + summary
    report = report + "}" + _nl()
    if (fs.write_text(report_path, report) == 0):
        return ""
    fs.write_text(".thagore/test/last_report.path", report_path)
    return report_path

func _build_test_begin_json(total: i32, no_run: i32, list_only: i32, workspace: i32, fail_fast: i32, filter: String, run_id: String) -> String:
    let mode = "run"
    if (no_run == 1):
        mode = "no-run"
    let json = "{"
    json = json + _json_quote("schema_version") + ":1,"
    json = json + _json_quote("event_schema") + ":" + _json_quote(_test_event_schema()) + ","
    json = json + _json_quote("run_id") + ":" + _json_quote(run_id) + ","
    json = json + _json_quote("type") + ":" + _json_quote("suite") + ","
    json = json + _json_quote("event") + ":" + _json_quote("started") + ","
    json = json + _json_quote("tool") + ":" + _json_quote("thagore test") + ","
    json = json + _json_quote("tool_version") + ":" + _json_quote("0.4.0-native-cli") + ","
    json = json + _json_quote("mode") + ":" + _json_quote(mode) + ","
    json = json + _json_quote("list_only") + ":" + _json_bool(list_only) + ","
    json = json + _json_quote("workspace") + ":" + _json_bool(workspace) + ","
    json = json + _json_quote("fail_fast") + ":" + _json_bool(fail_fast) + ","
    json = json + _json_quote("filter") + ":" + _json_quote(filter) + ","
    json = json + _json_quote("discovered_total") + ":" + _to_string_i32(total)
    json = json + "}"
    return json

func _emit_test_begin_json(total: i32, no_run: i32, list_only: i32, workspace: i32, fail_fast: i32, filter: String, run_id: String) -> void:
    print(_build_test_begin_json(total, no_run, list_only, workspace, fail_fast, filter, run_id))

func _build_test_case_json(name: String, stage: String, status: String, code: i32, has_code: i32, log_path: String, has_log: i32, run_id: String) -> String:
    let json = "{"
    json = json + _json_quote("schema_version") + ":1,"
    json = json + _json_quote("event_schema") + ":" + _json_quote(_test_event_schema()) + ","
    json = json + _json_quote("run_id") + ":" + _json_quote(run_id) + ","
    json = json + _json_quote("tool") + ":" + _json_quote("thagore test") + ","
    json = json + _json_quote("type") + ":" + _json_quote("test") + ","
    json = json + _json_quote("name") + ":" + _json_quote(name) + ","
    json = json + _json_quote("stage") + ":" + _json_quote(stage) + ","
    json = json + _json_quote("status") + ":" + _json_quote(status)
    if (has_code == 1):
        json = json + "," + _json_quote("code") + ":" + _to_string_i32(code)
    if ((has_log == 1) and (strlen(log_path) > 0)):
        json = json + "," + _json_quote("log_path") + ":" + _json_quote(log_path)
    json = json + "}"
    return json

func _emit_test_case_json(name: String, stage: String, status: String, code: i32, has_code: i32, log_path: String, has_log: i32, run_id: String) -> void:
    print(_build_test_case_json(name, stage, status, code, has_code, log_path, has_log, run_id))

func _build_test_summary_json(total: i32, built: i32, build_failed: i32, run_passed: i32, run_failed: i32, no_run: i32, list_only: i32, workspace: i32, fail_fast: i32, filter: String, run_id: String, duration_ms: i32, report_path: String) -> String:
    let failed_total = build_failed + run_failed
    let mode = "run"
    let status = "ok"
    mode = _test_mode_name(no_run, list_only)
    if (failed_total > 0):
        status = "failed"
    let exit_code = 0
    if (failed_total > 0):
        exit_code = 1
    let json = "{"
    json = json + _json_quote("schema_version") + ":1,"
    json = json + _json_quote("event_schema") + ":" + _json_quote(_test_event_schema()) + ","
    json = json + _json_quote("run_id") + ":" + _json_quote(run_id) + ","
    json = json + _json_quote("type") + ":" + _json_quote("suite") + ","
    json = json + _json_quote("event") + ":" + _json_quote("completed") + ","
    json = json + _json_quote("tool") + ":" + _json_quote("thagore test") + ","
    json = json + _json_quote("tool_version") + ":" + _json_quote("0.4.0-native-cli") + ","
    json = json + _json_quote("status") + ":" + _json_quote(status) + ","
    json = json + _json_quote("mode") + ":" + _json_quote(mode) + ","
    json = json + _json_quote("list_only") + ":" + _json_bool(list_only) + ","
    json = json + _json_quote("workspace") + ":" + _json_bool(workspace) + ","
    json = json + _json_quote("fail_fast") + ":" + _json_bool(fail_fast) + ","
    json = json + _json_quote("filter") + ":" + _json_quote(filter) + ","
    json = json + _json_quote("duration_ms") + ":" + _to_string_i32(duration_ms) + ","
    json = json + _json_quote("report_path") + ":" + _json_quote(report_path) + ","
    json = json + _json_quote("total") + ":" + _to_string_i32(total) + ","
    json = json + _json_quote("built") + ":" + _to_string_i32(built) + ","
    json = json + _json_quote("build_failed") + ":" + _to_string_i32(build_failed) + ","
    json = json + _json_quote("run_passed") + ":" + _to_string_i32(run_passed) + ","
    json = json + _json_quote("run_failed") + ":" + _to_string_i32(run_failed) + ","
    json = json + _json_quote("exit_code") + ":" + _to_string_i32(exit_code)
    json = json + "}"
    return json

func _emit_test_summary_json(total: i32, built: i32, build_failed: i32, run_passed: i32, run_failed: i32, no_run: i32, list_only: i32, workspace: i32, fail_fast: i32, filter: String, run_id: String, duration_ms: i32, report_path: String) -> void:
    print(_build_test_summary_json(total, built, build_failed, run_passed, run_failed, no_run, list_only, workspace, fail_fast, filter, run_id, duration_ms, report_path))

func _resolve_test_compiler() -> String:
    if (fs.exists("stage1.exe") == 1):
        return ".\\stage1.exe"
    if (fs.exists("stage1") == 1):
        return "./stage1"
    if (fs.exists("stage2.exe") == 1):
        return ".\\stage2.exe"
    if (fs.exists("stage2") == 1):
        return "./stage2"
    return ""

func _build_test_target(input_path: String, out_path: String, quiet: i32, build_log_path: String) -> i32:
    let compiler = _resolve_test_compiler()
    if (strlen(compiler) > 0):
        let args = "build\n" + input_path + "\n-o\n" + out_path
        if ((quiet == 1) and (strlen(build_log_path) > 0)):
            return process.exec_redirect(compiler, args, build_log_path, build_log_path)
        return process.exec(compiler, args)
    return _build_once(input_path, out_path, 0)

func _test_exec_path(path: String) -> String:
    if ((_starts_with(path, ".\\") == 1) or (_starts_with(path, "./") == 1)):
        return path
    if (_starts_with(path, ".") == 1):
        let tail = __thg_str_substr(path, 1, strlen(path) - 1)
        if (_ends_with(path, ".exe") == 1):
            return ".\\." + _replace_all(tail, "/", "\\")
        return "./." + tail
    return path

func _run_test_binary(path: String, quiet: i32, run_log_path: String) -> i32:
    let exec_path = _test_exec_path(path)
    if (quiet == 0):
        return process.exec(exec_path, "")
    if (strlen(run_log_path) == 0):
        return process.exec(exec_path, "")
    return process.exec_redirect(exec_path, "", run_log_path, run_log_path)

func _run_tests(filter: String, workspace: i32, no_run: i32, fail_fast: i32, as_json: i32, list_only: i32, exclude_set: String, package_set: String, exclude_package_set: String) -> i32:
    let tests = _discover_tests(filter, workspace, exclude_set, package_set, exclude_package_set)
    let discovered_set = _lines_to_set(tests)
    let total = _count_lines_nonempty(tests)
    let started_ms = time.now_ms()
    let run_id = "TST-" + _to_string_i32(started_ms) + "-" + _to_string_i32(total)
    let build_failed_set = ";"
    let run_failed_set = ";"

    if (as_json == 1):
        _emit_test_begin_json(total, no_run, list_only, workspace, fail_fast, filter, run_id)

    if (list_only == 1):
        let total_lines = _line_count(tests)
        let i = 0
        while (i < total_lines):
            let path = _trim(_line_at(tests, i))
            if (strlen(path) > 0):
                if (as_json == 1):
                    _emit_test_case_json(path, "discover", "found", 0, 0, "", 0, run_id)
                else:
                    print(path)
            i = i + 1
        if (as_json == 1):
            let elapsed_list = time.now_ms() - started_ms
            let elapsed_list_safe = elapsed_list
            if (elapsed_list_safe < 0):
                elapsed_list_safe = 0
            let report_path_list = _write_test_report(run_id, no_run, list_only, workspace, fail_fast, filter, total, 0, 0, 0, 0, discovered_set, build_failed_set, run_failed_set, started_ms, elapsed_list_safe)
            _emit_test_summary_json(total, 0, 0, 0, 0, no_run, list_only, workspace, fail_fast, filter, run_id, elapsed_list_safe, report_path_list)
        else:
            print("[test] discovered=" + _to_string_i32(total))
            let report_path_list_h = _write_test_report(run_id, no_run, list_only, workspace, fail_fast, filter, total, 0, 0, 0, 0, discovered_set, build_failed_set, run_failed_set, started_ms, 0)
            if (strlen(report_path_list_h) > 0):
                print("[test] report: " + report_path_list_h)
        return 0

    if (total == 0):
        let elapsed_empty = time.now_ms() - started_ms
        let elapsed_empty_safe = elapsed_empty
        if (elapsed_empty_safe < 0):
            elapsed_empty_safe = 0
        let report_path_empty = _write_test_report(run_id, no_run, list_only, workspace, fail_fast, filter, 0, 0, 0, 0, 0, discovered_set, build_failed_set, run_failed_set, started_ms, elapsed_empty_safe)
        if (as_json == 1):
            _emit_test_summary_json(0, 0, 0, 0, 0, no_run, list_only, workspace, fail_fast, filter, run_id, elapsed_empty_safe, report_path_empty)
        else:
            print("[test] no tests discovered")
            if (strlen(report_path_empty) > 0):
                print("[test] report: " + report_path_empty)
        return 0

    fs.mkdir(".thagore")
    fs.mkdir(".thagore/test")
    fs.mkdir(".thagore/test/bin")
    fs.mkdir(".thagore/test/log")

    if (as_json == 0):
        if (no_run == 1):
            print("[test] building " + _to_string_i32(total) + " test targets")
        else:
            print("[test] running " + _to_string_i32(total) + " tests")

    let built = 0
    let build_failed = 0
    let run_passed = 0
    let run_failed = 0
    let total_lines = _line_count(tests)
    let i = 0
    while (i < total_lines):
        let path = _trim(_line_at(tests, i))
        if (strlen(path) > 0):
            let test_id = _sanitize_test_id(path)
            let out_bin = ".thagore/test/bin/" + test_id + ".exe"
            let build_log = ".thagore/test/log/" + test_id + ".build.log"
            let run_log = ".thagore/test/log/" + test_id + ".run.log"
            if (as_json == 0):
                print("test " + path + " ... build")
            else:
                _emit_test_case_json(path, "build", "started", 0, 0, build_log, 1, run_id)
            let build_rc = _build_test_target(path, out_bin, as_json, build_log)
            if (build_rc != 0):
                build_failed = build_failed + 1
                build_failed_set = _set_add_unique(build_failed_set, path)
                if (as_json == 1):
                    _emit_test_case_json(path, "build", "failed", build_rc, 1, build_log, 1, run_id)
                else:
                    print("test " + path + " ... FAILED (build)")
                if (fail_fast == 1):
                    i = total_lines
            else:
                built = built + 1
                if (no_run == 1):
                    if (as_json == 1):
                        _emit_test_case_json(path, "build", "ok", 0, 0, build_log, 1, run_id)
                    else:
                        print("test " + path + " ... ok (built)")
                else:
                    if (as_json == 1):
                        _emit_test_case_json(path, "build", "ok", 0, 0, build_log, 1, run_id)
                    if (as_json == 1):
                        _emit_test_case_json(path, "run", "started", 0, 0, run_log, 1, run_id)
                    let run_rc = _run_test_binary(out_bin, as_json, run_log)
                    if (run_rc == 0):
                        run_passed = run_passed + 1
                        if (as_json == 1):
                            _emit_test_case_json(path, "run", "ok", 0, 0, run_log, 1, run_id)
                        else:
                            print("test " + path + " ... ok")
                    else:
                        run_failed = run_failed + 1
                        run_failed_set = _set_add_unique(run_failed_set, path)
                        if (as_json == 1):
                            _emit_test_case_json(path, "run", "failed", run_rc, 1, run_log, 1, run_id)
                        else:
                            print("test " + path + " ... FAILED")
                        if (fail_fast == 1):
                            i = total_lines
        i = i + 1

    let failed_total = build_failed + run_failed
    let elapsed = time.now_ms() - started_ms
    let elapsed_safe = elapsed
    if (elapsed_safe < 0):
        elapsed_safe = 0
    let report_path = _write_test_report(run_id, no_run, list_only, workspace, fail_fast, filter, total, built, build_failed, run_passed, run_failed, discovered_set, build_failed_set, run_failed_set, started_ms, elapsed_safe)
    if (as_json == 1):
        _emit_test_summary_json(total, built, build_failed, run_passed, run_failed, no_run, list_only, workspace, fail_fast, filter, run_id, elapsed_safe, report_path)
    else:
        if (no_run == 1):
            if (failed_total == 0):
                print("test result: ok. " + _to_string_i32(built) + " built; 0 failed; " + _to_string_i32(total) + " total")
            else:
                print("test result: FAILED. " + _to_string_i32(built) + " built; " + _to_string_i32(failed_total) + " failed; " + _to_string_i32(total) + " total")
        else:
            if (failed_total == 0):
                print("test result: ok. " + _to_string_i32(run_passed) + " passed; 0 failed; " + _to_string_i32(total) + " total")
            else:
                print("test result: FAILED. " + _to_string_i32(run_passed) + " passed; " + _to_string_i32(failed_total) + " failed; " + _to_string_i32(total) + " total")
        if (strlen(report_path) > 0):
            print("[test] report: " + report_path)

    if (failed_total == 0):
        return 0
    return 1

func _detect_clang() -> String:
    if (process.run("clang --version > thagore_clang_probe.log 2>&1") == 0):
        return "clang"
    if (process.run("C:/Progra~1/LLVM/bin/clang.exe --version > thagore_clang_probe.log 2>&1") == 0):
        return "C:/Progra~1/LLVM/bin/clang.exe"
    if (process.run("/usr/bin/clang --version > thagore_clang_probe.log 2>&1") == 0):
        return "/usr/bin/clang"
    if (process.run("/usr/local/bin/clang --version > thagore_clang_probe.log 2>&1") == 0):
        return "/usr/local/bin/clang"
    return ""

func _print_autofix_build_failure(total_fixed: i32, code: i32) -> void:
    if (total_fixed > 0):
        print("[autofix] rebuild=failed after fixes_applied=" + _to_string_i32(total_fixed))
    print("[autofix] failing_diagnostic=build_code_" + _to_string_i32(code))
    let report_path = ""
    if (total_fixed > 0):
        report_path = autofix.latest_applied_report_path()
    if (strlen(report_path) == 0):
        report_path = autofix.latest_report_path()
    if (strlen(report_path) > 0):
        print("[autofix] report: " + report_path)

func _link_exe(ir_path: String, out_path: String) -> i32:
    let clang_bin = _detect_clang()
    if (clang_bin.length() == 0):
        print("CRITICAL: Clang not found via PATH or standard locations. Please install LLVM.")
        return 1
    let cmd1 = clang_bin + " " + _quote(ir_path) + " -o " + _quote(out_path) + " -Wno-override-module thag_runtime.lib"
    if (process.run(cmd1) == 0):
        return 0
    let cmd2 = clang_bin + " " + _quote(ir_path) + " -o " + _quote(out_path) + " -Wno-override-module libthag_runtime.a"
    if (process.run(cmd2) == 0):
        return 0
    print("CRITICAL: runtime library not found (expected thag_runtime.lib or libthag_runtime.a).")
    return 1

func _looks_like_valid_llvm(ir: String) -> i32:
    if (_starts_with(ir, "; ModuleID = '") == 0):
        return 0
    if (_contains(ir, "\\n") == 1):
        return 0
    if (_contains(ir, "@main(") == 0):
        return 0
    return 1

func _build_once(input_path: String, out_path: String, emit_only: i32) -> i32:
    let source = fs.read_text(input_path)
    if (source.length() == 0):
        print("ERROR: cannot read source file: " + input_path)
        return 11
    let typed = typechecker.typecheck_to_typed(source)
    if (typed.error_count > 0):
        if (typed.error_code.length() > 0):
            print("Typecheck error [" + typed.error_code + "]: " + typed.error_message)
        print("ERROR: typecheck failed.")
        return 21
    let core = lowering.lower_program(typed)
    if (core.error_count > 0):
        if (core.error_code.length() > 0):
            print("Lowering error [" + core.error_code + "]: " + core.error_message)
        print("ERROR: lowering failed.")
        return 22
    let module_name = _strip_ext(_base_name(input_path))
    let ir = emitter.emit_program_core(core, module_name)
    if (_looks_like_valid_llvm(ir) == 0):
        fs.write_text(out_path + ".raw.ll", ir)
        print("ERROR: native emitter produced invalid LLVM IR.")
        return 2
    let ir_path = out_path + ".ll"
    if (emit_only == 1):
        if (out_path.length() > 3):
            if (__thg_str_substr(out_path, out_path.length() - 3, 3) == ".ll"):
                ir_path = out_path
    if (fs.write_text(ir_path, ir) == 0):
        print("ERROR: failed to write IR file: " + ir_path)
        return 1
    if (emit_only == 1):
        print(ir_path)
        return 0
    if (_link_exe(ir_path, out_path) != 0):
        print("ERROR: link failed.")
        return 1
    print("Build success.")
    return 0

func _build(input_path: String, out_path: String, emit_only: i32, autofix_mode_raw: String, autofix_lock: String, autofix_lock_strict: i32, autofix_lock_locked: i32, autofix_max_iterations: i32, autofix_max_files_touched: i32, autofix_workspace: i32, autofix_exclude_set: String) -> i32:
    let mode = autofix.normalize_mode(autofix_mode_raw)
    if (mode == "off"):
        return _build_once(input_path, out_path, emit_only)
    let max_iters = autofix_max_iterations
    if (max_iters < 1):
        max_iters = 1
    if (max_iters > 12):
        max_iters = 12
    let max_files = autofix_max_files_touched
    if (max_files < 1):
        max_files = 1
    let pass_idx = 0
    let total_fixed = 0
    let applied_sessions = ";"
    let baseline_rank = _error_severity_rank(21)
    while (pass_idx < max_iters):
        let code = _build_once(input_path, out_path, emit_only)
        if (code == 0):
            if (pass_idx > 0):
                print("[autofix] rebuild=success")
            return 0
        if ((pass_idx > 0) and (total_fixed > 0)):
            let now_rank = _error_severity_rank(code)
            if (now_rank > baseline_rank):
                print("[autofix] severity_increase_detected after autofix; rolling back applied sessions.")
                _rollback_sessions(applied_sessions)
                _print_autofix_build_failure(total_fixed, code)
                return code
        if (code != 21):
            _print_autofix_build_failure(total_fixed, code)
            return code
        if (pass_idx >= (max_iters - 1)):
            print("[autofix] max_passes_reached=" + _to_string_i32(max_iters))
            _print_autofix_build_failure(total_fixed, code)
            return code
        let batch = _apply_autofix_batch(input_path, mode, autofix_lock, autofix_lock_strict, autofix_lock_locked, max_files, autofix_workspace, autofix_exclude_set)
        if ((batch.error == 1) or (batch.changed <= 0)):
            print("[autofix] rebuild=failed")
            _print_autofix_build_failure(total_fixed, code)
            return code
        print("[autofix] iteration=" + _to_string_i32(pass_idx + 1) + " errors_before=1 warnings_before=0 fixes_applied=" + _to_string_i32(batch.changed))
        total_fixed = total_fixed + batch.changed
        applied_sessions = _set_union(applied_sessions, batch.sessions_set)
        pass_idx = pass_idx + 1
    print("[autofix] rebuild=failed")
    return 1

func _print_help() -> void:
    print("Thagore Compiler CLI")
    print("Usage:")
    print("  thagore build <input.tg> -o <output> [--autofix=<off|safe|aggressive>]")
    print("       [--autofix-lock <path>] [--autofix-lock-strict] [--autofix-locked] [--autofix-workspace]")
    print("       [--autofix-max-iterations N] [--autofix-max-files N] [--autofix-exclude a,b,c]")
    print("  thagore build <input.tg> --emit-llvm")
    print("  thagore <input.tg> --emit-llvm")
    print("  thagore test [filter] [--workspace] [--package <name>|a,b] [--exclude <a,b,c>]")
    print("       [--exclude-package <a,b,c>] [--no-run] [--fail-fast] [--json]")
    print("       [--message-format json|human] [--list]")
    print("  thagore fix doctor <entry.tg> [--workspace] [--exclude a,b,c] [--lock <path>] [--lock-strict] [--locked]")
    print("       [--message-format json|human]")
    print("  thagore fix dry-run <entry.tg> [--workspace] [--exclude a,b,c] [--lock <path>] [--lock-strict] [--locked]")
    print("       [--message-format json|human]")
    print("  thagore fix apply <entry.tg> [--level safe|aggressive] [--workspace] [--exclude a,b,c] [--max-files N] [--max-iterations N]")
    print("       [--lock <path>] [--lock-strict] [--locked] [--message-format json|human]")
    print("  thagore fix explain <entry.tg> [--json] [--workspace] [--exclude a,b,c] [--lock <path>] [--lock-strict] [--locked]")
    print("       [--message-format json|human]")
    print("  thagore fix rollback <session-id>")
    print("  thagore install toolchain")
    print("  thagore --version")

func _install_toolchain() -> i32:
    if (process.run("clang --version") == 0):
        print("LLVM already installed.")
        return 0
    print("Installing LLVM toolchain...")
    if (process.run("winget --version > thagore_winget_probe.log 2>&1") == 0):
        return process.run("winget install LLVM.LLVM")
    if (process.run("brew --version > thagore_brew_probe.log 2>&1") == 0):
        return process.run("brew install llvm")
    if (process.run("apt-get --version > thagore_apt_probe.log 2>&1") == 0):
        return process.run("sudo apt-get update && sudo apt-get install -y clang lld")
    print("ERROR: unsupported platform package manager. Install LLVM manually.")
    return 1

func _fix_level(raw: String) -> String:
    let m = _trim(raw)
    if (m == "aggressive"):
        return "aggressive"
    return "safe"

func _test_message_format_mode(raw: String) -> i32:
    let m = _trim(raw)
    if (m == "json"):
        return 1
    if ((m == "human") or (m == "pretty") or (m == "text")):
        return 0
    return -1

func main() -> i32:
    let argc = env.count()
    if (argc <= 1):
        _print_help()
        return 0
    let cmd = _trim(env.get(1))
    if ((cmd == "--help") or (cmd == "help")):
        _print_help()
        return 0
    if ((cmd == "--version") or (cmd == "version")):
        print("thagore 0.4.0-native-cli")
        return 0
    if (cmd == "fix"):
        if (argc <= 2):
            print("ERROR: missing fix subcommand.")
            return 1
        let sub = _trim(env.get(2))
        if (sub == "rollback"):
            if (argc <= 3):
                print("ERROR: missing fix session id.")
                return 1
            return autofix.run_fix_rollback(_trim(env.get(3)))
        let entry = ""
        let level = "safe"
        let as_json = 0
        let lock_path = ""
        let lock_strict = 0
        let lock_locked = 0
        let workspace = 0
        let exclude_csv = ""
        let max_files = 25
        let max_iterations = 3
        let fix_message_json = 0
        let i_fix = 3
        while (i_fix < argc):
            let arg_fix = _trim(env.get(i_fix))
            if (_starts_with(arg_fix, "--level=") == 1):
                level = _fix_level(_value_after_prefix(arg_fix, "--level="))
            else:
                if ((arg_fix == "--level") and ((i_fix + 1) < argc)):
                    level = _fix_level(_trim(env.get(i_fix + 1)))
                    i_fix = i_fix + 1
                else:
                    if (_starts_with(arg_fix, "--lock=") == 1):
                        lock_path = _trim(_value_after_prefix(arg_fix, "--lock="))
                    else:
                        if ((arg_fix == "--lock") and ((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                            lock_path = _trim(env.get(i_fix + 1))
                            i_fix = i_fix + 1
                        else:
                            if (arg_fix == "--lock"):
                                lock_path = "thagore.fix.lock"
                            else:
                                if (arg_fix == "--lock-strict"):
                                    lock_strict = 1
                                else:
                                    if (arg_fix == "--locked"):
                                        lock_locked = 1
                                    else:
                                        if ((arg_fix == "--workspace") or (arg_fix == "--all")):
                                            workspace = 1
                                        else:
                                            if (_starts_with(arg_fix, "--exclude=") == 1):
                                                let ex = _trim(_value_after_prefix(arg_fix, "--exclude="))
                                                if (strlen(exclude_csv) == 0):
                                                    exclude_csv = ex
                                                else:
                                                    exclude_csv = exclude_csv + "," + ex
                                            else:
                                                if (arg_fix == "--exclude"):
                                                    if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                        let ex2 = _trim(env.get(i_fix + 1))
                                                        if (strlen(exclude_csv) == 0):
                                                            exclude_csv = ex2
                                                        else:
                                                            exclude_csv = exclude_csv + "," + ex2
                                                        i_fix = i_fix + 1
                                                    else:
                                                        print("ERROR: --exclude requires a value.")
                                                        return 1
                                                else:
                                                    if (_starts_with(arg_fix, "--max-files=") == 1):
                                                        max_files = _parse_i32_default(_value_after_prefix(arg_fix, "--max-files="), max_files)
                                                    else:
                                                        if (arg_fix == "--max-files"):
                                                            if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                max_files = _parse_i32_default(_trim(env.get(i_fix + 1)), max_files)
                                                                i_fix = i_fix + 1
                                                            else:
                                                                print("ERROR: --max-files requires a value.")
                                                                return 1
                                                        else:
                                                            if (_starts_with(arg_fix, "--max-iterations=") == 1):
                                                                max_iterations = _parse_i32_default(_value_after_prefix(arg_fix, "--max-iterations="), max_iterations)
                                                            else:
                                                                if (arg_fix == "--max-iterations"):
                                                                    if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                        max_iterations = _parse_i32_default(_trim(env.get(i_fix + 1)), max_iterations)
                                                                        i_fix = i_fix + 1
                                                                    else:
                                                                        print("ERROR: --max-iterations requires a value.")
                                                                        return 1
                                                                else:
                                                                    if (arg_fix == "--json"):
                                                                        as_json = 1
                                                                    else:
                                                                        if (_starts_with(arg_fix, "--message-format=") == 1):
                                                                            let fmt_fix = _trim(_value_after_prefix(arg_fix, "--message-format="))
                                                                            let mode_fix = _test_message_format_mode(fmt_fix)
                                                                            if (mode_fix < 0):
                                                                                print("ERROR: unsupported --message-format: " + fmt_fix)
                                                                                return 1
                                                                            fix_message_json = mode_fix
                                                                        else:
                                                                            if (arg_fix == "--message-format"):
                                                                                if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                                    let fmt_fix2 = _trim(env.get(i_fix + 1))
                                                                                    let mode_fix2 = _test_message_format_mode(fmt_fix2)
                                                                                    if (mode_fix2 < 0):
                                                                                        print("ERROR: unsupported --message-format: " + fmt_fix2)
                                                                                        return 1
                                                                                    fix_message_json = mode_fix2
                                                                                    i_fix = i_fix + 1
                                                                                else:
                                                                                    print("ERROR: --message-format requires a value (json|human).")
                                                                                    return 1
                                                                            else:
                                                                                if (_starts_with(arg_fix, "--") == 1):
                                                                                    print("ERROR: unknown fix flag: " + arg_fix)
                                                                                    return 1
                                                                                else:
                                                                                    if (strlen(entry) == 0):
                                                                                        entry = arg_fix
                                                                                    else:
                                                                                        print("ERROR: multiple fix entry paths are not supported: " + arg_fix)
                                                                                        return 1
            i_fix = i_fix + 1
        if (strlen(entry) == 0):
            print("ERROR: missing entry path for fix command.")
            return 1
        if (max_files < 1):
            max_files = 1
        if (max_iterations < 1):
            max_iterations = 1
        let exclude_set = _csv_to_set(exclude_csv)
        if ((sub == "doctor") or (sub == "dry-run") or (sub == "apply") or (sub == "explain")):
            return _run_fix_multi(sub, entry, level, as_json, lock_path, lock_strict, lock_locked, workspace, exclude_set, max_files, max_iterations, fix_message_json)
        print("ERROR: unknown fix subcommand: " + sub)
        return 1
    if (cmd == "test"):
        let filter = ""
        let workspace = 0
        let no_run = 0
        let fail_fast = 0
        let as_json = 0
        let list_only = 0
        let exclude_csv = ""
        let package_csv = ""
        let exclude_package_csv = ""
        let i_test = 2
        while (i_test < argc):
            let arg_test = _trim(env.get(i_test))
            if ((arg_test == "--help") or (arg_test == "-h")):
                _print_help()
                return 0
            else:
                if ((arg_test == "--workspace") or (arg_test == "--all")):
                    workspace = 1
                else:
                    if (arg_test == "--no-run"):
                        no_run = 1
                    else:
                        if (arg_test == "--fail-fast"):
                            fail_fast = 1
                        else:
                            if (arg_test == "--json"):
                                as_json = 1
                            else:
                                if (_starts_with(arg_test, "--message-format=") == 1):
                                    let fmt = _trim(_value_after_prefix(arg_test, "--message-format="))
                                    let mode = _test_message_format_mode(fmt)
                                    if (mode < 0):
                                        print("ERROR: unsupported --message-format: " + fmt)
                                        return 1
                                    as_json = mode
                                else:
                                    if (arg_test == "--message-format"):
                                        if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                            let fmt2 = _trim(env.get(i_test + 1))
                                            let mode2 = _test_message_format_mode(fmt2)
                                            if (mode2 < 0):
                                                print("ERROR: unsupported --message-format: " + fmt2)
                                                return 1
                                            as_json = mode2
                                            i_test = i_test + 1
                                        else:
                                            print("ERROR: --message-format requires a value (json|human).")
                                            return 1
                                    else:
                                        if (arg_test == "--list"):
                                            list_only = 1
                                        else:
                                            if (_starts_with(arg_test, "--package=") == 1):
                                                let pkg_eq = _trim(_value_after_prefix(arg_test, "--package="))
                                                if (strlen(pkg_eq) == 0):
                                                    print("ERROR: --package requires a package name.")
                                                    return 1
                                                if (strlen(package_csv) == 0):
                                                    package_csv = pkg_eq
                                                else:
                                                    package_csv = package_csv + "," + pkg_eq
                                            else:
                                                if ((arg_test == "--package") or (arg_test == "-p")):
                                                    if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                                        let pkg_next = _trim(env.get(i_test + 1))
                                                        if (strlen(pkg_next) == 0):
                                                            print("ERROR: --package requires a package name.")
                                                            return 1
                                                        if (strlen(package_csv) == 0):
                                                            package_csv = pkg_next
                                                        else:
                                                            package_csv = package_csv + "," + pkg_next
                                                        i_test = i_test + 1
                                                    else:
                                                        print("ERROR: --package requires a package name.")
                                                        return 1
                                                else:
                                                    if (_starts_with(arg_test, "--exclude=") == 1):
                                                        let ex = _trim(_value_after_prefix(arg_test, "--exclude="))
                                                        if (strlen(exclude_csv) == 0):
                                                            exclude_csv = ex
                                                        else:
                                                            exclude_csv = exclude_csv + "," + ex
                                                    else:
                                                        if (arg_test == "--exclude"):
                                                            if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                                                let ex2 = _trim(env.get(i_test + 1))
                                                                if (strlen(exclude_csv) == 0):
                                                                    exclude_csv = ex2
                                                                else:
                                                                    exclude_csv = exclude_csv + "," + ex2
                                                                i_test = i_test + 1
                                                            else:
                                                                print("ERROR: --exclude requires a value.")
                                                                return 1
                                                        else:
                                                            if (_starts_with(arg_test, "--exclude-package=") == 1):
                                                                let ex_pkg = _trim(_value_after_prefix(arg_test, "--exclude-package="))
                                                                if (strlen(exclude_package_csv) == 0):
                                                                    exclude_package_csv = ex_pkg
                                                                else:
                                                                    exclude_package_csv = exclude_package_csv + "," + ex_pkg
                                                            else:
                                                                if (arg_test == "--exclude-package"):
                                                                    if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                                                        let ex_pkg2 = _trim(env.get(i_test + 1))
                                                                        if (strlen(exclude_package_csv) == 0):
                                                                            exclude_package_csv = ex_pkg2
                                                                        else:
                                                                            exclude_package_csv = exclude_package_csv + "," + ex_pkg2
                                                                        i_test = i_test + 1
                                                                    else:
                                                                        print("ERROR: --exclude-package requires a value.")
                                                                        return 1
                                                                else:
                                                                    if (_starts_with(arg_test, "--") == 1):
                                                                        print("ERROR: unknown test flag: " + arg_test)
                                                                        return 1
                                                                    else:
                                                                        if (strlen(filter) == 0):
                                                                            filter = arg_test
                                                                        else:
                                                                            print("ERROR: multiple test filters are not supported: " + arg_test)
                                                                            return 1
            i_test = i_test + 1
        let exclude_set = _csv_to_set(exclude_csv)
        let package_set = _csv_to_set(package_csv)
        let exclude_package_set = _csv_to_set(exclude_package_csv)
        return _run_tests(filter, workspace, no_run, fail_fast, as_json, list_only, exclude_set, package_set, exclude_package_set)
    if ((cmd == "install") and (argc > 2)):
        if (_trim(env.get(2)) == "toolchain"):
            return _install_toolchain()
    let emit_only = 0
    let autofix_mode = "off"
    let autofix_lock = ""
    let autofix_lock_strict = 0
    let autofix_lock_locked = 0
    let autofix_max_iterations = 3
    let autofix_max_files = 10
    let autofix_workspace = 0
    let autofix_exclude_csv = ""
    let input_path = ""
    let out_path = ""
    let i = 1
    if (cmd == "--emit-llvm-internal"):
        if (argc <= 2):
            print("ERROR: missing input path.")
            return 1
        input_path = _trim(env.get(2))
        emit_only = 1
        i = 3
    else:
        if ((cmd == "build") or (cmd == "--build")):
            if (argc <= 2):
                print("ERROR: missing input path.")
                return 1
            input_path = _trim(env.get(2))
            i = 3
        else:
            input_path = cmd
            i = 2
    while (i < argc):
        let arg = _trim(env.get(i))
        if (arg == "--emit-llvm"):
            emit_only = 1
        else:
            if (_starts_with(arg, "--autofix=") == 1):
                autofix_mode = _value_after_prefix(arg, "--autofix=")
            else:
                if (arg == "--autofix"):
                    if (((i + 1) < argc) and (_starts_with(_trim(env.get(i + 1)), "--") == 0)):
                        autofix_mode = _trim(env.get(i + 1))
                        i = i + 1
                    else:
                        autofix_mode = "safe"
                else:
                    if (_starts_with(arg, "--autofix-lock=") == 1):
                        autofix_lock = _trim(_value_after_prefix(arg, "--autofix-lock="))
                    else:
                        if ((arg == "--autofix-lock") and ((i + 1) < argc) and (_starts_with(_trim(env.get(i + 1)), "--") == 0)):
                            autofix_lock = _trim(env.get(i + 1))
                            i = i + 1
                        else:
                            if (arg == "--autofix-lock"):
                                autofix_lock = "thagore.fix.lock"
                            else:
                                if (arg == "--autofix-lock-strict"):
                                    autofix_lock_strict = 1
                                else:
                                    if (arg == "--autofix-locked"):
                                        autofix_lock_locked = 1
                                    else:
                                        if (_starts_with(arg, "--autofix-max-iterations=") == 1):
                                            autofix_max_iterations = _parse_i32_default(_value_after_prefix(arg, "--autofix-max-iterations="), autofix_max_iterations)
                                        else:
                                            if ((arg == "--autofix-max-iterations") and ((i + 1) < argc)):
                                                autofix_max_iterations = _parse_i32_default(_trim(env.get(i + 1)), autofix_max_iterations)
                                                i = i + 1
                                            else:
                                                if (_starts_with(arg, "--autofix-max-files=") == 1):
                                                    autofix_max_files = _parse_i32_default(_value_after_prefix(arg, "--autofix-max-files="), autofix_max_files)
                                                else:
                                                    if ((arg == "--autofix-max-files") and ((i + 1) < argc)):
                                                        autofix_max_files = _parse_i32_default(_trim(env.get(i + 1)), autofix_max_files)
                                                        i = i + 1
                                                    else:
                                                        if (_starts_with(arg, "--autofix-exclude=") == 1):
                                                            autofix_exclude_csv = _trim(_value_after_prefix(arg, "--autofix-exclude="))
                                                        else:
                                                            if ((arg == "--autofix-exclude") and ((i + 1) < argc)):
                                                                autofix_exclude_csv = _trim(env.get(i + 1))
                                                                i = i + 1
                                                            else:
                                                                if (arg == "--autofix-workspace"):
                                                                    autofix_workspace = 1
                                                                else:
                                                                    if ((arg == "-o") and ((i + 1) < argc)):
                                                                        out_path = _trim(env.get(i + 1))
                                                                        i = i + 1
        i = i + 1
    if (out_path.length() == 0):
        out_path = _default_output(input_path)
    let autofix_exclude_set = _csv_to_set(autofix_exclude_csv)
    return _build(input_path, out_path, emit_only, autofix_mode, autofix_lock, autofix_lock_strict, autofix_lock_locked, autofix_max_iterations, autofix_max_files, autofix_workspace, autofix_exclude_set)
