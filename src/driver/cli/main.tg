        if (rc_build != 0):
            return rc_build
        let run_cmd = run_out
        if (fs.exists(run_cmd) == 0):
            if (fs.exists(run_cmd + ".exe") == 1):
                run_cmd = run_cmd + ".exe"
        if (fs.exists(run_cmd) == 0):
            print("ERROR: built artifact not found: " + run_out)
            return 1
        if ((_starts_with(run_cmd, "./") == 0) and (_starts_with(run_cmd, "/") == 0) and (_contains(run_cmd, ":") == 0)):
            run_cmd = "./" + run_cmd
        return process.run(run_cmd)
    let emit_only = 0
    let autofix_mode = "off"
