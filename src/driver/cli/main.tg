    let autofix_lock_strict = 0
    let autofix_lock_locked = 0
    let autofix_max_iterations = 3
    let autofix_max_files = 10
    let autofix_workspace = 0
    let autofix_exclude_csv = ""
    let flow_mode_build = "off"
    let flow_strip_debug = 0
    let state_mode_build = "off"
    let intent_mode_build = ""
    let intent_policy_build = ""
    let intent_fallback_build = ""
    let intent_lock_path_build = ""
    let intent_strict_lock_build = -1
