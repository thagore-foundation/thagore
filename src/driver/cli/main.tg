import "src/driver/cli/common/core.tg"
import "src/driver/cli/fix/flow.tg"
import "src/driver/cli/test/flow.tg"
import "src/driver/cli/build/flow.tg"
import "src/driver/cli/install/flow.tg"
import "src/driver/cli/update/flow.tg"
import "src/driver/cli/update/platform.tg"
import "src/driver/cli/update/version.tg"
import "src/driver/flow/engine.tg" as flowctl
import "src/driver/intent/engine.tg" as intentctl
import "src/driver/state/engine.tg" as statectl

func _print_help() -> void:
    let cli = _update_cli_command_name()
    print(cli + " " + _update_current_version_text())
    print("Usage:")
    print("  " + cli + " --help")
    print("  " + cli + " --version")
    print("  " + cli + " build <input.tg> [-o output] [--target <triple>]")
    print("  " + cli + " run <input.tg> [-o output]")
    print("  " + cli + " <input.tg> [-o output]")
    print("  " + cli + " test [filter] [--workspace|--all] [--json]")
    print("  " + cli + " fix <doctor|dry-run|apply|explain|rollback> ...")
    print("  " + cli + " intent <doctor|explain|lock> <entry.tg> [flags]")
    print("  " + cli + " state <doctor|explain> <entry.tg> [--mode off|on|strict] [--json] [-o report.json]")
    print("  " + cli + " install toolchain [--yes]")
    print("  " + cli + " update <check|apply|rollback> [flags]")

func _helper_exec_path(candidate_raw: String) -> String:
    let candidate = _normalize_path(_trim(candidate_raw))
    if (strlen(candidate) == 0):
        return ""
    if ((_contains(candidate, "/") == 1) or (_contains(candidate, ":") == 1)):
        return candidate
    let cwd = _normalize_path(_trim(env.cwd()))
    if (strlen(cwd) > 0):
        return cwd + "/" + candidate
    return "./" + candidate

func _helper_path_from_dir(dir_raw: String, helper_name: String) -> String:
    if (strlen(helper_name) == 0):
        return ""
    let dir_norm = _normalize_path(_trim(dir_raw))
    if (strlen(dir_norm) == 0):
        dir_norm = "."
    let candidate = dir_norm
    if ((_ends_with(dir_norm, "/") == 0) and (_ends_with(dir_norm, "\\") == 0)):
        candidate = dir_norm + "/" + helper_name
    else:
        candidate = dir_norm + helper_name
    let target = _normalize_path(candidate)
    if (fs.exists(target) == 1):
        return target
    return ""

func _find_helper_in_path(candidate_raw: String) -> String:
    let candidate = _trim(candidate_raw)
    if (strlen(candidate) == 0):
        return ""
    if ((_contains(candidate, "/") == 1) or (_contains(candidate, "\\") == 1) or (_contains(candidate, ":") == 1)):
        return ""
    let delim = (if (_update_detect_os() == "windows") then ";" else ":")
    let path_list = env.get_var("PATH")
    let segment = ""
    let i = 0
    while (i < strlen(path_list)):
        let ch = _char_at(path_list, i)
        if (ch == delim):
            let found = _helper_path_from_dir(segment, candidate)
            if (strlen(found) > 0):
                return found
            segment = ""
        else:
            segment = segment + ch
        i = i + 1
    let final = _helper_path_from_dir(segment, candidate)
    if (strlen(final) > 0):
        return final
    return ""

func _configure_default_helper_bin() -> void:
    let configured = _trim(env.get_var("THAG_HELPER_BIN"))
    if (strlen(configured) > 0):
        let normalized = _helper_exec_path(configured)
        if (fs.exists(normalized) == 1):
            env.set_var("THAG_HELPER_BIN", normalized)
            return
        let from_path = _find_helper_in_path(configured)
        if (strlen(from_path) > 0):
            env.set_var("THAG_HELPER_BIN", from_path)
            return
        return
    let exe_path = _normalize_path(_trim(env.program_name()))
    if (strlen(exe_path) == 0):
        return
    let stage1_name = "stage1"
    if (_update_detect_os() == "windows"):
        stage1_name = "stage1.exe"
    let exe_dir = _dir_name(exe_path)
    let direct = _normalize_path(exe_dir + "/" + stage1_name)
    if (fs.exists(direct) == 1):
        env.set_var("THAG_HELPER_BIN", _helper_exec_path(direct))
        return
    let parent = _dir_name(exe_dir)
    let under_bin = _normalize_path(parent + "/bin/" + stage1_name)
    if (fs.exists(under_bin) == 1):
        env.set_var("THAG_HELPER_BIN", _helper_exec_path(under_bin))
        return
    if (fs.exists(exe_path) == 1):
        env.set_var("THAG_HELPER_BIN", _helper_exec_path(exe_path))
        return

func main() -> i32:
    let argc = env.count()
    _configure_default_helper_bin()
    if (argc <= 1):
        _print_help()
        return 0
    let cmd = _trim(env.get(1))
    if ((cmd == "--help") or (cmd == "help")):
        _print_help()
        return 0
    if ((cmd == "--version") or (cmd == "version")):
        print(_update_cli_command_name() + " " + _update_current_version_text())
        return 0
    _update_auto_notify_if_needed(cmd)
    if (cmd == "flow"):
        if (argc <= 2):
            print("ERROR: missing flow subcommand.")
            return 1
        let sub_flow = _trim(env.get(2))
        let entry_flow = ""
        let flow_mode = "on"
        let flow_durability = ""
        let flow_journal_format = "compact"
        let flow_json = 0
        let flow_fail_at = ""
        let flow_fail_once_at = ""
        let flow_timeout_at = ""
        let flow_crash_after_fail = 0
        let i_flow = 3
        while (i_flow < argc):
            let arg_flow = _trim(env.get(i_flow))
            if (_starts_with(arg_flow, "--mode=") == 1):
                flow_mode = flowctl.normalize_flow_mode(_value_after_prefix(arg_flow, "--mode="))
            else:
                if ((arg_flow == "--mode") and ((i_flow + 1) < argc) and (_starts_with(_trim(env.get(i_flow + 1)), "--") == 0)):
                    flow_mode = flowctl.normalize_flow_mode(_trim(env.get(i_flow + 1)))
                    i_flow = i_flow + 1
                else:
                    if (_starts_with(arg_flow, "--durability=") == 1):
                        flow_durability = flowctl.normalize_flow_durability(_value_after_prefix(arg_flow, "--durability="))
                    else:
                        if ((arg_flow == "--durability") and ((i_flow + 1) < argc) and (_starts_with(_trim(env.get(i_flow + 1)), "--") == 0)):
                            flow_durability = flowctl.normalize_flow_durability(_trim(env.get(i_flow + 1)))
                            i_flow = i_flow + 1
                        else:
                            if (_starts_with(arg_flow, "--journal-format=") == 1):
                                flow_journal_format = flowctl.normalize_flow_journal_format(_value_after_prefix(arg_flow, "--journal-format="))
                            else:
                                if ((arg_flow == "--journal-format") and ((i_flow + 1) < argc) and (_starts_with(_trim(env.get(i_flow + 1)), "--") == 0)):
                                    flow_journal_format = flowctl.normalize_flow_journal_format(_trim(env.get(i_flow + 1)))
                                    i_flow = i_flow + 1
                                else:
                                    if (arg_flow == "--json"):
                                        flow_json = 1
                                    else:
                                        if (_starts_with(arg_flow, "--fail-at=") == 1):
                                            flow_fail_at = _trim(_value_after_prefix(arg_flow, "--fail-at="))
                                        else:
                                            if ((arg_flow == "--fail-at") and ((i_flow + 1) < argc) and (_starts_with(_trim(env.get(i_flow + 1)), "--") == 0)):
                                                flow_fail_at = _trim(env.get(i_flow + 1))
                                                i_flow = i_flow + 1
                                            else:
                                                if (_starts_with(arg_flow, "--fail-once-at=") == 1):
                                                    flow_fail_once_at = _trim(_value_after_prefix(arg_flow, "--fail-once-at="))
                                                else:
                                                    if ((arg_flow == "--fail-once-at") and ((i_flow + 1) < argc) and (_starts_with(_trim(env.get(i_flow + 1)), "--") == 0)):
                                                        flow_fail_once_at = _trim(env.get(i_flow + 1))
                                                        i_flow = i_flow + 1
                                                    else:
                                                        if (_starts_with(arg_flow, "--timeout-at=") == 1):
                                                            flow_timeout_at = _trim(_value_after_prefix(arg_flow, "--timeout-at="))
                                                        else:
                                                            if ((arg_flow == "--timeout-at") and ((i_flow + 1) < argc) and (_starts_with(_trim(env.get(i_flow + 1)), "--") == 0)):
                                                                flow_timeout_at = _trim(env.get(i_flow + 1))
                                                                i_flow = i_flow + 1
                                                            else:
                                                                if (arg_flow == "--crash-after-fail"):
                                                                    flow_crash_after_fail = 1
                                                                else:
                                                                    if (_starts_with(arg_flow, "--") == 1):
                                                                        print("ERROR: unknown flow flag: " + arg_flow)
                                                                        return 1
                                                                    else:
                                                                        if (strlen(entry_flow) == 0):
                                                                            entry_flow = arg_flow
                                                                        else:
                                                                            print("ERROR: multiple flow entry paths are not supported: " + arg_flow)
                                                                            return 1
            i_flow = i_flow + 1
        if (sub_flow == "recover"):
            if (strlen(entry_flow) == 0):
                entry_flow = flowctl.latest_flow_session_id()
            if (strlen(entry_flow) == 0):
                print("ERROR: missing flow session id for recover (and no latest session found).")
                return 1
            return flowctl.run_flow_recover(entry_flow, flow_json)
        if (strlen(entry_flow) == 0):
            print("ERROR: missing entry path for flow command.")
            return 1
        if (sub_flow == "doctor"):
            return flowctl.run_flow_doctor(entry_flow, flow_mode, flow_json)
        if (sub_flow == "explain"):
            return flowctl.run_flow_explain(entry_flow, flow_mode, flow_json)
        if (sub_flow == "simulate"):
            return flowctl.run_flow_simulate_with_policy_full(entry_flow, flow_mode, flow_fail_at, flow_fail_once_at, flow_timeout_at, flow_json, flow_crash_after_fail, flow_durability, flow_journal_format)
        print("ERROR: unknown flow subcommand: " + sub_flow)
        return 1
    if (cmd == "intent"):
        if (argc <= 2):
            print("ERROR: missing intent subcommand.")
            return 1
        let sub_intent = _trim(env.get(2))
        let entry_intent = ""
        let intent_mode = "min"
        let intent_json = 0
        let intent_lock_out = "thagore.intent.lock"
        let i_intent = 3
        while (i_intent < argc):
            let arg_intent = _trim(env.get(i_intent))
            if (_starts_with(arg_intent, "--mode=") == 1):
                intent_mode = intentctl.normalize_intent_mode(_value_after_prefix(arg_intent, "--mode="))
            else:
                if ((arg_intent == "--mode") and ((i_intent + 1) < argc) and (_starts_with(_trim(env.get(i_intent + 1)), "--") == 0)):
                    intent_mode = intentctl.normalize_intent_mode(_trim(env.get(i_intent + 1)))
                    i_intent = i_intent + 1
                else:
                    if (arg_intent == "--json"):
                        intent_json = 1
                    else:
                        if (_starts_with(arg_intent, "-o=") == 1):
                            intent_lock_out = _trim(_value_after_prefix(arg_intent, "-o="))
                        else:
                            if (_starts_with(arg_intent, "--output=") == 1):
                                intent_lock_out = _trim(_value_after_prefix(arg_intent, "--output="))
                            else:
                                if (((arg_intent == "-o") or (arg_intent == "--output")) and ((i_intent + 1) < argc) and (_starts_with(_trim(env.get(i_intent + 1)), "--") == 0)):
                                    intent_lock_out = _trim(env.get(i_intent + 1))
                                    i_intent = i_intent + 1
                                else:
                                    if (_starts_with(arg_intent, "--") == 1):
                                        print("ERROR: unknown intent flag: " + arg_intent)
                                        return 1
                                    else:
                                        if (strlen(entry_intent) == 0):
                                            entry_intent = arg_intent
                                        else:
                                            print("ERROR: multiple intent entry paths are not supported: " + arg_intent)
                                            return 1
            i_intent = i_intent + 1
        if (strlen(entry_intent) == 0):
            print("ERROR: missing entry path for intent command.")
            return 1
        if (sub_intent == "doctor"):
            return intentctl.run_intent_doctor(entry_intent, intent_mode, intent_json)
        if (sub_intent == "explain"):
            return intentctl.run_intent_explain(entry_intent, intent_mode, intent_json)
        if (sub_intent == "lock"):
            return intentctl.run_intent_lock(entry_intent, intent_lock_out, intent_mode)
        print("ERROR: unknown intent subcommand: " + sub_intent)
        return 1
    if (cmd == "state"):
        if (argc <= 2):
            print("ERROR: missing state subcommand.")
            return 1
        let sub_state = _trim(env.get(2))
        let entry_state = ""
        let state_mode = "on"
        let state_json = 0
        let state_out = ""
        let i_state = 3
        while (i_state < argc):
            let arg_state = _trim(env.get(i_state))
            if (_starts_with(arg_state, "--mode=") == 1):
                state_mode = statectl.normalize_state_mode(_value_after_prefix(arg_state, "--mode="))
            else:
                if ((arg_state == "--mode") and ((i_state + 1) < argc) and (_starts_with(_trim(env.get(i_state + 1)), "--") == 0)):
                    state_mode = statectl.normalize_state_mode(_trim(env.get(i_state + 1)))
                    i_state = i_state + 1
                else:
                    if (arg_state == "--json"):
                        state_json = 1
                    else:
                        if (_starts_with(arg_state, "-o=") == 1):
                            state_out = _trim(_value_after_prefix(arg_state, "-o="))
                        else:
                            if (_starts_with(arg_state, "--out=") == 1):
                                state_out = _trim(_value_after_prefix(arg_state, "--out="))
                            else:
                                if (_starts_with(arg_state, "--output=") == 1):
                                    state_out = _trim(_value_after_prefix(arg_state, "--output="))
                                else:
                                    if (((arg_state == "-o") or (arg_state == "--out") or (arg_state == "--output")) and ((i_state + 1) < argc) and (_starts_with(_trim(env.get(i_state + 1)), "--") == 0)):
                                        state_out = _trim(env.get(i_state + 1))
                                        i_state = i_state + 1
                                    else:
                                        if (_starts_with(arg_state, "--") == 1):
                                            print("ERROR: unknown state flag: " + arg_state)
                                            return 1
                                        else:
                                            if (strlen(entry_state) == 0):
                                                entry_state = arg_state
                                            else:
                                                print("ERROR: multiple state entry paths are not supported: " + arg_state)
                                                return 1
            i_state = i_state + 1
        if (strlen(entry_state) == 0):
            print("ERROR: missing entry path for state command.")
            return 1
        if (sub_state == "doctor"):
            return statectl.run_state_doctor(entry_state, state_mode, state_json)
        if (sub_state == "explain"):
            return statectl.run_state_explain_to(entry_state, state_mode, state_json, state_out)
        print("ERROR: unknown state subcommand: " + sub_state)
        return 1
    if (cmd == "fix"):
        if (argc <= 2):
            print("ERROR: missing fix subcommand.")
            return 1
        let sub = _trim(env.get(2))
        if (sub == "rollback"):
            if (argc <= 3):
                print("ERROR: missing fix session id.")
                return 1
            return autofix.run_fix_rollback(_trim(env.get(3)))
        let entry = ""
        let level = "safe"
        let as_json = 0
        let lock_path = ""
        let lock_strict = 0
        let lock_locked = 0
        let workspace = 0
        let exclude_csv = ""
        let max_files = 25
        let max_iterations = 3
        let fix_message_json = 0
        let i_fix = 3
        while (i_fix < argc):
            let arg_fix = _trim(env.get(i_fix))
            if (_starts_with(arg_fix, "--level=") == 1):
                level = _fix_level(_value_after_prefix(arg_fix, "--level="))
            else:
                if ((arg_fix == "--level") and ((i_fix + 1) < argc)):
                    level = _fix_level(_trim(env.get(i_fix + 1)))
                    i_fix = i_fix + 1
                else:
                    if (_starts_with(arg_fix, "--lock=") == 1):
                        lock_path = _trim(_value_after_prefix(arg_fix, "--lock="))
                    else:
                        if ((arg_fix == "--lock") and ((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                            lock_path = _trim(env.get(i_fix + 1))
                            i_fix = i_fix + 1
                        else:
                            if (arg_fix == "--lock"):
                                lock_path = "thagore.fix.lock"
                            else:
                                if (arg_fix == "--lock-strict"):
                                    lock_strict = 1
                                else:
                                    if (arg_fix == "--locked"):
                                        lock_locked = 1
                                    else:
                                        if ((arg_fix == "--workspace") or (arg_fix == "--all")):
                                            workspace = 1
                                        else:
                                            if (_starts_with(arg_fix, "--exclude=") == 1):
                                                let ex = _trim(_value_after_prefix(arg_fix, "--exclude="))
                                                if (strlen(exclude_csv) == 0):
                                                    exclude_csv = ex
                                                else:
                                                    exclude_csv = exclude_csv + "," + ex
                                            else:
                                                if (arg_fix == "--exclude"):
                                                    if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                        let ex2 = _trim(env.get(i_fix + 1))
                                                        if (strlen(exclude_csv) == 0):
                                                            exclude_csv = ex2
                                                        else:
                                                            exclude_csv = exclude_csv + "," + ex2
                                                        i_fix = i_fix + 1
                                                    else:
                                                        print("ERROR: --exclude requires a value.")
                                                        return 1
                                                else:
                                                    if (_starts_with(arg_fix, "--max-files=") == 1):
                                                        max_files = _parse_i32_default(_value_after_prefix(arg_fix, "--max-files="), max_files)
                                                    else:
                                                        if (arg_fix == "--max-files"):
                                                            if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                max_files = _parse_i32_default(_trim(env.get(i_fix + 1)), max_files)
                                                                i_fix = i_fix + 1
                                                            else:
                                                                print("ERROR: --max-files requires a value.")
                                                                return 1
                                                        else:
                                                            if (_starts_with(arg_fix, "--max-iterations=") == 1):
                                                                max_iterations = _parse_i32_default(_value_after_prefix(arg_fix, "--max-iterations="), max_iterations)
                                                            else:
                                                                if (arg_fix == "--max-iterations"):
                                                                    if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                        max_iterations = _parse_i32_default(_trim(env.get(i_fix + 1)), max_iterations)
                                                                        i_fix = i_fix + 1
                                                                    else:
                                                                        print("ERROR: --max-iterations requires a value.")
                                                                        return 1
                                                                else:
                                                                    if (arg_fix == "--json"):
                                                                        as_json = 1
                                                                    else:
                                                                        if (_starts_with(arg_fix, "--message-format=") == 1):
                                                                            let fmt_fix = _trim(_value_after_prefix(arg_fix, "--message-format="))
                                                                            let mode_fix = _test_message_format_mode(fmt_fix)
                                                                            if (mode_fix < 0):
                                                                                print("ERROR: unsupported --message-format: " + fmt_fix)
                                                                                return 1
                                                                            fix_message_json = mode_fix
                                                                        else:
                                                                            if (arg_fix == "--message-format"):
                                                                                if (((i_fix + 1) < argc) and (_starts_with(_trim(env.get(i_fix + 1)), "--") == 0)):
                                                                                    let fmt_fix2 = _trim(env.get(i_fix + 1))
                                                                                    let mode_fix2 = _test_message_format_mode(fmt_fix2)
                                                                                    if (mode_fix2 < 0):
                                                                                        print("ERROR: unsupported --message-format: " + fmt_fix2)
                                                                                        return 1
                                                                                    fix_message_json = mode_fix2
                                                                                    i_fix = i_fix + 1
                                                                                else:
                                                                                    print("ERROR: --message-format requires a value (json|human).")
                                                                                    return 1
                                                                            else:
                                                                                if (_starts_with(arg_fix, "--") == 1):
                                                                                    print("ERROR: unknown fix flag: " + arg_fix)
                                                                                    return 1
                                                                                else:
                                                                                    if (strlen(entry) == 0):
                                                                                        entry = arg_fix
                                                                                    else:
                                                                                        print("ERROR: multiple fix entry paths are not supported: " + arg_fix)
                                                                                        return 1
            i_fix = i_fix + 1
        if (strlen(entry) == 0):
            print("ERROR: missing entry path for fix command.")
            return 1
        if (max_files < 1):
            max_files = 1
        if (max_iterations < 1):
            max_iterations = 1
        let exclude_set = _csv_to_set(exclude_csv)
        if ((sub == "doctor") or (sub == "dry-run") or (sub == "apply") or (sub == "explain")):
            return _run_fix_multi(sub, entry, level, as_json, lock_path, lock_strict, lock_locked, workspace, exclude_set, max_files, max_iterations, fix_message_json)
        print("ERROR: unknown fix subcommand: " + sub)
        return 1
    if (cmd == "test"):
        let filter = ""
        let workspace = 0
        let no_run = 0
        let fail_fast = 0
        let as_json = 0
        let list_only = 0
        let exclude_csv = ""
        let package_csv = ""
        let exclude_package_csv = ""
        let i_test = 2
        while (i_test < argc):
            let arg_test = _trim(env.get(i_test))
            if ((arg_test == "--help") or (arg_test == "-h")):
                _print_help()
                return 0
            else:
                if ((arg_test == "--workspace") or (arg_test == "--all")):
                    workspace = 1
                else:
                    if (arg_test == "--no-run"):
                        no_run = 1
                    else:
                        if (arg_test == "--fail-fast"):
                            fail_fast = 1
                        else:
                            if (arg_test == "--json"):
                                as_json = 1
                            else:
                                if (_starts_with(arg_test, "--message-format=") == 1):
                                    let fmt = _trim(_value_after_prefix(arg_test, "--message-format="))
                                    let mode = _test_message_format_mode(fmt)
                                    if (mode < 0):
                                        print("ERROR: unsupported --message-format: " + fmt)
                                        return 1
                                    as_json = mode
                                else:
                                    if (arg_test == "--message-format"):
                                        if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                            let fmt2 = _trim(env.get(i_test + 1))
                                            let mode2 = _test_message_format_mode(fmt2)
                                            if (mode2 < 0):
                                                print("ERROR: unsupported --message-format: " + fmt2)
                                                return 1
                                            as_json = mode2
                                            i_test = i_test + 1
                                        else:
                                            print("ERROR: --message-format requires a value (json|human).")
                                            return 1
                                    else:
                                        if (arg_test == "--list"):
                                            list_only = 1
                                        else:
                                            if (_starts_with(arg_test, "--package=") == 1):
                                                let pkg_eq = _trim(_value_after_prefix(arg_test, "--package="))
                                                if (strlen(pkg_eq) == 0):
                                                    print("ERROR: --package requires a package name.")
                                                    return 1
                                                if (strlen(package_csv) == 0):
                                                    package_csv = pkg_eq
                                                else:
                                                    package_csv = package_csv + "," + pkg_eq
                                            else:
                                                if ((arg_test == "--package") or (arg_test == "-p")):
                                                    if (((i_test + 1) < argc) and (_starts_with(_trim(env.get(i_test + 1)), "--") == 0)):
                                                        let pkg_next = _trim(env.get(i_test + 1))
                                                        if (strlen(pkg_next) == 0):
                                                            print("ERROR: --package requires a package name.")
                                                            return 1
                                                        if (strlen(package_csv) == 0):
                                                            package_csv = pkg_next
                                                        else:
