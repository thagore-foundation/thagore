import "src/driver/cli/common/core.tg"
import "src/driver/cli/install/platform.tg"
import "lib/path.tg" as path

func _update_detect_os() -> String:
    let raw = _install_detect_os()
    if (raw == "ubuntu"):
        return "linux"
    if (raw == "windows"):
        return "windows"
    if (raw == "macos"):
        return "macos"
    if (raw == "linux"):
        return "linux"
    return "portable"

func _update_detect_arch() -> String:
    let raw = _install_detect_arch()
    if (raw == "x86_64"):
        return "x86_64"
    if (raw == "arm64"):
        return "arm64"
    return "unknown"

func _update_cli_command_name() -> String:
    if (_update_detect_os() == "windows"):
        return "thagore.exe"
    return "thagore"

func _update_platform_supported(os_name: String, arch: String) -> i32:
    if ((os_name != "windows") and (os_name != "linux") and (os_name != "macos")):
        return 0
    if (arch == "unknown"):
        return 0
    return 1

func _update_windows_is_admin() -> i32:
    if (_update_detect_os() != "windows"):
        return 0
    if (process.run("net session >nul 2>&1") == 0):
        return 1
    return 0

func _update_windows_needs_admin(exe_path: String) -> i32:
    if (_update_detect_os() != "windows"):
        return 0
    let norm = _normalize_path(exe_path)
    if (_contains(norm, "/Program Files/") == 1):
        return 1
    if (_contains(norm, "/Program Files (x86)/") == 1):
        return 1
    return 0

func _update_target_binary_name(os_name: String) -> String:
    if (os_name == "windows"):
        return "thagore.exe"
    return "thagore"

func _update_executable_path() -> String:
    let os_name = _update_detect_os()
    let target_name = _update_target_binary_name(os_name)
    let probe = "thagore_update_where.log"
    if (os_name == "windows"):
        if (process.run("where thagore.exe > " + probe + " 2>&1") == 0):
            let line = _trim(_line_at(fs.read_text(probe), 0))
            if (strlen(line) > 0):
                return _normalize_path(line)
    else:
        if (process.run("which thagore > " + probe + " 2>&1") == 0):
            let line2 = _trim(_line_at(fs.read_text(probe), 0))
            if (strlen(line2) > 0):
                return _normalize_path(line2)
    let argv0 = _trim(env.program_name())
    if (strlen(argv0) == 0):
        return ""
    let norm = _normalize_path(argv0)
    if ((_contains(norm, "/") == 1) or (_contains(norm, ":") == 1)):
        let base_dir = _normalize_path(path.dirname(norm))
        let candidate = _normalize_path(path.join(base_dir, target_name))
        if (fs.exists(candidate) == 1):
            return candidate
        if (fs.exists(norm) == 1):
            return norm
        return candidate
    let from_cwd = _normalize_path(path.join(env.cwd(), norm))
    let from_cwd_target = _normalize_path(path.join(_normalize_path(path.dirname(from_cwd)), target_name))
    if (fs.exists(from_cwd_target) == 1):
        return from_cwd_target
    if (fs.exists(from_cwd) == 1):
        return from_cwd
    return from_cwd_target

func _update_asset_matches(name_raw: String, os_name: String, arch: String) -> i32:
    let name = _trim(name_raw)
    if (_contains(name, "stage1") == 1):
        return 0
    if (_contains(name, "runtime") == 1):
        return 0
    if ((os_name == "windows") and (_contains(name, "windows") == 0)):
        return 0
    if ((os_name == "linux") and (_contains(name, "linux") == 0)):
        return 0
    if ((os_name == "macos") and (_contains(name, "macos") == 0)):
        return 0
    if ((arch == "x86_64") and (_contains(name, "x86_64") == 0) and (_contains(name, "amd64") == 0)):
        return 0
    if ((arch == "arm64") and (_contains(name, "arm64") == 0) and (_contains(name, "aarch64") == 0)):
        return 0
    if (_ends_with(name, ".tar.gz") == 1):
        return 3
    if (_ends_with(name, ".zip") == 1):
        return 2
    if (_ends_with(name, ".exe") == 1):
        return 1
    return 0

func _update_asset_binary_path(extract_dir: String, os_name: String) -> String:
    let c1 = path.join(extract_dir, "bin/thagore")
    if (os_name == "windows"):
        c1 = path.join(extract_dir, "bin/thagore.exe")
    if (fs.exists(c1) == 1):
        return c1
    let c2 = path.join(extract_dir, "thagore")
    if (os_name == "windows"):
        c2 = path.join(extract_dir, "thagore.exe")
    if (fs.exists(c2) == 1):
        return c2
    return ""
