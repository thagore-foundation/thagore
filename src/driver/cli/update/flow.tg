import "src/driver/cli/common/core.tg"
import "src/driver/cli/update/platform.tg"
import "src/driver/cli/update/source.tg"
import "src/driver/cli/update/state.tg"
import "src/driver/cli/update/version.tg"
import "lib/io.tg" as io
import "lib/path.tg" as path

func _update_print_help() -> void:
    let cli = _update_cli_command_name()
    print(cli + " update")
    print("Usage:")
    print("  " + cli + " update check")
    print("  " + cli + " update apply [--yes] [--dry-run]")
    print("  " + cli + " update rollback [--yes]")

func _update_extract_archive(archive_path: String, out_dir: String) -> i32:
    if (_ends_with(archive_path, ".zip") == 1):
        return process.unzip(archive_path, out_dir)
    if (_ends_with(archive_path, ".tar.gz") == 1):
        let cmd = "tar -xzf " + _quote(archive_path) + " -C " + _quote(out_dir)
        return process.run(cmd)
    return 1

func _update_confirm(yes: i32, text: String) -> i32:
    if (yes == 1):
        return 1
    let answer = _trim(io.input_prompt(text + " [Y/n]: "))
    if ((strlen(answer) == 0) or (answer == "y") or (answer == "Y") or (answer == "yes") or (answer == "YES")):
        return 1
    return 0

func _update_apply(argc: i32, start: i32) -> i32:
    let yes = 0
    let dry_run = 0
    let elevated = 0
    let i = start
    while (i < argc):
        let arg = _trim(env.get(i))
        if ((arg == "--yes") or (arg == "-y")):
            yes = 1
        else:
            if (arg == "--dry-run"):
                dry_run = 1
            else:
                if (arg == "--elevated"):
                    elevated = 1
                else:
                    print("ERROR: unknown update apply flag: " + arg)
                    return 1
        i = i + 1
    let os_name = _update_detect_os()
    let arch = _update_detect_arch()
    if (_update_platform_supported(os_name, arch) == 0):
        print("ERROR: update is not supported on this platform (" + os_name + "/" + arch + ").")
        return 1
    let rel = _update_fetch_latest_foundation_release(os_name, arch)
    if (rel.ok == 0):
        print("ERROR: cannot fetch release metadata.")
        return 1
    if (_update_is_newer_than_current(rel.tag) <= 0):
        print("Already up to date (" + _update_current_version_text() + ").")
        return 0
    if (_update_confirm(yes, "Update to " + rel.tag + "?") == 0):
        print("Update aborted.")
        return 1
    let exe_path = _update_executable_path()
    if (strlen(exe_path) == 0):
        print("ERROR: cannot resolve current executable path.")
        return 1
    _update_ensure_dir()
    let archive_path = path.join(_update_state_dir(), "download.tmp")
    if (_ends_with(rel.asset_name, ".tar.gz") == 1):
        archive_path = path.join(_update_state_dir(), "download.tar.gz")
    else:
        if (_ends_with(rel.asset_name, ".zip") == 1):
            archive_path = path.join(_update_state_dir(), "download.zip")
    let extract_dir = path.join(_update_state_dir(), "extract")
    fs.mkdir(extract_dir)
    print("[update] release=" + rel.tag + " asset=" + rel.asset_name)
    if (dry_run == 1):
        print("[update] dry-run exe=" + exe_path)
        print("[update] dry-run url=" + rel.asset_url)
        return 0
    if (process.download(rel.asset_url, archive_path) != 0):
        print("ERROR: failed to download update asset.")
        return 1
    if (_update_extract_archive(archive_path, extract_dir) != 0):
        print("ERROR: failed to extract update archive.")
        return 1
    let new_bin = _update_asset_binary_path(extract_dir, os_name)
    if (strlen(new_bin) == 0):
        print("ERROR: extracted package missing compiler binary.")
        return 1
    let backup_path = _update_backup_file()
    if (_ends_with(exe_path, ".exe") == 1):
        backup_path = backup_path + ".exe"
    if (os_name == "windows"):
        if ((_update_windows_needs_admin(exe_path) == 1) and (_update_windows_is_admin() == 0)):
            if (elevated == 1):
                print("ERROR: update requires administrator privileges, but elevation was not granted.")
                return 1
            let ps_args = "-NoProfile" + process.argv_sep()
            ps_args = ps_args + "-ExecutionPolicy" + process.argv_sep()
            ps_args = ps_args + "Bypass" + process.argv_sep()
            ps_args = ps_args + "-Command" + process.argv_sep()
            let ps_script = "Start-Process -Verb RunAs -FilePath " + _quote(exe_path) + " -ArgumentList 'update','apply','--yes','--elevated'"
            ps_args = ps_args + ps_script
            if (process.exec("powershell", ps_args) != 0):
                print("ERROR: failed to relaunch updater with administrator privileges.")
                return 1
            print("[update] Relaunched elevated updater. Follow UAC prompt to continue.")
            return 0
        let staged_path = path.join(_update_state_dir(), "thagore.exe.next")
        let apply_script = path.join(_update_state_dir(), "apply-update.cmd")
        if (fs.exists(staged_path) == 1):
            fs.remove(staged_path)
        if (fs.exists(apply_script) == 1):
            fs.remove(apply_script)
        if (fs.move(new_bin, staged_path) != 1):
            print("ERROR: failed to stage updated binary for Windows.")
            return 1
        let script = "@echo off" + _nl()
        script = script + "setlocal" + _nl()
        script = script + "set SRC=" + _quote(staged_path) + _nl()
        script = script + "set DST=" + _quote(exe_path) + _nl()
        script = script + "set BAK=" + _quote(backup_path) + _nl()
        script = script + "for /l %%i in (1,1,20) do (" + _nl()
        script = script + "  move /y %DST% %BAK% >nul 2>&1 && goto moved_old" + _nl()
        script = script + "  timeout /t 1 /nobreak >nul" + _nl()
        script = script + ")" + _nl()
        script = script + "exit /b 1" + _nl()
        script = script + ":moved_old" + _nl()
        script = script + "for /l %%j in (1,1,20) do (" + _nl()
        script = script + "  move /y %SRC% %DST% >nul 2>&1 && goto done" + _nl()
        script = script + "  timeout /t 1 /nobreak >nul" + _nl()
        script = script + ")" + _nl()
        script = script + "move /y %BAK% %DST% >nul 2>&1" + _nl()
        script = script + "exit /b 1" + _nl()
        script = script + ":done" + _nl()
        script = script + "exit /b 0" + _nl()
        if (fs.write_text(apply_script, script) != 1):
            print("ERROR: failed to write Windows apply script: " + apply_script)
            return 1
        if (process.run("cmd /c start \"\" /min cmd /c " + _quote(apply_script)) != 0):
            print("ERROR: failed to launch Windows staged updater.")
            return 1
        fs.write_text(_update_backup_target_file(), exe_path)
        let now2 = time.now_ms()
        _update_write_state(now2, now2, rel.tag, rel.tag)
        print("Update scheduled: " + rel.tag)
        print("Close this shell and reopen to use updated binary.")
        return 0
    if (fs.exists(exe_path) == 1):
        if (fs.move(exe_path, backup_path) != 1):
            print("ERROR: failed to create backup: " + backup_path)
            return 1
    if (fs.move(new_bin, exe_path) != 1):
        if (fs.exists(backup_path) == 1):
            fs.move(backup_path, exe_path)
        print("ERROR: failed to place updated binary.")
        return 1
    fs.write_text(_update_backup_target_file(), exe_path)
    let now = time.now_ms()
    _update_write_state(now, now, rel.tag, rel.tag)
    print("Update completed: " + rel.tag)
    print("Restart shell to use new binary.")
    return 0

func _update_check() -> i32:
    let os_name = _update_detect_os()
    let arch = _update_detect_arch()
    if (_update_platform_supported(os_name, arch) == 0):
        print("ERROR: update is not supported on this platform (" + os_name + "/" + arch + ").")
        return 1
    let rel = _update_fetch_latest_foundation_release(os_name, arch)
    if (rel.ok == 0):
        print("ERROR: cannot fetch release metadata.")
        return 1
    if (_update_is_newer_than_current(rel.tag) > 0):
        print("Update available: " + rel.tag + " (current: " + _update_current_version_text() + ")")
        print("Run: " + _update_cli_command_name() + " update apply")
        return 0
    print("Already up to date (" + _update_current_version_text() + ").")
    return 0

func _update_rollback(argc: i32, start: i32) -> i32:
    let yes = 0
    let elevated = 0
    let i = start
    while (i < argc):
        let arg = _trim(env.get(i))
        if ((arg == "--yes") or (arg == "-y")):
            yes = 1
        else:
            if (arg == "--elevated"):
                elevated = 1
            else:
                print("ERROR: unknown update rollback flag: " + arg)
                return 1
        i = i + 1
    let exe_path = _trim(fs.read_text(_update_backup_target_file()))
    if (strlen(exe_path) == 0):
        exe_path = _update_executable_path()
    let backup_path = _update_backup_file()
    if (_ends_with(exe_path, ".exe") == 1):
        backup_path = backup_path + ".exe"
    if (fs.exists(backup_path) == 0):
        print("ERROR: no backup binary to rollback.")
        return 1
    if (_update_detect_os() == "windows"):
        if ((_update_windows_needs_admin(exe_path) == 1) and (_update_windows_is_admin() == 0)):
            if (elevated == 1):
                print("ERROR: rollback requires administrator privileges, but elevation was not granted.")
                return 1
            let ps_args2 = "-NoProfile" + process.argv_sep()
            ps_args2 = ps_args2 + "-ExecutionPolicy" + process.argv_sep()
            ps_args2 = ps_args2 + "Bypass" + process.argv_sep()
            ps_args2 = ps_args2 + "-Command" + process.argv_sep()
            let ps_script2 = "Start-Process -Verb RunAs -FilePath " + _quote(exe_path) + " -ArgumentList 'update','rollback','--yes','--elevated'"
            ps_args2 = ps_args2 + ps_script2
            if (process.exec("powershell", ps_args2) != 0):
                print("ERROR: failed to relaunch rollback with administrator privileges.")
                return 1
            print("[update] Relaunched elevated rollback. Follow UAC prompt to continue.")
            return 0
        let rollback_script = path.join(_update_state_dir(), "rollback-update.cmd")
        if (fs.exists(rollback_script) == 1):
            fs.remove(rollback_script)
        let rs = "@echo off" + _nl()
        rs = rs + "setlocal" + _nl()
        rs = rs + "set SRC=" + _quote(backup_path) + _nl()
        rs = rs + "set DST=" + _quote(exe_path) + _nl()
        rs = rs + "for /l %%i in (1,1,20) do (" + _nl()
        rs = rs + "  move /y %SRC% %DST% >nul 2>&1 && goto done" + _nl()
        rs = rs + "  timeout /t 1 /nobreak >nul" + _nl()
        rs = rs + ")" + _nl()
        rs = rs + "exit /b 1" + _nl()
        rs = rs + ":done" + _nl()
        rs = rs + "exit /b 0" + _nl()
        if (fs.write_text(rollback_script, rs) != 1):
            print("ERROR: failed to write Windows rollback script: " + rollback_script)
            return 1
        if (process.run("cmd /c start \"\" /min cmd /c " + _quote(rollback_script)) != 0):
            print("ERROR: failed to launch Windows staged rollback.")
            return 1
        print("Rollback scheduled.")
        print("Close this shell and reopen to use rolled-back binary.")
        return 0
    if (_update_confirm(yes, "Rollback current binary?") == 0):
        print("Rollback aborted.")
        return 1
    if (fs.exists(exe_path) == 1):
        fs.remove(exe_path)
    if (fs.move(backup_path, exe_path) != 1):
        print("ERROR: rollback failed.")
        return 1
    print("Rollback completed.")
    return 0

func _update_auto_notify_if_needed(cmd: String) -> void:
    if (env.get_var("THAGORE_DISABLE_UPDATE_CHECK") == "1"):
        return
    if ((cmd == "update") or (cmd == "help") or (cmd == "--help") or (cmd == "version") or (cmd == "--version") or (cmd == "install")):
        return
    let now = time.now_ms()
    if (_update_should_check(now, 86400000) == 0):
        return
    let os_name = _update_detect_os()
    let arch = _update_detect_arch()
    if (_update_platform_supported(os_name, arch) == 0):
        return
    let rel = _update_fetch_latest_foundation_release(os_name, arch)
    if (rel.ok == 0):
        return
    let prev_notified = _update_get_state_string("notified_tag")
    let notify_ms = _update_get_state_i32("last_notify_ms", 0)
    if ((_update_is_newer_than_current(rel.tag) > 0) and ((prev_notified != rel.tag) or ((now - notify_ms) >= 86400000))):
        print("[update] New version available " + rel.tag + " (current: " + _update_current_version_text() + ")")
        print("[update] Run: " + _update_cli_command_name() + " update apply")
        _update_write_state(now, now, rel.tag, rel.tag)
        return
    _update_write_state(now, notify_ms, prev_notified, rel.tag)

func _update_dispatch(argc: i32, start: i32) -> i32:
    if (argc <= start):
        _update_print_help()
        return 0
    let sub = _trim(env.get(start))
    if (sub == "check"):
        return _update_check()
    if (sub == "apply"):
        return _update_apply(argc, start + 1)
    if (sub == "rollback"):
        return _update_rollback(argc, start + 1)
    if ((sub == "--help") or (sub == "-h") or (sub == "help")):
        _update_print_help()
        return 0
    print("ERROR: unknown update subcommand: " + sub)
    return 1
