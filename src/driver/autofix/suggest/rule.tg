import "src/driver/autofix/common/core.tg"

func _rule_compiler_suggestions_span(source: String, file: String, mode: String, applied_flag: i32, session_id: String, start_index: i32, emit_detail: i32) -> RuleResult:
    fs.write_text(_compiler_last_fix_json_path(), "")
    fs.write_text(_compiler_last_stats_json_path(), "")
    let normalized_file = _normalize_path(file)
    let payload = _read_suggestions_payload(normalized_file)
    let total = _line_count(payload)
    if (total <= 0):
        return _rule_result(source, "", 0, start_index)
    let eligible_total = 0
    let ci = 0
    while (ci < total):
        let line_c = _trim(_line_at(payload, ci))
        if (strlen(line_c) > 0):
            let raw_file_c = _json_get_string(line_c, "file")
            if (strlen(raw_file_c) == 0):
                raw_file_c = normalized_file
            let sug_file_c = _normalize_path(raw_file_c)
            if (sug_file_c == normalized_file):
                let app_c = _json_get_string(line_c, "applicability")
                let kind_c = _suggestion_applicability_kind(app_c)
                if (_suggestion_allowed(kind_c, mode) == 1):
                    let start_c = _json_get_i32(line_c, "start_byte", -1)
                    let end_c = _json_get_i32(line_c, "end_byte", -1)
                    if ((start_c >= 0) and (end_c >= start_c) and (end_c <= strlen(source))):
                        let replacement_c = _json_get_string(line_c, "replacement")
                        let current_c = __thg_str_substr(source, start_c, end_c - start_c)
                        let expected_c = _json_get_string(line_c, "expected_old")
                        let no_change_c = 0
                        if (current_c == replacement_c):
                            no_change_c = 1
                        if ((strlen(expected_c) > 0) and (current_c != expected_c)):
                            no_change_c = 1
                        if ((strlen(replacement_c) > 0) and ((start_c + strlen(replacement_c)) <= strlen(source))):
                            if (__thg_str_substr(source, start_c, strlen(replacement_c)) == replacement_c):
                                no_change_c = 1
                        if (no_change_c == 0):
                            eligible_total = eligible_total + 1
        ci = ci + 1

    let fixed = source
    let out_fixes_json = ""
    let applied_count = 0
    let selected_ranges = ";"
    let next_idx = start_index
    let scan_more = 1
    while (scan_more == 1):
        let best_start = -1
        let best_end = -1
        let best_kind = 0
        let best_line = ""
        let li = 0
        while (li < total):
            let line = _trim(_line_at(payload, li))
            let reject = 0
            if (strlen(line) == 0):
                reject = 1
            else:
                let raw_file = _json_get_string(line, "file")
                if (strlen(raw_file) == 0):
                    raw_file = normalized_file
                let sug_file = _normalize_path(raw_file)
                if (sug_file != normalized_file):
                    reject = 1
                else:
                    let app = _json_get_string(line, "applicability")
                    let kind = _suggestion_applicability_kind(app)
                    if (_suggestion_allowed(kind, mode) == 0):
                        reject = 1
                    else:
                        let start_b = _json_get_i32(line, "start_byte", -1)
                        let end_b = _json_get_i32(line, "end_byte", -1)
                        if ((start_b < 0) or (end_b < start_b) or (end_b > strlen(fixed))):
                            reject = 1
                        else:
                            if (_ranges_overlap_any(start_b, end_b, selected_ranges) == 1):
                                reject = 1
                            else:
                                let replacement = _json_get_string(line, "replacement")
                                let current_range = __thg_str_substr(fixed, start_b, end_b - start_b)
                                let expected_old = _json_get_string(line, "expected_old")
                                let no_change = 0
                                if (current_range == replacement):
                                    no_change = 1
                                if ((strlen(expected_old) > 0) and (current_range != expected_old)):
                                    no_change = 1
                                if ((strlen(replacement) > 0) and ((start_b + strlen(replacement)) <= strlen(fixed))):
                                    if (__thg_str_substr(fixed, start_b, strlen(replacement)) == replacement):
                                        no_change = 1
                                if (no_change == 1):
                                    reject = 1
                                else:
                                    if (start_b > best_start):
                                        best_start = start_b
                                        best_end = end_b
                                        best_kind = kind
                                        best_line = line
            li = li + 1

        if (best_start < 0):
            scan_more = 0
        else:
            let old_snippet = __thg_str_substr(fixed, best_start, best_end - best_start)
            let replacement = _json_get_string(best_line, "replacement")
            let prefix = __thg_str_substr(fixed, 0, best_start)
            let suffix = __thg_str_substr(fixed, best_end, strlen(fixed) - best_end)
            fixed = prefix + replacement + suffix
            selected_ranges = _set_add_unique(selected_ranges, _to_string_i32(best_start) + ":" + _to_string_i32(best_end))
            let code = _json_get_string(best_line, "code")
            if (strlen(code) == 0):
                code = "COMPILER_SUGGESTION"
            let risk = "safe"
            if (best_kind == 1):
                risk = "aggressive"
            let fix_id = _fix_id("compiler-span", next_idx)
            let start_line = _line_from_offset(source, best_start)
            let start_col = _col_from_offset(source, best_start)
            let end_line = _line_from_offset(source, best_end)
            let end_col = _col_from_offset(source, best_end)
            let diff = "@@ byte " + _to_string_i32(best_start) + ":" + _to_string_i32(best_end) + " @@" + _nl() + "-" + old_snippet + _nl() + "+" + replacement
            if (emit_detail == 1):
                _print_fix_detail(fix_id, "compiler_suggestion_span_edit", risk, code, file, start_line, start_col, end_line, end_col, old_snippet, replacement, diff, session_id, applied_flag)
            let fix_json = _build_fix_json(fix_id, "compiler_suggestion_span_edit", risk, code, file, start_line, start_col, end_line, end_col, old_snippet, replacement, diff, applied_flag)
            out_fixes_json = _append_json(out_fixes_json, fix_json)
            applied_count = applied_count + 1
            next_idx = next_idx + 1

    let overlap_skipped = eligible_total - applied_count
    let overlap_out = overlap_skipped
    if (overlap_out < 0):
        overlap_out = 0
    let stats_json = "{"
    stats_json = stats_json + _json_quote("eligible") + ":" + _to_string_i32(eligible_total) + ","
    stats_json = stats_json + _json_quote("applied") + ":" + _to_string_i32(applied_count) + ","
    stats_json = stats_json + _json_quote("overlap_skipped") + ":" + _to_string_i32(overlap_out)
    stats_json = stats_json + "}"
    fs.write_text(_compiler_last_fix_json_path(), out_fixes_json)
    fs.write_text(_compiler_last_stats_json_path(), stats_json)
    return _rule_result(fixed, "", applied_count, next_idx)

