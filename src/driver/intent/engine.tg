import "src/driver/cli/common/core.tg"
import "src/semantics/intent/matcher.tg" as im
import "src/syntax/parser/header.tg" as ph
import "lib/env.tg" as env
import "lib/fs.tg" as fs

struct IntentPlan:
    records: String
    count: i32
    errors: i32


func _intent_plan(records: String, count: i32, errors: i32) -> IntentPlan:
    return IntentPlan(records, count, errors)

func _json_bool(flag: i32) -> String:
    if (flag == 1):
        return "true"
    return "false"

func _parse_i32_default(text: String, fallback: i32) -> i32:
    let s = _trim(text)
    if (strlen(s) == 0):
        return fallback
    let i = 0
    let sign = 1
    if (_char_at(s, 0) == "-"):
        sign = -1
        i = 1
    if (i >= strlen(s)):
        return fallback
    let value = 0
    let digits = 0
    while (i < strlen(s)):
        let ch = _char_at(s, i)
        let d = _find_char("0123456789", ch)
        if (d < 0):
            return fallback
        value = (value * 10) + d
        digits = digits + 1
        i = i + 1
    if (digits == 0):
        return fallback
    if (sign < 0):
        return 0 - value
    return value

func normalize_intent_mode(mode: String) -> String:
    let m = _trim(mode)
    if (m == "off"):
        return "off"
    if (m == "max"):
        return "max"
    return "min"

func normalize_intent_policy(policy: String) -> String:
    let p = _trim(policy)
    if ((p == "safe") or (p == "fast") or (p == "debug")):
        return p
    return ""

func normalize_intent_fallback(fallback: String) -> String:
    let f = _trim(fallback)
    if ((f == "allow") or (f == "deny")):
        return f
    return "deny"

func policy_default_mode(policy: String) -> String:
    let p = normalize_intent_policy(policy)
    if (p == "safe"):
        return "max"
    if (p == "fast"):
        return "min"
    if (p == "debug"):
        return "off"
    return "off"

func policy_default_fallback(policy: String) -> String:
    let p = normalize_intent_policy(policy)
    if ((p == "fast") or (p == "debug")):
        return "allow"
    return "deny"

func policy_default_strict_lock(policy: String) -> i32:
    if (normalize_intent_policy(policy) == "safe"):
        return 1
    return 0

func _strip_spaces(text: String) -> String:
    let out = _replace_all(text, " ", "")
    return _replace_all(out, "\t", "")

func _find(text: String, needle: String) -> i32:
    let n = strlen(text)
    let m = strlen(needle)
    if (m == 0):
        return 0
    let i = 0
    while ((i + m) <= n):
        if (__thg_str_substr(text, i, m) == needle):
            return i
        i = i + 1
    return -1

func _leading_spaces(line: String) -> i32:
    let i = 0
    let n = strlen(line)
    while (i < n):
        let ch = _char_at(line, i)
        if (ch == " "):
            i = i + 1
        else:
            if (ch == "\t"):
                i = i + 4
            else:
                return i
    return i

func _pack_field(text: String) -> String:
    let out = _replace_all(text, "%", "%25")
    out = _replace_all(out, "|", "%7C")
    out = _replace_all(out, ";", "%3B")
    out = _replace_all(out, _nl(), "%0A")
    out = _replace_all(out, "\r", "%0D")
    return out

func _unpack_field(text: String) -> String:
    let out = _replace_all(text, "%0D", "\r")
    out = _replace_all(out, "%0A", _nl())
    out = _replace_all(out, "%3B", ";")
    out = _replace_all(out, "%7C", "|")
    out = _replace_all(out, "%25", "%")
    return out

func _record_field(record: String, field_index: i32) -> String:
    let i = 0
    let idx = 0
    let token = ""
    while (i < strlen(record)):
        let ch = _char_at(record, i)
        if (ch == "|"):
            if (idx == field_index):
                return _unpack_field(token)
            token = ""
            idx = idx + 1
        else:
            token = token + ch
        i = i + 1
    if (idx == field_index):
        return _unpack_field(token)
    return ""

func _append_record(records: String, record: String) -> String:
    if (strlen(records) == 0):
        return record
    return records + _nl() + record

func _new_record(intent_id: String, line_no: i32, kind: String, goal: String, strategy: String, selected_rule: String, verified: i32, verify_reason: String, func_name: String, constraints_lines: String, candidate_rules_set: String) -> String:
    let rec = _pack_field(intent_id) + "|"
    rec = rec + _pack_field(_to_string_i32(line_no)) + "|"
    rec = rec + _pack_field(kind) + "|"
    rec = rec + _pack_field(goal) + "|"
    rec = rec + _pack_field(strategy) + "|"
    rec = rec + _pack_field(selected_rule) + "|"
    rec = rec + _pack_field(_to_string_i32(verified)) + "|"
    rec = rec + _pack_field(verify_reason) + "|"
    rec = rec + _pack_field(func_name) + "|"
    rec = rec + _pack_field(constraints_lines) + "|"
    rec = rec + _pack_field(candidate_rules_set)
    return rec

func _set_to_lines_json_array(lines_text: String) -> String:
    let out = "["
    let first = 1
    let total = _line_count(lines_text)
    let i = 0
    while (i < total):
        let line = _trim(_line_at(lines_text, i))
        if (strlen(line) > 0):
            if (first == 0):
                out = out + ","
            out = out + _json_quote(line)
            first = 0
        i = i + 1
    out = out + "]"
    return out

func _parse_intent_func_name(line: String) -> String:
    let s = _trim(line)
    if (_starts_with(s, "intent func ") == 0):
        return ""
    let body = _trim(__thg_str_substr(s, 12, strlen(s) - 12))
    let p = _find_char(body, "(")
    if (p <= 0):
        return ""
    return _trim(__thg_str_substr(body, 0, p))

func _goal_for_strategy(strategy: String) -> String:
    if (strategy == "dp.fib.v1"):
        return "fibonacci_dp"
    if (strategy == "dp.trib.v1"):
        return "tribonacci_dp"
    if (strategy == "math.factorial.loop.v1"):
        return "factorial_iterative"
    if (strategy == "math.pow.binary_exp"):
        return "power_fast"
    if (strategy == "math.gcd.euclid"):
        return "gcd_euclid"
    if (strategy == "number.prime.sqrt.v1"):
        return "is_prime_fast"
    if (strategy == "number.divisors.sqrt.v1"):
        return "count_divisors_sqrt"
    if (strategy == "greedy.sweep.v1"):
        return "interval_cover_greedy"
    if (strategy == "search.binary.v1"):
        return "binary_search_sorted"
    if (strategy == "search.lower_bound.v1"):
        return "lower_bound_sorted"
    if (strategy == "search.upper_bound.v1"):
        return "upper_bound_sorted"
    if (strategy == "search.count_less.v1"):
        return "count_less_sorted"
    if (strategy == "search.count_less_equal.v1"):
        return "count_less_equal_sorted"
    if (strategy == "search.count_greater.v1"):
        return "count_greater_sorted"
    if (strategy == "search.count_greater_equal.v1"):
        return "count_greater_equal_sorted"
    if (strategy == "search.count_equal.v1"):
        return "count_equal_sorted"
    if (strategy == "search.count_not_equal.v1"):
        return "count_not_equal_sorted"
    if (strategy == "search.count_range.v1"):
        return "count_range_sorted"
    if (strategy == "search.count_outside_range.v1"):
        return "count_outside_range_sorted"
    if (strategy == "search.two_sum.v1"):
        return "two_sum_sorted_exists"
    if (strategy == "number.bit_peel.iterative"):
        return "bit_peel_iterative"
    if (strategy == "math.sum.formula.v1"):
        return "sum_formula"
    if (strategy == "math.sum_squares.formula.v1"):
        return "sum_squares_formula"
    if (strategy == "math.sum_cubes.formula.v1"):
        return "sum_cubes_formula"
    if (strategy == "math.sum_even_squares.formula.v1"):
        return "sum_even_squares_formula"
    if (strategy == "math.sum_odd_squares.formula.v1"):
        return "sum_odd_squares_formula"
    if (strategy == "math.sum_even_cubes.formula.v1"):
        return "sum_even_cubes_formula"
    if (strategy == "math.sum_odd_cubes.formula.v1"):
        return "sum_odd_cubes_formula"
    if (strategy == "math.sum_even.formula.v1"):
        return "sum_even_formula"
    if (strategy == "math.sum_odd.formula.v1"):
        return "sum_odd_formula"
    if (strategy == "math.sqrt.newton.v1"):
        return "sqrt_bounded_loop"
    if (strategy == "search.identity.bounds.v1"):
        return "search_element"
    return ""

func _rule_for_strategy(strategy: String) -> String:
    if (strategy == "dp.fib.v1"):
        return "rule.fibonacci_dp.iterative.v1"
    if (strategy == "dp.trib.v1"):
        return "rule.dp.trib.iterative.v1"
    if (strategy == "math.factorial.loop.v1"):
        return "rule.math.factorial.loop.v1"
    if (strategy == "math.pow.binary_exp"):
        return "rule.math.pow.binary_exp.v1"
    if (strategy == "math.gcd.euclid"):
        return "rule.math.gcd.euclid.v1"
    if (strategy == "number.prime.sqrt.v1"):
        return "rule.number.prime.sqrt.v1"
    if (strategy == "number.divisors.sqrt.v1"):
        return "rule.number.divisors.sqrt.v1"
    if (strategy == "greedy.sweep.v1"):
        return "rule.greedy.interval_cover.v1"
    if (strategy == "search.binary.v1"):
        return "rule.search.binary.sorted.v1"
    if (strategy == "search.lower_bound.v1"):
        return "rule.search.lower_bound.sorted.v1"
    if (strategy == "search.upper_bound.v1"):
        return "rule.search.upper_bound.sorted.v1"
    if (strategy == "search.count_less.v1"):
        return "rule.search.count_less.sorted.v1"
    if (strategy == "search.count_less_equal.v1"):
        return "rule.search.count_less_equal.sorted.v1"
    if (strategy == "search.count_greater.v1"):
        return "rule.search.count_greater.sorted.v1"
    if (strategy == "search.count_greater_equal.v1"):
        return "rule.search.count_greater_equal.sorted.v1"
    if (strategy == "search.count_equal.v1"):
        return "rule.search.count_equal.sorted.v1"
    if (strategy == "search.count_not_equal.v1"):
        return "rule.search.count_not_equal.sorted.v1"
    if (strategy == "search.count_range.v1"):
        return "rule.search.count_range.sorted.v1"
    if (strategy == "search.count_outside_range.v1"):
        return "rule.search.count_outside_range.sorted.v1"
    if (strategy == "search.two_sum.v1"):
        return "rule.search.two_sum.sorted.v1"
    if (strategy == "number.bit_peel.iterative"):
        return "rule.number.bit_peel.iterative.v1"
    if (strategy == "math.sum.formula.v1"):
        return "rule.math.sum.formula.v1"
    if (strategy == "math.sum_squares.formula.v1"):
        return "rule.math.sum_squares.formula.v1"
    if (strategy == "math.sum_cubes.formula.v1"):
        return "rule.math.sum_cubes.formula.v1"
    if (strategy == "math.sum_even_squares.formula.v1"):
        return "rule.math.sum_even_squares.formula.v1"
    if (strategy == "math.sum_odd_squares.formula.v1"):
        return "rule.math.sum_odd_squares.formula.v1"
    if (strategy == "math.sum_even_cubes.formula.v1"):
        return "rule.math.sum_even_cubes.formula.v1"
    if (strategy == "math.sum_odd_cubes.formula.v1"):
        return "rule.math.sum_odd_cubes.formula.v1"
    if (strategy == "math.sum_even.formula.v1"):
        return "rule.math.sum_even.formula.v1"
    if (strategy == "math.sum_odd.formula.v1"):
        return "rule.math.sum_odd.formula.v1"
    if (strategy == "math.sqrt.newton.v1"):
        return "rule.sqrt_bounded_loop.mul_guard.v2"
    if (strategy == "search.identity.bounds.v1"):
        return "rule.search_element.binary_iter.v2"
    return ""

func _auto_goal_from_name(func_name: String) -> String:
    let n = _trim(func_name)
    if (_contains(n, "lower_bound") == 1):
        return "lower_bound_sorted"
    if (_contains(n, "count_range") == 1):
        return "count_range_sorted"
    if (_contains(n, "two_sum") == 1):
        return "two_sum_sorted_exists"
    if (_contains(n, "gcd") == 1):
        return "gcd_euclid"
    if (_contains(n, "pow") == 1):
        return "power_fast"
    if (_contains(n, "prime") == 1):
        return "is_prime_fast"
    if ((_contains(n, "sprinkler") == 1) or (_contains(n, "cover") == 1)):
        return "interval_cover_greedy"
    if (_contains(n, "sum_even") == 1):
        return "sum_even_formula"
    return "reduce_sum"

func _candidate_rules_for_goal(goal: String, mode: String) -> String:
    if (goal == "reduce_sum"):
        return ";rule.reduce_sum.scalar.v1;rule.reduce_sum.simd.v2;rule.reduce_sum.parallel.v3;"
    if (goal == "off"):
        return ";rule.intent.off;"
    let selected = im.select_rule(goal, mode)
    if (selected == "rule.unsupported"):
        return ";"
    return ";" + selected + ";"

func _parse_plan(entry_path: String, source: String, mode: String) -> IntentPlan:
    let total = _line_count(source)
    let mode_norm = normalize_intent_mode(mode)
    let i = 0
    let records = ""
    let count = 0
    let errors = 0
    while (i < total):
        let raw = _line_at(source, i)
        let line = _trim(raw)
        let indent = _leading_spaces(raw)
        if (_starts_with(line, "intent ") == 1):
            let kind = ph.parse_intent_kind(line)
            if (strlen(kind) == 0):
                errors = errors + 1
            else:
                let func_name = _parse_intent_func_name(line)
                let goal_raw = ""
                let strategy = ""
                let constraints_lines = ""
                let in_constraints = 0
                let constraints_indent = -1
                let disable_intent = 0
                let j = i + 1
                while (j < total):
                    let raw2 = _line_at(source, j)
                    let line2 = _trim(raw2)
                    let indent2 = _leading_spaces(raw2)
                    if (strlen(line2) == 0):
                        j = j + 1
                    else:
                        if (indent2 <= indent):
                            j = total
                        else:
                            if (ph.is_intent_goal_line(line2) == 1):
                                goal_raw = _trim(__thg_str_substr(line2, 5, strlen(line2) - 5))
                                in_constraints = 0
                            else:
                                if (_starts_with(line2, "strategy:") == 1):
                                    strategy = _trim(__thg_str_substr(line2, 9, strlen(line2) - 9))
                                    in_constraints = 0
                                else:
                                    if (ph.is_intent_constraints_header(line2) == 1):
                                        in_constraints = 1
                                        constraints_indent = indent2
                                    else:
                                        if (in_constraints == 1):
                                            if (indent2 > constraints_indent):
                                                if (strlen(constraints_lines) > 0):
                                                    constraints_lines = constraints_lines + _nl()
                                                constraints_lines = constraints_lines + line2
                                                if (_strip_spaces(line2) == "intent==false"):
                                                    disable_intent = 1
                                            else:
                                                in_constraints = 0
                            j = j + 1
                let goal = _trim(goal_raw)
                if (strlen(goal) == 0):
                    errors = errors + 1
                let resolved_goal = goal
                if ((goal == "off") or (disable_intent == 1)):
                    resolved_goal = "off"
                else:
                    if (goal == "auto_plan"):
                        resolved_goal = _auto_goal_from_name(func_name)
                let selected_rule = im.select_rule(resolved_goal, mode_norm)
                let verified = 1
                let verify_reason = "ok"
                if (resolved_goal == "off"):
                    selected_rule = "rule.intent.off"
                    verify_reason = "intent-disabled"
                else:
                    if (im.is_supported_goal(resolved_goal) == 0):
                        selected_rule = "rule.unsupported"
                        verified = 0
                        verify_reason = "unsupported-goal"
                if (strlen(strategy) > 0):
                    let strategy_goal = _goal_for_strategy(strategy)
                    let strategy_rule = _rule_for_strategy(strategy)
                    if (strlen(strategy_rule) == 0):
                        selected_rule = "rule.unsupported"
                        verified = 0
                        verify_reason = "strategy-unknown"
                    else:
                        let current_goal = resolved_goal
                        if (goal == "auto_plan"):
                            current_goal = strategy_goal
                            resolved_goal = strategy_goal
                        if ((strlen(strategy_goal) > 0) and (current_goal != strategy_goal)):
                            selected_rule = "rule.unsupported"
                            verified = 0
                            verify_reason = "strategy-goal-mismatch"
                        else:
                            selected_rule = strategy_rule
                            verified = 1
                            verify_reason = "ok"
                let candidate_rules_set = _candidate_rules_for_goal(resolved_goal, mode_norm)
                candidate_rules_set = _set_add_unique(candidate_rules_set, selected_rule)
                let intent_id = _normalize_path(entry_path) + ":" + _to_string_i32(i + 1) + ":intent_" + kind + "_" + _to_string_i32(count + 1)
                let rec = _new_record(intent_id, i + 1, kind, resolved_goal, strategy, selected_rule, verified, verify_reason, func_name, constraints_lines, candidate_rules_set)
                records = _append_record(records, rec)
                count = count + 1
        i = i + 1
    return _intent_plan(records, count, errors)

func _records_json_array(records: String) -> String:
    let out = "["
    let first = 1
    let total = _line_count(records)
    let i = 0
    while (i < total):
        let rec = _trim(_line_at(records, i))
        if (strlen(rec) > 0):
            if (first == 0):
                out = out + ","
            let item = "{"
            item = item + _json_quote("intent_id") + ":" + _json_quote(_record_field(rec, 0)) + ","
            item = item + _json_quote("kind") + ":" + _json_quote(_record_field(rec, 2)) + ","
            item = item + _json_quote("line") + ":" + _record_field(rec, 1) + ","
            item = item + _json_quote("goal") + ":" + _json_quote(_record_field(rec, 3)) + ","
            item = item + _json_quote("constraints") + ":" + _set_to_lines_json_array(_record_field(rec, 9)) + ","
            item = item + _json_quote("candidate_rules") + ":" + _set_to_json_array(_record_field(rec, 10)) + ","
            item = item + _json_quote("matched") + ":" + _json_bool(_record_field(rec, 5) != "rule.unsupported") + ","
            item = item + _json_quote("selected_rule") + ":" + _json_quote(_record_field(rec, 5)) + ","
            item = item + _json_quote("verified") + ":" + _json_bool(_record_field(rec, 6) == "1") + ","
            item = item + _json_quote("verify_reason") + ":" + _json_quote(_record_field(rec, 7))
            item = item + "}"
            out = out + item
            first = 0
        i = i + 1
    out = out + "]"
    return out

func _rule_family(rule_id: String) -> String:
    if (_starts_with(rule_id, "rule.") == 0):
        return "misc"
    let body = __thg_str_substr(rule_id, 5, strlen(rule_id) - 5)
    let p = _find_char(body, ".")
    if (p < 0):
        return body
    return __thg_str_substr(body, 0, p)

func _map_get_i32(map_text: String, key: String, fallback: i32) -> i32:
    let total = _line_count(map_text)
    let i = 0
    while (i < total):
        let line = _trim(_line_at(map_text, i))
        if (_starts_with(line, key + "=") == 1):
            return _parse_i32_default(_trim(__thg_str_substr(line, strlen(key) + 1, strlen(line) - strlen(key) - 1)), fallback)
        i = i + 1
    return fallback

func _map_set_i32(map_text: String, key: String, value: i32) -> String:
    let out = ""
    let total = _line_count(map_text)
    let i = 0
    let replaced = 0
    while (i < total):
        let line = _trim(_line_at(map_text, i))
        if (strlen(line) > 0):
            if (_starts_with(line, key + "=") == 1):
                if (strlen(out) > 0):
                    out = out + _nl()
                out = out + key + "=" + _to_string_i32(value)
                replaced = 1
            else:
                if (strlen(out) > 0):
                    out = out + _nl()
                out = out + line
        i = i + 1
    if (replaced == 0):
        if (strlen(out) > 0):
            out = out + _nl()
        out = out + key + "=" + _to_string_i32(value)
    return out

func _registry_enforce(records: String) -> i32:
    let reg_path = _trim(env.get("THAG_INTENT_REGISTRY"))
    if (strlen(reg_path) == 0):
        return 0
    if (fs.exists(reg_path) == 0):
        print("[intent] error: registry file not found: " + reg_path)
        return 1
    let text = fs.read_text(reg_path)
    let enabled = 1
    let budget_total = -1
    let rules_set = ";"
    let family_caps = ""
    let total = _line_count(text)
    let i = 0
    while (i < total):
        let line = _trim(_line_at(text, i))
        if ((strlen(line) > 0) and (_starts_with(line, "#") == 0)):
            if (_starts_with(line, "enabled=") == 1):
                let v = _trim(__thg_str_substr(line, 8, strlen(line) - 8))
                if ((v == "0") or (v == "false") or (v == "off") or (v == "no")):
                    enabled = 0
            else:
                if (_starts_with(line, "budget.total=") == 1):
                    budget_total = _parse_i32_default(_trim(__thg_str_substr(line, 13, strlen(line) - 13)), budget_total)
                else:
                    if (_starts_with(line, "budget.family.") == 1):
                        let eq = _find_char(line, "=")
                        if (eq > 13):
                            let name = _trim(__thg_str_substr(line, 14, eq - 14))
                            let cap = _parse_i32_default(_trim(__thg_str_substr(line, eq + 1, strlen(line) - eq - 1)), -1)
                            if ((strlen(name) > 0) and (cap >= 0)):
                                family_caps = _map_set_i32(family_caps, name, cap)
                    else:
                        if (_starts_with(line, "rule=") == 1):
                            rules_set = _set_add_unique(rules_set, _trim(__thg_str_substr(line, 5, strlen(line) - 5)))
        i = i + 1
    if (enabled == 0):
        return 0
    if (budget_total == 0):
        print("[intent] registry violation: budget.total exhausted.")
        return 1
    let used = 0
    let family_counts = ""
    let rc_total = _line_count(records)
    let j = 0
    while (j < rc_total):
        let rec = _trim(_line_at(records, j))
        if (strlen(rec) > 0):
            let rule = _record_field(rec, 5)
            if (strlen(rule) > 0):
                used = used + 1
                if ((_set_count(rules_set) > 0) and (_set_contains(rules_set, rule) == 0)):
                    print("[intent] registry violation: rule disabled: " + rule)
                    return 1
                let fam = _rule_family(rule)
                let fam_next = _map_get_i32(family_counts, fam, 0) + 1
                family_counts = _map_set_i32(family_counts, fam, fam_next)
                let fam_cap = _map_get_i32(family_caps, fam, -1)
                if ((fam_cap >= 0) and (fam_next > fam_cap)):
                    print("[intent] registry violation: family budget exceeded: " + fam)
                    return 1
        j = j + 1
    if ((budget_total > 0) and (used > budget_total)):
        print("[intent] registry violation: budget.total exceeded.")
        return 1
    return 0

func _source_digest(source: String) -> String:
    return "sha256:" + _to_string_i32(_hash_text(source))

func _lock_find_entry_slice(lock_text: String, intent_id: String) -> String:
    let p1 = _find(lock_text, _json_quote("intent_id") + ":" + _json_quote(intent_id))
    let p2 = _find(lock_text, _json_quote("intent_id") + ": " + _json_quote(intent_id))
    let p = p1
    if (p < 0):
        p = p2
    if (p < 0):
        return ""
    let tail = __thg_str_substr(lock_text, p, strlen(lock_text) - p)
    let e = _find_char(tail, "}")
    if (e < 0):
        return tail
    return __thg_str_substr(tail, 0, e + 1)

func _strict_lock_validate(source: String, records: String, mode: String, lock_path: String) -> i32:
    if (mode != "max"):
        print("[intent] error: --strict-lock requires --intent=max.")
        return 1
    if (strlen(lock_path) == 0):
        print("[intent] error: --strict-lock requires --intent-lock <path>.")
        return 1
    if (fs.exists(lock_path) == 0):
        print("[intent] error: intent lock file not found: " + lock_path)
        return 1
    let lock_text = fs.read_text(lock_path)
    if (_json_get_string(lock_text, "source_digest") != _source_digest(source)):
        print("[intent] strict lock violation: source digest mismatch.")
        return 1
    let total = _line_count(records)
    let i = 0
    while (i < total):
        let rec = _trim(_line_at(records, i))
        if (strlen(rec) > 0):
            let intent_id = _record_field(rec, 0)
            let selected_rule = _record_field(rec, 5)
            let slice = _lock_find_entry_slice(lock_text, intent_id)
            if (strlen(slice) == 0):
                print("[intent] strict lock violation: missing lock entry for " + intent_id)
                return 1
            if (_json_get_string(slice, "selected_rule") != selected_rule):
                print("[intent] strict lock violation: selected_rule mismatch for " + intent_id)
                return 1
        i = i + 1
    return 0

func _write_lock_file(source: String, records: String, out_path: String) -> i32:
    let target = _trim(env.get("THAG_TARGET"))
    if (strlen(target) == 0):
        target = "native"
    let out = "{"
    out = out + _json_quote("schema_version") + ":1,"
    out = out + _json_quote("thagore_version") + ":" + _json_quote("0.5.0") + ","
    out = out + _json_quote("target") + ":" + _json_quote(target) + ","
    out = out + _json_quote("source_digest") + ":" + _json_quote(_source_digest(source)) + ","
    out = out + _json_quote("entries") + ":["
    let first = 1
    let total = _line_count(records)
    let i = 0
    while (i < total):
        let rec = _trim(_line_at(records, i))
        if (strlen(rec) > 0):
            if (first == 0):
                out = out + ","
            let intent_id = _record_field(rec, 0)
            let goal = _record_field(rec, 3)
            let selected_rule = _record_field(rec, 5)
            let verify_reason = _record_field(rec, 7)
            let constraints = _record_field(rec, 9)
            out = out + "{"
            out = out + _json_quote("intent_id") + ":" + _json_quote(intent_id) + ","
            out = out + _json_quote("goal") + ":" + _json_quote(goal) + ","
            out = out + _json_quote("selected_rule") + ":" + _json_quote(selected_rule) + ","
            out = out + _json_quote("constraints_digest") + ":" + _json_quote("sha256:" + _to_string_i32(_hash_text(constraints))) + ","
            out = out + _json_quote("verification_digest") + ":" + _json_quote("sha256:" + _to_string_i32(_hash_text(verify_reason + "|" + selected_rule)))
            out = out + "}"
            first = 0
        i = i + 1
    out = out + "]}"
    out = out + _nl()
    if (fs.write_text(out_path, out) == 0):
        print("[intent] error: failed to write lock file: " + out_path)
        return 1
    fs.mkdir(".thagore")
    fs.mkdir(".thagore/intent")
    fs.write_text(".thagore/intent/last_lock.path", out_path)
    return 0

func run_intent_doctor(entry_path: String, mode: String, as_json: i32) -> i32:
    if (fs.exists(entry_path) == 0):
        print("[intent] error: source file not found: " + entry_path)
        return 1
    let source = fs.read_text(entry_path)
    let plan = _parse_plan(entry_path, source, mode)
    let ok = (plan.errors == 0)
    if (as_json == 1):
        let json = "{"
        json = json + _json_quote("schema_version") + ":1,"
        json = json + _json_quote("type") + ":" + _json_quote("intent_doctor") + ","
        json = json + _json_quote("entry") + ":" + _json_quote(_normalize_path(entry_path)) + ","
        json = json + _json_quote("mode") + ":" + _json_quote(normalize_intent_mode(mode)) + ","
        json = json + _json_quote("engine") + ":" + _json_quote("ready") + ","
        json = json + _json_quote("intent_entries") + ":" + _to_string_i32(plan.count) + ","
        json = json + _json_quote("errors") + ":" + _to_string_i32(plan.errors) + ","
        json = json + _json_quote("ok") + ":" + _json_bool(ok)
        json = json + "}"
        print(json)
    else:
        print("[intent][doctor] entry=" + _normalize_path(entry_path))
        print("[intent][doctor] mode=" + normalize_intent_mode(mode))
        print("[intent][doctor] engine=ready")
        print("[intent][doctor] intent_entries=" + _to_string_i32(plan.count))
        print("[intent][doctor] errors=" + _to_string_i32(plan.errors))
    if (ok == 1):
        return 0
    return 1

func run_intent_explain(entry_path: String, mode: String, as_json: i32) -> i32:
    if (fs.exists(entry_path) == 0):
        print("[intent] error: source file not found: " + entry_path)
        return 1
    let source = fs.read_text(entry_path)
    let mode_norm = normalize_intent_mode(mode)
    let plan = _parse_plan(entry_path, source, mode_norm)
    let json = "{"
    json = json + _json_quote("entry") + ":" + _json_quote(_normalize_path(entry_path)) + ","
    json = json + _json_quote("mode") + ":" + _json_quote(mode_norm) + ","
    json = json + _json_quote("entries") + ":" + _records_json_array(plan.records)
    json = json + "}"
    fs.mkdir(".thagore")
    fs.mkdir(".thagore/intent")
    fs.write_text(".thagore/intent/last_explain.json", json + _nl())
    if (as_json == 1):
        print(json)
    else:
        print("[intent][explain] entry=" + _normalize_path(entry_path))
        print("[intent][explain] mode=" + mode_norm)
        print("[intent][explain] entries=" + _to_string_i32(plan.count))
    if (plan.errors == 0):
        return 0
    return 1

func run_intent_lock(entry_path: String, out_path: String, mode: String) -> i32:
    if (fs.exists(entry_path) == 0):
        print("[intent] error: source file not found: " + entry_path)
        return 1
    let source = fs.read_text(entry_path)
    let plan = _parse_plan(entry_path, source, mode)
    if (plan.errors > 0):
        print("[intent] error: invalid intent declaration(s).")
        return 1
    let total = _line_count(plan.records)
    let i = 0
    while (i < total):
        let rec = _trim(_line_at(plan.records, i))
        if ((strlen(rec) > 0) and (_record_field(rec, 6) != "1")):
            print("[intent] error: intent verification failed: " + _record_field(rec, 7))
            return 1
        i = i + 1
    if (_registry_enforce(plan.records) != 0):
        return 1
    let out = _trim(out_path)
    if (strlen(out) == 0):
        out = "thagore.intent.lock"
    let rc = _write_lock_file(source, plan.records, out)
    if (rc == 0):
        print("[intent] lock: " + out)
    return rc

func run_intent_gate(entry_path: String, mode: String, fallback: String, strict_lock: i32, lock_path: String) -> i32:
    let mode_norm = normalize_intent_mode(mode)
    let fallback_norm = normalize_intent_fallback(fallback)
    print("[intent] mode=" + mode_norm)
    if (mode_norm == "off"):
        return 0
    if (fs.exists(entry_path) == 0):
        print("[intent] error: source file not found: " + entry_path)
        return 1
    let source = fs.read_text(entry_path)
    let plan = _parse_plan(entry_path, source, mode_norm)
    if (plan.errors > 0):
        print("[intent] error: invalid intent declaration(s).")
        return 1
    if (_registry_enforce(plan.records) != 0):
        return 1
    if (strict_lock == 1):
        if (_strict_lock_validate(source, plan.records, mode_norm, lock_path) != 0):
            return 1
    let total = _line_count(plan.records)
    let i = 0
    while (i < total):
        let rec = _trim(_line_at(plan.records, i))
        if (strlen(rec) > 0):
            let verified = _record_field(rec, 6)
            let selected = _record_field(rec, 5)
            let reason = _record_field(rec, 7)
            let fn_name = _record_field(rec, 8)
            if (verified != "1"):
                if (fallback_norm == "allow"):
                    print("[intent] warning: fallback allow due to " + reason)
                else:
                    print("[intent] error: verification failed: " + reason)
                    return 1
            if ((selected == "rule.dp.trib.iterative.v1") and (strlen(fn_name) > 0)):
                print("intent rewrite applied for " + fn_name + " using " + selected)
        i = i + 1
    return 0
