{
  "scopeName": "source.thagore",
  "name": "Thagore",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.thagore",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.thagore",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.thagore",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.thagore",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.thagore",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.thagore",
          "match": "\\b(func|struct|impl|import|from|pub|let|const|if|else|while|for|return|break|continue|include|as|extern|intent|flow)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.thagore",
          "match": "\\b(i32|i64|f64|bool|str|void|ptr)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.thagore",
          "match": "\\b(print|println|eprint|eprintln|flush)\\b"
        }
      ]
    }
  }
}
