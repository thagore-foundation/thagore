{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"]],
  "indentationRules": {
    "increaseIndentPattern": ":$",
    "decreaseIndentPattern": "^\\s*(else|elif):"
  },
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ]
}
