import "src/compiler/parser.tg" as parser
import "src/compiler/eval.tg" as eval

func main() -> i32:
    print("--- Function Test: Fibonacci ---")
    print("Calculating fib(10)...")

    let program = "{ func fib(n) { if (n < 2) { return n; }; return fib(n - 1) + fib(n - 2); }; fib(10) }"
    let root = parser.parse_program(program)

    let interp = eval.new()
    let result = interp.exec_stmt(root)

    print("Result:")
    print(result)

    if (result == 55):
        print("SUCCESS: Function recursion works.")
    else:
        print("FAILURE: Wrong fibonacci result.")

    return 0
