extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __thg_str_add(a: String, b: String) -> String

struct StringBuilder:
    total_len: i32
    cache: String

func substring(text: String, start: i32, count: i32) -> String:
    if (count <= 0):
        return ""
    if (start < 0):
        return ""
    if (text == null):
        return ""
    let text_len = strlen(text)
    if (start >= text_len):
        return ""
    let available = text_len - start
    let bounded = count
    if (bounded > available):
        bounded = available
    if (bounded <= 0):
        return ""
    return __thg_str_substr(text, start, bounded)

func char_at(text: String, index: i32) -> String:
    return substring(text, index, 1)

func equals(a: String, b: String) -> bool:
    return a == b

func _digit_char(digit: i32) -> String:
    return __thg_str_substr("0123456789", digit, 1)

func to_string_i32(value: i32) -> String:
    if (value == 0):
        return "0"
    if (value == (-2147483647 - 1)):
        return "-2147483648"
    let n = value
    let sign = ""
    if (n < 0):
        sign = "-"
        n = 0 - n
    let reversed = ""
    while (n > 0):
        let q = n / 10
        let r = n - (q * 10)
        reversed = reversed + _digit_char(r)
        n = q
    let out = ""
    let i = strlen(reversed) - 1
    while (i >= 0):
        out = out + __thg_str_substr(reversed, i, 1)
        i = i - 1
    return sign + out

func builder_new() -> StringBuilder:
    return StringBuilder(0, "")

func append(self: StringBuilder, part: String) -> StringBuilder:
    return StringBuilder(self.total_len + strlen(part), __thg_str_add(self.cache, part))

func len(self: StringBuilder) -> i32:
    return self.total_len

func to_string(self: StringBuilder) -> String:
    return self.cache

func dispose(self: StringBuilder) -> i32:
    return 1
