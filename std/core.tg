extern func malloc(size: i32) -> ptr
extern func free(p: ptr) -> void
extern func memcpy(dst: ptr, src: ptr, size: i32) -> ptr
extern func strlen(s: String) -> i32
extern func printf(fmt: String, value: i32) -> i32
extern func puts(text: String) -> i32
extern func exit(code: i32) -> void
extern func __thg_ptr_set(base: ptr, index: i32, value: ptr) -> void
extern func __thg_ptr_get(base: ptr, index: i32) -> ptr
extern func __thg_ptr_null() -> ptr
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func print_i32(value: i32) -> i32:
    return printf("%d\n", value)

func print_str(text: String) -> i32:
    return puts(text)

func thg_str_add(a: String, b: String) -> String:
    # Bootstrap-safe path: avoid temporary native allocation to prevent leaks.
    return a + b

func ptr_set(base: ptr, index: i32, value: ptr) -> i32:
    if (base == __thg_ptr_null()):
        return 0
    if (index < 0):
        return 0
    __thg_ptr_set(base, index, value)
    return 1

func ptr_get(base: ptr, index: i32) -> ptr:
    if (base == __thg_ptr_null()):
        return __thg_ptr_null()
    if (index < 0):
        return __thg_ptr_null()
    return __thg_ptr_get(base, index)

func ptr_null() -> ptr:
    return __thg_ptr_null()

func str_substr(s: String, start: i32, len: i32) -> String:
    return __thg_str_substr(s, start, len)

func mem_free(p: ptr) -> i32:
    if (p == __thg_ptr_null()):
        return 0
    free(p)
    return 1

func abort(code: i32) -> i32:
    exit(code)
    return code
