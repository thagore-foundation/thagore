from . import lexer
from . import pipeline
from . import session
import std.string as string

pub func main() -> i32:
  let path = session.input_path()
  let source = session.read_source(path)
  if (string.len(source) == 0):
    return 1
  let kind = session.input_kind()
  println(pipeline.scan_report(source, kind))
  return 0
