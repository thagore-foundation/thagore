from . import driver
import std.fs as fs
import std.process as process
import std.string as string

func input_path() -> str:
  let arg = process.argv(1)
  if (string.len(arg) > 0):
    return arg
  return "tests/bootstrap_seed/sample.tg"

func input_kind() -> str:
  let arg = process.argv(2)
  if (string.str_eq(arg, "library")):
    return driver.library_module_kind()
  return driver.executable_root_kind()

func output_mode() -> str:
  let arg = process.argv(3)
  if (string.str_eq(arg, "dump-desugared")):
    return arg
  return "analyze"

pub func main() -> i32:
  let path = input_path()
  let source = fs.read(path)
  if (string.len(source) == 0):
    return 1
  let cwd = fs.getcwd()
  let kind = input_kind()
  let mode = output_mode()
  if (string.str_eq(mode, "dump-desugared")):
    println(driver.desugar_source_with_kind(source, kind))
    return 0
  println(driver.analyze_source_with_kind(cwd, source, kind))
  return 0
