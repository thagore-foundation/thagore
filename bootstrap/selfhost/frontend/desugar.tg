from . import module_kind
import std.string as string

func append_space(out: str, value: str) -> str:
  if (string.len(value) == 0):
    return out
  if (string.len(out) == 0):
    return value
  return string.concat(out, string.concat(" ", value))

func is_decl_line(trimmed: str) -> bool:
  return string.starts_with(trimmed, "import ") or string.starts_with(trimmed, "from ") or string.starts_with(trimmed, "func ")

func is_control_flow_line(trimmed: str) -> bool:
  return string.starts_with(trimmed, "return ") or string.str_eq(trimmed, "return") or string.starts_with(trimmed, "break") or string.starts_with(trimmed, "continue")

func append_line(out: str, line: str) -> str:
  if (string.len(out) == 0):
    return line
  return string.concat(out, string.concat("\n", line))

func slice(text: str, start: i32, end: i32) -> str:
  return string.substr(text, start, end - start)

func starts_with_at(text: str, start: i32, needle: str) -> bool:
  if (start < 0 or start + string.len(needle) > string.len(text)):
    return false
  let offset: i32 = 0
  while (offset < string.len(needle)):
    if (string.str_eq(string.char_at(text, start + offset), string.char_at(needle, offset)) == false):
      return false
    offset = offset + 1
  return true

func find_next_func(source: str, start: i32) -> i32:
  let index: i32 = start
  while (index < string.len(source)):
    if (starts_with_at(source, index, "func ")):
      return index
    index = index + 1
  return -1

func find_char(text: str, needle: str, start: i32) -> i32:
  let index: i32 = start
  while (index < string.len(text)):
    if (string.str_eq(string.char_at(text, index), needle)):
      return index
    index = index + 1
  return -1

func find_body_colon(text: str) -> i32:
  let index: i32 = 0
  let depth: i32 = 0
  while (index < string.len(text)):
    let ch = string.char_at(text, index)
    if (string.str_eq(ch, "(")):
      depth = depth + 1
    if (string.str_eq(ch, ")") and depth > 0):
      depth = depth - 1
    if (depth == 0 and string.str_eq(ch, ":")):
      return index
    index = index + 1
  return -1

func contains_arrow_before_colon(text: str, colon: i32) -> bool:
  if (colon < 0):
    return false
  let index: i32 = 0
  while (index + 1 < colon):
    if (string.str_eq(string.char_at(text, index), "-") and string.str_eq(string.char_at(text, index + 1), ">")):
      return true
    index = index + 1
  return false

func choose_end(next_func: i32, source_len: i32) -> i32:
  if (next_func < 0):
    return source_len
  return next_func

func function_header(chunk: str) -> str:
  let colon = find_body_colon(chunk)
  if (colon < 0):
    return string.trim(chunk)
  return string.trim(slice(chunk, 0, colon))

func function_body(chunk: str) -> str:
  let colon = find_body_colon(chunk)
  if (colon < 0):
    return ""
  return slice(chunk, colon + 1, string.len(chunk))

func function_name(chunk: str) -> str:
  let header = function_header(chunk)
  let name_start = string.find(header, "func ")
  if (name_start < 0):
    return ""
  let open_paren = find_char(header, "(", name_start + 5)
  if (open_paren < 0):
    return ""
  return string.trim(slice(header, name_start + 5, open_paren))

func binding_key(name: str) -> str:
  return string.concat(name, "=")

func append_binding(table: str, name: str, ty: str) -> str:
  if (string.len(name) == 0 or string.len(ty) == 0):
    return table
  if (string.len(lookup_binding(table, name)) > 0):
    return table
  let entry = string.concat(binding_key(name), ty)
  if (string.len(table) == 0):
    return entry
  return string.concat(table, string.concat("\n", entry))

func lookup_binding(table: str, name: str) -> str:
  if (string.len(name) == 0 or string.len(table) == 0):
    return ""
  let prefix = binding_key(name)
  let lines = string.split(table, "\n")
  for line in lines:
    if (string.starts_with(line, prefix)):
      return slice(line, string.len(prefix), string.len(line))
  return ""

func add_param_bindings(table: str, chunk: str) -> str:
  let header = function_header(chunk)
  let open_paren = string.find(header, "(")
  if (open_paren < 0):
    return table
  let close_paren = find_char(header, ")", open_paren + 1)
  if (close_paren < 0):
    return table
  let params = string.trim(slice(header, open_paren + 1, close_paren))
  if (string.len(params) == 0):
    return table
  let parts = string.split(params, ",")
  for part in parts:
    let trimmed = string.trim(part)
    let colon = string.find(trimmed, ":")
    if (colon < 0):
      continue
    let name = string.trim(slice(trimmed, 0, colon))
    let ty = string.trim(slice(trimmed, colon + 1, string.len(trimmed)))
    table = append_binding(table, name, ty)
  return table

func add_local_binding(table: str, line: str) -> str:
  let trimmed = string.trim(line)
  if (string.starts_with(trimmed, "let ") == false):
    return table
  let colon = string.find(trimmed, ":")
  if (colon < 0):
    return table
  let name = string.trim(slice(trimmed, 4, colon))
  let equals = string.find(trimmed, "=")
  let type_end = string.len(trimmed)
  if (equals >= 0):
    type_end = equals
  let ty = string.trim(slice(trimmed, colon + 1, type_end))
  return append_binding(table, name, ty)

func infer_literal_type(expr: str) -> str:
  if (string.str_eq(expr, "true") or string.str_eq(expr, "false")):
    return "bool"
  if (string.len(expr) > 0 and string.str_eq(string.char_at(expr, 0), "\"")):
    return "str"
  let digits = "0123456789"
  let index: i32 = 0
  while (index < string.len(expr)):
    let ch = string.char_at(expr, index)
    if (string.contains(digits, ch) == false):
      return ""
    index = index + 1
  if (string.len(expr) > 0):
    return "i32"
  return ""

func infer_expr_type(expr: str, bindings: str, known_returns: str) -> str:
  let trimmed = string.trim(expr)
  let literal = infer_literal_type(trimmed)
  if (string.len(literal) > 0):
    return literal
  let binding = lookup_binding(bindings, trimmed)
  if (string.len(binding) > 0):
    return binding
  let open_paren = string.find(trimmed, "(")
  if (open_paren < 0):
    return ""
  let close_paren = find_char(trimmed, ")", open_paren + 1)
  if (close_paren != string.len(trimmed) - 1):
    return ""
  let callee = string.trim(slice(trimmed, 0, open_paren))
  return lookup_binding(known_returns, callee)

func collect_return_type(chunk: str, known_returns: str) -> str:
  let bindings = add_param_bindings("", chunk)
  let body = function_body(chunk)
  let lines = string.split(body, "\n")
  let return_type = ""
  for line in lines:
    bindings = add_local_binding(bindings, line)
    let trimmed = string.trim(line)
    if (string.starts_with(trimmed, "return ") == false):
      continue
    let expr = string.trim(slice(trimmed, 7, string.len(trimmed)))
    let inferred = infer_expr_type(expr, bindings, known_returns)
    if (string.len(inferred) == 0):
      return ""
    if (string.len(return_type) == 0):
      return_type = inferred
      continue
    if (string.str_eq(return_type, inferred) == false):
      return ""
  return return_type

func explicit_return_type(chunk: str) -> str:
  let header = function_header(chunk)
  let arrow = string.find(header, "->")
  if (arrow < 0):
    return ""
  return string.trim(slice(header, arrow + 2, string.len(header)))

func collect_known_return_types(source: str) -> str:
  let known = ""
  let index: i32 = 0
  while (index < string.len(source)):
    let func_start = find_next_func(source, index)
    if (func_start < 0):
      break
    let next_func = find_next_func(source, func_start + 5)
    let func_end = choose_end(next_func, string.len(source))
    let chunk = string.trim(slice(source, func_start, func_end))
    let explicit = explicit_return_type(chunk)
    if (string.len(explicit) > 0):
      known = append_binding(known, function_name(chunk), explicit)
    index = func_end
  let changed = true
  while (changed):
    changed = false
    index = 0
    while (index < string.len(source)):
      let func_start = find_next_func(source, index)
      if (func_start < 0):
        break
      let next_func = find_next_func(source, func_start + 5)
      let func_end = choose_end(next_func, string.len(source))
      let chunk = string.trim(slice(source, func_start, func_end))
      let name = function_name(chunk)
      if (string.len(lookup_binding(known, name)) == 0):
        let inferred = collect_return_type(chunk, known)
        if (string.len(inferred) > 0):
          known = append_binding(known, name, inferred)
          changed = true
      index = func_end
  return known

func rewrite_function(chunk: str, known_returns: str) -> str:
  let colon = find_body_colon(chunk)
  if (colon < 0):
    return chunk
  if (contains_arrow_before_colon(chunk, colon)):
    return chunk
  let inferred = collect_return_type(chunk, known_returns)
  if (string.len(inferred) == 0):
    return chunk
  let header = string.trim(slice(chunk, 0, colon))
  let body = slice(chunk, colon, string.len(chunk))
  return string.concat(header, string.concat(" -> ", string.concat(inferred, body)))

pub func infer_return_types(source: str) -> str:
  let known_returns = collect_known_return_types(source)
  let out = ""
  let index: i32 = 0
  while (index < string.len(source)):
    let func_start = find_next_func(source, index)
    if (func_start < 0):
      let tail = string.trim(slice(source, index, string.len(source)))
      return append_space(out, tail)
    let prefix = string.trim(slice(source, index, func_start))
    out = append_space(out, prefix)
    let next_func = find_next_func(source, func_start + 5)
    let func_end = choose_end(next_func, string.len(source))
    let chunk = string.trim(slice(source, func_start, func_end))
    out = append_space(out, rewrite_function(chunk, known_returns))
    index = func_end
  return out

pub func infer_return_type_issue(current_kind: str, source: str) -> str:
  if (module_kind.allows_top_layer_sugar(current_kind) == false):
    let index_no_sugar: i32 = 0
    while (index_no_sugar < string.len(source)):
      let func_start = find_next_func(source, index_no_sugar)
      if (func_start < 0):
        return ""
      let next_func = find_next_func(source, func_start + 5)
      let func_end = choose_end(next_func, string.len(source))
      let chunk = string.trim(slice(source, func_start, func_end))
      let colon = find_body_colon(chunk)
      if (colon >= 0 and contains_arrow_before_colon(chunk, colon) == false):
        return "selfhost core requires explicit return type"
      index_no_sugar = func_end
    return ""
  let known_returns = collect_known_return_types(source)
  let index: i32 = 0
  while (index < string.len(source)):
    let func_start = find_next_func(source, index)
    if (func_start < 0):
      return ""
    let next_func = find_next_func(source, func_start + 5)
    let func_end = choose_end(next_func, string.len(source))
    let chunk = string.trim(slice(source, func_start, func_end))
    let colon = find_body_colon(chunk)
    if (colon >= 0 and contains_arrow_before_colon(chunk, colon) == false):
      if (string.len(collect_return_type(chunk, known_returns)) == 0):
        return "cannot infer return type"
    index = func_end
  return ""

pub func top_level_control_flow_issue(current_kind: str, source: str) -> str:
  if (module_kind.allows_top_layer_sugar(current_kind) == false):
    return ""
  let lines = string.split(source, "\n")
  for line in lines:
    let trimmed = string.trim(line)
    if (string.len(trimmed) == 0 or is_decl_line(trimmed)):
      continue
    if (is_control_flow_line(trimmed)):
      return "top-level control flow is not allowed"
  return ""

pub func implicit_main(current_kind: str, source: str) -> str:
  if (module_kind.allows_top_layer_sugar(current_kind) == false):
    return source
  if (string.contains(source, "func main(")):
    return infer_return_types(source)
  let lines = string.split(source, "\n")
  let prefix = ""
  let body = ""
  for line in lines:
    let trimmed = string.trim(line)
    if (string.len(trimmed) == 0):
      continue
    if (is_decl_line(trimmed)):
      prefix = append_space(prefix, trimmed)
    else:
      body = append_space(body, trimmed)
  if (string.len(body) == 0):
    return source
  let synthesized = string.concat("func main() -> i32: ", body)
  let with_return = string.concat(synthesized, " return 0")
  return infer_return_types(append_space(prefix, with_return))
