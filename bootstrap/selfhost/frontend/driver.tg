from . import lexer
from . import parser
from . import symbols
from . import diagnostics
from . import resolver
import std.fs as fs
import std.string as string

pub func normalize_source(source: str) -> str:
  let normalized_crlf = string.replace(source, "\r\n", "\n")
  return string.replace(normalized_crlf, "\r", "\n")

pub func analyze_source(cwd: str, source: str) -> str:
  let normalized = normalize_source(source)
  let report = lexer.scan(normalized)
  let summary = parser.summary(report)
  let table = symbols.collect(report)
  let imports = resolver.resolve(cwd, normalized)
  let left = string.concat("tokens=", report)
  let with_summary = string.concat(left, string.concat(" || summary=", summary))
  let with_symbols = string.concat(with_summary, string.concat(" || symbols=", table))
  let with_imports = string.concat(with_symbols, string.concat(" || imports=", imports))
  let issues = diagnostics.analyze_semantics(summary, table, imports, cwd, normalized, report)
  return string.concat(with_imports, string.concat(" || diagnostics=", issues))

pub func analyze_path(cwd: str, path: str) -> str:
  let source = fs.read(path)
  if (string.len(source) == 0):
    return ""
  return analyze_source(cwd, source)
