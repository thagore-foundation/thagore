from . import lexer
from . import parser
from . import symbols
from . import resolver
from . import report
from . import session
import std.string as string

pub func main() -> i32:
  let path = session.input_path()
  let source = session.read_source(path)
  if (string.len(source) == 0):
    return 1
  let cwd = session.cwd()
  let kind = session.input_kind()
  let desugared = session.desugared_source(source, kind)
  let token_report = lexer.scan(desugared)
  let summary = parser.summary(token_report)
  let table = symbols.collect(token_report)
  let imports = resolver.resolve(cwd, desugared)
  println(report.full_report(token_report, summary, table, imports, "ok"))
  return 0
