import std.string as string

func normalize_path(path: str) -> str:
  return string.replace(path, "\\", "/")

func strip_exe_suffix(name: str) -> str:
  if (string.len(name) < 4):
    return name
  let start = string.len(name) - 4
  let suffix = ""
  let index: i32 = start
  while (index < string.len(name)):
    suffix = string.concat(suffix, string.char_at(name, index))
    index = index + 1
  if (string.str_eq(suffix, ".exe")):
    let trimmed = ""
    let inner: i32 = 0
    while (inner < start):
      trimmed = string.concat(trimmed, string.char_at(name, inner))
      inner = inner + 1
    return trimmed
  return name

func render_base(command: str, path: str, source_root: str, current_kind: str) -> str:
  let with_command = string.concat("command=", command)
  let with_entry = string.concat(with_command, string.concat(";entry=", normalize_path(path)))
  let with_root = string.concat(with_entry, string.concat(";source_root=", normalize_path(source_root)))
  return string.concat(with_root, string.concat(";kind=", current_kind))

func lowering_state(lowered: str) -> str:
  if (string.contains(lowered, "lowering-skipped")):
    return "skipped"
  if (string.contains(lowered, "lowering-unavailable")):
    return "unavailable"
  return "ready"

pub func phases(command: str) -> str:
  if (string.str_eq(command, "check")):
    return "read,desugar,scan,parse,resolve,check,report"
  if (string.str_eq(command, "build")):
    return "read,desugar,scan,parse,resolve,check,lower,adapter,host-emit,host-link,verify-artifact"
  if (string.str_eq(command, "run")):
    return "read,desugar,scan,parse,resolve,check,lower,adapter,host-emit,host-link,verify-artifact,host-run,capture"
  return "read,desugar,scan,parse,resolve,check"

pub func phase_route(command: str, diagnostics_ok: bool) -> str:
  if (string.str_eq(command, "check")):
    return "read>frontend-check>report"
  if (string.str_eq(command, "build")):
    if (diagnostics_ok):
      return "read>frontend-check>lower>adapter>host-emit>host-link>verify-artifact"
    return "read>frontend-check>diagnostic-fallback>host-emit>host-link>verify-artifact"
  if (string.str_eq(command, "run")):
    if (diagnostics_ok):
      return "read>frontend-check>lower>adapter>host-emit>host-link>verify-artifact>host-run"
    return "read>frontend-check>diagnostic-fallback>host-emit>host-link>verify-artifact>host-run"
  return "read>frontend-check"

pub func phase_gate(command: str, diagnostics_ok: bool) -> str:
  if (string.str_eq(command, "check")):
    return "frontend-report"
  if (diagnostics_ok):
    return "checked-lowered-emitted"
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    return "diagnostic-fallback"
  return "frontend-only"

pub func artifact_contract(command: str) -> str:
  if (string.str_eq(command, "build")):
    return "native-exe+rto"
  if (string.str_eq(command, "run")):
    return "native-exe+rto+stdout"
  if (string.str_eq(command, "check")):
    return "report-only"
  return "frontend-only"

pub func handoff(command: str, diagnostics_ok: bool) -> str:
  if (string.str_eq(command, "check")):
    return "frontend-report"
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    if (diagnostics_ok):
      return "backend-emission"
    return "host-fallback"
  return "frontend-only"

pub func backend_contract(command: str) -> str:
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    return "host-emit-link-v1"
  if (string.str_eq(command, "check")):
    return "frontend-report-v1"
  return "frontend-only"

pub func emits(command: str) -> str:
  if (string.str_eq(command, "build")):
    return "artifact,plan,adapter,emit,link,verify,lowered,host,runtime-object"
  if (string.str_eq(command, "run")):
    return "artifact,stdout,plan,adapter,emit,link,verify,lowered,host,runtime-object"
  if (string.str_eq(command, "check")):
    return "report"
  return "report"

pub func emission_input(command: str) -> str:
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    return "entry,artifact,capture,lowered-blocks,lowered-cfg,lowered-values,lowered-defs,lowered-uses,lowered-statements,lowered-terminators"
  return "entry"

pub func emission_output(command: str) -> str:
  if (string.str_eq(command, "build")):
    return "artifact,runtime-object"
  if (string.str_eq(command, "run")):
    return "artifact,runtime-object,stdout"
  if (string.str_eq(command, "check")):
    return "report"
  return "report"

pub func link_contract(command: str) -> str:
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    return "host-cc-link-v1"
  return "frontend-only"

pub func link_input(command: str) -> str:
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    return "artifact,runtime-object,linker,host-emit-output"
  return "frontend-only"

pub func link_output(command: str) -> str:
  if (string.str_eq(command, "build")):
    return "artifact"
  if (string.str_eq(command, "run")):
    return "artifact,stdout"
  return "report"

pub func verify_contract(command: str) -> str:
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    return "artifact-smoke-v1"
  return "frontend-only"

pub func verify_input(command: str) -> str:
  if (string.str_eq(command, "build") or string.str_eq(command, "run")):
    return "artifact,runtime-object"
  return "frontend-only"

pub func verify_output(command: str) -> str:
  if (string.str_eq(command, "build")):
    return "artifact-smoke"
  if (string.str_eq(command, "run")):
    return "artifact-smoke,stdout"
  return "report"

pub func lowering_shape(lowered: str) -> str:
  if (string.contains(lowered, "blocks=[") and string.contains(lowered, "#b") and string.contains(lowered, "values=[") and string.contains(lowered, "source=") and string.contains(lowered, "defs=[") and string.contains(lowered, "uses=[") and string.contains(lowered, "flows=[") and string.contains(lowered, "statements=[") and string.contains(lowered, "target=") and string.contains(lowered, "terminators=[") and string.contains(lowered, "value=")):
    return "typed-structured-flow-blockcfg"
  if (string.contains(lowered, "blocks=[") and string.contains(lowered, "#b") and string.contains(lowered, "values=[") and string.contains(lowered, "source=") and string.contains(lowered, "defs=[") and string.contains(lowered, "uses=[") and string.contains(lowered, "statements=[") and string.contains(lowered, "target=") and string.contains(lowered, "terminators=[") and string.contains(lowered, "value=")):
    return "typed-structured-defuse-blockcfg"
  if (string.contains(lowered, "blocks=[") and string.contains(lowered, "#b") and string.contains(lowered, "values=[") and string.contains(lowered, "defs=[") and string.contains(lowered, "uses=[") and string.contains(lowered, "statements=[") and string.contains(lowered, "terminators=[")):
    return "typed-defuse-blockcfg"
  if (string.contains(lowered, "values=[") and string.contains(lowered, "defs=[") and string.contains(lowered, "uses=[") and string.contains(lowered, "statements=[") and string.contains(lowered, "terminators=[")):
    return "typed-defuse-cfg"
  if (string.contains(lowered, "values=[") and string.contains(lowered, "statements=[") and string.contains(lowered, "terminators=[")):
    return "typed-cfg"
  if (string.contains(lowered, "lowering-skipped")):
    return "skipped"
  if (string.contains(lowered, "lowering-unavailable")):
    return "unavailable"
  return "summary"

pub func orchestration_plan(command: str, path: str, source_root: str, current_kind: str, diagnostics_ok: bool, artifact_name: str, lowered: str) -> str:
  let base = render_base(command, path, source_root, current_kind)
  let with_phases = string.concat(base, string.concat(";phases=", phases(command)))
  let status = "error"
  let route = "host-fallback"
  if (diagnostics_ok):
    status = "ok"
    route = "selfhost-checked"
  let with_status = string.concat(with_phases, string.concat(";diagnostics=", status))
  let with_route = string.concat(with_status, string.concat(";route=", route))
  let with_phase_route = string.concat(with_route, string.concat(";phase_route=", phase_route(command, diagnostics_ok)))
  let with_phase_gate = string.concat(with_phase_route, string.concat(";phase_gate=", phase_gate(command, diagnostics_ok)))
  let with_artifact = string.concat(with_phase_gate, string.concat(";artifact=", artifact_name))
  let with_runtime_object = string.concat(with_artifact, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_emits = string.concat(with_runtime_object, string.concat(";emits=", emits(command)))
  let with_contract = string.concat(with_emits, string.concat(";artifact_contract=", artifact_contract(command)))
  let with_handoff = string.concat(with_contract, string.concat(";handoff=", handoff(command, diagnostics_ok)))
  let with_backend_contract = string.concat(with_handoff, string.concat(";backend_contract=", backend_contract(command)))
  let with_link_contract = string.concat(with_backend_contract, string.concat(";link_contract=", link_contract(command)))
  let with_verify_contract = string.concat(with_link_contract, string.concat(";verify_contract=", verify_contract(command)))
  let with_lowering_state = string.concat(with_verify_contract, string.concat(";lowering_state=", lowering_state(lowered)))
  let with_lowering_shape = string.concat(with_lowering_state, string.concat(";lowering_shape=", lowering_shape(lowered)))
  return string.concat(with_lowering_shape, string.concat(";lowered=", lowered))

pub func adapter_request(command: str, path: str, source_root: str, current_kind: str, diagnostics_ok: bool, artifact_name: str, capture_name: str, lowered: str) -> str:
  let base = render_base(command, path, source_root, current_kind)
  let adapter_name = "host-thagc-build"
  let route = "host-fallback"
  if (string.str_eq(command, "run")):
    adapter_name = "host-thagc-build-run"
  if (diagnostics_ok):
    route = "selfhost-checked"
  let with_adapter = string.concat(base, string.concat(";adapter=", adapter_name))
  let with_phases = string.concat(with_adapter, string.concat(";phases=", phases(command)))
  let with_route = string.concat(with_phases, string.concat(";route=", route))
  let with_phase_route = string.concat(with_route, string.concat(";phase_route=", phase_route(command, diagnostics_ok)))
  let with_phase_gate = string.concat(with_phase_route, string.concat(";phase_gate=", phase_gate(command, diagnostics_ok)))
  let with_artifact = string.concat(with_phase_gate, string.concat(";artifact=", artifact_name))
  let with_capture = string.concat(with_artifact, string.concat(";capture=", capture_name))
  let with_runtime_object = string.concat(with_capture, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_emits = string.concat(with_runtime_object, string.concat(";emits=", emits(command)))
  let with_backend_input = string.concat(with_emits, string.concat(";backend_input=", emission_input(command)))
  let with_backend_output = string.concat(with_backend_input, string.concat(";backend_output=", emission_output(command)))
  let with_contract = string.concat(with_backend_output, string.concat(";artifact_contract=", artifact_contract(command)))
  let with_handoff = string.concat(with_contract, string.concat(";handoff=", handoff(command, diagnostics_ok)))
  let with_backend_contract = string.concat(with_handoff, string.concat(";backend_contract=", backend_contract(command)))
  let with_link_contract = string.concat(with_backend_contract, string.concat(";link_contract=", link_contract(command)))
  let with_verify_contract = string.concat(with_link_contract, string.concat(";verify_contract=", verify_contract(command)))
  let with_lowering_state = string.concat(with_verify_contract, string.concat(";lowering_state=", lowering_state(lowered)))
  let with_lowering_shape = string.concat(with_lowering_state, string.concat(";lowering_shape=", lowering_shape(lowered)))
  return string.concat(with_lowering_shape, string.concat(";lowered=", lowered))

pub func emission_request(command: str, path: str, source_root: str, current_kind: str, diagnostics_ok: bool, artifact_name: str, capture_name: str, lowered: str) -> str:
  let base = render_base(command, path, source_root, current_kind)
  let route = "host-fallback"
  if (diagnostics_ok):
    route = "selfhost-checked"
  let with_emitter = string.concat(base, ";emitter=host-thagc")
  let with_route = string.concat(with_emitter, string.concat(";route=", route))
  let with_phase_route = string.concat(with_route, string.concat(";phase_route=", phase_route(command, diagnostics_ok)))
  let with_phase_gate = string.concat(with_phase_route, string.concat(";phase_gate=", phase_gate(command, diagnostics_ok)))
  let with_artifact = string.concat(with_phase_gate, string.concat(";artifact=", artifact_name))
  let with_capture = string.concat(with_artifact, string.concat(";capture=", capture_name))
  let with_runtime_object = string.concat(with_capture, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_input = string.concat(with_runtime_object, string.concat(";emission_input=", emission_input(command)))
  let with_output = string.concat(with_input, string.concat(";emission_output=", emission_output(command)))
  let with_contract = string.concat(with_output, string.concat(";artifact_contract=", artifact_contract(command)))
  let with_handoff = string.concat(with_contract, string.concat(";handoff=", handoff(command, diagnostics_ok)))
  let with_backend_contract = string.concat(with_handoff, string.concat(";backend_contract=", backend_contract(command)))
  let with_link_contract = string.concat(with_backend_contract, string.concat(";link_contract=", link_contract(command)))
  let with_verify_contract = string.concat(with_link_contract, string.concat(";verify_contract=", verify_contract(command)))
  let with_lowering_state = string.concat(with_verify_contract, string.concat(";lowering_state=", lowering_state(lowered)))
  let with_lowering_shape = string.concat(with_lowering_state, string.concat(";lowering_shape=", lowering_shape(lowered)))
  return string.concat(with_lowering_shape, string.concat(";lowered=", lowered))

pub func link_request(command: str, path: str, source_root: str, current_kind: str, diagnostics_ok: bool, artifact_name: str, lowered: str) -> str:
  let base = render_base(command, path, source_root, current_kind)
  let route = "host-fallback"
  if (diagnostics_ok):
    route = "selfhost-checked"
  let with_linker = string.concat(base, ";linker=cc")
  let with_route = string.concat(with_linker, string.concat(";route=", route))
  let with_phase_route = string.concat(with_route, string.concat(";phase_route=", phase_route(command, diagnostics_ok)))
  let with_phase_gate = string.concat(with_phase_route, string.concat(";phase_gate=", phase_gate(command, diagnostics_ok)))
  let with_artifact = string.concat(with_phase_gate, string.concat(";artifact=", artifact_name))
  let with_runtime_object = string.concat(with_artifact, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_input = string.concat(with_runtime_object, string.concat(";link_input=", link_input(command)))
  let with_output = string.concat(with_input, string.concat(";link_output=", link_output(command)))
  let with_contract = string.concat(with_output, string.concat(";artifact_contract=", artifact_contract(command)))
  let with_handoff = string.concat(with_contract, string.concat(";handoff=", handoff(command, diagnostics_ok)))
  let with_backend_contract = string.concat(with_handoff, string.concat(";backend_contract=", backend_contract(command)))
  let with_link_contract = string.concat(with_backend_contract, string.concat(";link_contract=", link_contract(command)))
  let with_verify_contract = string.concat(with_link_contract, string.concat(";verify_contract=", verify_contract(command)))
  let with_lowering_state = string.concat(with_verify_contract, string.concat(";lowering_state=", lowering_state(lowered)))
  let with_lowering_shape = string.concat(with_lowering_state, string.concat(";lowering_shape=", lowering_shape(lowered)))
  return string.concat(with_lowering_shape, string.concat(";lowered=", lowered))

pub func verify_request(command: str, path: str, source_root: str, current_kind: str, diagnostics_ok: bool, artifact_name: str, lowered: str) -> str:
  let base = render_base(command, path, source_root, current_kind)
  let route = "host-fallback"
  if (diagnostics_ok):
    route = "selfhost-checked"
  let with_verifier = string.concat(base, ";verifier=artifact-smoke")
  let with_route = string.concat(with_verifier, string.concat(";route=", route))
  let with_phase_route = string.concat(with_route, string.concat(";phase_route=", phase_route(command, diagnostics_ok)))
  let with_phase_gate = string.concat(with_phase_route, string.concat(";phase_gate=", phase_gate(command, diagnostics_ok)))
  let with_artifact = string.concat(with_phase_gate, string.concat(";artifact=", artifact_name))
  let with_runtime_object = string.concat(with_artifact, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_input = string.concat(with_runtime_object, string.concat(";verify_input=", verify_input(command)))
  let with_output = string.concat(with_input, string.concat(";verify_output=", verify_output(command)))
  let with_contract = string.concat(with_output, string.concat(";artifact_contract=", artifact_contract(command)))
  let with_handoff = string.concat(with_contract, string.concat(";handoff=", handoff(command, diagnostics_ok)))
  let with_backend_contract = string.concat(with_handoff, string.concat(";backend_contract=", backend_contract(command)))
  let with_link_contract = string.concat(with_backend_contract, string.concat(";link_contract=", link_contract(command)))
  let with_verify_contract = string.concat(with_link_contract, string.concat(";verify_contract=", verify_contract(command)))
  let with_lowering_state = string.concat(with_verify_contract, string.concat(";lowering_state=", lowering_state(lowered)))
  let with_lowering_shape = string.concat(with_lowering_state, string.concat(";lowering_shape=", lowering_shape(lowered)))
  return string.concat(with_lowering_shape, string.concat(";lowered=", lowered))

pub func verify_completed(command: str, artifact_name: str, stdout_ready: bool) -> str:
  let with_command = string.concat("command=", command)
  let with_artifact = string.concat(with_command, string.concat(";artifact=", artifact_name))
  let with_runtime_object = string.concat(with_artifact, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_contract = string.concat(with_runtime_object, string.concat(";verify_contract=", verify_contract(command)))
  let verified = "artifact,runtime-object"
  let result = "artifact-ready"
  let probe = "spawn-artifact"
  if (stdout_ready):
    verified = "artifact,runtime-object,stdout"
    result = "artifact-ready+stdout"
    probe = "spawn-artifact+capture"
  let with_verified = string.concat(with_contract, string.concat(";verified=", verified))
  let with_result = string.concat(with_verified, string.concat(";artifact_result=", result))
  let with_artifact_ready = string.concat(with_result, ";artifact_ready=true")
  let with_probe = string.concat(with_result, string.concat(";probe=", probe))
  let with_runtime = string.concat(with_artifact_ready, string.concat(";probe=", string.concat(probe, ";runtime_object_ready=true")))
  if (stdout_ready):
    return string.concat(with_runtime, ";stdout_ready=true;phase_complete=verify-artifact;status=ok")
  return string.concat(with_runtime, ";stdout_ready=false;phase_complete=verify-artifact;status=ok")

pub func emission_completed(command: str, artifact_name: str, stdout_ready: bool, lowered: str) -> str:
  let with_command = string.concat("command=", command)
  let with_artifact = string.concat(with_command, string.concat(";artifact=", artifact_name))
  let with_runtime_object = string.concat(with_artifact, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_input = string.concat(with_runtime_object, string.concat(";emission_input=", emission_input(command)))
  let with_output = string.concat(with_input, string.concat(";emission_output=", emission_output(command)))
  let with_contract = string.concat(with_output, string.concat(";artifact_contract=", artifact_contract(command)))
  let with_backend = string.concat(with_contract, string.concat(";backend_contract=", backend_contract(command)))
  let with_verify = string.concat(with_backend, string.concat(";verify_contract=", verify_contract(command)))
  let with_lowering = string.concat(with_verify, string.concat(";lowering_shape=", lowering_shape(lowered)))
  let with_artifact_ready = string.concat(with_lowering, ";artifact_ready=true;runtime_object_ready=true")
  if (stdout_ready):
    return string.concat(with_artifact_ready, ";stdout_ready=true;phase_complete=host-emit;status=ok")
  return string.concat(with_artifact_ready, ";stdout_ready=false;phase_complete=host-emit;status=ok")

pub func link_completed(command: str, artifact_name: str, stdout_ready: bool, lowered: str) -> str:
  let with_command = string.concat("command=", command)
  let with_artifact = string.concat(with_command, string.concat(";artifact=", artifact_name))
  let with_runtime_object = string.concat(with_artifact, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_input = string.concat(with_runtime_object, string.concat(";link_input=", link_input(command)))
  let with_output = string.concat(with_input, string.concat(";link_output=", link_output(command)))
  let with_contract = string.concat(with_output, string.concat(";artifact_contract=", artifact_contract(command)))
  let with_link = string.concat(with_contract, string.concat(";link_contract=", link_contract(command)))
  let with_verify = string.concat(with_link, string.concat(";verify_contract=", verify_contract(command)))
  let with_lowering = string.concat(with_verify, string.concat(";lowering_shape=", lowering_shape(lowered)))
  let with_ready = string.concat(with_lowering, ";artifact_ready=true;runtime_object_ready=true;link_ready=true")
  if (stdout_ready):
    return string.concat(with_ready, ";stdout_ready=true;phase_complete=host-link;status=ok")
  return string.concat(with_ready, ";stdout_ready=false;phase_complete=host-link;status=ok")

pub func build_command(host_thagc: str, path: str, output_path: str) -> str:
  return string.concat(host_thagc, string.concat(" build ", string.concat(path, string.concat(" -o ", output_path))))

pub func run_command(output_path: str, capture_file: str) -> str:
  return string.concat(output_path, string.concat(" > ", capture_file))

pub func runtime_object_name(artifact_name: str) -> str:
  return string.concat(strip_exe_suffix(artifact_name), ".thagore_rt.o")

pub func host_command_summary(command: str, host_thagc: str, path: str, artifact_name: str, capture_name: str) -> str:
  let binary = host_thagc
  if (string.str_eq(binary, "thagc.exe")):
    binary = "thagc"
  let base = string.concat("host=", binary)
  let with_action = string.concat(base, string.concat(";action=", command))
  let with_entry = string.concat(with_action, string.concat(";entry=", normalize_path(path)))
  let with_artifact = string.concat(with_entry, string.concat(";artifact=", artifact_name))
  let with_runtime_object = string.concat(with_artifact, string.concat(";runtime_object=", runtime_object_name(artifact_name)))
  let with_linker = string.concat(with_runtime_object, ";linker=cc")
  if (string.str_eq(command, "run")):
    return string.concat(with_linker, string.concat(";capture=", capture_name))
  return with_linker

pub func plan_artifact_name(artifact_name: str) -> str:
  return string.concat(artifact_name, ".plan.txt")

pub func request_artifact_name(artifact_name: str) -> str:
  return string.concat(artifact_name, ".adapter.txt")

pub func lowered_artifact_name(artifact_name: str) -> str:
  return string.concat(artifact_name, ".lowered.txt")

pub func host_command_artifact_name(artifact_name: str) -> str:
  return string.concat(artifact_name, ".host.txt")

pub func emission_artifact_name(artifact_name: str) -> str:
  return string.concat(artifact_name, ".emit.txt")

pub func link_artifact_name(artifact_name: str) -> str:
  return string.concat(artifact_name, ".link.txt")

pub func verify_artifact_name(artifact_name: str) -> str:
  return string.concat(artifact_name, ".verify.txt")
