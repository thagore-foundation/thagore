import std.array as array
import std.string as string

func token_kind(token: str) -> str:
  let out = ""
  let index: i32 = 0
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    if (string.str_eq(ch, "(")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

func token_text(token: str) -> str:
  let start = string.find(token, "(")
  if (start < 0):
    return ""
  let out = ""
  let index: i32 = start + 1
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    let next = string.char_at(token, index + 1)
    if (string.str_eq(ch, ")") and string.str_eq(next, "@")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

func append_entry(out: str, name: str, kind: str) -> str:
  let entry = string.concat(name, string.concat(":", kind))
  if (string.len(out) == 0):
    return entry
  return string.concat(out, string.concat(" | ", entry))

pub func collect(report: str) -> str:
  let tokens = string.split(report, " | ")
  let count = array.len(tokens)
  let out = ""
  let index: i32 = 0

  while (index < count):
    let current = array.get(tokens, index)
    let kind = token_kind(current)
    let text = token_text(current)

    if (string.str_eq(kind, "kw") and string.str_eq(text, "func") and (index + 1) < count):
      out = append_entry(out, token_text(array.get(tokens, index + 1)), "func")
      index = index + 2
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "let") and (index + 1) < count):
      out = append_entry(out, token_text(array.get(tokens, index + 1)), "local")
      index = index + 2
      continue

    index = index + 1

  return out
