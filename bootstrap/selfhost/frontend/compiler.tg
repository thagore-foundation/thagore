from . import pipeline
from . import session
from . import module_kind
from . import lower
from . import adapter
import std.fs as fs
import std.process as process
import std.string as string

func command_name() -> str:
  let arg = process.argv(1)
  if (string.len(arg) > 0):
    return arg
  return "help"

func command_path() -> str:
  return process.argv(2)

func command_option() -> str:
  return process.argv(3)

func command_kind(command: str) -> str:
  if (string.str_eq(command, "build") or string.str_eq(command, "run") or string.str_eq(command, "plan-build") or string.str_eq(command, "plan-run") or string.str_eq(command, "adapter-build") or string.str_eq(command, "adapter-run") or string.str_eq(command, "emit-build") or string.str_eq(command, "emit-run")):
    return module_kind.executable_root()
  let arg = process.argv(3)
  if (string.str_eq(arg, "library")):
    return module_kind.library_module()
  if (string.str_eq(arg, "core-exe")):
    return module_kind.selfhost_core_executable_root()
  if (string.str_eq(arg, "core-library")):
    return module_kind.selfhost_core_library_module()
  return module_kind.executable_root()

func usage() -> str:
  return "usage: frontend-compiler <help|version|analyze|check|report|desugar|scan|parse|build|run> [path] [exe|library|core-exe|core-library|artifact]"

func version() -> str:
  return "frontend-compiler bootstrap-slice"

func host_thagc() -> str:
  let configured = process.env("THAGORE_STAGE0")
  if (string.len(configured) > 0):
    return configured
  return "thagc"

func scratch_root() -> str:
  let configured = process.env("THAGORE_SELFHOST_TMP")
  if (string.len(configured) > 0):
    return configured
  return session.cwd()

func ensure_scratch_root() -> bool:
  let root = scratch_root()
  if (string.len(root) == 0):
    return false
  if (fs.is_dir(root)):
    return true
  return fs.mkdir(root)

func artifact_name() -> str:
  return command_option()

func artifact_path() -> str:
  let name = artifact_name()
  if (string.len(name) == 0):
    return ""
  return fs.path_join(scratch_root(), name)

func capture_path(output_path: str) -> str:
  return string.concat(output_path, ".stdout.txt")

func plan_artifact_path(output_path: str) -> str:
  return string.concat(output_path, ".plan.txt")

func request_artifact_path(output_path: str) -> str:
  return string.concat(output_path, ".adapter.txt")

func lowered_artifact_path(output_path: str) -> str:
  return string.concat(output_path, ".lowered.txt")

func host_command_artifact_path(output_path: str) -> str:
  return string.concat(output_path, ".host.txt")

func emission_artifact_path(output_path: str) -> str:
  return string.concat(output_path, ".emit.txt")

func actual_command(command: str) -> str:
  if (string.str_eq(command, "plan-build") or string.str_eq(command, "adapter-build") or string.str_eq(command, "emit-build")):
    return "build"
  if (string.str_eq(command, "plan-run") or string.str_eq(command, "adapter-run") or string.str_eq(command, "emit-run")):
    return "run"
  if (string.str_eq(command, "plan-check")):
    return "check"
  return command

func has_clean_diagnostics(report: str) -> bool:
  return string.contains(report, "diagnostics=ok")

func source_report(path: str, current_kind: str) -> str:
  let source = session.read_source(path)
  if (string.len(source) == 0):
    return ""
  let source_root = session.source_dir(path)
  return pipeline.full_report(source_root, source, current_kind)

func lowering_summary(path: str, diagnostics_ok: bool, require_lowering: bool) -> str:
  if (require_lowering == false):
    return "lowering-skipped(route=frontend-only)"
  if (diagnostics_ok == false):
    return "lowering-skipped(route=host-fallback)"
  let source = session.read_source(path)
  if (string.len(source) == 0):
    return ""
  let lowered = lower.lower_report(source)
  if (string.len(lowered) == 0):
    return "lowering-unavailable"
  return lowered

func orchestration_plan(command: str, path: str, current_kind: str) -> str:
  let actual = actual_command(command)
  let report = source_report(path, current_kind)
  if (string.len(report) == 0):
    return ""
  let source_root = session.source_dir(path)
  let diagnostics_ok = has_clean_diagnostics(report)
  let require_lowering = string.str_eq(actual, "build") or string.str_eq(actual, "run")
  let lowered = lowering_summary(path, diagnostics_ok, require_lowering)
  let artifact = ""
  if (string.str_eq(actual, "build") or string.str_eq(actual, "run")):
    artifact = artifact_name()
  return adapter.orchestration_plan(actual, path, source_root, current_kind, diagnostics_ok, artifact, lowered)

func adapter_preview(command: str, path: str, current_kind: str) -> str:
  let actual = actual_command(command)
  if (string.str_eq(actual, "build") == false and string.str_eq(actual, "run") == false):
    return ""
  let report = source_report(path, current_kind)
  if (string.len(report) == 0):
    return ""
  let diagnostics_ok = has_clean_diagnostics(report)
  let lowered = lowering_summary(path, diagnostics_ok, true)
  let output_path = artifact_path()
  if (string.len(output_path) == 0):
    return ""
  return adapter.adapter_request(actual, path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), capture_path(artifact_name()), lowered)

func emission_preview(command: str, path: str, current_kind: str) -> str:
  let actual = actual_command(command)
  if (string.str_eq(actual, "build") == false and string.str_eq(actual, "run") == false):
    return ""
  let report = source_report(path, current_kind)
  if (string.len(report) == 0):
    return ""
  let diagnostics_ok = has_clean_diagnostics(report)
  let lowered = lowering_summary(path, diagnostics_ok, true)
  let output_path = artifact_path()
  if (string.len(output_path) == 0):
    return ""
  return adapter.emission_request(actual, path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), capture_path(artifact_name()), lowered)

func run_command(command: str, path: str, current_kind: str) -> str:
  let source = session.read_source(path)
  if (string.len(source) == 0):
    return ""
  let source_root = session.source_dir(path)
  if (string.str_eq(command, "analyze")):
    return pipeline.full_report(source_root, source, current_kind)
  if (string.str_eq(command, "check")):
    return pipeline.full_report(source_root, source, current_kind)
  if (string.str_eq(command, "report")):
    return pipeline.normalized_report(source_root, source, current_kind)
  if (string.str_eq(command, "desugar")):
    return pipeline.desugared_source(source, current_kind)
  if (string.str_eq(command, "scan")):
    return pipeline.scan_report(source, current_kind)
  if (string.str_eq(command, "parse")):
    return pipeline.parse_report(source_root, source, current_kind)
  return ""

pub func main() -> i32:
  let command = command_name()
  if (string.str_eq(command, "help")):
    println(usage())
    return 0
  if (string.str_eq(command, "version")):
    println(version())
    return 0
  let path = command_path()
  if (string.len(path) == 0):
    println(usage())
    return 1
  if (string.str_eq(command, "plan-check") or string.str_eq(command, "plan-build") or string.str_eq(command, "plan-run")):
    let current_kind = command_kind(command)
    let plan = orchestration_plan(command, path, current_kind)
    if (string.len(plan) == 0):
      return 1
    println(plan)
    return 0
  if (string.str_eq(command, "adapter-build") or string.str_eq(command, "adapter-run")):
    let current_kind = command_kind(command)
    let preview = adapter_preview(command, path, current_kind)
    if (string.len(preview) == 0):
      return 1
    println(preview)
    return 0
  if (string.str_eq(command, "emit-build") or string.str_eq(command, "emit-run")):
    let current_kind = command_kind(command)
    let preview = emission_preview(command, path, current_kind)
    if (string.len(preview) == 0):
      return 1
    println(preview)
    return 0
  if (string.str_eq(command, "build")):
    let current_kind = command_kind(command)
    let report = source_report(path, current_kind)
    if (string.len(report) == 0):
      return 1
    let diagnostics_ok = has_clean_diagnostics(report)
    let lowered = lowering_summary(path, diagnostics_ok, true)
    let output_path = artifact_path()
    if (string.len(output_path) == 0 or ensure_scratch_root() == false):
      println(usage())
      return 1
    let plan = adapter.orchestration_plan("build", path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), lowered)
    let request = adapter.adapter_request("build", path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), capture_path(artifact_name()), lowered)
    let emission = adapter.emission_request("build", path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), capture_path(artifact_name()), lowered)
    let host_command = adapter.build_command(host_thagc(), path, output_path)
    let host_summary = adapter.host_command_summary("build", host_thagc(), path, artifact_name(), "")
    fs.write(plan_artifact_path(output_path), plan)
    fs.write(request_artifact_path(output_path), request)
    fs.write(emission_artifact_path(output_path), emission)
    fs.write(lowered_artifact_path(output_path), lowered)
    fs.write(host_command_artifact_path(output_path), host_summary)
    let exit_code = process.run(host_command)
    if (exit_code != 0):
      return exit_code
    if (fs.exists(output_path) == false):
      return 1
    println(string.concat("built=", artifact_name()))
    return 0
  if (string.str_eq(command, "run")):
    let current_kind = command_kind(command)
    let report = source_report(path, current_kind)
    if (string.len(report) == 0):
      return 1
    let diagnostics_ok = has_clean_diagnostics(report)
    let lowered = lowering_summary(path, diagnostics_ok, true)
    let output_path = artifact_path()
    if (string.len(output_path) == 0 or ensure_scratch_root() == false):
      println(usage())
      return 1
    let plan = adapter.orchestration_plan("run", path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), lowered)
    let request = adapter.adapter_request("run", path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), capture_path(artifact_name()), lowered)
    let emission = adapter.emission_request("run", path, session.source_dir(path), current_kind, diagnostics_ok, artifact_name(), capture_path(artifact_name()), lowered)
    let build_command = adapter.build_command(host_thagc(), path, output_path)
    let run_command = adapter.run_command(output_path, capture_path(output_path))
    let host_summary = adapter.host_command_summary("run", host_thagc(), path, artifact_name(), capture_path(artifact_name()))
    fs.write(plan_artifact_path(output_path), plan)
    fs.write(request_artifact_path(output_path), request)
    fs.write(emission_artifact_path(output_path), emission)
    fs.write(lowered_artifact_path(output_path), lowered)
    fs.write(host_command_artifact_path(output_path), host_summary)
    let build_code = process.run(build_command)
    if (build_code != 0):
      return build_code
    if (fs.exists(output_path) == false):
      return 1
    let captured = capture_path(output_path)
    fs.remove(captured)
    let run_code = process.run(adapter.run_command(output_path, captured))
    let output = session.read_source(captured)
    fs.remove(captured)
    fs.remove(output_path)
    if (string.len(output) > 0):
      println(output)
    return run_code
  let current_kind = command_kind(command)
  let output = run_command(command, path, current_kind)
  if (string.len(output) == 0):
    if (string.str_eq(command, "analyze") or string.str_eq(command, "check") or string.str_eq(command, "report") or string.str_eq(command, "desugar") or string.str_eq(command, "scan") or string.str_eq(command, "parse")):
      return 1
    println(usage())
    return 1
  println(output)
  return 0
