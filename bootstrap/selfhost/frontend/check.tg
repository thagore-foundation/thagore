from . import driver
from . import session
import std.string as string

pub func main() -> i32:
  let path = session.input_path()
  let source = session.read_source(path)
  if (string.len(source) == 0):
    return 1
  let cwd = session.cwd()
  let kind = session.input_kind()
  let mode = session.output_mode("check", "dump-report", "")
  if (string.str_eq(mode, "dump-report")):
    println(driver.report_source_with_kind(cwd, source, kind))
    return 0
  println(driver.analyze_source_with_kind(cwd, source, kind))
  return 0
