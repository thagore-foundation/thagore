import std.array as array
import std.string as string

func token_kind(token: str) -> str:
  let out = ""
  let index: i32 = 0
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    if (string.str_eq(ch, "(")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

func token_text(token: str) -> str:
  let start = string.find(token, "(")
  if (start < 0):
    return ""
  let out = ""
  let index: i32 = start + 1
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    let next = ""
    if ((index + 1) < string.len(token)):
      next = string.char_at(token, index + 1)
    if (string.str_eq(ch, ")") and string.str_eq(next, "@")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

pub func summary(report: str) -> str:
  let tokens = string.split(report, " | ")
  let token_count = array.len(tokens)
  let func_name = ""
  let return_type = ""
  let local_name = ""
  let local_type = ""
  let local_value = ""
  let local_count: i32 = 0
  let return_ident = ""
  let index: i32 = 0

  while (index < token_count):
    let current = array.get(tokens, index)
    let kind = token_kind(current)
    let text = token_text(current)

    if (string.str_eq(kind, "kw") and string.str_eq(text, "func") and (index + 5) < token_count):
      func_name = token_text(array.get(tokens, index + 1))
      return_type = token_text(array.get(tokens, index + 5))
      index = index + 6
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "let") and (index + 5) < token_count):
      local_name = token_text(array.get(tokens, index + 1))
      local_type = token_text(array.get(tokens, index + 3))
      local_value = token_text(array.get(tokens, index + 5))
      local_count = local_count + 1
      index = index + 6
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "let") and (index + 1) < token_count):
      local_name = token_text(array.get(tokens, index + 1))
      local_type = ""
      local_value = ""
      local_count = local_count + 1
      index = index + 2
      continue

    if (string.str_eq(kind, "kw") and string.str_eq(text, "return") and (index + 1) < token_count):
      return_ident = token_text(array.get(tokens, index + 1))
      index = index + 2
      continue

    index = index + 1

  let base = string.concat("func=", func_name)
  let with_return = string.concat(base, string.concat(";return=", return_type))
  let with_locals = string.concat(with_return, string.concat(";locals=", string.from_int(local_count)))
  let local_binding = string.concat(local_name, string.concat(":", string.concat(local_type, string.concat("=", local_value))))
  let with_first_local = string.concat(with_locals, string.concat(";first_local=", local_binding))
  return string.concat(with_first_local, string.concat(";return_ident=", return_ident))
