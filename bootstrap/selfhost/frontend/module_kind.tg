import std.string as string

pub func executable_root() -> str:
  return "executable-root"

pub func selfhost_core_executable_root() -> str:
  return "selfhost-core-executable-root"

pub func library_module() -> str:
  return "library-module"

pub func selfhost_core_library_module() -> str:
  return "selfhost-core-library-module"

pub func allows_top_layer_sugar(module_kind: str) -> bool:
  return string.str_eq(module_kind, executable_root())

func is_library_kind(module_kind: str) -> bool:
  return string.str_eq(module_kind, library_module()) or string.str_eq(module_kind, selfhost_core_library_module())

func is_core_kind(module_kind: str) -> bool:
  return string.str_eq(module_kind, selfhost_core_executable_root()) or string.str_eq(module_kind, selfhost_core_library_module())

func line_starts_with(line: str, prefix: str) -> bool:
  let trimmed = string.trim(line)
  return string.starts_with(trimmed, prefix)

pub func validate_top_level(module_kind: str, source: str) -> str:
  let lines = string.split(source, "\n")
  for line in lines:
    let trimmed = string.trim(line)
    if (string.len(trimmed) == 0):
      continue
    if (line_starts_with(trimmed, "import ") or line_starts_with(trimmed, "from ") or line_starts_with(trimmed, "func ")):
      continue
    if (is_library_kind(module_kind)):
      return "library module has top-level statements"
    if (is_core_kind(module_kind)):
      return "selfhost core executable requires explicit main"
  return ""
