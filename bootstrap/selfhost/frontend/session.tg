from . import module_kind
from . import desugar
import std.fs as fs
import std.process as process
import std.string as string

pub func input_path() -> str:
  let arg = process.argv(1)
  if (string.len(arg) > 0):
    return arg
  return "bootstrap/selfhost/corpus/fixtures/bootstrap_seed/sample.tg"

pub func input_kind() -> str:
  let arg = process.argv(2)
  if (string.str_eq(arg, "library")):
    return module_kind.library_module()
  if (string.str_eq(arg, "core-exe")):
    return module_kind.selfhost_core_executable_root()
  if (string.str_eq(arg, "core-library")):
    return module_kind.selfhost_core_library_module()
  return module_kind.executable_root()

pub func output_mode(default_mode: str, first_mode: str, second_mode: str) -> str:
  let arg = process.argv(3)
  if (string.str_eq(arg, first_mode)):
    return arg
  if (string.len(second_mode) > 0 and string.str_eq(arg, second_mode)):
    return arg
  return default_mode

pub func read_source(path: str) -> str:
  return fs.read(path)

pub func cwd() -> str:
  return fs.getcwd()

pub func source_dir(path: str) -> str:
  let normalized = string.replace(path, "\\", "/")
  let last_sep: i32 = -1
  let index: i32 = 0
  while (index < string.len(normalized)):
    if (string.str_eq(string.char_at(normalized, index), "/")):
      last_sep = index
    index = index + 1
  if (last_sep < 0):
    return fs.getcwd()
  let out = ""
  let slice_index: i32 = 0
  while (slice_index < last_sep):
    out = string.concat(out, string.char_at(normalized, slice_index))
    slice_index = slice_index + 1
  if (string.len(out) == 0):
    return fs.getcwd()
  return out

pub func normalize_source(source: str) -> str:
  let normalized_crlf = string.replace(source, "\r\n", "\n")
  return string.replace(normalized_crlf, "\r", "\n")

pub func desugared_source(source: str, kind: str) -> str:
  let normalized = normalize_source(source)
  return desugar.implicit_main(kind, normalized)
