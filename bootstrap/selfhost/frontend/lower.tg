from . import lexer
from . import session
import std.array as array
import std.string as string

func token_at(tokens: Array[str], index: i32) -> str:
  if (index < 0 or index >= array.len(tokens)):
    return ""
  return array.get(tokens, index)

func token_kind(token: str) -> str:
  let out = ""
  let index: i32 = 0
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    if (string.str_eq(ch, "(")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

func token_text(token: str) -> str:
  let start = string.find(token, "(")
  if (start < 0):
    return ""
  let out = ""
  let index: i32 = start + 1
  while (index < string.len(token)):
    let ch = string.char_at(token, index)
    let next = ""
    if ((index + 1) < string.len(token)):
      next = string.char_at(token, index + 1)
    if (string.str_eq(ch, ")") and string.str_eq(next, "@")):
      return out
    out = string.concat(out, ch)
    index = index + 1
  return out

func token_matches(tokens: Array[str], index: i32, kind: str, text: str) -> bool:
  let current = token_at(tokens, index)
  if (string.len(current) == 0):
    return false
  return string.str_eq(token_kind(current), kind) and string.str_eq(token_text(current), text)

func token_is_kind(tokens: Array[str], index: i32, kind: str) -> bool:
  let current = token_at(tokens, index)
  if (string.len(current) == 0):
    return false
  return string.str_eq(token_kind(current), kind)

func token_value(tokens: Array[str], index: i32) -> str:
  let current = token_at(tokens, index)
  if (string.len(current) == 0):
    return ""
  return token_text(current)

func append_csv(items: str, value: str) -> str:
  if (string.len(value) == 0):
    return items
  if (string.len(items) == 0):
    return value
  return string.concat(items, string.concat(",", value))

func append_unique(items: str, value: str) -> str:
  if (string.len(value) == 0):
    return items
  if (string.len(items) == 0):
    return value
  let parts = string.split(items, ",")
  for part in parts:
    if (string.str_eq(part, value)):
      return items
  return string.concat(items, string.concat(",", value))

func append_mapping(items: str, name: str, value: str) -> str:
  if (string.len(name) == 0 or string.len(value) == 0):
    return items
  return append_unique(items, string.concat(name, string.concat(":", value)))

func lookup_mapping(items: str, name: str) -> str:
  if (string.len(items) == 0 or string.len(name) == 0):
    return ""
  let parts = string.split(items, ",")
  for part in parts:
    let sep = string.find(part, ":")
    if (sep < 0):
      continue
    let key = ""
    let value = ""
    let index: i32 = 0
    while (index < string.len(part)):
      let ch = string.char_at(part, index)
      if (index < sep):
        key = string.concat(key, ch)
      if (index > sep):
        value = string.concat(value, ch)
      index = index + 1
    if (string.str_eq(key, name)):
      return value
  return ""

func wrap_list(items: str) -> str:
  return string.concat("[", string.concat(items, "]"))

func literal_type(tokens: Array[str], index: i32) -> str:
  if (token_is_kind(tokens, index, "int")):
    return "i32"
  if (token_matches(tokens, index, "kw", "true") or token_matches(tokens, index, "kw", "false") or token_matches(tokens, index, "ident", "true") or token_matches(tokens, index, "ident", "false")):
    return "bool"
  return ""

func call_name(tokens: Array[str], index: i32) -> str:
  if (token_is_kind(tokens, index, "ident") and token_matches(tokens, index + 1, "punct", "(")):
    return token_value(tokens, index)
  return ""

func load_name(tokens: Array[str], index: i32) -> str:
  if (token_is_kind(tokens, index, "ident") and token_matches(tokens, index + 1, "punct", "(") == false):
    return token_value(tokens, index)
  return ""

func value_type(tokens: Array[str], index: i32, locals: str, funcs: str, hinted_type: str) -> str:
  let literal = literal_type(tokens, index)
  if (string.len(literal) > 0):
    return literal
  let call = call_name(tokens, index)
  if (string.len(call) > 0):
    if (string.len(hinted_type) > 0):
      return hinted_type
    return lookup_mapping(funcs, call)
  let load = load_name(tokens, index)
  if (string.len(load) > 0):
    let local_type = lookup_mapping(locals, load)
    if (string.len(local_type) > 0):
      return local_type
    if (string.len(hinted_type) > 0):
      return hinted_type
    return lookup_mapping(funcs, load)
  return hinted_type

func rhs_state(tokens: Array[str], index: i32, locals: str, funcs: str, hinted_type: str) -> str:
  let literal = literal_type(tokens, index)
  if (string.len(literal) > 0):
    return string.concat("const;", string.concat(string.concat("const(", string.concat(literal, ")")), string.concat(";", string.concat(literal, string.concat(";const:", literal)))))
  let call = call_name(tokens, index)
  if (string.len(call) > 0):
    let result_type = value_type(tokens, index, locals, funcs, hinted_type)
    let ir = string.concat("call(", string.concat(call, string.concat("->", string.concat(result_type, ")"))))
    let descriptor = string.concat("call:", string.concat(call, string.concat("->", result_type)))
    return string.concat("call;", string.concat(ir, string.concat(";", string.concat(result_type, string.concat(";", descriptor)))))
  let load = load_name(tokens, index)
  if (string.len(load) > 0):
    let result_type = value_type(tokens, index, locals, funcs, hinted_type)
    let ir = string.concat("load(", string.concat(load, string.concat(":", string.concat(result_type, ")"))))
    let descriptor = string.concat("load:", string.concat(load, string.concat(":", result_type)))
    return string.concat("load;", string.concat(ir, string.concat(";", string.concat(result_type, string.concat(";", descriptor)))))
  let result_type = value_type(tokens, index, locals, funcs, hinted_type)
  if (string.len(result_type) > 0):
    let ir = string.concat("value(", string.concat(result_type, ")"))
    let descriptor = string.concat("value:", result_type)
    return string.concat("value;", string.concat(ir, string.concat(";", string.concat(result_type, string.concat(";", descriptor)))))
  return "unknown;;;unknown"

func split_state(state: str, part: i32) -> str:
  let parts = string.split(state, ";")
  if (part < 0 or part >= array.len(parts)):
    return ""
  return array.get(parts, part)

func rhs_ir(state: str) -> str:
  return split_state(state, 1)

func rhs_descriptor(state: str) -> str:
  return split_state(state, 3)

func append_block_ir(ir: str, block: str, op: str) -> str:
  if (string.len(op) == 0):
    return ir
  return append_csv(ir, string.concat(block, string.concat(":", op)))

func append_rhs_ir(ir: str, block: str, state: str) -> str:
  let op = rhs_ir(state)
  if (string.len(op) == 0):
    return ir
  return append_block_ir(ir, block, op)

func append_edge(edges: str, from_block: str, to_block: str) -> str:
  if (string.len(from_block) == 0 or string.len(to_block) == 0):
    return edges
  return append_unique(edges, string.concat(from_block, string.concat("->", to_block)))

func is_assignment_target(tokens: Array[str], index: i32) -> bool:
  if (token_is_kind(tokens, index, "ident") == false):
    return false
  if (token_matches(tokens, index + 1, "punct", "=") == false):
    return false
  if (token_matches(tokens, index - 1, "punct", ":") and token_matches(tokens, index - 3, "kw", "let")):
    return false
  return true

func render_function(name: str, return_type: str, locals: str, blocks: str, edges: str, ir: str) -> str:
  let with_name = string.concat("fn=", name)
  let with_sig = string.concat(with_name, string.concat(";sig=()->", return_type))
  let with_locals = string.concat(with_sig, string.concat(";locals=", wrap_list(locals)))
  let with_blocks = string.concat(with_locals, string.concat(";blocks=", wrap_list(blocks)))
  let with_cfg = string.concat(with_blocks, string.concat(";cfg=", wrap_list(edges)))
  return string.concat(with_cfg, string.concat(";ir=", wrap_list(ir)))

func append_function(out: str, line: str) -> str:
  if (string.len(out) == 0):
    return line
  return string.concat(out, string.concat(" || ", line))

pub func lower_report(source: str) -> str:
  let tokens = string.split(lexer.scan(source), " | ")
  let count = array.len(tokens)
  let out = ""
  let func_returns = ""
  let current_name = ""
  let current_return = ""
  let current_locals = ""
  let current_blocks = ""
  let current_edges = ""
  let current_block = ""
  let current_ir = ""
  let index: i32 = 0

  while (index < count):
    if (token_matches(tokens, index, "kw", "func") and token_is_kind(tokens, index + 1, "ident") and token_is_kind(tokens, index + 5, "ident")):
      if (string.len(current_name) > 0):
        out = append_function(out, render_function(current_name, current_return, current_locals, current_blocks, current_edges, current_ir))
      current_name = token_value(tokens, index + 1)
      current_return = token_value(tokens, index + 5)
      func_returns = append_mapping(func_returns, current_name, current_return)
      current_locals = ""
      current_blocks = "entry"
      current_edges = ""
      current_block = "entry"
      current_ir = ""
      index = index + 6
      continue
    if (token_matches(tokens, index, "kw", "let")):
      let local_name = token_value(tokens, index + 1)
      let local_type = token_value(tokens, index + 3)
      current_locals = append_mapping(current_locals, local_name, local_type)
      current_ir = append_block_ir(current_ir, current_block, string.concat("alloc(", string.concat(local_name, string.concat(":", string.concat(local_type, ")")))))
      if (token_matches(tokens, index + 4, "punct", "=")):
        let rhs = rhs_state(tokens, index + 5, current_locals, func_returns, local_type)
        current_ir = append_rhs_ir(current_ir, current_block, rhs)
        current_ir = append_block_ir(current_ir, current_block, string.concat("store(", string.concat(local_name, string.concat(":", string.concat(local_type, string.concat("<-", string.concat(rhs_descriptor(rhs), ")")))))))
      index = index + 1
      continue
    if (is_assignment_target(tokens, index)):
      let target = token_value(tokens, index)
      let target_type = lookup_mapping(current_locals, target)
      let rhs = rhs_state(tokens, index + 2, current_locals, func_returns, target_type)
      current_ir = append_rhs_ir(current_ir, current_block, rhs)
      current_ir = append_block_ir(current_ir, current_block, string.concat("assign(", string.concat(target, string.concat(":", string.concat(target_type, string.concat("<-", string.concat(rhs_descriptor(rhs), ")")))))))
      index = index + 1
      continue
    if (token_matches(tokens, index, "kw", "if")):
      current_blocks = append_unique(current_blocks, "then")
      current_edges = append_edge(current_edges, current_block, "then")
      let cond = rhs_state(tokens, index + 2, current_locals, func_returns, "bool")
      current_ir = append_rhs_ir(current_ir, current_block, cond)
      current_ir = append_block_ir(current_ir, current_block, string.concat("branch(", string.concat(rhs_descriptor(cond), ")")))
      current_block = "then"
      index = index + 1
      continue
    if (token_matches(tokens, index, "kw", "while")):
      current_blocks = append_unique(current_blocks, "loop")
      current_edges = append_edge(current_edges, current_block, "loop")
      let cond = rhs_state(tokens, index + 2, current_locals, func_returns, "bool")
      current_ir = append_rhs_ir(current_ir, current_block, cond)
      current_ir = append_block_ir(current_ir, current_block, string.concat("loop(", string.concat(rhs_descriptor(cond), ")")))
      current_block = "loop"
      index = index + 1
      continue
    if (token_matches(tokens, index, "kw", "return")):
      current_blocks = append_unique(current_blocks, "exit")
      current_edges = append_edge(current_edges, current_block, "exit")
      current_block = "exit"
      let rhs = rhs_state(tokens, index + 1, current_locals, func_returns, current_return)
      current_ir = append_rhs_ir(current_ir, current_block, rhs)
      let descriptor = rhs_descriptor(rhs)
      if (string.len(descriptor) > 0 and string.str_eq(descriptor, "unknown") == false):
        current_ir = append_block_ir(current_ir, current_block, string.concat("ret(", string.concat(descriptor, ")")))
      if (string.len(descriptor) == 0 or string.str_eq(descriptor, "unknown")):
        current_ir = append_block_ir(current_ir, current_block, "ret(void)")
      index = index + 1
      continue
    index = index + 1
  if (string.len(current_name) > 0):
    out = append_function(out, render_function(current_name, current_return, current_locals, current_blocks, current_edges, current_ir))
  return out

pub func main() -> i32:
  let path = session.input_path()
  let source = session.read_source(path)
  if (string.len(source) == 0):
    return 1
  println(lower_report(source))
  return 0
