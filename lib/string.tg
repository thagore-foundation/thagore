extern func strlen(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String
extern func __thg_str_contains(text: String, needle: String) -> i32
extern func __thg_str_starts_with(text: String, prefix: String) -> i32
extern func __thg_str_ends_with(text: String, suffix: String) -> i32
extern func __thg_str_trim(text: String) -> String
extern func __thg_str_replace(text: String, old: String, new: String) -> String
extern func __thg_str_lower(text: String) -> String
extern func __thg_str_upper(text: String) -> String
extern func __string_from_codepoint(cp: i32) -> String

func len(text: String) -> i32:
    return strlen(text)

func char_at(text: String, index: i32) -> String:
    return __thg_str_substr(text, index, 1)

func trim(text: String) -> String:
    return __thg_str_trim(text)

func contains(text: String, needle: String) -> i32:
    return __thg_str_contains(text, needle)

func starts_with(text: String, prefix: String) -> i32:
    return __thg_str_starts_with(text, prefix)

func ends_with(text: String, suffix: String) -> i32:
    return __thg_str_ends_with(text, suffix)

func replace(text: String, old_frag: String, new_frag: String) -> String:
    return __thg_str_replace(text, old_frag, new_frag)

func lower(text: String) -> String:
    return __thg_str_lower(text)

func upper(text: String) -> String:
    return __thg_str_upper(text)

func from_codepoint(cp: i32) -> String:
    return __string_from_codepoint(cp)

func quote(text: String) -> String:
    let dq = from_codepoint(34)
    return dq + text + dq

func unquote(text: String) -> String:
    let s = trim(text)
    let n = len(s)
    let dq = from_codepoint(34)
    if (n >= 2):
        if ((char_at(s, 0) == dq) and (char_at(s, n - 1) == dq)):
            return __thg_str_substr(s, 1, n - 2)
    return s
