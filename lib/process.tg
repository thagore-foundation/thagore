import "lib/string.tg" as str

extern func __process_run(cmd: String) -> i32
extern func __process_exec_argv(program: String, args_text: String, stdout_path: String, stderr_path: String, timeout_ms: i32) -> i32
extern func __string_from_codepoint(cp: i32) -> String
extern func __process_open_path(path: String) -> i32
extern func __http_download_file(url: String, out_path: String) -> i32
extern func __archive_unzip(zip_path: String, out_dir: String) -> i32
extern func __fs_move(src: String, dst: String) -> i32

func _has_injection_patterns(cmd: String) -> i32:
    # Check for command chaining
    if str.contains(cmd, "; "):
        return 1
    if str.contains(cmd, "&& "):
        return 1
    if str.contains(cmd, "|| "):
        return 1
    # Check for pipe injection
    if str.contains(cmd, "| "):
        return 1
    # Check for command substitution
    if str.contains(cmd, "$("):
        return 1
    if str.contains(cmd, "`"):
        return 1
    # Check for newline injection
    if str.contains(cmd, "\n"):
        return 1
    # Check for background execution
    if str.contains(cmd, " &"):
        return 1
    return 0

func _is_allowed_command(cmd: String) -> i32:
    if str.starts_with(cmd, "curl "):
        return 1
    if str.starts_with(cmd, "tar "):
        return 1
    if str.starts_with(cmd, "powershell "):
        return 1
    if str.starts_with(cmd, "move "):
        return 1
    if str.starts_with(cmd, "start "):
        return 1
    if str.starts_with(cmd, "mkdir "):
        return 1
    if str.starts_with(cmd, "cp "):
        return 1
    if str.starts_with(cmd, "rm "):
        return 1
    return 0

func shell_escape(text: String) -> String:
    let result = str.replace(text, "\\", "\\\\")
    result = str.replace(result, "\"", "\\\"")
    result = str.replace(result, "$", "\\$")
    result = str.replace(result, "`", "\\`")
    result = str.replace(result, "!", "\\!")
    return result

func run(cmd: String) -> i32:
    # Check for injection patterns
    if _has_injection_patterns(cmd) == 1:
        return -1
    # Check whitelist
    if _is_allowed_command(cmd) == 0:
        return -2
    return __process_run(cmd)

func exec(program: String, args_text: String) -> i32:
    return __process_exec_argv(program, args_text, "", "", 0)

func exec_timeout(program: String, args_text: String, timeout_ms: i32) -> i32:
    return __process_exec_argv(program, args_text, "", "", timeout_ms)

func exec_redirect(program: String, args_text: String, stdout_path: String, stderr_path: String) -> i32:
    return __process_exec_argv(program, args_text, stdout_path, stderr_path, 0)

func exec_redirect_timeout(program: String, args_text: String, stdout_path: String, stderr_path: String, timeout_ms: i32) -> i32:
    return __process_exec_argv(program, args_text, stdout_path, stderr_path, timeout_ms)

func _dq() -> String:
    return __string_from_codepoint(34)

func argv_sep() -> String:
    return __string_from_codepoint(10)

func quote(text: String) -> String:
    return _dq() + shell_escape(text) + _dq()

func open_path(path: String) -> i32:
    let p = str.replace(path, "/", "\\")
    let rc = __process_open_path(p)
    if (rc == 0):
        return 0
    return run("start " + _dq() + _dq() + " " + quote(p))

func download(url: String, out_path: String) -> i32:
    let rc = __http_download_file(url, out_path)
    if (rc == 0):
        return 0
    return run("curl -L -o " + quote(out_path) + " " + quote(url))

func unzip(zip_path: String, out_dir: String) -> i32:
    let rc = __archive_unzip(zip_path, out_dir)
    if (rc == 0):
        return 0
    return run("powershell -NoProfile -Command Expand-Archive -Force " + quote(zip_path) + " " + quote(out_dir))

func move_file(src: String, dst: String) -> i32:
    if (__fs_move(src, dst) == 1):
        return 0
    return run("move /y " + quote(src) + " " + quote(dst) + " >nul 2>&1")

struct Command:
    cmd: String

impl Command:
    func exec(self) -> i32:
        return run(self.cmd)
