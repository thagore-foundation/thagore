extern func malloc(size: usize) -> ptr
extern func free(p: ptr) -> void
extern func __thg_ptr_null() -> ptr
extern func __thg_ptr_set(base: ptr, index: i32, value: ptr) -> void
extern func __thg_ptr_get(base: ptr, index: i32) -> ptr

func _slot_bytes() -> i32
  return 8

func _capacity() -> i32
  return 1024

func new() -> ptr
  let data = malloc(_capacity() * _slot_bytes())
  if data == __thg_ptr_null()
    return __thg_ptr_null()
  let i = 0
  while i < _capacity()
    __thg_ptr_set(data, i, __thg_ptr_null())
    i = i + 1
  return data

func push(items: ptr, item: ptr) -> i32
  if items == __thg_ptr_null()
    return 0
  if item == __thg_ptr_null()
    return 0
  let i = 0
  while i < _capacity()
    if __thg_ptr_get(items, i) == __thg_ptr_null()
      __thg_ptr_set(items, i, item)
      return 1
    i = i + 1
  return 0

func get(items: ptr, index: i32) -> ptr
  if items == __thg_ptr_null()
    return __thg_ptr_null()
  if index < 0
    return __thg_ptr_null()
  if index >= _capacity()
    return __thg_ptr_null()
  return __thg_ptr_get(items, index)

func count(items: ptr) -> i32
  if items == __thg_ptr_null()
    return 0
  let n = 0
  while n < _capacity()
    if __thg_ptr_get(items, n) == __thg_ptr_null()
      return n
    n = n + 1
  return _capacity()

func dispose(items: ptr) -> i32
  if items == __thg_ptr_null()
    return 0
  free(items)
  return 1
