extern func __thg_fs_read_text(path: String) -> String
extern func __thg_fs_write_text(path: String, text: String) -> i32
extern func __thg_fs_remove(path: String) -> i32
extern func __thg_ptr_null() -> ptr

func read_text(path: String) -> String:
    return __thg_fs_read_text(path)

func write_text(path: String, text: String) -> i32:
    return __thg_fs_write_text(path, text)

func exists(path: String) -> i32:
    # Legacy runtime does not expose exists. Keep API stable with fail-safe default.
    return 0

func mkdir(path: String) -> i32:
    # Legacy runtime does not expose mkdir. Keep API stable with fail-safe default.
    return 0

func list_dir(path: String) -> String:
    # Legacy runtime does not expose list_dir.
    return ""

func open_binary(path: String, mode: String) -> ptr:
    return __thg_ptr_null()

func write_bytes(handle: ptr, buffer: String) -> i32:
    return 0

func read_bytes(handle: ptr, size: i32) -> String:
    return ""

func seek(handle: ptr, offset: i32, whence: i32) -> i32:
    return -1

func close(handle: ptr) -> i32:
    return 0

func open_write(path: String) -> ptr:
    return __thg_ptr_null()

func open_read(path: String) -> ptr:
    return __thg_ptr_null()
