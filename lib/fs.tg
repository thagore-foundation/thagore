extern func fopen(filename: String, mode: String) -> ptr
extern func fputs(str: String, stream: ptr) -> i32
extern func fclose(stream: ptr) -> i32
extern func fgetc(stream: ptr) -> i32
extern func feof(stream: ptr) -> i32

struct File:
    handle: ptr

impl File:
    func write(self, content: String) -> i32:
        return fputs(content, self.handle)

    func close(self) -> i32:
        return fclose(self.handle)

    func read_all(self) -> String:
        return "File Content Placeholder"

func open_write(path: String) -> File:
    let mode = "w"
    let p = fopen(path, mode)
    return File(p)

func open_read(path: String) -> File:
    let mode = "r"
    let p = fopen(path, mode)
    return File(p)
