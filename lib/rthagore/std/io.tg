// io (thagore-compatible shim)

use fs as fs
use sys_platform as sys_platform

extern func __io_read_line(prompt: String) -> String
extern func __io_read_all() -> String
extern func __thg_input_i32() -> i32

func _is_stdin_selector(path: String) -> bool
    if path == null
        return true
    if path == ""
        return true
    if path == "-"
        return true
    if path == "stdin"
        return true
    if path == "STDIN"
        return true
    if path == "con"
        return true
    if path == "CON"
        return true
    if path == "/dev/stdin"
        return true
    return false

func read_text(path: String) -> String
    let text = fs.read_text(path)
    if text == null
        return ""
    return text

func write_text(path: String, text: String) -> i32 = fs.write_text(path, text)

func read_bytes(path: String) -> String
    if sys_platform.file_exists(path) == 0
        return ""
    let handle = sys_platform.file_open(path, "r")
    if handle == null
        return ""
    let size = sys_platform.file_fstat(handle)
    if size < 0
        sys_platform.file_close(handle)
        return ""
    let data = sys_platform.file_read(handle, size)
    sys_platform.file_close(handle)
    if data == null
        return ""
    return data

func write_bytes(path: String, buffer: String) -> i32
    let handle = sys_platform.file_open(path, "w")
    if handle == null
        return 0
    let written = sys_platform.file_write(handle, buffer)
    sys_platform.file_close(handle)
    return written

func stdin_read_line(prompt: String = "") -> String
    let line = __io_read_line(prompt)
    if line == null
        return ""
    return line

func input(prompt: String = "") -> String
    return stdin_read_line(prompt)

func input_i32() -> i32
    return __thg_input_i32()

func stdin_read_all() -> String
    let text = __io_read_all()
    if text == null
        return ""
    return text

func stdread(path: String = "") -> String
    if _is_stdin_selector(path)
        return stdin_read_all()
    return read_text(path)

func stdout_write(text: String) -> i32
    print(text)
    return 0
