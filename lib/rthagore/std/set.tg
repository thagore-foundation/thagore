// set stored as newline-delimited unique values.

extern func __thg_cstr_len(s: String) -> i32
extern func __thg_str_substr(s: String, start: i32, len: i32) -> String

func _line_count(text: String) -> i32
  if text == null
    return 0
  let n = __thg_cstr_len(text)
  if n <= 0
    return 0
  let i = 0
  let count = 1
  while i < n
    if __thg_str_substr(text, i, 1) == "\n"
      count = count + 1
    i = i + 1
  return count

func _line_at(text: String, index: i32) -> String
  if index < 0
    return ""
  if text == null
    return ""
  let n = __thg_cstr_len(text)
  if n <= 0
    return ""
  let line = 0
  let start = 0
  let i = 0
  while i <= n
    if (i == n) or (__thg_str_substr(text, i, 1) == "\n")
      if line == index
        return __thg_str_substr(text, start, i - start)
      line = line + 1
      start = i + 1
    i = i + 1
  return ""

func _append_line(out: String, line: String) -> String
  if line == ""
    return out
  if out == ""
    return line
  return out + "\n" + line

func add(s: String, value: String) -> String
  if has(s, value)
    return s
  return _append_line(s, value)

func remove(s: String, value: String) -> String
  let out = ""
  let i = 0
  let n = _line_count(s)
  while i < n
    let cur = _line_at(s, i)
    if cur != value
      out = _append_line(out, cur)
    i = i + 1
  return out

func has(s: String, value: String) -> bool
  let i = 0
  let n = _line_count(s)
  while i < n
    if _line_at(s, i) == value
      return true
    i = i + 1
  return false

func union(a: String, b: String) -> String
  let out = a
  let i = 0
  let n = _line_count(b)
  while i < n
    out = add(out, _line_at(b, i))
    i = i + 1
  return out

func intersection(a: String, b: String) -> String
  let out = ""
  let i = 0
  let n = _line_count(a)
  while i < n
    let cur = _line_at(a, i)
    if has(b, cur)
      out = _append_line(out, cur)
    i = i + 1
  return out

func difference(a: String, b: String) -> String
  let out = ""
  let i = 0
  let n = _line_count(a)
  while i < n
    let cur = _line_at(a, i)
    if not has(b, cur)
      out = _append_line(out, cur)
    i = i + 1
  return out

func symmetric_diff(a: String, b: String) -> String
  return union(difference(a, b), difference(b, a))
