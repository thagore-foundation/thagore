// env (thagore-compatible shim)

extern func __env_get(key: String) -> String
extern func __env_set(key: String, value: String) -> i32
extern func __env_args() -> String
extern func __env_cwd() -> String

func get(key: String) -> String
    let value = __env_get(key)
    if value == null
        return ""
    return value

func set(key: String, value: String) -> i32
    return __env_set(key, value)

func args() -> String
    let value = __env_args()
    if value == null
        return ""
    return value

func cwd() -> String
    let value = __env_cwd()
    if value == null
        return ""
    return value
