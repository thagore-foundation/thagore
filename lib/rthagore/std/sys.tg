// sys (thagore-compatible shim)

use env as env
use process as process

func run(cmd: String, args: String = "") -> i32
    if args == ""
        return process.run(cmd)
    return process.exec(cmd, args)

func exec(program: String, args_text: String = "") -> i32
    return process.exec(program, args_text)

func exec_redirect(program: String, args_text: String = "", stdout_path: String = "", stderr_path: String = "") -> i32
    return process.exec_redirect(program, args_text, stdout_path, stderr_path)

func args() -> String = env.args()

func cwd() -> String = env.cwd()

func getenv(key: String) -> String = env.get(key)

func setenv(key: String, value: String) -> i32 = env.set(key, value)
