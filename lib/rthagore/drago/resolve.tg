// drago resolve (compat implementation)

use tgc as tgc
use "../std/string.tg" as string

extern func __thg_cstr_len(s: String) -> i32

func _len(text: String) -> i32
  return __thg_cstr_len(text)

func _char_at(text: String, index: i32) -> String
  return text.substr(index, 1)

func _find_char(text: String, ch: String) -> i32
  let i = 0
  let n = _len(text)
  while i < n
    if _char_at(text, i) == ch
      return i
    i = i + 1
  return -1

func _append_line(out: String, line: String) -> String
  if line == ""
    return out
  if out == ""
    return line
  return out + "\n" + line

func _resolve_line(line: String, locked_doc: String) -> String
  let eq = _find_char(line, "=")
  if eq <= 0
    return line
  let key = string.trim(line.substr(0, eq))
  if not string.starts_with(key, "deps.")
    return line
  let lock_value = tgc.get(locked_doc, key)
  if lock_value == ""
    return line
  let pair = key + "="
  return pair + lock_value

func resolve(deps: String, locked: String = "") -> String
  let deps_doc = tgc.parse(deps)
  if locked == ""
    return deps_doc
  let lock_doc = tgc.parse(locked)
  if deps_doc == ""
    return lock_doc

  let out = ""
  let line = ""
  let i = 0
  let n = _len(deps_doc)
  while i < n
    let ch = _char_at(deps_doc, i)
    if ch == "\r"
      i = i + 1
    else
      if ch == "\n"
        let clean = string.trim(line)
        if clean != ""
          out = _append_line(out, _resolve_line(clean, lock_doc))
        line = ""
        i = i + 1
      else
        line = line + ch
        i = i + 1

  let last = string.trim(line)
  if last != ""
    out = _append_line(out, _resolve_line(last, lock_doc))
  return out
