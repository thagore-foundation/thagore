extern func __thg_arg_count() -> i32
extern func __thg_arg_get(index: i32) -> String
extern func __env_get(key: String) -> String
extern func __env_set(key: String, value: String) -> i32
extern func __env_cwd() -> String
extern func __env_args() -> String

func count() -> i32:
    return __thg_arg_count()

func get(index: i32) -> String:
    return __thg_arg_get(index)

func program_name() -> String:
    return get(0)

func get_var(key: String) -> String:
    let value = __env_get(key)
    if (value == null):
        return ""
    return value

func set_var(key: String, value: String) -> i32:
    return __env_set(key, value)

func cwd() -> String:
    let path = __env_cwd()
    if (path == null):
        return ""
    return path

func args_text() -> String:
    let text = __env_args()
    if (text == null):
        return ""
    return text
