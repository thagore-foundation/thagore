func os_file_move(src: String, dst: String) -> i32:
    if (os_abi_direct_enabled() == 1):
        let plat = os_platform_name()
        if (plat == "windows"):
            return abi_windows.abi_move_file(src, dst)
        if (((plat == "linux") or (plat == "macos")) or (plat == "bsd")):
            return abi_posix.abi_move_file(src, dst)
    return fs.move(src, dst)

func os_file_open_binary(p: String, mode: String) -> ptr:
    return fs.open_binary(p, mode)

func os_file_open_read(p: String) -> ptr:
