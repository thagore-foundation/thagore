func os_exec_capture(program: String, args_text: String, stdout_path: String, stderr_path: String, timeout_ms: i32) -> i32:
    return process.exec_redirect_timeout(program, args_text, stdout_path, stderr_path, timeout_ms)

func os_download_and_unzip(url: String, zip_path: String, out_dir: String) -> i32:
    let rc1 = process.download(url, zip_path)
    if (rc1 != 0):
        return rc1
    fs.ensure_dir(out_dir)
    return process.unzip(zip_path, out_dir)

func os_http_request(method: String, url: String, body: String) -> String:
    return http.request(method, url, body)

func os_http_get(url: String) -> String:
    return http.get(url)

func os_http_post(url: String, body: String) -> String:
    return http.post(url, body)

func os_time_now_ms() -> i32:
    if (os_abi_direct_enabled() == 1):
        if (os_platform_name() == "windows"):
            return abi_windows.abi_time_now_ms()
    return time.now_ms()

func os_time_sleep_ms(ms: i32) -> i32:
    if (os_abi_direct_enabled() == 1):
        let plat = os_platform_name()
        if (plat == "windows"):
            return abi_windows.abi_sleep_ms(ms)
        if (((plat == "linux") or (plat == "macos")) or (plat == "bsd")):
            return abi_posix.abi_sleep_ms(ms)
    return time.sleep_ms(ms)

func os_process_id() -> i32:
    if (os_abi_direct_enabled() == 1):
        let plat = os_platform_name()
        if (plat == "windows"):
            return abi_windows.abi_process_id()
        if (((plat == "linux") or (plat == "macos")) or (plat == "bsd")):
            return abi_posix.abi_process_id()
    return -1

func os_thread_id() -> i32:
    if (os_abi_direct_enabled() == 1):
        if (os_platform_name() == "windows"):
            return abi_windows.abi_thread_id()
    return -1

func os_debug_print(text: String) -> i32:
    if ((os_abi_direct_enabled() == 1) and (os_platform_name() == "windows")):
        return abi_windows.abi_debug_print(text)
    print(text)
    return 0

