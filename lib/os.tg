func os_file_close(handle: ptr) -> i32:
    return fs.close(handle)

func os_file_write_ensured(p: String, text: String) -> i32:
    let dir = path.dirname(p)
    if (str.len(dir) > 0):
        fs.ensure_dir(dir)
    return fs.write_text(p, text)

func os_file_read_or_default(p: String, fallback: String) -> String:
    if (fs.exists(p) == 1):
        return fs.read_text(p)
    return fallback

