import "lib/env.tg" as env
import "lib/fs.tg" as fs
import "lib/http.tg" as http
import "lib/io.tg" as io
import "lib/list.tg" as list
import "lib/map.tg" as map
import "lib/os_abi_posix.tg" as abi_posix
import "lib/os_abi_windows.tg" as abi_windows
import "lib/path.tg" as path
import "lib/process.tg" as process
import "lib/string.tg" as str
import "lib/time.tg" as time

func os_abi_mode() -> String:
    let mode = str.lower(str.trim(env.get_var("THAG_OS_ABI_MODE")))
    if ((mode == "direct") or (mode == "native") or (mode == "os")):
        return "direct"
    return "wrapped"

func os_abi_direct_enabled() -> i32:
    if (os_abi_mode() == "direct"):
        return 1
    return 0

func os_platform_name() -> String:
    let os_name = env.get_var("OS")
    if (os_name == "Windows_NT"):
        return "windows"
    let ostype = str.lower(env.get_var("OSTYPE"))
    if (((str.contains(ostype, "win") == 1) or (str.contains(ostype, "msys") == 1)) or (str.contains(ostype, "cygwin") == 1)):
        return "windows"
    if (str.contains(ostype, "linux") == 1):
        return "linux"
    if ((str.contains(ostype, "darwin") == 1) or (str.contains(ostype, "mac") == 1)):
        return "macos"
    if (str.contains(ostype, "bsd") == 1):
        return "bsd"
    return "unknown"

func os_is_windows() -> i32:
    if (os_platform_name() == "windows"):
        return 1
    return 0

func os_args_count() -> i32:
    return env.count()

func os_arg(index: i32) -> String:
    return env.get(index)

func os_program_name() -> String:
