func os_file_read_text(p: String) -> String:
    return fs.read_text(p)

func os_file_write_text(p: String, text: String) -> i32:
    return fs.write_text(p, text)

func os_file_remove(p: String) -> i32:
    if (os_abi_direct_enabled() == 1):
        let plat = os_platform_name()
        if (plat == "windows"):
            return abi_windows.abi_remove_file(p)
        if (((plat == "linux") or (plat == "macos")) or (plat == "bsd")):
            return abi_posix.abi_remove_file(p)
    return fs.remove(p)

func os_file_exists(p: String) -> i32:
    if (os_abi_direct_enabled() == 1):
        let plat = os_platform_name()
        if (plat == "windows"):
            return abi_windows.abi_file_exists(p)
        if (((plat == "linux") or (plat == "macos")) or (plat == "bsd")):
            return abi_posix.abi_file_exists(p)
    return fs.exists(p)

func os_file_mkdir(p: String) -> i32:
    if (os_abi_direct_enabled() == 1):
        let plat = os_platform_name()
        if (plat == "windows"):
            return abi_windows.abi_mkdir(p)
        if (((plat == "linux") or (plat == "macos")) or (plat == "bsd")):
            return abi_posix.abi_mkdir(p)
    return fs.mkdir(p)

