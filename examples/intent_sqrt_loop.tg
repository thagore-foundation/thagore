intent func count_divisors(n: i32) -> i32:
    goal: auto_plan
    constraints:
        deterministic == true

func count_divisors(n: i32) -> i32:
    let i = 1
    let count = 0
    while (i <= n):
        if ((n % i) == 0):
            count = count + 1
        i = i + 1
    return count

func main() -> i32:
    print(count_divisors(360))
    return 0
