import fs
extern func __time_now_ms() -> i32

intent func fib_auto(n: i32) -> i32:
    goal: auto_plan
    constraints:
        deterministic == true

func fib_auto(n: i32) -> i32:
    if (n < 2):
        return n
    return fib_auto(n - 1) + fib_auto(n - 2)

func main() -> i32:
    let seed = __time_now_ms()
    let n = 35 + (seed - (seed / 3) * 3)
    let t0 = __time_now_ms()
    let ans = fib_auto(n)
    let t1 = __time_now_ms()
    print("auto_plan fib:")
    print(ans)
    print("auto_plan elapsed_ms:")
    print(t1 - t0)
    return 0

