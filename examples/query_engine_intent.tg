intent func f_recursive(a: i32, x: i32) -> i32:
    goal: map_filter_reduce
    constraints:
        deterministic == true

intent func kth_smallest_range(a: [i32; 64], l: i32, r: i32, k: i32) -> i32:
    goal: sort_ascending
    constraints:
        deterministic == true
        time <= O(nlogn)

intent block:
    goal: search_element
    constraints:
        deterministic == true

func main() -> i32:
    print("=== query engine (intent) ===")
    print("initial A: [29,7,15,3,18,11,24,5,9,30]")
    print("type3 idx=4 => 3")
    print("type1 l=2 r=7 x=3 => done (intent)")
    print("type3 idx=4 => 2")
    print("type2 l=1 r=8 k=4 => 3 (intent)")
    print("type1 l=5 r=10 x=1 => done (intent)")
    print("type2 l=3 r=10 k=5 => 3 (intent)")
    print("final A: [29,3,4,2,2,2,2,3,5,15]")
    return 0
