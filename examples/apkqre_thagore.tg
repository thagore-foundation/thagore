import "lib/fs.tg" as fs
import "lib/process.tg" as process
import "lib/io.tg" as io
import "lib/string.tg" as str
import "lib/path.tg" as path

func _download_if_missing(url: String, out_path: String, label: String) -> i32:
    if (fs.exists(out_path) == 1):
        return 0
    print("Downloading " + label + "...")
    if (process.download(url, out_path) != 0):
        print("Download failed: " + label)
        return 1
    if (fs.exists(out_path) == 0):
        print("Missing file: " + out_path)
        return 1
    return 0

func _extract_zip(zip_path: String, out_dir: String) -> i32:
    return process.unzip(zip_path, out_dir)

func _detect_or_install_java(jre_url: String, jre_zip: String, jre_dir: String) -> String:
    let p1 = "tools/jdk/jdk-17.0.9+9-jre/bin/java.exe"
    let p2 = "tools/jdk/bin/java.exe"
    if (fs.exists(p1) == 1):
        return p1
    if (fs.exists(p2) == 1):
        return p2
    print("Java not found. Downloading Temurin JRE...")
    if (_download_if_missing(jre_url, jre_zip, "Temurin JRE") != 0):
        return ""
    if (_extract_zip(jre_zip, jre_dir) != 0):
        print("JRE extract failed.")
        return ""
    if (fs.exists(p1) == 1):
        return p1
    if (fs.exists(p2) == 1):
        return p2
    return ""

func _decode_apk(java_bin: String, apktool_jar: String) -> String:
    let apk = str.unquote(io.input_prompt("Enter full APK path: "))
    if (fs.exists(apk) == 0):
        print("File not found.")
        return ""
    let name = path.stem(apk)
    let out_dir = path.join("decoded", name)
    let nl = process.argv_sep()
    let args = "-jar" + nl + apktool_jar + nl + "d" + nl + apk + nl + "-o" + nl + out_dir + nl + "-f"
    let log_path = "tools/last_decode.log"
    print("Decoding APK...")
    if (process.exec_redirect(java_bin, args, log_path, log_path) != 0):
        print("Decode failed.")
        io.print_file_if_non_empty(log_path, "----- error log -----", "----- end log -----")
        return ""
    if (fs.exists(out_dir) == 1):
        process.open_path(out_dir)
    else:
        print("Decode finished but output folder not found: " + out_dir)
    return name

func _build_apk(java_bin: String, apktool_jar: String, folder: String) -> i32:
    let target_dir = path.join("decoded", folder)
    if (fs.exists(target_dir) == 0):
        print("Folder not found.")
        return 1
    let out_apk = path.join(target_dir, "unsigned.apk")
    let nl = process.argv_sep()
    let args = "-jar" + nl + apktool_jar + nl + "b" + nl + target_dir + nl + "-o" + nl + out_apk
    let log_path = "tools/last_build.log"
    print("Building APK...")
    if (process.exec_redirect(java_bin, args, log_path, log_path) != 0):
        print("Build failed.")
        io.print_file_if_non_empty(log_path, "----- error log -----", "----- end log -----")
        return 1
    print("Build done: " + out_apk)
    return 0

func _sign_apk(java_bin: String, signer_jar: String, folder: String) -> i32:
    let apk_to_sign = path.join(path.join("decoded", folder), "unsigned.apk")
    if (fs.exists(apk_to_sign) == 0):
        print("unsigned.apk not found. Build first.")
        return 1
    let output_path = str.trim(io.input_prompt("Save signed APK to (default: apksigned): "))
    if (str.len(output_path) == 0):
        output_path = "apksigned"
    fs.ensure_dir(output_path)
    let nl = process.argv_sep()
    let args = "-jar" + nl + signer_jar + nl + "--apks" + nl + apk_to_sign + nl + "--out" + nl + output_path + nl + "--allowResign"
    let log_path = "tools/last_sign.log"
    print("Signing APK...")
    if (process.exec_redirect(java_bin, args, log_path, log_path) != 0):
        print("Signing failed.")
        io.print_file_if_non_empty(log_path, "----- error log -----", "----- end log -----")
        return 1
    let signed_apk = path.join(output_path, "unsigned-aligned-debugSigned.apk")
    let final_apk = path.join(output_path, folder + "-signed.apk")
    if (fs.exists(signed_apk) == 1):
        process.move_file(signed_apk, final_apk)
        print("Output: " + final_apk)
    process.open_path(output_path)
    return 0

func _tools_menu(java_bin: String, apktool_jar: String, signer_jar: String, jadx_gui: String, folder: String) -> i32:
    let done = 0
    while (done == 0):
        print("=== Working on: " + folder + " ===")
        print("1. Open folder")
        print("2. Build APK")
        print("3. Sign APK")
        print("4. Open JADX GUI")
        print("5. Back")
        let op = str.trim(io.input_prompt("Choice: "))
        if (op == "1"):
            let work_dir = path.join("decoded", folder)
            if (fs.exists(work_dir) == 1):
                process.open_path(work_dir)
            else:
                print("Folder not found.")
        if (op == "2"):
            _build_apk(java_bin, apktool_jar, folder)
        if (op == "3"):
            _sign_apk(java_bin, signer_jar, folder)
        if (op == "4"):
            if (fs.exists(jadx_gui) == 1):
                process.open_path(jadx_gui)
            else:
                print("JADX not found.")
        if (op == "5"):
            done = 1
    return 0

func main() -> i32:
    fs.ensure_dir("tools")
    fs.ensure_dir("decoded")
    fs.ensure_dir("apksigned")

    let jre_url = "https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.9%2B9.1/OpenJDK17U-jre_x64_windows_hotspot_17.0.9_9.zip"
    let jre_zip = "tools/jre.zip"
    let jre_dir = "tools/jdk"
    let apktool_url = "https://bitbucket.org/iBotPeaches/apktool/downloads/apktool_2.9.3.jar"
    let apktool_jar = "tools/apktool.jar"
    let jadx_url = "https://github.com/skylot/jadx/releases/download/v1.5.3/jadx-1.5.3.zip"
    let jadx_zip = "tools/jadx.zip"
    let jadx_dir = "tools/jadx"
    let jadx_gui = "tools/jadx/bin/jadx-gui.bat"
    let signer_url = "https://github.com/patrickfav/uber-apk-signer/releases/download/v1.3.0/uber-apk-signer-1.3.0.jar"
    let signer_jar = "tools/uber-apk-signer.jar"

    let java_bin = _detect_or_install_java(jre_url, jre_zip, jre_dir)
    if (str.len(java_bin) == 0):
        print("Java setup failed.")
        return 1
    if (_download_if_missing(apktool_url, apktool_jar, "Apktool") != 0):
        return 1
    if (_download_if_missing(signer_url, signer_jar, "Uber APK Signer") != 0):
        return 1
    if (fs.exists(jadx_gui) == 0):
        if (_download_if_missing(jadx_url, jadx_zip, "JADX") != 0):
            return 1
        if (_extract_zip(jadx_zip, jadx_dir) != 0):
            print("JADX extract failed.")
            return 1

    let exit_loop = 0
    while (exit_loop == 0):
        print("=== ApkQRE (Thagore) ===")
        print("1. Decode new APK")
        print("2. View decoded")
        print("3. Exit")
        let ch = str.trim(io.input_prompt("Choice: "))
        if (ch == "1"):
            let folder = _decode_apk(java_bin, apktool_jar)
            if (str.len(folder) > 0):
                _tools_menu(java_bin, apktool_jar, signer_jar, jadx_gui, folder)
        if (ch == "2"):
            print("=== Decoded APKs ===")
            let listing = fs.list_dir("decoded")
            print(listing)
            let folder2 = str.trim(io.input_prompt("Folder name (exact): "))
            if (fs.exists(path.join("decoded", folder2)) == 1):
                _tools_menu(java_bin, apktool_jar, signer_jar, jadx_gui, folder2)
            else:
                print("Folder not found.")
        if (ch == "3"):
            exit_loop = 1
    return 0
