from lib.gui import canvas
from lib.gui import clear
from lib.gui import draw_line
from lib.gui import draw_point
from lib.gui import present
from lib.gui import last_frame_path
from lib.gui import run_fixed_timestep
from lib.gui import destroy

func main():
  let c = canvas(96, 96, "thagore_joy")
  clear(c, 16777215)
  draw_line(c, 8, 8, 87, 87, 255)
  draw_line(c, 8, 87, 87, 8, 255)
  draw_point(c, 48, 48, 16711680)
  run_fixed_timestep(c, 60, 3)
  present(c)
  print(last_frame_path(c))
  destroy(c)
  return 0
