import lib.tensor as tensor
import lib.trace as trace
import lib.sql as sql

func infer_score(seed: i64) -> i64:
  let x = tensor.new_i64(3)
  let w = tensor.new_i64(3)
  tensor.set_i64(x, 0, seed)
  tensor.set_i64(x, 1, seed + 1)
  tensor.set_i64(x, 2, seed + 2)
  tensor.set_i64(w, 0, 2)
  tensor.set_i64(w, 1, 3)
  tensor.set_i64(w, 2, 4)
  let score = tensor.dot_i64(x, w)
  tensor.free(x)
  tensor.free(w)
  return score

func emit_request_event() -> i32:
  trace.event("request.received")
  return 1

flow model_inference:
  step parse_request = emit_request_event()
    irreversible
  step score_step = infer_score(3)
    retry 2
    idempotent
    timeout 300ms
    irreversible

func build_feature_query() -> ptr:
  let b = sql.builder()
  sql.select(b, "id,value")
  sql.from(b, "feature_store")
  sql.where(b, "id = 7")
  sql.limit(b, 1)
  return sql.build(b)

func main() -> i32:
  trace.enable()
  let span = trace.span_begin("model_inference")
  let ok = model_inference()
  if (ok == 0):
    trace.event("model_inference.failed")
    trace.span_end(span)
    trace.disable()
    return 1
  print(build_feature_query())
  print(infer_score(3))
  trace.event("model_inference.ok")
  trace.span_end(span)
  trace.disable()
  return 0
