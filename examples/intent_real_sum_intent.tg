import fs
extern func __time_now_ms() -> i32

intent func sum_to_n(n: i32) -> i32:
    goal: reduce_sum
    constraints:
        deterministic == true

func sum_to_n(n: i32) -> i32:
    let i = 1
    let s = 0
    while (i <= n):
        s = s + i
        i = i + 1
    return s

func main() -> i32:
    let seed = __time_now_ms()
    let base = 60000 + (seed - (seed / 1000) * 1000)
    let rounds = 8000
    let t0 = __time_now_ms()
    let i = 0
    let cur = base
    let last = 0
    while (i < rounds):
        last = sum_to_n(cur)
        cur = cur + 1
        if (cur > base + 31):
            cur = base
        i = i + 1
    let t1 = __time_now_ms()
    print("intent sum_to_n:")
    print(last)
    print("intent elapsed_ms:")
    print(t1 - t0)
    return 0

