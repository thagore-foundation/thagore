import fs
extern func __time_now_ms() -> i32

intent func fib_recursive(n: i32) -> i32:
    goal: auto_plan
    constraints:
        deterministic == true

intent func sum_to_n_loop(n: i32) -> i32:
    goal: reduce_sum
    constraints:
        deterministic == true

intent func isqrt_loop(n: i32) -> i32:
    constraints:
        deterministic == true

intent func search_identity(n: i32, target: i32) -> i32:
    constraints:
        deterministic == true

intent func factorial_recursive(n: i32) -> i32:
    goal: auto_plan
    constraints:
        deterministic == true

intent func pow_linear(base: i32, exp: i32) -> i32:
    constraints:
        deterministic == true

intent func gcd_subtractive(a: i32, b: i32) -> i32:
    constraints:
        deterministic == true

intent func is_prime_naive(n: i32) -> i32:
    goal: auto_plan
    constraints:
        deterministic == true

intent func count_divisors_naive(n: i32) -> i32:
    goal: auto_plan
    constraints:
        deterministic == true

intent func bit_peel_recursive(a: i32, x: i32) -> i32:
    goal: auto_plan
    constraints:
        deterministic == true

func fib_recursive(n: i32) -> i32:
    if (n < 2):
        return n
    return fib_recursive(n - 1) + fib_recursive(n - 2)

func sum_to_n_loop(n: i32) -> i32:
    let i = 1
    let s = 0
    while (i <= n):
        s = s + i
        i = i + 1
    return s

func isqrt_loop(n: i32) -> i32:
    let i = 0
    while (((i + 1) * (i + 1)) <= n):
        i = i + 1
    return i

func search_identity(n: i32, target: i32) -> i32:
    let i = 0
    while (i < n):
        if (i == target):
            return i
        i = i + 1
    return -1

func factorial_recursive(n: i32) -> i32:
    if (n <= 1):
        return 1
    return n * factorial_recursive(n - 1)

func pow_linear(base: i32, exp: i32) -> i32:
    let i = 0
    let result = 1
    while (i < exp):
        result = result * base
        i = i + 1
    return result

func gcd_subtractive(a: i32, b: i32) -> i32:
    let x = a
    let y = b
    while (x != y):
        if (x > y):
            x = x - y
        else:
            y = y - x
    return x

func is_prime_naive(n: i32) -> i32:
    if (n < 2):
        return 0
    let i = 2
    while (i < n):
        if ((n - (n / i) * i) == 0):
            return 0
        i = i + 1
    return 1

func count_divisors_naive(n: i32) -> i32:
    if (n <= 0):
        return 0
    let i = 1
    let count = 0
    while (i <= n):
        if ((n - (n / i) * i) == 0):
            count = count + 1
        i = i + 1
    return count

func bit_peel_recursive(a: i32, x: i32) -> i32:
    if (x == 0):
        return a
    return bit_peel_recursive(a / 2, x - 1) + (a - (a / 2) * 2)

func bench_mix(seed: i32) -> i32:
    let acc = 0

    let fib_n = 33 + (seed - (seed / 4) * 4)
    acc = acc + fib_recursive(fib_n)

    let i = 0
    while (i < 3000):
        acc = acc + sum_to_n_loop(65000 + (i - (i / 32) * 32))
        i = i + 1

    let j = 0
    while (j < 2500):
        acc = acc + isqrt_loop(123456789 - j)
        j = j + 1

    let k = 0
    while (k < 3000):
        acc = acc + search_identity(50000, 49999 - (k - (k / 8) * 8))
        k = k + 1

    let f = 0
    let fn = 10
    while (f < 60000):
        acc = acc + factorial_recursive(fn)
        fn = fn + 1
        if (fn > 12):
            fn = 10
        f = f + 1

    let p = 0
    let exp = 11
    while (p < 80000):
        acc = acc + pow_linear(2, exp)
        exp = exp + 1
        if (exp > 18):
            exp = 11
        p = p + 1

    let g = 0
    let ga = 2800
    let gb = 1999
    while (g < 12000):
        acc = acc + gcd_subtractive(ga, gb)
        ga = ga + 7
        gb = gb + 11
        if (ga > 3600):
            ga = 2800
        if (gb > 2600):
            gb = 1999
        g = g + 1

    let p2 = 0
    let prime_n = 16000
    while (p2 < 3500):
        acc = acc + is_prime_naive(prime_n)
        prime_n = prime_n + 1
        if (prime_n > 16800):
            prime_n = 16000
        p2 = p2 + 1

    let d2 = 0
    let div_n = 26000
    while (d2 < 2600):
        acc = acc + count_divisors_naive(div_n)
        div_n = div_n + 1
        if (div_n > 26800):
            div_n = 26000
        d2 = d2 + 1

    let b = 0
    let cur = 1000000007
    while (b < 80000):
        acc = acc + bit_peel_recursive(cur, 16)
        cur = cur + 12345
        if (cur > 1000500000):
            cur = 1000000007
        b = b + 1

    return acc

func main() -> i32:
    let seed = __time_now_ms()
    let t0 = __time_now_ms()
    let ans = bench_mix(seed)
    let t1 = __time_now_ms()
    print("auto-expand intent:")
    print(ans)
    print("elapsed_ms:")
    print(t1 - t0)
    return 0

